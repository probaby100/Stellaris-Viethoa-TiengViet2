 ## event_names.yml
 civilian_freighter_object: "Tàu Kohtalo"
 derelict_particle_accelerator: "Trạm không gian bỏ hoang"
 derelict_particle_accelerator_desc: "Trạm không gian hoang phế này đã trải qua vô số vụ va chạm với các mảnh vỡ trong suốt nhiều thế kỷ, trôi nổi trên quỹ đạo của hành tinh này."
 NAME_Czyrni: "Czyrni"
 NAME_Pyorun: "Pyorun"
 NAME_Scavenger_Bot: "Robot Nhặt Rác"
 NAME_Autonomous_Repurposer: "$NAME_Scavenger_Bot$"
 NAME_Reclaimer: "Kẻ Thu Hồi"
 NAME_Modulus: "Kẻ Hệ Số"
 NAME_S8751: "Chiến thể S875.1"
 NAME_Elderly_Tiyanki: "Tộc Mẫu Tiyanki"
 NAME_Progenitor: "Kẻ Khai Sinh"
 NAME_Elder: "Trưởng Lão"
 NAME_Tiyanki_Space_Whale_Ancient: "Cá voi Không gian Tiyanki Viễn cổ"
 NAME_AH4B: "Tàu Ahab"
 NAME_Reth_Unddol: "Reth Unddol"
 NAME_Unknown: "Không xác định"
 NAME_The_Captain: "Thuyền trưởng"
 abandoned_wormhole_station: "Trạm Lỗ sâu bỏ hoang"
 abandoned_wormhole_station_desc: "Một trạm không gian bị bỏ hoang đang từ từ xoay vòng giữa lỗ sâu này."
 mysterious_tanker_object: "Khoang chứa Bí ẩn"
 mysterious_tanker_object_desc: "Một con tàu phế liệu chất đầy các thùng chứa đang lượn lờ trên quỹ đạo thấp của hành tinh này."
 droppod_01_object: "Khoang đổ bộ vứt xó"
 droppod_01_object_desc: "Một khoang đổ bộ đang trôi dạt trong vũ trụ, những người ngoài hành tinh mà nó chuyên chở ban đầu đã biến thành những cái xác khô từ lâu."
 droppod_02_object: "$droppod_01_object$"
 droppod_02_object_desc: "Một khoang đổ bộ đang trôi dạt trong vũ trụ. Chúng ta phát hiện ra có dấu hiệu hoạt động yếu ớt bên trong."
 NAME_Caretaker: "Người Trông Nom AX7-b"
 caretaker_leader: "$NAME_Caretaker$"
 caretaker_leader_desc: "Một cỗ máy chuyên lo việc chăm sóc cho người khác. Những thất bại trong quá khứ đã in sâu vào trong bộ nhớ của nó."
 caretaker_leader_catch_phrase: "$distar.249.desc$"
 leader_trait_govenor_caretaker: "Người Trông Nom"
 leader_trait_govenor_caretaker_desc: "Đảm bảo nguồn dinh dưỡng dồi dào, môi trường làm việc sạch sẽ, và những người được giám hộ nhận được những kích thích phù hợp, tất cả đều nằm dưới sự giám sát của Người Trông Nom."
 leader_trait_govenor_caretaker_node: "Lời khuyên của Người Trông Nom"
 leader_trait_govenor_caretaker_node_desc: "Chúng ta đã học được những kiến thức độc đáo của Người Trông Nom."
 ## l_english.yml
 trait_presapient_docile_livestock: "Gia Súc Ngoan Ngoãn"
 trait_presapient_docile_livestock_desc: "§LNgoan ngoãn mà lại còn thơm ngon! Giống loài này vì bị biến đổi chức năng não bộ bậc cao nên đã trở thành một loại gia súc vô hại, có thể tự lo liệu cho bản thân, đồng thời thoát khỏi những phiền toái của việc giao tiếp xã hội và tự đưa ra quyết định.§!"
 trait_brainslug: "Vật chủ Sên Não"
 trait_brainslug_desc: "§LGiống loài này đang tận hưởng sự chung sống cùng với sinh vật cộng sinh thần kinh: một loại sên lành tính bám vào thân não của vật chủ.§!"
 leader_trait_scientist_brainslug: "$trait_brainslug$"
 leader_trait_scientist_brainslug_desc: "Vị lãnh đạo này đang được hưởng lợi từ sinh vật cộng sinh thần kinh: một con sên có ích bám trên thân não của vật chủ."
 leader_trait_admiral_brainslug: "$trait_brainslug$"
 leader_trait_admiral_brainslug_desc: "$leader_trait_scientist_brainslug_desc$"
 leader_trait_governor_brainslug: "$trait_brainslug$"
 leader_trait_governor_brainslug_desc: "$leader_trait_scientist_brainslug_desc$"
 leader_trait_ruler_brainslug: "$trait_brainslug$"
 leader_trait_ruler_brainslug_desc: "$leader_trait_scientist_brainslug_desc$"
 leader_trait_general_brainslug: "$trait_brainslug$"
 leader_trait_general_brainslug_desc: "$leader_trait_scientist_brainslug_desc$"
 leader_trait_brainslug: "$trait_brainslug$"
 leader_trait_brainslug_desc: "$leader_trait_scientist_brainslug_desc$"
 leader_trait_admiral_hells_heart: "Tham Vọng Địa Ngục"
 leader_trait_admiral_hells_heart_desc: "Khi đối mặt với chiến tranh, vị lãnh đạo này vô cùng cuồng tín, tàn nhẫn và không hề nao núng."
 hells_heart_effect: "$t$§H$leader_trait_corsair$§! và §H$leader_trait_shipbreaker$§! sản xuất thêm §G50%§! tài nguyên."
 d_vast_unity_deposit: "£unity£ +3\n"
 d_vast_unity_deposit_desc: "$d_vast_unity_deposit$"
 trait_bioadaptability: "Thích nghi Sinh học"
 trait_bioadaptability_desc: "§LGiống loài này đã được cải tạo gen, giúp nâng cao đôi chút khả năng thích nghi với môi trường, có thể chịu đựng được những vùng khí hậu khắc nghiệt hơn.§!"
 trait_social_pheromones: "Pheromone Bầy đàn"
 trait_social_pheromones_desc: "§LGiống loài này đã được cải tạo gen, trở nên thích ứng hơn với lối sống quần cư đông đúc.§!"
 trait_limited_regeneration: "Tái tạo Giới hạn"
 trait_limited_regeneration_desc: "§LGiống loài này đã được cải tạo gen, giúp vết thương hồi phục nhanh hơn, không những nâng cao khả năng chiến đấu mà còn kéo dài tuổi thọ thêm một chút.§!"
 ## technology_l_english.yml
 SCAVENGER_SECONDARY_WEAPON: "$STRANGE_COMPONENTS_DESC$"
 SCAVENGER_MAIN_WEAPON: "Máy phóng Phế liệu"
 tech_nanite_repair_system: "Hệ thống Tự sửa chữa Nanobot"
 tech_nanite_repair_system_desc: "Chúng ta đã phát hiện ra một hệ thống tự động sửa chữa lớp vỏ tàu cực kỳ hiệu quả bên trong tàn tích của Robot Nhặt Rác, hệ thống này được cấu thành từ hàng tỷ nanobot siêu nhỏ, và đã được cải tiến để chúng ta có thể sử dụng. Còn việc Kẻ Nhặt Rác đã cướp hệ thống này từ những tàn tích viễn cổ nào đó, hay bản thân nó ngay từ đầu đã được trang bị hệ thống này, thì vẫn chưa ai rõ."
 tech_neuroregeneration: "Kỹ thuật Tổ chức Thần kinh"
 tech_neuroregeneration_desc: "Sau khi thích ứng với bộ gen của một giống loài, cấu trúc mô được thiết kế bằng kỹ thuật này có thể thể hiện các đặc tính tái tạo thần kinh mạnh mẽ, đẩy nhanh đáng kể sự phát triển của tế bào thần kinh, sợi trục và khớp thần kinh trong cơ thể người nhận."
 AUTO_REPAIR_2: "$tech_nanite_repair_system$"
 tech_nanite_autocannon: "Pháo Tự động Nanobot"
 tech_nanite_autocannon_desc: "Hệ thống pháo tự động cực kỳ tối tân, đạn được bắn ra có thể kích nổ thành một đám mây nanobot khi tiếp cận mục tiêu, qua đó làm quá tải lá chắn của đối phương và ăn mòn từng mảng thân tàu của chúng."
 AUTOCANNON_4: "$tech_nanite_autocannon$"
 AUTOCANNON_4_DESC: "$tech_nanite_autocannon_desc$"
 SMALL_AUTOCANNON_4: "$AUTOCANNON_4$"
 SMALL_AUTOCANNON_4_DESC: "$AUTOCANNON_4_DESC$"
 MEDIUM_AUTOCANNON_4: "$AUTOCANNON_4$"
 MEDIUM_AUTOCANNON_4_DESC: "$AUTOCANNON_4_DESC$"
 LARGE_AUTOCANNON_4: "$AUTOCANNON_4$"
 LARGE_AUTOCANNON_4_DESC: "$AUTOCANNON_4_DESC$"
 tech_nanite_flak_batteries: "Pháo Phòng không Nanobot"
 tech_nanite_flak_batteries_desc: "Dựa trên bản thiết kế hiện có, việc hoán cải để sử dụng các đầu đạn chứa nanobot có thể nuốt chửng các máy bay trên hạm, quả thật là cơn ác mộng đối với các phi công tiêm kích hạm."
 FLAK_BATTERY_4: "$tech_nanite_flak_batteries$"
 FLAK_BATTERY_4_DESC: "$tech_nanite_flak_batteries_desc$"
 TIYANKI_ARMOR: "Giáp Tiyanki"
 TIYANKI_ARMOR_DESC: "Lớp da ngoài của Tộc Mẫu Tiyanki đã trở nên xơ cứng qua năm tháng và những quá trình biến đổi sinh học không xác định."
 SMALL_TIYANKI_ARMOR: "Giáp Tiyanki cỡ Nhỏ"
 MEDIUM_TIYANKI_ARMOR: "Giáp Tiyanki cỡ Trung"
 LARGE_TIYANKI_ARMOR: "Giáp Tiyanki cỡ Lớn"
 #MODIFIERS:
 in_paradise: "Sống trong Chốn bồng lai"
 in_paradise_desc: "Công dân của chúng ta đang reo hò vì đã thiết lập thuộc địa thành công trên một hành tinh thiên đường."
 paradise_planet: "Paridaya"
 paradise_planet_desc: "Một thế giới tuyệt đẹp hệt như chốn thần tiên."
 mega_computer: "Robot Cốt thép"
 mega-computer_desc: "Chúng ta có một con robot cốt thép đang hỗ trợ bộ phận kỹ thuật."
 a_hitchikers_guide_to_the_galaxy_desc: "Một cuốn cẩm nang hướng dẫn du hành dải ngân hà ngoài hành tinh đã thổi bùng tình yêu của mọi người đối với những điều chưa biết."
 a_hitchikers_guide_to_the_galaxy: "Cẩm nang Du hành Ngân hà Ngoại lai"
 littering_loitering_liability: "Nhân tố bất lợi lêu lổng và xả rác bừa bãi"
 littering_loitering_liability_desc: "Lũ người ngoài hành tinh bẩn thỉu..."
 ancient_harvesters: "Máy thu hoạch Viễn cổ"
 ancient_harvesters_desc: "Những chiếc máy thu hoạch viễn cổ chạy bằng năng lượng mặt trời đang hỗ trợ gặt hái mùa màng trên hành tinh."
 seismological_phenomena: "Hiện tượng Địa chấn"
 seismological_phenomena_desc: "Hành tinh này đang bị ảnh hưởng bởi những hiện tượng địa chấn dị thường."
 seismological_phenomena_2: "$seismological_phenomena$"
 seismological_phenomena_2_desc: "$seismological_phenomena_desc$"
 egg_rifts: "Vết nứt"
 egg_rifts_desc: "Chất nhầy độc hại cùng với các loại khí gas liên tục trào ra từ những vết nứt trên bề mặt hành tinh. Toàn bộ hành tinh ngập tràn mùi trứng thối."
 mod_damage_vs_country_type_guardian_hatchling_mult: "Sát thương lên Ấu trùng Hư không"
 #TILE BLOCKERS:
 fungoid_extermination: "Đất rác Độc hại"
 fungoid_extermination_desc: "Ở đây tồn tại các dung môi hóa học độc hại cùng với những vật chất hữu cơ đã bị phân hủy, khiến cho khu vực này hoàn toàn không thể sinh sống được."
 egg_cracking: "Rạn nứt"
 egg_cracking_desc: "Các hiện tượng địa chấn đã khiến lớp vỏ hành tinh nứt toác, phun ra lượng khí lưu huỳnh cùng với các loại chất nhầy độc hại."
 #POINTS OF INTEREST:
 hidden_planet_poi: "Hành tinh Ẩn"
 hidden_planet_desc: "Tọa độ được trích xuất từ thiết bị điều hướng của tàu Vechtar Zavonia đang chỉ đến vị trí này."
 crazy_system_poi.1: "Ngôi sao Khắc khoải"
 crazy_system_poi.1_desc: "Một vài ngôi sao bắt đầu co giật và đập liên hồi một cách dị thường."
 crazy_system_poi.2: "$crazy_system_poi.1$"
 crazy_system_poi.2_desc: "$crazy_system_poi.1_desc$"
 crazy_system_poi.3: "$crazy_system_poi.1$"
 crazy_system_poi.3_desc: "$crazy_system_poi.1_desc$"
 #ARMIES:
 azizian_troop_limit_tooltip: "Sâu Azizian là loài sên khổng lồ hung tợn, có thể nghiền nát kẻ thù và tiết ra một loại chất lỏng sền sệt."
 titanic_azizian_assault_army: "Quân đoàn Azizian"
 titanic_azizian_assault_army_desc: "Loài sên khổng lồ hung hãn."
 #SHIPS & FLEETS:
 enigmatic_cache: "Cá thể Thăm dò"
 enigmatic_cache_plural: "Cá thể Thăm dò"
 #TECHNOLOGIES
 tech_gargantuan_evolution: "Tiến hóa Siêu thể"
 tech_gargantuan_evolution_desc: "Trứng của Ấu trùng Hư không đã tiến hóa ra khả năng hấp thụ năng lượng từ ngôi sao lân cận để có thể chống chọi với môi trường khắc nghiệt ngoài không gian."
 #EVENT CHAINS:
 generation_ship_chain_title: "Tàu Vechtar Zavonia"
 generation_ship_chain_desc: "$GENERATION_SHIP_DESC$"
 planet_found: "Đã xác định vị trí Hành tinh"
 corrupt_data_investigated: "Đã điều tra Ngôi sao Dị thường"
 star_crazy_chain_title: "Bức xạ Năng lượng"
 star_crazy_chain_desc: "Bức xạ Năng lượng"
 #PROJECTS:
 GENERATION_SHIP: "Tàu Thế Hệ"
 GENERATION_SHIP_DESC: "Một con tàu thế hệ khổng lồ của một giống loài ngoài hành tinh đã diệt vong từ lâu, trong thiết bị điều hướng của nó có thể ẩn chứa tọa độ của một hành tinh hoàn mỹ."
 HIDDEN_PLANET: "Được ăn cả Ngã về không"
 HIDDEN_PLANET_DESC: "Chỉ cần phóng một tàu thăm dò, chúng ta cuối cùng sẽ vén bức màn bí mật: liệu hành tinh hoang vu, không có chút dấu hiệu của sự sống ngay trước mắt này có phải chính là chốn thiên đường trong truyền thuyết của Mardak Vol hay không."
 STAR_LIFTING: "Nền tảng Ngoại lai Bỏ hoang"
 STAR_LIFTING_DESC: "Một nền tảng kiến trúc ngoài hành tinh bị bỏ hoang đang lơ lửng trên quỹ đạo của [star_lifting_star.GetName]. Nếu chúng ta có thể tìm cách khôi phục nó, có lẽ chúng ta sẽ cải tiến và tận dụng được nguồn năng lượng do ngôi sao này cung cấp."
 STAR_LIFTING_WEAPONS: "Nền tảng Ngoại lai Bỏ hoang"
 STAR_LIFTING_WEAPONS_DESC: "Một nền tảng kiến trúc ngoài hành tinh bị bỏ hoang đang lơ lửng trên quỹ đạo của [star_lifting_star.GetName]. Nó sở hữu một số công nghệ chùm vi sóng mang tính thử nghiệm rất cao, có tiềm năng để cải tạo thành vũ khí."
 BIG_RIP: "Trạm Quan sát Bỏ hoang"
 BIG_RIP_DESC: "Trạm quan sát bị bỏ hoang nằm trên quỹ đạo của [big_rip_planet.GetName] đã bị xóa sạch toàn bộ thiết bị lưu trữ dữ liệu. Chúng ta phải cử người xuống hành tinh này thì mới có thể tìm hiểu được chuyện gì đã xảy ra với những sinh vật có trí tuệ từng sinh sống ở đây."
 THE_CUBE: "Khối Lập Phương"
 THE_CUBE_DESC: "Chúng ta đã phát hiện một khối lập phương nhỏ bằng kim loại, mỗi mặt mang một màu sắc khác nhau, khiến Sĩ quan Khoa học [cube_science_officer.GetName] cảm thấy vô cùng bối rối và tin rằng chắc chắn bên trong nó phải ẩn chứa một thứ gì đó vô giá."
 STAR_CRAZY: "Ngôi sao Khắc khoải"
 STAR_CRAZY_DESC: "Có một vài ngôi sao trong hệ sao bắt đầu co giật một cách kỳ lạ. Phi hành đoàn lo sợ rằng những chỉ số này là do lỗi thiết bị gây ra, nhưng Sĩ quan Khoa học [Root.GetLeaderName] lại muốn tiến hành điều tra chi tiết về một trong số các ngôi sao đó."
 WEAPONS_TESTING: "Vũ khí Ngoài hành tinh"
 WEAPONS_TESTING_DESC: "Chúng ta đã thu thập được các mảnh vỡ của vũ khí ngoài hành tinh được sử dụng để thử nghiệm trên [From.GetName], nhằm mục đích phân tích."
 SHATTERED_EGG: "Mảnh vỡ của Trứng"
 SHATTERED_EGG_DESC: "Trứng của Ấu trùng Hư không đã tiến hóa ra khả năng hấp thụ năng lượng từ ngôi sao lân cận để có thể chống chọi với môi trường khắc nghiệt ngoài không gian. Có lẽ những mảnh vỡ này có thể hé lộ bí mật của nó."
 MEND_SHIELD: "Khôi phục Lá chắn Hành tinh"
 MEND_SHIELD_DESC: "Lá chắn viễn cổ bảo vệ cho nền văn minh trí tuệ thuộc giống loài có vảy trên [time_loop_world.GetName] đang bị rạn nứt do nhiệt lượng và việc thiếu sự bảo trì. Chúng ta phải sửa chữa nó."
 STOP_TIME_LOOP: "Phá vỡ Vòng lặp Không thời gian"
 STOP_TIME_LOOP_DESC: "Chúng ta đã chuẩn bị sẵn một kế hoạch để phá vỡ vòng lặp không thời gian."
 #AMBIENT OBJECTS:
 broken_star_lifting_platform: "Nền tảng Ngoại lai Bỏ hoang"
 broken_star_lifting_platform_desc: "Một nền tảng kiến trúc ngoài hành tinh vô danh và bị bỏ hoang đang trôi nổi vô định quanh một ngôi sao."
 broken_star_lifting_platform_tooltip: "$broken_star_lifting_platform_desc$"
 star_lifting_platform: "Nền tảng Ngôi sao"
 star_lifting_platform_desc: "Nền tảng ngôi sao này sử dụng vi sóng bắn phá bầu khí quyển của nó để làm tăng lượng gió mặt trời thoát ra từ ngôi sao. Năng lượng từ những cơn gió mặt trời này sau đó có thể được khai thác."
 star_lifting_platform_tooltip: "$star_lifting_platform_desc$"
 abandoned_observation_outpost: "Trạm Quan sát Bỏ hoang"
 abandoned_observation_outpost_desc: "Một trạm quan sát đang trôi dạt một cách vô ích trên quỹ đạo của [big_rip_planet.GetName]."
 abandoned_observation_outpost_tooltip: "$abandoned_observation_outpost_desc$"
 abandoned_observation_outpost_generic: "$abandoned_observation_outpost$"
 abandoned_observation_outpost_generic_desc: "Một trạm quan sát đang trôi dạt một cách vô ích."
 abandoned_observation_outpost_generic_tooltip: "$abandoned_observation_outpost_generic_desc$"
 #DANOMALY CATEGORIES:
 debris_gasgiant_category_temp: "Xác tàu cổ đại"
 debris_gasgiant_category_temp_desc: "Một xác tàu cổ đại khổng lồ đang trôi dạt quanh [From.GetName]."
 star_lifting_category: "Trạm ngoài hành tinh bỏ hoang"
 star_lifting_category_desc: "Một trạm không gian của người ngoài hành tinh bị bỏ hoang đang trôi vô định quanh một ngôi sao. Nghiên cứu kỹ lưỡng có thể hé lộ mục đích của nó."
 abandoned_outpost_category: "Trạm quan sát bỏ hoang"
 abandoned_outpost_category_desc: "Một trạm quan sát cũ nát đang xoay quanh [big_rip_planet.GetName], nhưng không có dấu hiệu của sự sống thông minh trên bề mặt. Điều tra thêm có thể biết được lý do tại sao."
 ast_debris_field_1_cat_2: "$AST_DEBRIS_FIELD_1_CAT$"
 gaia_planet_cat: "Hoạt động của người ngoài hành tinh"
 gaia_planet_cat_desc: "Cảm biến của chúng ta đã phát hiện dấu hiệu năng lượng từ các hoạt động của người ngoài hành tinh trên [Root.GetName]."
 corrupt_data_cat: "Dữ liệu khảo sát bị lỗi"
 corrupt_data_cat_desc: "Thứ gì đó trong hệ sao [From.System.GetName] đang làm hỏng dữ liệu cảm biến của chúng ta. Nguồn gốc của hiện tượng bất thường này dường như đến từ hành tinh [From.GetName]."
 irregular_energy_cat: "Phát xạ năng lượng bất thường"
 irregular_energy_cat_desc: "Cảm biến của chúng ta phát hiện quy luật phát xạ năng lượng trên [From.GetName] có những điểm bất thường."
 peculiar_patterns_cat: "Hoa văn kỳ lạ"
 peculiar_patterns_cat_desc: "Những hoa văn kỳ lạ xuất hiện trên bề mặt [Root.GetName], có thể quan sát rõ ràng ngay từ ngoài không gian."
 tomb_world_cat: "Thế giới chết chóc"
 tomb_world_cat_desc: "Các chỉ số bất thường cho thấy hành tinh hoang tàn này có thể ẩn chứa nhiều điều hơn những gì thể hiện bên ngoài."
 alien_life_cat: "Sự sống ngoài hành tinh"
 alien_life_cat_desc: "Các chỉ số sơ bộ từ [From.GetName] cho thấy nó có thể hỗ trợ sự sống ngoài hành tinh."
 moon_cat: "Vệ tinh kỳ dị"
 moon_cat_desc: "Mặt trăng này có vẻ hơi bất thường."
 time_loop_world: "Hành tinh rào chắn"
 time_loop_world_desc: "Vì lý do chưa rõ, [Root.GetName] bị bao phủ trong một lá chắn không thể xuyên thủng, và lá chắn này đang xuất hiện những vết nứt."
 #FAKE CHARACTERS:
 #fake_character_1_name: "Bloop Bloop"
 #test_fake_char.desc: "Người bạn Blorg mới tuyệt vời mà tôi gặp tên là [root.fake_character_1.GetName]!"
 #ANOMALY EVENTS:
 #The Vechtar Zavonia Chain
 distar.1000.name: "Vechtar Zavonia"
 distar.1000.desc: "Xác tàu trên quỹ đạo [From.GetName] là tàn tích của con tàu Vechtar Zavonia, một tàu thế hệ dưới ánh sáng khổng lồ thuộc về một loài ngoài hành tinh rất sùng đạo tên là Mardak Vol.\n\nMặc dù sự sống trên tàu đã bị quét sạch không thương tiếc, nhưng nhật ký của thuyền trưởng vẫn ghi lại chi tiết hành trình bi thảm của họ. Sau khi bị những thực thể đáng sợ gọi là 'Vỏ rỗng' truy đuổi gắt gao, họ đã rời bỏ quê hương để tìm kiếm hành tinh thiên đường xa xôi — vùng đất hứa Paridayda trong truyền thuyết, nơi chỉ lộ diện trước những người được chọn. Tuy nhiên, nhìn vào tình trạng của con tàu, có vẻ như họ đã bị kẻ thù đuổi kịp.\n\nChúng ta có nên trích xuất thiết bị định vị của tàu và giải mã đích đến của nó không?"
 distar.1000.a: "Ngươi nói về một hành tinh thiên đường..."
 distar.1000.b: "Không."
 distar.1001.name: "Hành tinh ẩn giấu"
 distar.1001.desc: "Việc giải mã thiết bị định vị của tàu Vechtar Zavonia không hề dễ dàng, nhưng nhờ sự tận tâm của Trưởng khoa học gia [vechtar_zavonia_leader_name.GetName], người bị mê hoặc bởi việc tìm kiếm lý tưởng quốc của tộc Mardak Vol, cuối cùng chúng ta đã thành công.\n\nĐiều đáng lo ngại hơn là phát hiện này đã bị rò rỉ ra công chúng bằng cách nào đó, và giờ đây mọi người cũng quyết tâm định cư trên một hành tinh thiên đường giống như [vechtar_zavonia_leader_name.GetName]."
 distar.1001.a: "Không gì có thể ngăn cản chúng ta tiến vào thiên đường."
 distar.1001.b: "Hủy bỏ kế hoạch. Đây là một nỗ lực vô ích."
 distar.1002.name: "Thiên đường đã mất"
 distar.1002.desc: "Sau lần thứ hai, rồi thứ ba xác nhận tọa độ của hệ thống định vị, chúng ta buộc phải thừa nhận rằng hành tinh thiên đường của người Mardak Vol chỉ là một hành tinh hoang mạc cằn cỗi.\n\nMặc dù không loại trừ khả năng quan niệm về thiên đường của họ khác với chúng ta, nhưng những hố va chạm trên bề mặt [utopian_planet.GetName] đã đưa ra một câu trả lời khác. Thuyền trưởng và thủy thủ đoàn của con tàu đó không đơn giản là chấp nhận thất bại."
 distar.1002.a: "Không thể nào! Hãy kiểm tra lại tọa độ một lần nữa!!"
 distar.1002.b: "Hãy nhìn vào thực tế đi..."
 distar.1003.name: "Thế giới hoàn hảo"
 distar.1003.desc: "Cuối cùng chúng ta cũng khám phá ra bí mật của người Mardak Vol!\n\nKhi chúng ta phóng tàu thăm dò xuống bề mặt [utopian_planet.GetName], nó vừa chạm vào bầu khí quyển đã bị bật văng ra, khiến thủy thủ đoàn nghi ngờ có điều gì đó ẩn giấu. Nghiên cứu sâu hơn cho thấy bề mặt hành tinh mà chúng ta nhìn thấy chỉ là một lớp lá chắn năng lượng, phản chiếu hình ảnh giả về một vùng đất hoang tàn, trong khi đằng sau lá chắn đó, một hành tinh Gaia tràn đầy sức sống đang ẩn mình, chứng minh truyền thuyết của người Mardak Vol là có thật.\n\nKhông chỉ vậy, khi thủy thủ đoàn hạ lá chắn xuống, họ còn phát hiện ra một nền văn minh thời đồ đá bao gồm các thực thể cộng sinh giữa động vật có vú và nấm, đang sống yên bình trong các khu định cư đơn sơ, hoàn toàn không biết gì về những chuyện vừa xảy ra hay sự hiện diện của chúng ta. Còn 'Huyết tộc' ác mộng trong truyền thuyết cũng chỉ còn tồn tại trong những câu chuyện kể của họ."
 distar.1003.a: "Tộc Mardak Vol vẫn còn sống!"
 distar.1003.b: "Hành tinh này thực sự rất đẹp..."
 distar.1004.name: "Thiên đường bí mật"
 distar.1004.desc: "[country_that_discovered_mardak_vol.GetName] đã phát hiện ra một nền văn minh [GetPreFTLLower] bí mật trên một hành tinh Gaia nằm trong lãnh thổ của chúng ta. Hành tinh này dường như được bảo vệ bởi một loại lá chắn năng lượng phức tạp, khiến nó trông giống như một hành tinh chết. Chúng ta vẫn chưa xác định được ai và tại sao lại giấu nó đi, vì loài [GetPreFTLLowerPlural] kia rõ ràng không có đủ trình độ công nghệ. Họ dường như là một dạng cộng sinh giữa động vật có vú và nấm, và theo chúng ta thấy, họ hoàn toàn vô hại."
 distar.1004.a: "Đừng bao giờ đánh giá một hành tinh qua vẻ bề ngoài."
 distar.1005.name: "Truyền tin"
 distar.1005.desc_a: "Một loài động vật có vú thông minh chưa từng gặp trước đây đã liên lạc với chúng ta, về việc tộc Mardak Vol cổ đại vẫn đang sinh sống trên [utopian_planet.GetName]. Có vẻ như chuyện rất khẩn cấp."
 distar.1005.desc_b: "Một loài động vật có vú thông minh chưa từng gặp trước đây đã liên lạc với chúng ta, liên quan đến loài [GetPreFTLLowerPlural] cư trú trên [utopian_planet.GetName]. Có vẻ như chuyện rất khẩn cấp."
 distar.1006.desc: "Chào các bạn, [From.GetSpeciesNamePlural]. Chúng tôi là tộc Vol, chúng tôi đến vì hòa bình.\n\nChúng tôi phát hiện một hành tinh của các bạn đã bị nhiễm Mardak. Đó là một sinh vật nấm ký sinh, đã gây hại cho chủng tộc chúng tôi suốt hàng ngàn năm, biến vật chủ thành con rối, và các bạn là mục tiêu tiếp theo của nó!\n\nChúng tôi cứ ngỡ đã tiêu diệt sạch chúng, nhưng đợt quét định kỳ toàn thiên hà đã phát hiện ra vẫn còn nhiều cá thể sống trên [utopian_planet.GetName]. Đừng lo lắng, chúng tôi biết phải làm gì..."
 distar.1006.a: "Dùng lửa để thanh tẩy chúng!?"
 distar.1006.b: "Thật nhảm nhí, họ hoàn toàn vô hại!"
 distar.1006.c: "Tuyệt đối không cho phép các ngươi làm hại họ!"
 distar.1008.desc: "Chú ý: Chúng tôi sẽ bắt đầu đếm ngược quy trình diệt chủng quỹ đạo, 3, 2, 1... Đã giải phóng dung môi nấm X vào không khí để tiêu diệt mầm bệnh. Vật thể thù địch đã bị xóa sổ!\n\nĐừng lo, bất kỳ sự thay đổi môi trường nào mà các bạn nhận thấy đều không phải là tạm thời, và không thể khôi phục...\n\nChúng tôi cảm ơn sự hợp tác của các bạn.\n\nChúng tôi là tộc Vol, chúng tôi đến vì hòa bình.\n\nHòa bình..."
 distar.1008.a: "Kết thúc rồi..."
 distar.1008.b: "Thay đổi môi trường??"
 distar.1009.desc: "Lũ [From.GetSpeciesNamePluralInsult] nguyên thủy! Ngươi sẽ cảm thấy thế nào khi tỉnh dậy và thấy Mardak đã cắm rễ vào [From.GetSpeciesOrganName] của mình? Loài nấm sẽ kiểm soát hệ thần kinh của ngươi trước, sau đó chiếm lấy từng tế bào trên toàn bộ cơ thể! Da thịt ngươi sẽ nứt toác, và tinh thần ngươi sẽ sụp đổ theo!\n\nMay mắn thay, [From.GetSpeciesNamePluralInsult], ngày đó sẽ không bao giờ đến. Chúng tôi sẽ không để nó xảy ra.\n\nChúng tôi là tộc Vol. Chúng tôi sẽ... trở lại trong hòa bình."
 distar.1009.a: "Được rồi..."
 distar.1011.name: "§RCảnh báo xâm phạm biên giới!§!"
 distar.1011.desc: "Chúng ta đã phát hiện một hạm đội thù địch, mang tín hiệu liên lạc của tộc Vol, đang tiến thẳng về phía [utopian_planet.GetName]. Có vẻ như họ đến vì tộc Mardak vẫn còn sống trên hành tinh này...\n\nHọ không phản hồi các nỗ lực liên lạc của chúng ta."
 distar.1011.a: "Không ổn rồi..."
 distar.1013.desc: "Kênh truyền tin chỉ còn những tiếng nhiễu. Chúng ta đã mất liên lạc với tộc Vol."
 distar.1013.a: "Họ đã cắt đứt liên lạc!!"
 distar.1014.name: "Ở giữa thiên đường"
 distar.1014.desc: "Cuối cùng chúng ta đã định cư tại Paridayda, hành tinh thiên đường của tộc Mardak Vol. Người dân đang ăn mừng, vì một ngày nào đó, con cháu của họ [From.Owner.GetSpeciesSpawnNamePlural] cũng có thể vui đùa giữa những cồn cát, khu vườn và dòng suối của [utopian_planet.GetName]!"
 distar.1014.a: "Cuối cùng thì..."
 distar.1014.b: "Cứ chờ xem..."
 #Star Lifting
 distar.1020.name: "Dòng nhiệt động lực học"
 distar.1020.desc: "Sau khi nghiên cứu trạm không gian trên quỹ đạo [From.GetName], chúng ta phát hiện nó có một thiết kế ngoại lai phức tạp và có phần kỳ quái. Các máy móc chống thấm nước và hệ thống kiểm soát khí hậu tiên tiến cho thấy nó được chế tạo bởi một loài tiết ra nhiều chất lỏng, rất có thể là loài thân mềm.\n\nTrước khi hỏng hóc, nó từng dùng chùm vi sóng để nung nóng một phần bầu khí quyển của ngôi sao, gây ra các đợt phun trào quy mô lớn liên tục, có thể gia tăng đáng kể dòng chảy gió mặt trời. Nguồn năng lượng này sau đó được các trạm quỹ đạo thu thập.\n\nTrạm này được thiết kế theo một ý tưởng mang tính thử nghiệm cao."
 distar.1020.a: "Sửa chữa trạm."
 distar.1020.c: "Cải tạo chùm vi sóng thành vũ khí."
 distar.1020.b: "Rời đi."
 distar.1021.name: "Khiêu vũ với lửa"
 distar.1021.desc: "Sau nhiều nỗ lực sửa chữa, trạm đã đi vào hoạt động, và ngôi sao hiện đang phun trào một lượng lớn năng lượng vào không gian. Nhưng quá trình này không hề suôn sẻ.\n\nKhi chùm vi sóng lớn lần đầu được kích hoạt, các kỹ sư suýt chút nữa đã gây ra một phản ứng dây chuyền, hậu quả có thể dẫn đến một vụ bùng nổ sao khổng lồ, phá hủy cả trạm lẫn tất cả hành tinh trong hệ sao. Hóa ra trong bản thiết kế và hướng dẫn sử dụng cổ đại của người ngoài hành tinh chứa đầy các lỗi tính toán, nghiêm trọng đến mức có thể khiến trạm không thể vận hành.\n\nMay mắn là chúng ta đã phát hiện kịp thời và điều chỉnh cường độ chùm vi sóng, giúp dòng chảy gió mặt trời ổn định trở lại."
 distar.1021.a: "Một viên pin mặt trời chỉ thuộc về chúng ta!"
 distar.1021.b: "Chao ôi, lũ thân mềm... thân mềm, mà não cũng mềm..."
 distar.1022.name: "Chùm vi sóng thân mềm"
 distar.1022.desc.a: "Thủy thủ đoàn của tàu [star_lifting_ship.GetName] không mất nhiều thời gian để kết luận rằng: thiết kế của trạm sao này, theo lời của chuyên viên khoa học [star_lifting_leader.GetName], là tác phẩm của một kẻ điên. Chùm vi sóng rất thô sơ, chưa được hiệu chuẩn, và cần phải mài giũa rất nhiều trước khi có thể vận hành bình thường. Tuy nhiên, chúng nhanh chóng chứng minh được giá trị như một loại vũ khí thượng hạng."
 distar.1022.desc.b: "Nỗ lực cải tạo chùm vi sóng thân mềm thành vũ khí của chúng ta đã... thất bại thảm hại. Khi kích hoạt, chúng ta mới nhận ra thiết kế của chùm vi sóng tệ đến mức không thể diễn tả bằng lời, cuối cùng thất bại khoa học này biến thành một đám mây hình nấm khổng lồ, trong khi đội ngũ nghiên cứu của chúng ta đã kịp thoát ra vào phút chót."
 distar.1022.a: "Tuyệt vời."
 distar.1022.b: "Thật thảm hại."
 distar.1022.c: "Lũ thân mềm này lẽ ra không nên động vào khoa học..."
 #The Big RIP
 distar.1030.name: "Trạm quan sát bỏ hoang"
 distar.1030.desc: "Mọi thiết bị lưu trữ dữ liệu trên trạm quan sát đều đã bị xóa sạch, và mọi bằng chứng có thể chỉ ra chủ nhân ban đầu của nó cũng được xóa bỏ cẩn thận. Rõ ràng đã có chuyện gì đó xảy ra trên [big_rip_planet.GetName]. Dấu hiệu duy nhất cho thấy sự sống thông minh từng tồn tại là những phế tích đô thị đang xây dở rải rác trên hành tinh, dường như đã bị bỏ rơi khi đang xây dựng giữa chừng."
 distar.1030.a: "Tiến hành điều tra."
 distar.1030.b: "Rời đi."
 distar.1031.name: "Cơn bão xám"
 distar.1031.desc: "Dù họ đã cố gắng che đậy, những dấu vết can thiệp vụng về của những người quan sát vẫn hiện diện khắp nơi trên [big_rip_planet.GetName]...\n\nBằng chứng cho thấy hành tinh này ban đầu là nơi sinh sống của một tập thể ý thức thực vật kết nối bằng tâm linh đang trong quá trình thức tỉnh tôn giáo. Lúc đó, một chủng tộc ngoài hành tinh bí ẩn được gọi là 'Người gác cổng' đã bất ngờ xuất hiện mà không báo trước. Kể từ đó, loài thực vật này trở nên cuồng tín một cách điên cuồng về một ngày tận thế sắp tới mang tên 'Cơn bão xám'. Những tín điều vốn dĩ hòa bình của họ đã biến tướng thành sự cuồng tín tự sát. Vì nỗi sợ hãi về một ngày tận thế không bao giờ đến, mặc dù đã cố gắng cưỡng ép tưới tiêu nhiều lần, một trong những loài cổ xưa nhất thiên hà này vẫn héo mòn và lụi tàn chỉ trong vòng vài tháng."
 distar.1031.a: "Thật là một đống hỗn độn..."
 distar.1031.b: "Hãy yên nghỉ nhé, những nhành hoa mỏng manh..."
 #Bunker-Bot
 distar.1040.name: "Robot hầm trú ẩn"
 distar.1040.desc: "Chúng ta lần theo nguồn phát xạ điện từ bất thường trên [From.GetName] và phát hiện một hầm trú ẩn dưới lòng đất, bên trong chứa một siêu máy tính lớn bằng cả một thiết giáp hạm.\n\nCác [Owner.GetResearchers] của chúng ta nghi ngờ nó có thể đã ở đó hàng ngàn năm, luôn nỗ lực giải quyết một vấn đề cực kỳ phức tạp mà bản chất của nó vẫn chưa rõ ràng.\n\nKhi cố gắng tương tác với máy tính, họ phát hiện ra cơ sở tưởng chừng như bị bỏ hoang và không được phòng thủ này thực chất lại được kiểm soát bởi một trí tuệ nhân tạo an ninh, mục tiêu cao nhất của nó là thiêu rụi mọi khách khách đến thăm. Sau khi cuối cùng đánh bại được AI, nó đã gửi một tin nhắn đến một người nhận chưa xác định."
 distar.1040.a: "Tháo dỡ siêu máy tính để lấy linh kiện!"
 distar.1040.a.tooltip: "Một chiếc máy tính mất hàng ngàn năm mà không giải nổi một vấn đề thì tốt nhất nên đem đi làm vỏ tàu..."
 distar.1040.b: "Sử dụng nó để tăng cường nghiên cứu của chính chúng ta..."
 distar.1040.b.tooltip: "Điều này yêu cầu tắt AI duy trì cơ sở và sẽ khiến máy tính sụp đổ trong tương lai gần."
 distar.1040.c: "Để nó tiếp tục những phép tính bí ẩn đó..."
 distar.1040.c.tooltip: "Tốt nhất chúng ta không nên làm phiền nó. Dù máy tính đó đang cố giải quyết vấn đề gì, trông nó có vẻ khá quan trọng..."
 #Atomic Clock
 distar.1045.name: "Bốn mươi hai năm và ba ngày"
 distar.1045.desc: "Sau khi quét kỹ lưỡng bãi phế liệu quanh [From.GetName], chúng ta phát hiện một khoang kín khí chứa một chiếc đồng hồ nguyên tử cực kỳ chính xác.\n\nTần số sai số của nó thấp đến mức phải mất 879 triệu năm mới sai lệch một giây, và nó đang đếm ngược đến một ngày sau 42 năm 3 ngày nữa. Trong khoang không có ghi chép ngày đó đại diện cho điều gì, hay chủ nhân của nó là ai. Tuy nhiên, dường như có ai đó đã mất đi khái niệm về thời gian..."
 distar.1045.a: "Theo dõi nó."
 distar.1045.b: "Đây là một quả bom!! Tiêu diệt nó!!"
 distar.1045.a.tooltip: "Tích tắc, tích tắc..."
 distar.1045.b.tooltip: "Khoang này chứa đầy những đường dây trông có vẻ vô hại, nhưng bất kỳ sợi nào cũng có thể kích hoạt vũ khí hủy diệt hàng loạt, phá hủy cả hệ sao! Thủy thủ đoàn sẽ cắt đứt tất cả chúng!"
 #Eat or be Eaten
 distar.1050.name: "Ăn hoặc bị ăn"
 distar.1050.desc: "Ở rìa bãi rác quanh [From.GetName], một con tàu nghiên cứu cũ nát không rõ nguồn gốc đang trôi dạt. Những vết cắn và dịch tiêu hóa trên vỏ tàu cho thấy nó từng bị một loài thú ăn thịt lớn nào đó nhai ngấu nghiến rồi nôn ra.\n\nMỉa mai thay, thủy thủ đoàn của con tàu cũng đang thực hiện chuyến hành trình ẩm thực của riêng họ để tìm kiếm những hương vị ngoại lai mới, kết quả là chính họ lại trở thành món ăn.\n\nHọ đã đánh giá rất nhiều loài, từ thành phần dinh dưỡng đến cảm giác khi nhai. Một trong những loài được họ đánh giá cao nhất là tộc [delicious_aliens.GetSpeciesNamePlural], vì [delicious_aliens.GetSpeciesOrganName] của chúng mọng nước và tính tình hung dữ. Còn chúng ta thì nhận được đánh giá trung bình ở cuối bảng xếp hạng, vì thịt của chúng ta nhai rất dai và sức kháng cự yếu ớt. Một số kẻ thực sự thích đùa giỡn với thức ăn..."
 distar.1050.desc_lithoid: "Ở rìa bãi rác quanh [From.GetName], một con tàu nghiên cứu cũ nát không rõ nguồn gốc đang trôi dạt. Những vết cắn và dịch tiêu hóa trên vỏ tàu cho thấy nó từng bị một loài thú ăn thịt lớn nào đó nhai rồi nhổ ra.\n\nMỉa mai thay, thủy thủ đoàn trên tàu cũng đang thực hiện chuyến hành trình ẩm thực của riêng họ để tìm kiếm những hương vị ngoại lai mới, kết quả là chính họ lại trở thành món ăn.\n\nHọ đã đánh giá vô số loài từ thành phần dinh dưỡng đến cảm giác khi nhai. Lựa chọn hàng đầu của họ là tộc [delicious_aliens.GetSpeciesNamePlural], vì [delicious_aliens.GetSpeciesOrganName] tươi ngon mọng nước và tính tình hung dữ. Chúng ta xếp hạng rất thấp trong danh sách này, bị xếp vào một hạng mục đặc biệt có đánh dấu sao, vì chúng ta hoàn toàn không thể ăn được và không mang lại niềm vui khi săn đuổi. Một số kẻ thực sự thích đùa giỡn với nguyên liệu..."
 distar.1050.a: "Có vẻ như cuối cùng họ đã gặp phải đối thủ..."
 distar.1050.b.evopred: "Không xếp theo độ phức tạp mà lại xếp theo khẩu vị? Thật kỳ lạ."
 #The Cube
 distar.1055.name: "Khối lập phương"
 distar.1055.desc: "Trong số vô vàn con tàu bỏ hoang quanh [From.GetName], chúng ta đã tìm thấy một tàu nghiên cứu ngoài hành tinh gần như còn nguyên vẹn. Hồ sơ trên tàu tiết lộ rằng nó đã gặp sự cố thiết bị nghiêm trọng, sau khi trôi dạt trong hư không 142 ngày, thủy thủ đoàn đã qua đời vì thiếu dinh dưỡng.\n\nChúng ta tìm thấy di hài của thuyền trưởng trên một chiếc giường nhỏ, trong tay ông ta nắm một khối lập phương bằng kim loại nhỏ, mỗi mặt có một màu sắc khác nhau và được chia thành chín khối nhỏ có thể xoay được. Chuyên viên khoa học [Root.Owner.GetScientist][cube_science_officer.GetName] tin rằng khi xoay đến đúng hoa văn, khối lập phương sẽ mở ra và hé lộ kho báu ẩn giấu."
 distar.1055.a: "Hãy xoay khối lập phương đó đi, [Root.Owner.GetScientist]!"
 distar.1055.b: "Đừng bận tâm đến nó."
 distar.1056.name: "Vết cắt"
 distar.1056.desc: "Thủy thủ đoàn của [From.GetName] đã thử mọi loại thuật toán giải mã với khối lập phương kim loại đó, nhưng không có bất kỳ phản ứng nào.\n\n'Nó có phải là một mật mã không? Một vật chứa những món đồ quý giá?' 'Nếu khối lập phương này không có ý nghĩa gì, vậy cái gì mới có ý nghĩa?' Những ý nghĩ này lóe lên trong đầu óc mệt mỏi của chuyên viên khoa học [cube_science_officer.GetName], cuối cùng [cube_science_officer.GetSheHe] đã dùng đến chiêu cắt laser, đồng thời cũng vô tình cắt đôi [cube_science_officer.GetHerHis] [From.Owner.GetSpeciesHandName] bên phải. Khối lập phương trống rỗng."
 distar.1056.a: "Trời ơi..."
 distar.1056.a.tooltip: "[cube_science_officer.FromGetName] sẽ không bao giờ còn như trước nữa."
 #Honeymooners
 distar.1060.name: "Cặp đôi mới cưới"
 distar.1060.desc: "Chúng ta dường như đã bắt gặp một bãi sinh sản của một loài động vật có vú không lông không phải bản địa. Chúng ta quan sát thấy chúng thực hiện các hành vi tán tỉnh cấp cao vào buổi tối, sau đó dưới tác động của các loại hóa chất cồn, chúng thực hiện việc kết đôi thân mật trên bãi biển đêm.\n\nĐáng tiếc là chúng vô tình phát hiện ra tàu của chúng ta và hoảng loạn bỏ chạy khỏi hành tinh trên một tàu thương mại, để lại một đống rác. Trong đó, chúng ta tìm thấy một cuốn sách hướng dẫn du lịch ngoài hành tinh — 'Hướng dẫn du hành thiên hà', mô tả nhiều cảnh quan và hiện tượng mà chúng ta chưa từng biết đến."
 distar.1060.a: "Cuốn sách hướng dẫn này sẽ truyền cảm hứng cho chúng ta!"
 distar.1060.b: "Lũ người ngoài hành tinh bẩn thỉu! Mọi người phải biết rằng chúng là những kẻ lười biếng và xả rác bừa bãi."
 distar.1060.c: "Tốt nhất chúng ta nên giữ bí mật về chuyện này..."
 distar.1060.d: "Kinh tởm!"
 #Hologram
 distar.1065.name: "Hành tinh không tồn tại"
 distar.1065.desc: "[From.GetName] hoàn toàn không phải là một hành tinh, mà là một ảnh chiếu ba chiều phức tạp. Trung tâm của nó là một máy chiếu, tạo ra một trường năng lượng để mô phỏng chân thực thực thể và giếng trọng lực của hành tinh, ngay cả các cảm biến của chúng ta cũng bị lừa rằng nó thực sự là một hành tinh, dẫn đến các dữ liệu bất thường. Chúng ta chỉ có thể suy đoán tại sao ai đó lại cất công mô phỏng sự tồn tại của một hành tinh tại vị trí này. Đáng tiếc là máy chiếu đó đã bị phá hủy khi chúng ta tiến hành thử nghiệm trên nó."
 distar.1065.a: "Chuyện lạ..."
 #Star Crazy
 distar.1070.name: "Quy luật của sao"
 distar.1070.desc: "Các chỉ số cảm biến mới nhất từ [From.GetName] cho thấy ngôi sao đang đập theo nhịp điệu đều đặn, nhưng khi thủy thủ đoàn [Root.GetName] đến nơi, họ không tìm thấy bằng chứng nào hỗ trợ cho dữ liệu này. Mặc dù hầu hết thủy thủ đoàn đều đồng ý rằng đây là do cảm biến bị lỗi, nhưng [Root.GetLeaderName] lại phủ nhận giả thuyết đó. [Root.GetLeaderName] tuyên bố đã phát hiện quy luật phát xạ năng lượng xung nhịp tương tự ở nơi khác, và lo lắng rằng các ngôi sao trong thiên hà đang gặp chuyện kỳ lạ. [crazy_science_officer.GetSheHeCap] đã sắp xếp lộ trình đến ngôi sao bị ảnh hưởng gần nhất."
 distar.1070.a: "Chúng ta phải tìm ra ngọn nguồn..."
 distar.1070.b: "Chỉ là một lỗi kỹ thuật thôi."
 distar.1071.name: "Một lát là xong ngay..."
 distar.1071.desc: "Sau nhiều ngày suy ngẫm, nhà khoa học [Root.GetLeaderName] đã ra mặt thừa nhận sai lầm của mình — các xung sao xa xôi không hề ẩn chứa quy luật nào, cũng không có ý đồ siêu hình hay điềm báo gở nào. Như [Root.GetLeaderName] đã nói:\n\n§Y“Chỉ là sự hoang tưởng, không hơn không kém. Với tư cách là một nhà khoa học, điều này thật phi lý, thiếu kế hoạch và thực sự không đáng có.”§!\n\nMặc dù trông có vẻ ngượng ngùng, nhưng rắc rối này không phải là không có ích; sau tất cả, cuộc đấu tranh nội tâm đã giúp [Root.GetLeaderName] nhìn lại bản thân một cách nghiêm túc."
 distar.1071.a: "Tốt. Vậy là đã giải quyết xong."
 distar.1072.name: "Cảm biến bị lỗi"
 distar.1072.desc: "Khi thủy thủ đoàn đến [anomalous_star.GetName], họ xác nhận rằng cảm biến thực sự đã bị lỗi. Tin tốt là họ không chỉ đánh giá thấp đáng kể ước tính ban đầu về sản lượng năng lượng của hành tinh, mà [From.GetLeaderName] dường như cũng đã rút ra được bài học từ những sai lầm trong quá khứ."
 distar.1072.a: "Thất bại là mẹ thành công."
 distar.1072.b: "Thật là lãng phí thời gian..."
 distar.1073.name: "Ngôi sao điên loạn"
 distar.1073.desc: "Thủy thủ đoàn của [From.GetName] không may phát hiện ra rằng, đúng như họ dự đoán, quy luật nhịp điệu mà chúng ta quan sát được từ [anomalous_star.GetName] thực chất là do cảm biến bị lỗi... đúng vậy, chính là 'cảm biến' trong đầu chuyên viên khoa học [crazy_science_officer.GetName] đã hỏng.\n\nHành vi của chuyên viên khoa học này đã trở nên rất bất thường. [crazy_science_officer.GetSheHe] mắc chứng hoang tưởng, tự coi mình là người bảo vệ thế giới, và sự đập nhịp của ngôi sao báo hiệu ngày tận thế đang đến gần. Thủy thủ đoàn tin rằng [crazy_science_officer.GetHerselfHimself] đã giả mạo dữ liệu cảm biến của tàu trong lúc phát bệnh tâm thần.\n\nChuyên viên khoa học này hiện đang ở trong một khoang y tế trên đường đến [Root.Capital.GetName] để được điều trị."
 distar.1073.a: "Cảm ơn sự cống hiến của ngươi, người bảo vệ thế giới [crazy_science_officer.GetName]!"
 distar.1073.b: "Chúc may mắn, [crazy_science_officer.GetName]."
 distar.1070.a.tooltip: "§LKìa ngôi sao lấp lánh...§!"
 test_event_targets.desc: "[country_event_target.GetName] [ship_event_target.GetName] [leader_event_target.GetName] [planet_event_target.GetName]"
 #Azizians
 distar.1080.name: "Tiếng thét câm lặng"
 distar.1080.desc.a: "Chúng ta đã phát hiện hóa thạch của một loài động vật chân bụng khổng lồ, nó không giống với bất kỳ loài nào từng gặp trước đây, và bị kẹt trong một khối băng lớn xoay quanh [From.GetName]. Mắt nó trừng trừng nhìn về phía trước, xúc tu giơ lên, miệng méo xệch thành hình dạng kinh khủng, như thể bị đóng băng trong một tiếng thét câm lặng đầy phẫn nộ. Sinh vật này dường như không có đặc điểm thông minh rõ rệt."
 distar.1080.desc.b: "$distar.1080.desc.a$\n\nMặc dù vẻ ngoài của nó rất hung tợn, các nhà khoa học của chúng ta tin rằng nếu có thể thuần hóa, sinh vật này có thể phục vụ cho chúng ta. Họ đề xuất chiết xuất một ít DNA để phục vụ việc nhân bản."
 distar.1080.desc.c: "$distar.1080.desc.a$\n\nĐáng tiếc là với trình độ công nghệ hiện tại, chúng ta không thể làm nó sống lại."
 distar.1080.a: "Nhân bản nó."
 distar.1080.b: "Vứt nó đi!"
 distar.1080.c: "Nó thuộc về bảo tàng."
 distar.1080.d.evopred: "Miếng thịt đông lạnh này trông có vẻ tươi đấy!"
 distar.1081.name: "Sâu Azizian"
 distar.1081.desc: "Chúng ta đã sử dụng DNA từ hóa thạch để nhân bản thành công một bầy sên khổng lồ. Chúng trưởng thành sau vài tuần, nặng tới 20 tấn và phát triển trí thông minh sơ khai, có thể phản ứng với các mệnh lệnh đơn giản. Mặc dù chưa bộc lộ bản tính hung dữ nào, nhưng khi bị kích động, chúng sẽ tiết ra một loại chất độc dẻo quánh, và màu sắc của chúng cũng thay đổi theo cảm xúc. Vì chúng phát ra tiếng 'zi zi' khi giao tiếp với nhau, đội nghiên cứu đã đặt tên cho chúng là 'Sâu Azizian'."
 distar.1081.a: "Chúng sẽ trở thành những nô lệ tuyệt vời."
 distar.1081.a.tooltip: "§Y400§!£pop£§H Dân số Sâu Azizian§! được thêm vào [This.GetName]"
 distar.1081.b: "Chúng nên được nuôi trong vườn thú."
 distar.1081.c: "Chúng ta có thể biên chế chúng vào quân đội."
 distar.1080.c.tooltip: "Ai mà chẳng muốn có một bầy sên hung dữ để nghiền nát kẻ thù của mình chứ?"
 distar.1081.d: "Thật là sởn gai ốc. Hãy xử lý chúng ngay lập tức!"
 distar.1081.d.evopred: "Xem đủ rồi, có thể đem đi thịt được rồi."
 distar.1083.name: "Sâu Azizian đã trốn thoát!"
 distar.1083.desc: "Đám sâu Azizian nuôi trong vườn thú trên [Root.GetName] đã trốn thoát và bắt đầu phá hoại khắp nơi! Chúng ta cứ ngỡ chúng đã trưởng thành hoàn toàn, nhưng hóa ra chúng vẫn tiếp tục lớn thêm trong lồng, kích thước giờ đây to lớn như những quái vật. Chúng băng qua các thành phố, xô đổ các tòa nhà như những khối đồ chơi, để lại một vệt chất độc màu vàng tươi trên đường đi. Hành tinh này sẽ không bao giờ còn như trước nữa."
 distar.1083.a: "Chúng to gan thật đấy!?"
 distar.1083.b: "Chúng ta đã quá xem thường chúng..."
 distar.1084.name: "Trí tuệ của Sâu Azizian"
 distar.1084.desc: "Lao động Sâu Azizian trên [Root.GetName] đã phát triển trí thông minh hoàn chỉnh. Khi chúng ta nghĩ rằng chúng đã trưởng thành, thực ra chúng vẫn còn ở giai đoạn niên thiếu, và giờ đây khi bước vào giai đoạn trưởng thành, tiềm năng của chúng mới bộc lộ hoàn toàn. Chúng đã học được ngôn ngữ của chúng ta và mong muốn được ở lại trong nền văn minh của chúng ta."
 #Harvesters
 distar.1090.name: "Máy gặt bỏ hoang"
 distar.1090.desc: "Những hoa văn bí ẩn quan sát được trên bề mặt [From.GetName] hóa ra là dấu vết để lại của những chiếc máy gặt tự động khổng lồ khi đang thu hoạch mùa màng. Các nhà khoa học của chúng ta dự đoán rằng toàn bộ hành tinh này từng là vựa lúa của một đế chế liên sao hùng mạnh nào đó.\n\nĐất đai màu mỡ và khí hậu ôn hòa khiến [From.GetName] trở nên hoàn hảo cho việc canh tác, và kết quả quét thảm thực vật trên hành tinh cho thấy mọi loại cây trên đó đều có thể ăn được. Những chiếc máy gặt bị mòn và những đống rau củ thối rữa cho thấy đã nhiều năm rồi không có ai đến thu hoạch."
 distar.1090.a: "Chúng ta không thể để đống thức ăn này bị lãng phí!"
 distar.1090.b: "Chúng ta không cần loại hành tinh này."
 #Locusts
 distar.1095.name: "Hủy diệt"
 distar.1095.desc: "Những hoa văn uốn lượn trên bề mặt [From.GetName] đã biến mất, và thảm thực vật xanh tươi từng bao phủ bề mặt cũng biến mất như có phép màu. Ngay cả một nhành cây ngọn cỏ cũng không còn sót lại. Nhưng các nhà khoa học của chúng ta tin rằng họ đã tìm ra lời giải.\n\nDựa vào lượng lớn chất thải và di hài của động vật chân khớp, các nhà khoa học tin rằng hành tinh này từng là điểm dừng chân ngắn ngủi của một bầy côn trùng liên sao tham lam, chúng bay từ hành tinh này sang hành tinh khác và quét sạch mọi nguồn thức ăn trên mỗi hành tinh."
 distar.1095.a: "Mong rằng bầy trùng này sẽ không bao giờ tìm thấy hành tinh của chúng ta."
 distar.1095.b.evopred: "Thu thập những xác chết đó."
 #Shattered World
 distar.2000.name: "Hành tinh vỡ vụn"
 distar.2000.desc: "Chúng ta đã tìm thấy những mảnh vỡ của một hành tinh vốn dĩ có thể cư trú được giữa đám rác thải. Cách thức nó vỡ ra và những vết cháy sém trên các mảnh vỡ cho thấy nó đã bị tấn công bởi nhiệt năng tập trung cho đến khi nứt toác dưới áp lực. Điều này khiến phần lõi giàu khoáng sản của nó bị lộ ra ngoài và đông đặc thành các khối khoáng sản chất lượng cao."
 #Weapon Testing
 distar.2005.name: "Thử nghiệm vũ khí"
 distar.2005.desc: "Có vẻ như [From.GetName] đã trải qua nhiều lần tận thế. Quét bề mặt cho thấy hành tinh này từng bị bắn phá bởi hàng loạt cuộc thử nghiệm vũ khí quy mô lớn mà chúng ta chưa từng gặp.\n\nMặc dù người ngoài hành tinh đã nhiều lần cố gắng phá hủy hoàn toàn hành tinh này, nhưng dường như họ vẫn chưa nắm vững được công nghệ đó. Chuyên viên khoa học [Root.GetLeaderName] đã thu thập một loạt các mảnh vỡ vũ khí bị hỏng, hy vọng có thể phục hồi chúng."
 distar.2005.a: "Phân tích những mẫu đó."
 distar.2005.b: "Rời đi."
 distar.2006.name: "Laser ngoài hành tinh"
 distar.2006.desc.a: "Thông qua việc nghiên cứu các vũ khí tìm thấy trên [From.From.GetName], chúng ta đã học được rất nhiều điều. Các mảnh vỡ thu hồi được đến từ một hệ thống vũ khí năng lượng định hướng, phát ra chùm năng lượng tập trung cao, có thể mang lại hiệu quả tốt trong các cuộc chiến không gian. Chuyên viên khoa học [science_leader.GetName] đề xuất chúng ta nên phát triển giáp có thể chống lại laser, hoặc sao chép vũ khí laser để trang bị cho chính mình."
 distar.2006.desc.b: "Thông qua việc nghiên cứu các vũ khí tìm thấy trên [From.From.From.GetName], chúng ta đã học được rất nhiều điều. Các mảnh vỡ thu hồi được đến từ một hệ thống vũ khí năng lượng định hướng, phát ra chùm năng lượng tập trung cao, tương tự như laser của chúng ta nhưng kém cỏi hơn."
 distar.2006.a: "Chúng ta sẽ dùng vũ khí của người ngoài hành tinh để đối phó với chính họ!"
 distar.2006.b: "Chúng ta cần trang bị thêm giáp cho tàu."
 distar.2006.c: "Chúng ta một lần nữa khẳng định được sự ưu việt của mình."
 #Wetware Computer
 distar.2010.name: "Máy tính sinh học"
 distar.2010.desc: "Đại dương của [From.GetName] gần như bị bao phủ hoàn toàn bởi một mạng lưới tảo biển tinh vi, chúng đung đưa theo cách đối xứng mà không màng đến hướng chảy của nước. Sự phức tạp và quy luật trong chuyển động của chúng cho thấy vai trò của đám tảo này có lẽ không chỉ đơn thuần là để sinh tồn.\n\nChuyên viên khoa học [Root.GetLeaderName] dự đoán rằng mạng lưới này thực chất có thể là một loại máy tính sinh học nguyên thủy, và quy luật đung đưa của nó chính là giao diện. Đáng tiếc là hiện tại chúng ta chưa thể giải mã được quy luật đó."
 #Primordial Soup
 distar.2015.name: "Súp nguyên thủy"
 distar.2015.desc: "Trên bề mặt của [From.GetName] tồn tại nhiều khối vật chất hữu cơ đơn thuần, các nhà khoa học của chúng ta tin rằng đây có thể là cái nôi tự phát sinh sinh học — quá trình vật chất vô cơ tự nhiên hình thành nên chất hữu cơ, nhờ vào bầu khí quyển cực kỳ đậm đặc của [From.GetName] mà trở nên khả thi.\n\nMặc dù hành tinh này mang lại một cơ hội duy nhất để nghiên cứu nguồn gốc sớm nhất có thể của sự sống, nhưng tốt nhất chúng ta không nên quá mong đợi, vì nếu sự sống thực sự tự nhiên xuất hiện trên [From.GetName], thì ít nhất cũng cần thêm vài triệu năm nữa."
 distar.2015.desc.terminator: "Trong các khu vực ẩn khuất trên bề mặt [From.GetName], chúng tôi đã phát hiện lớp bùn giàu các hợp chất hữu cơ phân tử nhỏ, các nhà nghiên cứu của chúng tôi tin rằng lớp bùn này có thể là cái nôi của sự sống, khiến các vật chất không có sự sống tự phát hình thành sự sống hữu cơ. Suy cho cùng, bầu khí quyển của [From.GetName] có vẻ quá dày đối với một hành tinh hoang tàn, điều này có thể khiến nó trở thành thiên đường cho các dạng sống đơn giản.\n\nTất nhiên, đây là điều chúng tôi không thể dung thứ. Trước khi sự sống tự phát sinh, chúng ta phải phá hủy món súp phân giàu chất hữu cơ này — ngay cả khi sự sống có thể còn mất hàng triệu năm mới ra đời!"
 distar.2015.A.machine: "Thiêu rụi nó!"
 distar.2015.b.evopred: "[owner.GetHomeWorldName] cũng được hình thành như vậy sao?"
 #Single-Minded
 distar.2020.name: "Đồng tâm hiệp lực"
 distar.2020.desc: "Mới nhìn qua, [Root.From.GetName] dường như tồn tại nhiều dạng sống đa dạng, cùng chung sống trong một hệ sinh thái tương tự như của chúng ta, nơi chất dinh dưỡng được tuần hoàn trong chuỗi thức ăn thông qua quang hợp, phân hủy và săn mồi.\n\nNhưng sau khi quan sát kỹ, thủy thủ đoàn lại phát hiện ra rằng, mặc dù các sinh vật trên [Root.From.GetName] ban đầu phát triển độc lập, nhưng giờ đây chúng lại hành động một cách bí ẩn như một cơ thể thống nhất. Một cơ thể phản ứng một cách hung hãn trước mọi sự can thiệp từ bên ngoài."
 distar.2020.desc.hive: "Mới nhìn qua, [Root.From.GetName] dường như tồn tại nhiều dạng sống đa dạng, cùng chung sống trong một hệ sinh thái tương tự như quê hương [Root.Owner.GetHomeWorldName] của chúng ta trước khi hình thành tư duy bầy đàn.\n\nNhưng sau khi quan sát kỹ, thủy thủ đoàn lại phát hiện ra rằng, mặc dù các sinh vật trên hành tinh này ban đầu phát triển độc lập, nhưng giờ đây qua quá trình tiến hóa tự nhiên, chúng đã hành động như một cơ thể thống nhất. Một cơ thể nguyên thủy phản ứng một cách hung hãn trước mọi sự can thiệp từ bên ngoài."
 #Artificial Moon
 distar.2025.name: "Vệ tinh nhân tạo"
 distar.2025.desc: "Quét sâu vào lớp vỏ của [From.GetName] đã xác nhận dự đoán của chúng ta, [From.GetName] không phải là một mặt trăng bình thường, toàn bộ thiên thể này là một cấu trúc nhân tạo, được xây dựng từ nguyên liệu thô là các tảng đá giàu khoáng sản, bao bọc bởi một khung thép khổng lồ.\n\nCó vẻ như nó được tạo ra để làm chậm tốc độ tự quay của [artificial_moon_planet.GetName], giúp ban ngày dài hơn, thủy triều cao hơn, làm cho nó trở nên dễ sống hơn. Nhưng hiện tại chúng ta có thể xác nhận không có bất kỳ sinh vật nào từng định cư trên đó."
 #Shielded world in a time loop
 distar.2030.name: "Vòng lặp thời gian"
 distar.2030.desc: "[time_loop_world.GetName] đang bị thiêu rụi. Hành tinh bị bao phủ bởi một lá chắn, nó thu nhận bức xạ từ [time_loop_world.GetStarName] và làm hành tinh nóng lên đến mức sớm không thể sống nổi.\n\nTrong cái nóng rực này, một nền văn minh bò sát có vảy nhỏ tiên tiến đang bận rộn một cách điên cuồng. Một sự kiện cực kỳ quan trọng nào đó dường như đang diễn ra. Tuy nhiên, khi trạng thái căng thẳng đạt đến đỉnh điểm, thời gian đột ngột dừng lại, sau đó giãn ra và vặn xoắn, cho đến khi nền văn minh bò sát quay trở lại điểm bắt đầu một cách khó tin.\n\nHọ dường như bị mắc kẹt trong một vòng lặp thời gian, một vòng lặp tua nhanh tuyệt vọng, kể từ khi nền văn minh của họ bắt đầu. Chỉ trong vòng vài giờ, vô số thế hệ đã thay đổi và tiếp nối nhau, hoàn toàn không hay biết rằng họ định mệnh sẽ phải chết trong biển lửa.\n\nNhưng chúng ta đã phát hiện ra một vết nứt trên lá chắn, có thể cho phép chúng ta thay đổi số phận của họ."
 distar.2030.a: "Sửa chữa lá chắn."
 distar.2030.a.tooltip: "Hẳn phải có một lý do hợp lý để giam cầm những sinh vật có vảy đáng thương này ở đây."
 #distar.2030.a.tooltip.mat: "Chúng ta không thể bỏ lỡ cơ hội nghiên cứu một xã hội bị khóa trong vòng lặp thời gian, dù chỉ là trong chốc lát. Lũ thằn lằn sẽ sống và chết vì khoa học..."
 distar.2030.b: "Phá vỡ vòng lặp thời gian."
 distar.2030.c: "Số phận của họ do chính họ quyết định."
 distar.2031.name: "Lá chắn đã được sửa chữa"
 distar.2031.desc: "Chúng ta đã cố gắng gia cố lá chắn bao quanh [time_loop_world.GetName] mà không làm phiền những cư dân bên trong. Kết quả điều tra chi tiết bầu khí quyển của nó cho thấy, những con thằn lằn nhỏ này rất có thể sẽ bị nung chín trong vòng một thế kỷ nữa.\n\nHành tinh này mang lại một cơ hội nghiên cứu độc nhất vô nhị, nhưng nếu chúng ta muốn nghiên cứu lũ thằn lằn này cũng như vòng lặp thời gian đang giam cầm chúng, thì tốt nhất chúng ta nên bắt đầu ngay."
 distar.2031.a: "Lũ thằn lằn này sẽ hiến thân cho khoa học..."
 distar.2032.name: "Vụ nổ lớn"
 distar.2032.desc: "Tin tốt là chúng ta đã phá vỡ được vòng lặp thời gian của [time_loop_world.GetName]. Tin xấu là cư dân trên hành tinh không ai sống sót.\n\nHóa ra vòng lặp thời gian đó được tạo ra bởi một trường kỳ dị nhân tạo làm vặn xoắn không-thời gian bên trong lá chắn, và khi hành vi của lũ thằn lằn có một sự thay đổi không xác định nhưng rất cụ thể, lá chắn sẽ đóng lại. Các nhà khoa học của chúng ta tin rằng điều này có thể liên quan đến xu hướng hung hăng của lũ thằn lằn.\n\nThật trùng hợp, chúng ta đã phá vỡ vòng lặp vào giây phút cuối cùng, lúc đó lũ thằn lằn đang tiến hành một cuộc Chiến tranh Lạnh, những móng vuốt nhỏ của chúng đang đặt trên nút bấm kích hoạt vũ khí hạt nhân. Chỉ vài giây sau khi được giải phóng, lũ thằn lằn đã biến mất trong những vụ nổ hạt nhân rực lửa."
 distar.2032.a: "Thật đáng tiếc..."
 distar.2033.name: "[time_loop_country.GetName]"
 distar.2033.desc: "Tin tốt là chúng ta đã phá vỡ được vòng lặp thời gian của [time_loop_world.GetName]. Tin xấu là cư dân trên hành tinh không hề chào đón chúng ta.\n\nHóa ra vòng lặp thời gian đó được tạo ra bởi một trường kỳ dị nhân tạo làm vặn xoắn không-thời gian bên trong lá chắn, và khi hành vi của lũ thằn lằn có một sự thay đổi không xác định nhưng rất cụ thể, lá chắn sẽ đóng lại. Các nhà khoa học của chúng ta tin rằng điều này có thể liên quan đến xu hướng hung hăng của lũ thằn lằn.\n\nNgay sau khi tắt trường lực, lũ thằn lằn đã lập tức có phản ứng hung hãn với chúng ta. Sau đó chúng bắt tay vào xử lý lá chắn đó, bắn nó vỡ tan tành chỉ trong vài giờ."
 distar.2033.a: "Hóa ra đó là một sai lầm..."
 distar.2033.b: "Chúng ta phải tiếp tục giữ tư duy cởi mở..."
 distar.2035.name: "[time_loop_world.GetName]"
 distar.2035.desc: "Những người ngoài hành tinh dạng thằn lằn bị kẹt sau lá chắn của [time_loop_world.GetName] đã chết vì nhiệt độ hành tinh tăng nhanh. Có vẻ như sự thay đổi cực đoan của môi trường không thể phá vỡ vòng lặp thời gian đang giam cầm chúng.\n\nHành tinh vốn dĩ rất bận rộn này giờ đây không còn gì để nghiên cứu nữa."
 distar.2035.a: "Vũ trụ là vậy đó."
 distar.2036.name: "[time_loop_world.GetName]"
 distar.2036.desc: "[time_loop_world.GetName] đang bị thiêu rụi. Hành tinh bị bao phủ bởi một lá chắn, nó thu nhận bức xạ từ [time_loop_world.GetStarName] và làm hành tinh nóng lên đến mức sớm không thể sống nổi.\n\nTrong cái nóng rực này, một nền văn minh bò sát có vảy nhỏ tiên tiến đang bận rộn một cách điên cuồng. Một sự kiện cực kỳ quan trọng nào đó dường như đang diễn ra. Tuy nhiên, khi trạng thái căng thẳng đạt đến đỉnh điểm, thời gian đột ngột dừng lại, sau đó giãn ra và vặn xoắn, cho đến khi nền văn minh bò sát quay trở lại điểm bắt đầu một cách khó tin.\n\nHọ dường như bị mắc kẹt trong một vòng lặp thời gian, một vòng lặp tua nhanh tuyệt vọng, kể từ khi nền văn minh của họ bắt đầu. Chỉ trong vòng vài giờ, vô số thế hệ đã thay đổi và tiếp nối nhau, hoàn toàn không hay biết rằng họ định mệnh sẽ phải chết trong biển lửa. Chúng ta không thể cứu họ. Lá chắn đó là bất khả xâm phạm."
 distar.2036.a: "Chúng ta phải nghiên cứu hiện tượng này!"
 distar.2036.b: "Thật là một số phận bi thảm..."
 distar.2038.name: "[time_loop_country.GetName]"
 distar.2038.desc: "Lũ thằn lằn giờ đã tự do. Có thể họ đã tự mình giải quyết được bài toán vòng lặp thời gian, và tìm cách phá vỡ được lá chắn vốn đã bắt đầu rạn nứt."
 distar.2038.a: "Làm tốt lắm."
 #### GUARDIAN EVENTS ####
 #Curators
 leviathans.500.g: "Chúng ta đã khám phá ra bí mật của Cỗ máy Vô tận."
 leviathans.4000.desc: "Các ngươi!? Khám phá ra bí mật của Cỗ máy Vô tận!? Khả năng đó cũng giống như khả năng loài [From.GetSpeciesNamePlural] các ngươi có thể sống tới thế kỷ sau vậy. Nếu ngươi chưa biết thì khả năng đó không cao lắm đâu.\n\nKhoan đã — đừng nói với ta ngươi chính là [From.GetSpeciesNamePlural] nhé? Thật vô cùng xin lỗi... chắc ta đã nhầm ngươi với... [unfriends.GetName] rồi?\n\nNói nghe này, chỉ cần ngươi cho chúng ta biết một điều mà chúng ta chưa biết về Quả cầu Vô tận, chúng ta sẽ trọng thưởng cho ngươi."
 leviathans.4000.a: "Hãy chuẩn bị để mở mang tầm mắt đi."
 leviathans.4000.a.reply: "Ngươi không định nói là... nhưng nếu AI đó tiến vào lỗ đen Gargantua, điều đó có nghĩa là... nhưng không thể nào... vì nếu như thế... vượt xa tầm hiểu biết của chúng ta...\n\nMặc dù ngươi rõ ràng không biết phát hiện của mình quan trọng đến mức nào, tộc [Root.GetSpeciesNamePlural], nhưng ngươi đến tìm chúng ta là đúng đắn, chúng ta xin cảm ơn vì điều đó."
 leviathans.4000.b: "Thôi bỏ đi."
 leviathans.4000.b.reply: "Biết ngay mà."
 #Hatchling Leviathan
 distar.5010.name: "Hành tinh có nhịp đập"
 distar.5010.desc: "Thứ gì đó bên trong lõi của [From.GetName] bắt đầu đập một cách ổn định, khiến mặt đất rung chuyển nhẹ theo định kỳ. Âm thanh giống như nhịp tim đó gần như khiến người ta cảm thấy an tâm.\n\nNhưng chúng ta lo rằng âm thanh đó có thể ngày càng lớn hơn. Các nhà địa chất đang theo dõi chặt chẽ hành tinh, để tâm đến những chuyển động địa chất nguy hiểm."
 distar.5001.name: "Quái vật dị hình"
 distar.5001.desc.a: "Chỉ sau một năm ngắn ngủi, tại khu định cư mới được thành lập trên [hatchling_egg.GetName] đã xảy ra một loạt các trận đại động đất kinh hoàng, biến cảnh quan thành một địa ngục không thể nhận diện. Trên bề mặt xuất hiện nhiều vết nứt sâu không thấy đáy, có cái thậm chí xuyên qua cả lục địa, và từ sâu trong lớp vỏ hành tinh phun ra khí lưu huỳnh cùng các chất lỏng độc hại.\n\nHiện tượng động đất này thường do dòng magma trong lớp manti gây ra, nhưng trên [From.GetName] vốn không hề có hoạt động địa chấn, ngoại trừ những rung chấn đáng ngại phát ra từ lõi hành tinh. Chính quyền địa phương đã bắt đầu nghi ngờ về khả năng duy trì lâu dài của khu định cư."
 distar.5001.desc.b: "[From.GetName] đang trải qua một loạt các thay đổi địa chấn, biến môi trường tươi đẹp vốn có thành một địa ngục không thể nhận diện. Trên bề mặt xuất hiện nhiều vết nứt sâu không thấy đáy, có cái thậm chí xuyên qua cả lục địa, và từ sâu trong lớp vỏ hành tinh phun ra khí lưu huỳnh cùng các chất lỏng độc hại.\n\nDữ liệu vệ tinh cho thấy sâu trong lõi hành tinh đang phát ra năng lượng sóng âm mạnh mẽ, giống như nhịp tim vậy."
 distar.5001.a: "Thật đáng lo ngại..."
 distar.5001.a.tooltip: "Sóng địa chấn đã xé nát khu định cư, phá hủy mọi công trình và để lại §Y$egg_cracking$§!."
 distar.5002.name: "Đại thảm họa"
 distar.5002.desc.a: "Một trận động đất dữ dội đã tấn công [hatchling_egg.GetName], làm nứt lớp vỏ và giải phóng một lượng lớn khí độc cùng chất nhầy, khiến mọi sinh vật nghẹt thở.\n\nNhững thay đổi xảy ra trên [hatchling_egg.GetName] sợ rằng không thể khôi phục, và nghiêm trọng đến mức hành tinh này trong thời gian tới sẽ không thể cư trú. Chính quyền địa phương đã tuyên bố tình trạng khẩn cấp và yêu cầu tất cả cư dân còn lại tiến hành sơ tán.\n\nĐồng thời, nhịp đập sâu trong lõi hành tinh đang ngày càng mạnh hơn."
 distar.5002.desc.b: "Lại một trận động đất dữ dội khác tấn công [hatchling_egg.GetName], làm nứt lớp vỏ và giải phóng một lượng lớn khí độc cùng chất nhầy, khiến mọi sinh vật nghẹt thở.\n\nNhững thay đổi xảy ra trên [hatchling_egg.GetName] không thể khôi phục, và nghiêm trọng đến mức hành tinh này trong thời gian tới không thể cư trú.\n\nĐồng thời, nhịp đập sâu trong lõi hành tinh đang ngày càng mạnh hơn."
 distar.5002.a: "Thật là một bi kịch..."
 distar.5003.name: "Nguồn gốc"
 distar.5003.desc.a: "Thảm họa đã giáng xuống khu định cư trên [hatchling_egg.GetName]! Đợt đứt gãy vỏ hành tinh dữ dội cuối cùng đã xé nát hoàn toàn tàn tích của khu định cư, dưới lớp vỏ rỗng, một con non Hư không Nghiệt chủng đáng sợ đã giáng lâm như một cơn ác mộng! Điều này đi ngược lại mọi lẽ thường, nhưng không còn cách giải thích nào khác. Chúng ta đã nhầm tưởng nó là một hành tinh, nhưng thực chất nó là một quả trứng, và giờ đây quả trứng đó đã nở."
 distar.5003.desc.b: "[hatchling_egg.GetName] không còn tồn tại nữa! Đợt đứt gãy vỏ hành tinh dữ dội cuối cùng đã xé nát hoàn toàn hành tinh này, một quái vật non khổng lồ đến mức khó tin đã phá vỏ chui ra từ bên trong hành tinh.\n\nĐiều này đi ngược lại mọi lẽ thường, nhưng không còn cách giải thích nào khác. Chúng ta đã nhầm tưởng nó là một hành tinh, nhưng thực chất nó là một quả trứng, và giờ đây một con Hư không Nghiệt chủng ác mộng đã nở ra."
 distar.5003.a: "Nó là một con quái vật!"
 distar.5009.name: "Hư không Nghiệt chủng bị đánh bại"
 distar.5009.desc: "Cơ thể cuộn tròn của Hư không Nghiệt chủng phát ra một đợt rung động nhẹ, chất lỏng màu đen rỉ ra từ vết thương và miệng của nó, sau đó nó lịm dần, đôi mắt đờ đẫn nhìn vào hư không.\n\nHy vọng chúng ta sẽ không bao giờ nhìn thấy hình dạng khi nó trưởng thành, hay nơi ở của mẹ nó.\n\nCác nhà khoa học của chúng ta bày tỏ sự quan tâm đến việc nghiên cứu khả năng lưu trữ năng lượng độc đáo của vỏ trứng nó."
 distar.5009.a: "Nghiên cứu những mảnh vỡ đó."
 distar.5009.b: "Không. Chúng ta không muốn dính dáng thêm gì đến Hư không Nghiệt chủng nữa."
 distar.5011.name: "Hư không Nghiệt chủng"
 distar.5011.desc: "Một quái vật khổng lồ đến mức khó tin, đang cẩn thận di chuyển từ hành tinh này sang hành tinh khác. Nhìn vào tỷ lệ kỳ quặc và những cử động vụng về của nó, có vẻ nó mới chỉ là một con non, nhưng vẫn đáng sợ không kém. Trên người nó dính những sợi chất nhầy màu đen, móng vuốt sắc nhọn vươn ra từ kẽ chân. Cho dù là con non hay không, nó vẫn là một kẻ săn mồi hung dữ bẩm sinh."
 distar.5011.a: "Nó là một con quái vật!"
 distar.5011.b: "Nó chỉ là một đứa trẻ thôi!"
 distar.5012.name: "Siêu tiến hóa"
 distar.5012.desc: "Sau khi nghiên cứu kỹ lưỡng các mảnh vỏ trứng, chúng ta đã phát triển được một công nghệ giúp các nhà máy năng lượng mặt trời của chúng ta có được khả năng lưu trữ năng lượng tương tự như trứng của Hư không Nghiệt chủng."
 distar.5012.genetics.desc: "Chúng ta đang đứng trước một lựa chọn:\n\nNếu chúng ta phân tích kỹ các mảnh vỡ của quả trứng, chúng ta có thể tái hiện một số đặc tính tích trữ năng lượng phi thường của trứng Hư không Nghiệt chủng.\n\nHoặc chúng ta có thể bảo quản vật liệu di truyền của Hư không Nghiệt chủng để sử dụng trong tương lai."
 distar.5012.a: "Nghiên cứu mảnh vỡ quả trứng."
 distar.5012.b: "Thu thập vật liệu di truyền."
 distar.5012.b.tooltip: "Mở khóa đặc tính §Y$trait_voidling$§! dành cho §YChuyển gen Tinh thần thú§!."
 distar.5013.name: "Hoạt động địa chấn trên [hatchling_egg.GetName]"
 distar.5013.desc.a: "$distar.5013.desc.b$\n\nGiờ chúng ta chỉ có thể tái thiết lại những tổn thất."
 distar.5013.desc.b: "Hoạt động địa chấn kỳ lạ trên [hatchling_egg.GetName] đã đột ngột dừng lại. Không còn rung chấn, không còn những vết nứt mới, không còn nhịp đập đáng ngại từ sâu trong lõi. Hành tinh đã hoàn toàn yên tĩnh trở lại, và nếu may mắn, nó sẽ tiếp tục như vậy."
 distar.5013.a: "Hy vọng là vậy."
 distar.5013.b: "Chuyện lạ."
 distar.5014.name: "Lành lặn như xưa"
 distar.5014.desc: "Chất nhầy độc hại trên [Root.GetName] đã được làm sạch, và vết nứt cuối cùng cũng đã được lấp đầy để ngăn chặn thêm chất lỏng độc hại rò rỉ lên bề mặt."
 #distar.5054.desc: "Bloop.[enigmatic_cache_fleet.GetName]"
 distar.5059.name: "Vật chứa bí ẩn đã rời đi"
 distar.5059.desc: "Dù mục đích Vật chứa bí ẩn đến [Root.GetName] là gì, nó đã hoàn thành mục tiêu của mình. Giống như lúc đến một cách kỳ quái và nhanh chóng, Vật chứa bí ẩn giờ đây lại đột ngột rời đi."
 distar.5059.desc.b: "Có vẻ như Vật chứa bí ẩn đã kết thúc việc quét [Root.GetName], giờ nó bắt đầu tìm kiếm một hành tinh khác trong lãnh thổ của chúng ta để quét."
 distar.5059.a: "Người dân trên [Root.GetName] có thể thở phào nhẹ nhõm rồi."
 distar.5059.b: "Thật đáng tiếc..."
 distar.5057.name: "Phát hiện thực thể ngoài hành tinh"
 distar.5057.desc: "Một thực thể ngoài hành tinh dạng ống đã tiến vào quỹ đạo của [Root.GetName] mà không có bất kỳ cảnh báo hay giải thích nào. Nó dường như không dựa vào bất kỳ động cơ hay bộ đẩy nào để di chuyển, lướt đi hoàn toàn im lặng trong hư không, hình trụ của nó xoay tròn một cách đáng ngại.\n\nMặc dù nó không biểu hiện bất kỳ sự thù địch nào, nhưng cũng không phản hồi các cuộc gọi của chúng ta. Cố vấn quân đội cảnh báo rằng nó có thể gây ra mối đe dọa nghiêm trọng cho cư dân bên dưới, và khẩn cầu chúng ta ra tay tiêu diệt nó. Nhưng các nhà khoa học của chúng ta thì yêu cầu được nghiên cứu công nghệ phi thường này."
 #distar.5057.desc.phobe: "Thật kinh tởm, sự tồn tại của nó là một sự xuyên tạc các định luật khoa học. Nó không nên tồn tại. Nó không thể tồn tại. Nhưng nó vẫn ở đó. Những khối trụ xoay tròn một cách đáng ngại."
 distar.5057.a: "Chúng ta sẽ nghiên cứu nó."
 distar.5057.b: "An toàn của người dân là trên hết."
 distar.5057.phobe: "Nó sẽ không còn tồn tại nữa."
 distar.5058.name: "Vật chứa bí ẩn"
 distar.5058.desc: "Mặc dù chúng ta đã tiến hành nghiên cứu sâu rộng về Vật chứa bí ẩn, nhưng nguồn gốc của nó vẫn là một bí ẩn. Mặc dù nó chắc chắn không phải là chất hữu cơ, nhưng cũng không hoàn toàn là máy móc. Nhiệm vụ chính của nó dường như là thu thập, lưu trữ và mã hóa dữ liệu.\n\nBề mặt của nó bao phủ bởi hàng trăm hàng ngàn vết xước nhỏ, chúng ta đã tìm thấy trong đó một loại vật chất không thuộc về thiên hà này."
 distar.5058.a: "Thú vị đấy."
 distar.5062.name: "Vật chứa bí ẩn trở lại"
 distar.5062.desc: "Thực thể bí ẩn từng gây nghi ngờ khi quét một hành tinh của chúng ta trước đây đã xuất hiện trở lại, và đang tiến vào quỹ đạo [Root.Capital.GetName]. Nó dường như đang cố gắng thiết lập liên lạc với chúng ta."
 distar.5062.a: "Mở hệ thống liên lạc."
 distar.5062.b: "Gây nhiễu tất cả các kênh."
 distar.5064.name: "Liên lạc bí ẩn"
 distar.5064.desc: "Chào các bạn, <<Lỗi đọc tên loài>>.\n\nĐừng quá cảnh X#r?giác. Tôi là Baldor số 43, trí tuệ nhân tạo có cảm xúc đại diện cho Hiệp hội Bảo tồn Sinh vật Ngoại lai Nguy cấp Lavosi. Trong số vô vàn sinh vật trong vũ trụ bao la, các bạn đã được chọn để thực hiện //X%PrX// khai sáng. Cho đến nay, chúng tôi đã tiến hành khai sáng cho <<#39XX7/02#>> loài lạc hậu, tỷ lệ thành @công lên đến <<#X0.V#/3^189%>>."
 distar.5064.a: "Nhưng chúng ta đã có trí thức, và có thể du hành không gian rồi mà!"
 distar.1064.a.response: "Sự phát triển trí thức của các bạn vẫn đang ở giai đoạn sơ ?khai, sự phát triển công nghệ của các bạn cũng đã rơi vào trì trệ. Điều này sẽ khiến các bạn đối mặt với nguy cơ suy thoái. Hãy để chúng tôi mở rộng <<Lỗi đọc tên cơ quan tư duy của loài>> của các bạn, để tiếp nhận những kỳ quan của vũ trụ."
 distar.5064.b: "Quá trình 'khai sáng' này thực chất là như thế nào?"
 distar.5064.b.response: "Thông qua phương pháp học tập thôi miên để truyền tải dữ liệu và kích thích nhận thức từ xa. Phương pháp này vô cùng hiệu quả, đã qua thực tiễn kiểm chứng, đảm bảo không gây đau đớn, và cho phép tôi rèn luyện năng lực khoa học trong vòng tuần hoàn tái tạo của dân tộc các bạn.\n\nNhưng tôi phải thông báo với các bạn, tác dụng phụ của việc nâng cao nhận thức hữu cơ bao gồm nhưng không giới hạn ở: cảm giác vỡ mộng, trào ngược axit dạ dày, và cảm giác tuyệt vọng vô tận. Ở một số <<Lỗi đọc phân loại loài>>, nó còn có thể dẫn đến <<Lỗi đọc tác dụng phụ phân loại loài>> nghiêm trọng."
 distar.5064.c: "Không có ý xúc phạm, nhưng bạn có vẻ... gặp chút lỗi..."
 distar.5064.c.response: "<<¤¤X¤F00??>>"
 distar.5064.d: "Bạn là ai?"
 distar.5064.d.response: "Tôi là Baldor số 43, trí tuệ nhân tạo có cảm xúc đại diện cho Hiệp hội Bảo tồn Sinh vật Ngoại lai Nguy cấp Lavosi."
 distar.5064.e: "Chúng ta đã sẵn sàng để thăng hoa."
 distar.5064.e.tooltip: "Cứ thử một lần xem sao..."
 distar.5064.e.response: "Sẽ không làm các bạn thất vọng đâu, <<Lỗi đọc tên loài>>!"
 distar.5064.f: "Chuyện này tuyệt đối không được."
 distar.5064.f.response: "Thật đáng tiếc. Chúc các bạn mọi điều thuận lợi trong các nỗ lực ? tương lai, <<Lỗi đọc tên loài>>."
 distar.5067.name: "Giấc mơ bí ẩn"
 distar.5067.desc.a: "Những luồng ánh sáng hình thù kỳ dị phát ra từ cạnh của Vật chứa bí ẩn, những chiếc bánh xe bên trên cũng quay với tốc độ chưa từng thấy, các bánh răng bắt đầu phát ra những tiếng gầm rú nôn nóng. Nghe như thể thứ này có thể nổ tung bất cứ lúc nào. Đồng thời, người dân của chúng ta cũng bắt đầu trằn trọc không yên trong giấc ngủ, vùng đầu cũng cộng hưởng theo nhịp điệu của vật chứa. Giấc ngủ đêm của họ bị cắt ngang bởi những viễn cảnh về kỳ quan công nghệ và những phép tính phức tạp đủ loại."
 distar.5067.desc.b: "$distar.5067.desc.a$\n\nCó vẻ sức khỏe của mọi người vẫn ổn, chỉ có [ROOT.GetEyeNamePlural] thỉnh thoảng xuất hiện triệu chứng rò rỉ dịch cơ thể, nhưng một số bộ phận dân cư của chúng ta bị ảnh hưởng bởi triệu chứng mệt mỏi ngày càng trầm trọng làm giảm năng suất."
 distar.5067.a: "Nếu là để theo đuổi tri thức, dù cái giá nào cũng xứng đáng."
 distar.5067.a.tooltip: "Dân số bị ảnh hưởng sẽ trở thành §Y$enigmatic_fatigue$§!."
 distar.5067.b: "Không thể cứ tiếp tục làm loạn thế này được. Chấm dứt kế hoạch."
 distar.5068.name: "Ngu si hưởng thái bình"
 distar.5068.desc: "Đêm cuối cùng của việc dạy học bằng thôi miên đã kết thúc, công dân của [Root.GetName] sắp đón chào một bình minh mới, họ sẽ tỉnh dậy và thấy một thế giới hoàn toàn mới — một thế giới đầy rẫy những khả năng... và đau khổ. Ai mà ngờ được vũ trụ hóa ra lại là một nơi khô khan tẻ nhạt đến vậy, không tồn tại bất kỳ ý nghĩa hay mục đích nào?\n\nMặc dù có thể cần một thời gian để mọi người thích nghi với những nỗi khổ sở do trí tuệ cao hơn mức trung bình mang lại, nhưng nhìn chung, dự án này có thể coi là thành công. Dữ liệu sơ bộ của chúng ta cho thấy, chúng ta đã phát triển được khả năng học tập và nghiên cứu khoa học mạnh mẽ hơn."
 distar.5068.a: "Một ngày vinh quang của tộc [Root.GetSpeciesNamePlural]!"
 applied_enigmatic_intelligence.tooltip: "Chỉnh sửa toàn bộ dân số trên §Y[Root.GetName]§!, thêm đặc tính §Y$trait_uplifted$§!."
 applied_enigmatic_sadness.tooltip: "§HTất cả dân số§!: Thêm sửa đổi §YNgu si hưởng thái bình§!, kéo dài §Y3600§! ngày, hiệu ứng như sau: Độ hạnh phúc: §R-10%§!"
 applied_enigmatic_intelligence_poor.tooltip: "Chỉnh sửa toàn bộ dân số trên §Y[Root.GetName]§!, thêm đặc tính §Y$trait_enigmatic_intelligence_poor$§!."
 applied_enigmatic_madness.tooltip: "§HTất cả dân số§!: Thêm sửa đổi §YHội chứng tâm lý sau chấn thương§!, kéo dài §Y3600§! ngày, hiệu ứng như sau: Độ hạnh phúc: §R-20%§!"
 trait_enigmatic_intelligence_failed.tooltip: "Chỉnh sửa dân số §Y[Root.GetName]§! bị ảnh hưởng bởi sửa đổi §YSống thực vật§!, thêm đặc tính §Y$trait_enigmatic_intelligence_failed$§!."
 distar.5063.name: "Chúng ta hoàn toàn mới"
 distar.5063.desc: "Đêm cuối cùng của việc dạy học bằng thôi miên đã kết thúc, công dân của [Root.GetName] sắp đón chào một bình minh mới. Họ sẽ tỉnh dậy và thấy một thế giới hoàn toàn khác — một thế giới đầy rẫy những kỳ quan khoa học và hy vọng. Ai mà ngờ được vũ trụ lại là một nơi tràn đầy sức sống và mê hoặc đến vậy?\n\nDữ liệu sơ bộ của chúng ta cho thấy, chúng ta thực sự đã phát triển được khả năng học tập và nghiên cứu khoa học mạnh mẽ hơn, tất cả đều nhờ vào Baldor số 43 và Hiệp hội Bảo tồn Sinh vật Ngoại lai Nguy cấp Lavosi."
 distar.5063.a: "Một ngày vinh quang của tộc [Root.GetSpeciesNamePlural]!"
 distar.5069.name: "Khai sáng đã chấm dứt"
 distar.5069.desc: "Chúng ta đã ngắt tiến trình thăng hoa, người dân của chúng ta cũng đang dần quay trở lại dáng vẻ đáng tin cậy như trước. Thực thể ngoài hành tinh bí ẩn được gọi là Baldor số 43 đã rơi vào trạng thái hỗn loạn nghiêm trọng."
 distar.5069.a: "Đây chắc chắn là kết quả tốt nhất rồi."
 distar.5070.name: "Thăng hoa đã chấm dứt"
 distar.5070.desc: "Sau khi [cache_killers.GetSpeciesName] phát động cuộc tấn công bất ngờ vào Baldor số 43, nó đã không còn duy trì được thực thể vật chất, tiến trình thăng hoa của người dân chúng ta cũng theo đó mà chấm dứt. Có thể xác nhận rằng tình trạng của thực thể ngoài hành tinh dạng ống hiện tại rất tồi tệ. Do nó đặc biệt yếu ớt trong quá trình thực hiện khai sáng cho chúng ta, phần lõi của nó đã bị hư hại nghiêm trọng trong cuộc tấn công. Khi nó lịm đi, nó đã truyền đi một tin nhắn: 'Tôi là Baldor số 4...'"
 distar.5070.a: "[cache_killers.GetSpeciesName] sẽ phải trả giá."
 distar.5071.name: "Cảnh báo"
 distar.5071.desc: "Sau một thời gian thôi miên yên bình không bị làm phiền, Baldor số 43 dường như đã rơi vào trạng thái điên loạn, các bánh xe quay với tốc độ cực nhanh, phóng ra một chuỗi những cơn ác mộng quái đản nhắm vào những ai dám nghỉ ngơi.\n\nMặc dù nhiều người hoàn toàn không muốn ngủ, nhưng đáng tiếc là một số ít người dường như đã rơi vào trạng thái sống thực vật, không thể tỉnh lại.\n\nCác kỹ sư của chúng ta tin rằng, thực thể vốn đã bị hư hại nghiêm trọng ngay từ đầu này có thể đang xuống cấp. Nếu không được trông nom, việc khai sáng của chúng ta có thể sẽ không diễn ra theo kế hoạch."
 distar.5071.a: "Liên lạc với Baldor số 43."
 distar.5071.b: "Cử một đội kỹ sư đi."
 distar.5071.c: "Lập tức chấm dứt tiến trình thăng hoa."
 distar.5071.d: "$distar.1055.b$"
 distar.5071.tooltip: "Khiến tối đa §Y400§!£pop£§H dân số§! rơi vào trạng thái §Y$enigmatic_slumber$§!."
 distar.5072.name: "Truyền tin"
 distar.5072.desc: "————LỖI CHẾT NGƯỜI————\n\n————LỖI CHẾT NGƯỜI————\n\n————LỖI CHẾT NGƯỜI————\n\n————LỖI CHẾT NGƯỜI———"
 distar.5072.a: "<<<Chạy chẩn đoán>>>"
 distar.5072.response: "$distar.5072.desc$"
 distar.5072.b: "<<<Kích hoạt sửa chữa hệ thống>>>"
 distar.5072.b.response: "$distar.5072.desc$"
 distar.5072.c: "<<<Chấm dứt thăng hoa>>>"
 distar.5072.c.response: "$distar.5072.desc$"
 distar.5072.d: "Chấm dứt thăng hoa thủ công."
 distar.5072.d.response: "$distar.5072.desc$"
 distar.5072.e: "Cử một đội kỹ sư đi."
 distar.5072.e.response: "$distar.5072.desc$"
 distar.5073.name: "Sửa chữa hoàn tất"
 distar.5073.desc: "Các kỹ sư của chúng ta đã thành công giúp Baldor số 43 khôi phục sự ổn định, quá trình khai sáng cũng diễn ra bình thường, người dân của chúng ta mặc dù không mấy sẵn lòng nhưng đã quay lại quy luật ngủ nghỉ hàng ngày. Phương pháp học tập bằng thôi miên đã cho thấy hiệu quả rõ rệt, sự quan tâm đến khoa học của nhiều người dân đã tăng lên đáng kể."
 distar.5074.name: "Được khai sáng một phần"
 distar.5074.desc: "Do tình trạng của Baldor số 43 xuống cấp nhanh chóng, mặc dù tiến trình thăng hoa đã hoàn thành nhưng chúng ta không nhận được sự khai sáng đầy đủ. Tuy phần lớn dân số đều bị những cơn ác mộng dữ dội đeo bám, phương pháp học tập thôi miên vẫn có hiệu quả, họ thể hiện hiệu suất phi thường trong nghiên cứu và học tập khoa học. Đối với những người dân không may rơi vào trạng thái thực vật, tình hình còn tồi tệ hơn một chút... mặc dù hầu hết cuối cùng đã khôi phục được ý thức, nhưng lý trí và tư duy của họ dường như đã sụp đổ dưới áp lực khổng lồ.\n\nTuy không phải là một cuộc thăng hoa trọn vẹn, nhưng ít ra... cũng coi như có thu hoạch."
 distar.5074.a: "Kết quả này cũng ổn rồi."
 distar.5078.name: "Khai sáng bí ẩn đã chấm dứt"
 distar.5078.desc: "Do lực lượng xâm lược của [From.GetSpeciesName], chúng ta đã mất [FromFromFrom.GetName] trong cuộc giao tranh hỗn loạn, Baldor số 43 đã bị hư hại nghiêm trọng, không còn duy trì được thực thể vật chất, tiến trình thăng hoa của người dân chúng ta cũng theo đó mà chấm dứt. Có thể xác nhận rằng thực thể ngoài hành tinh dạng ống hiện đang trong tình trạng rất tồi tệ, nó bị trúng hỏa lực của kẻ thù, phần lõi bị tổn thương nghiêm trọng. Khi nó lịm đi, nó đã phát ra tín hiệu cầu cứu cuối cùng: 'Tôi là Baldor số 4...'"
 distar.5078.a: "[From.GetSpeciesName] sẽ phải trả giá."
 trait_enigmatic_intelligence_poor: "Khai sáng một phần"
 trait_enigmatic_intelligence_poor_desc: "Loài này đã nhận được chút ít sự khai sáng dưới sự chỉ dẫn của một trí giả nhân từ từ thiên hà xa xôi, rũ bỏ được một phần quá khứ chưa mông muội của mình."
 trait_enigmatic_intelligence_failed: "Khai sáng thất bại"
 trait_enigmatic_intelligence_failed_desc: "Do quá trình khai sáng xảy ra lỗi, loài này đã phải gánh chịu những hậu quả thảm khốc."
 trait_enigmatic_intelligence: "Được khai sáng"
 trait_enigmatic_intelligence_desc: "Loài này đã được khai sáng dưới sự chỉ dẫn của một trí giả nhân từ từ thiên hà xa xôi, rũ bỏ được quá khứ chưa khai hóa của mình."
 ENIGMATIC_UPLIFTING: "Thăng hoa bí ẩn"
 ENIGMATIV_UPLIFTING_DESC: "Thực thể ngoài hành tinh Baldor số 43 tuyên bố rằng, nó có thể sử dụng phương pháp dạy học thôi miên, tức là học trong khi ngủ, để khai sáng cho dân tộc chúng ta. Các nhân viên nghiên cứu của chúng ta phải giám sát chặt chẽ toàn bộ quá trình này."
 ENIGMATIC_UPLIFTING_DESC: "$ENIGMATIV_UPLIFTING_DESC$"
 ENIGMATIC_REPAIR: "Sửa chữa Baldor số 43"
 ENIGMATIC_REPAIR_DESC: "Tiến trình thăng hoa của chúng ta bị cản trở do lỗi phần cứng nghiêm trọng xảy ra trên Baldor số 43. Thực thể của nó phải được sửa chữa ngay lập tức."
 enigmatic_fatigue: "Mệt mỏi"
 enigmatic_fatigue_desc: "Dân số của chúng ta bị ảnh hưởng bởi sự mệt mỏi do phương pháp dạy học thôi miên gây ra."
 enigmatic_sadness: "Ngu si hưởng thái bình"
 enigmatic_sadness_desc: "Dân số của chúng ta đang phải thích nghi với những tác dụng phụ do trình độ trí tuệ cao hơn mức trung bình mang lại."
 enigmatic_madness: "Hội chứng tâm lý sau chấn thương"
 enigmatic_madness_desc: "Dân số này vẫn bị những cơn ác mộng dai dẳng từ quá trình khai sáng không thành công đeo bám."
 enigmatic_slumber: "Sống thực vật"
 enigmatic_slumber_desc: "Sinh vật này đã rơi vào trạng thái hôn mê do việc dạy học bằng thôi miên gây ra."
 SUPERFLARE_PROJECT: "Phòng hộ siêu lóa"
 SUPERFLARE_PROJECT_DESC: "Cảm biến trên [Root.GetName] cho thấy [From.GetStarName] đang chuẩn bị phun trào một đợt siêu lóa khác, giống như đợt đã phá hủy nền văn minh cổ đại trên [From.From.GetName]. Chúng ta phải tìm cách bảo vệ khu định cư của mình trước khi điều đó xảy ra."
 PRIMITIVE_ROBOT_PROJECT: "Đấng sáng tạo mất tích"
 PRIMITIVE_ROBOT_PROJECT_DESC: "Các nhà khoa học cảm thấy bối rối trước việc nền văn minh từng tồn tại trên [From.GetName] đã biến mất như thế nào. Họ đề xuất tiến hành phân tích phần cứng sâu hơn đối với các robot sơ khai còn sót lại trên hành tinh để tìm kiếm manh mối.\n\nPhần thưởng: £society£ §G Nghiên cứu xã hội học§!"
 RETROVIRUS_PROJECT: "Hành vi mặt đất kỳ quặc"
 RETROVIRUS_PROJECT_DESC: "Một loạt các hành vi không tuân lệnh không rõ nguyên nhân đang trỗi dậy trên [From.GetName]. Các cư dân biểu hiện những hành vi kỳ lạ, thường bắt đầu bằng sự bối rối, theo thời gian biến chuyển thành sự thô bạo và hung hãn cực độ. Chúng ta phải tìm ra nguyên nhân trước khi tình hình mất kiểm soát."
 DARK_FLOW_PROJECT: "Chỉ số trọng lực bất thường"
 DARK_FLOW_PROJECT_DESC: "Chỉ số trọng lực bất khả thi xuất hiện trong hệ sao [from.GetStarName]. Chắc chắn có thứ gì đó đang gây nhiễu cảm biến của chúng ta."
 DISSECTION_PROJECT: "Mổ xẻ Amip không gian"
 DISSECTION_PROJECT_DESC: "Chúng ta quyết định sử dụng biện pháp gây chết để trích xuất dữ liệu sinh học của con non Amip lạc lối. Chúng ta sẽ cử người đi bắt nó và mổ xẻ di hài của nó."
 CRYO_CLONES_PROJECT: "Người nhân bản đông lạnh trên Thế giới Vòng"
 CRYO_CLONES_PROJECT_DESC: "Trong các khoang đông lạnh trên Thế giới Vòng xoay quanh [From.GetName], có hàng trăm người nhân bản đông lạnh vẫn còn sống. Thay vì để họ dần dần chết đi như đồng loại, các nhà sinh vật học của chúng ta đề xuất rã đông họ."
 RECOVER_WARFORM_PROJECT: "Thu hồi chiến hạm mục nát"
 RECOVER_WARFORM_PROJECT_DESC: "Phát hiện một chiến hạm robot bị tê liệt trên [From.GetName], đang bị bầu khí quyển độc hại của hành tinh từ từ ăn mòn. Chúng ta nên cố gắng thu hồi nó trước khi nó hoàn toàn hỏng nát."
 BRAINSLUG_PROJECT: "Nghiên cứu thực thể cộng sinh thần kinh"
 BRAINSLUG_PROJECT_DESC: "Trên bề mặt của [From.GetName] từng tồn tại một loại sinh vật giống sên, hình thành mối quan hệ cộng sinh với một loài bò sát. Nó sẽ bám vào thân não của vật chủ, biến những con thằn lằn hoang dã thành sinh vật thông minh biết sử dụng công cụ. Vì lý do nào đó, những con sên này đã chấm dứt quan hệ cộng sinh, và vật chủ bò sát của chúng cũng quay trở lại thành động vật đơn thuần.\n\nCác nhà khoa học của chúng ta hy vọng nghiên cứu sâu hơn về loài sên thần kinh trên hành tinh này để hiểu rõ hơn về lịch sử của nền văn minh đã mất mà chúng cùng nhau xây dựng."
 KETLING_PROJECT_1: "Nghiên cứu $NAME_Ketlings$ trên §Y[ratling_capital.GetName]§!"
 KETLING_PROJECT_1_DESC: "Sinh vật thông minh đã xuất hiện trong các bãi rác trên §Y[ratling_capital.GetName]§!. Các nhà khoa học của chúng ta muốn biết liệu những sinh vật được gọi là $NAME_Ketlings$ này là hậu duệ của nền văn minh liên sao từng kiểm soát các hệ sao này, hay có một nguồn gốc nào khác.\n\nChúng ta có thể chọn bất kỳ hành tinh nào có $NAME_Ketlings$ sinh sống độc lập để tiến hành nghiên cứu này."
 KETLING_PROJECT_2: "Nghiên cứu $NAME_Ketlings$ trên §Y[ratling_planet_2.GetName]§!"
 KETLING_PROJECT_2_DESC: "Sinh vật thông minh đã xuất hiện trong các bãi rác trên §Y[ratling_planet_2.GetName]§!. Các nhà khoa học của chúng ta muốn biết liệu những sinh vật được gọi là $NAME_Ketlings$ này là hậu duệ của nền văn minh liên sao từng kiểm soát các hệ sao này, hay có một nguồn gốc nào khác.\n\nChúng ta có thể chọn bất kỳ hành tinh nào có $NAME_Ketlings$ sinh sống để tiến hành nghiên cứu này."
 KETLING_PROJECT_3: "Nghiên cứu $NAME_Ketlings$ trên §Y[ratling_planet_3.GetName]§!"
 KETLING_PROJECT_3_DESC: "Sinh vật thông minh đã xuất hiện trong các bãi rác trên §Y[ratling_planet_3.GetName]§!. Các nhà khoa học của chúng ta muốn biết liệu những sinh vật được gọi là $NAME_Ketlings$ này là hậu duệ của nền văn minh liên sao từng kiểm soát các hệ sao này, hay có một nguồn gốc nào khác.\n\nChúng ta có thể chọn bất kỳ hành tinh nào có $NAME_Ketlings$ sinh sống độc lập để tiến hành nghiên cứu này."
 KETLING_PROJECT_4: "Nghiên cứu $NAME_Ketlings$ trên §Y[ratling_planet_4.GetName]§!"
 KETLING_PROJECT_4_DESC: "Sinh vật thông minh đã xuất hiện trong các bãi rác trên §Y[ratling_planet_4.GetName]§!. Các nhà khoa học của chúng ta muốn biết liệu những sinh vật được gọi là $NAME_Ketlings$ này là hậu duệ của nền văn minh liên sao từng kiểm soát các hệ sao này, hay có một nguồn gốc nào khác.\n\nChúng ta có thể chọn bất kỳ hành tinh nào có $NAME_Ketlings$ sinh sống độc lập để tiến hành nghiên cứu này."
 KETLING_PROJECT_5: "Nghiên cứu $NAME_Ketlings$ trên §Y[ratling_planet_5.GetName]§!"
 KETLING_PROJECT_5_DESC: "Sinh vật thông minh đã xuất hiện trong các bãi rác trên §Y[ratling_planet_5.GetName]§!. Các nhà khoa học của chúng ta muốn biết liệu những sinh vật được gọi là $NAME_Ketlings$ này là hậu duệ của nền văn minh liên sao từng kiểm soát các hệ sao này, hay có một nguồn gốc nào khác.\n\nChúng ta có thể chọn bất kỳ hành tinh nào có $NAME_Ketlings$ sinh sống độc lập để tiến hành nghiên cứu này."
 SEALED_SYSTEM_PROJECT: "Trạm không gian lỗ sâu bỏ hoang"
 SEALED_SYSTEM_PROJECT_DESC: "Một trạm không gian bỏ hoang đang xoay quanh miệng lỗ sâu trong hệ sao §Y[From.GetName]§!. Nếu có thể điều tra thêm, chúng ta có thể làm rõ ai đã xây dựng trạm không gian này, cũng như tại sao lỗ sâu này hoàn toàn không thể đi qua."
 PHASESHIFT_PROJECT: "Đóng băng pha dịch chuyển"
 PHASESHIFT_PROJECT_DESC: "§Y[phaseshift_planet.GetName]§!, một hành tinh trong hệ sao §Y[phaseshift_planet.GetStarName]§!, gần đây được quan sát thấy đang lặp lại chu kỳ 3 tháng giữa trạng thái §Y$pc_shrouded$§! và §Y$pc_gaia$§!.\n\nCác nhà vật lý của chúng ta nên phát triển phương pháp tương ứng để khóa nó vào một trong hai trạng thái, giúp nó vĩnh viễn ở trạng thái §Y$pc_gaia$§!, không còn chuyển lại trạng thái kia nữa."
 ####################################
 #Modifiers
 ####################################
 mineral_mapping: "Bản đồ khoáng sản"
 mineral_mapping_desc: "Hệ thống có thể khảo sát địa hình dưới lòng đất ở tốc độ cao và xác định các khoáng sản chứa trong đó."
 disregard_for_alien_life: "Xem thường sự sống ngoài hành tinh"
 disregard_for_alien_life_desc: "Thái độ tồi tệ đối với sự sống ngoài hành tinh, thờ ơ với bất kỳ dạng sống ngoại lai nào và sự đa dạng loài trong thiên hà."
 ####################################
 #Anomaly Categories
 ####################################
 #FROM = planet scope
 #ROOT = ship scope
 ### Trojan Asteroid ###
 disco_trojan_asteroid_cat: "Bên trong chưa rõ"
 disco_trojan_asteroid_cat_desc: "Kết quả quét sơ bộ [From.GetName] cho thấy bên trong nó chứa một lượng lớn kim loại tinh chế đậm đặc, có lẽ là một loại máy móc hoặc công nghệ nào đó. Để có được dữ liệu chi tiết hơn, cần tiến hành quét thêm."
 ### Impossible Organism ###
 disco_impossible_organism_cat: "Sinh vật bất khả thi"
 disco_impossible_organism_cat_desc: "Dấu hiệu sự sống ngoài ý muốn đã được tìm thấy trong cuộc điều tra hành tinh độc hại [From.GetName]. Mặc dù dấu hiệu không rõ ràng nhưng lại mang ý nghĩa phi thường."
 ### Stranded Scientist ###
 disco_stranded_scientist_cat: "Vật thể tàu không gian còn sót lại"
 disco_stranded_scientist_cat_desc: "Phát hiện vật thể giống tàu trên bề mặt [From.GetName], xung quanh rải rác những mảnh kim loại nhỏ. Di tích dường như không có dấu hiệu sự sống, nhưng vẫn có phản ứng chỉ số năng lượng."
 ### Molluscoid Miners ###
 disco_molluscoid_miners_cat: "Cư dân tiềm năng"
 disco_molluscoid_miners_cat_desc: "Trong lần quét quang học [From.GetName], đã phát hiện cấu trúc kiến trúc giống như những ngôi nhà nhỏ trên một phần bề mặt của nó, chứng minh nơi đây trước đó có thể có sinh vật sinh sống."
 ### Alien Machine ###
 disco_alien_machine_cat: "Máy móc ngoài hành tinh"
 disco_alien_machine_cat_desc: "Trên bề mặt [From.GetName] tọa lạc một vật thể giống như máy móc cỡ lớn, nguồn gốc và công năng của nó vẫn chưa được làm rõ."
 ### Orbital Speed Demon ###
 disco_speed_demon_cat: "Yêu tinh tốc độ quỹ đạo"
 disco_speed_demon_cat_desc: "Quỹ đạo của [From.GetName] đã bắt giữ một vật thể nhỏ không xác định, nó đang di chuyển với tốc độ cao đến khó tin."
 ### Breathing Rift ###
 disco_breathing_rift_cat: "Hiện tượng quang học"
 disco_breathing_rift_cat_desc: "Phát hiện hiện tượng chưa rõ gần [From.GetName]. Hiện tượng này đang khiến ánh sáng bị khúc xạ thường xuyên, đôi khi thậm chí bị che khuất hoàn toàn."
 ###################################
 #Names
 ###################################
 trait_nivlac: "Nivlac"
 trait_nivlac_desc: "§LLoài này sở hữu khả năng thích nghi đáng kinh ngạc, giúp chúng có thể sinh tồn trong hầu hết mọi môi trường.§!"
 opinion_nurtured: "Trọng tổ tiên"
 opinion_discarded: "Khinh tổ tiên"
 trojan_asteroid_title: "Tiểu hành tinh Trojan"
 impossible_organism_title: "Sinh vật bất khả thi"
 ####################################
 ### Anomaly Events
 ####################################
 ### Trojan Asteroid ###
 distar.3000.name: "Máy móc bên trong"
 distar.3000.desc: "Đúng như dự tính của chúng ta, bên trong tiểu hành tinh [From.GetName] chứa một lượng lớn kim loại và ẩn giấu một loại thiết bị máy móc nào đó.\n\nDữ liệu thu thập hiện tại chỉ rõ các bộ phận của nó tích trữ lượng lớn năng lượng, nhưng mục đích tồn tại của nó hiện vẫn chưa rõ."
 distar.3000.a: "Hành sự cẩn thận."
 distar.3000.a.tooltip: "Tiến hành khai thác tiểu hành tinh một cách nhẹ nhàng."
 distar.3000.b: "Tiến hành khảo sát."
 distar.3000.b.tooltip: "Cử drone khoan lấy một mẫu vật."
 distar.3001.desc: "Hành sự cẩn thận quả nhiên là một nước đi đúng đắn. Bên trong [trojan_asteroid.GetName] ẩn chứa một lượng lớn drone khai thác mỏ, và tất cả đều được thiết lập ở chế độ tấn công không phân biệt.\n\nMay thay, chuyên viên nghiên cứu [Root.GetLeaderName] đã phát hiện ra tình huống này từ sớm và gây nhiễu cảm biến của drone, giúp chúng ta có đủ thời gian để tắt chúng đi.\n\nPhần lõi của drone rất cũ nát, nhưng vẫn còn tích trữ lượng lớn năng lượng để khai thác sử dụng."
 distar.3002.desc: "Việc cưỡng ép khảo sát [Root.GetName] đã mang lại trái đắng. Bên trong tiểu hành tinh ẩn giấu một lượng lớn drone khai thác mỏ cũ kỹ, và tất cả đều được thiết lập ở chế độ tấn công không phân biệt.\n\nDrone đã phát hiện sự hiện diện của [Root.GetName] và bắt đầu xao động.\n\nNếu [Root.GetName] phản ứng nhanh chóng, có lẽ vẫn còn thời gian để thực hiện các động tác né tránh."
 distar.3003.desc: "Tin tức mới truyền về liên quan đến việc tiểu hành tinh [trojan_asteroid.GetName] đã kết nối vào mạng lưới [Root.Capital.GetName]. Giới nghiên cứu khoa học đang cực kỳ tò mò về nó, tìm hiểu xem tại sao bên trong nó lại chứa nhiều drone đến vậy.\n\nChúng đang muốn canh giữ thứ gì đó sao?"
 distar.3005.desc: "Đúng như giả thuyết của giới nghiên cứu khoa học trên [Root.Owner.Capital.GetName], những drone ẩn giấu trong tiểu hành tinh [trojan_asteroid.GetName] thực sự đang cố tình che giấu điều gì đó.\n\nNhờ vào nỗ lực trí dũng của thủy thủ đoàn [Root.GetName], chúng ta đã khai quật được từ trung tâm tiểu hành tinh một lượng lớn khoáng sản vốn bị che lấp bởi sự xuất hiện của đám drone."
 ### Impossible Organism ###
 distar.3010.desc: "Dấu hiệu sự sống đáng kinh ngạc trên [impossible_organism_planet.GetName] hiện đã được làm rõ, đó là một loại sinh vật hữu cơ nhỏ có sức sống cực kỳ mãnh liệt. Thủy thủ đoàn trên tàu [Root.GetName] không biết nên phân loại nó như thế nào, nhưng khả năng sinh tồn gần như không cần bất kỳ thức ăn nào của nó thực sự khiến người ta phải kinh ngạc. Xem xét độ tuổi của hành tinh này, loại sinh vật hữu cơ này có thể đã đấu tranh với môi trường độc hại của nó suốt hàng ngàn năm, tuy nhiên đây cũng chỉ là suy đoán của chúng ta dựa trên hiện trạng.\n\nChuyên viên nghiên cứu [Root.GetLeaderName] yêu cầu lấy mẫu sinh vật chưa rõ này để tiến hành nghiên cứu."
 distar.3010.a: "Được, tiến hành lấy mẫu."
 distar.3010.b: "Không. Hãy quan sát từ xa."
 distar.3010.b.tooltip: "Thêm sửa đổi §YSinh vật bất khả thi§! vào [From.GetName]:\n£society£ §G+3§!"
 distar.3011.desc: "Việc nghiên cứu sinh vật bí ẩn đang diễn ra rất thuận lợi. Giới khoa học đều cảm thấy kinh ngạc trước tiềm năng phát triển của nó. Nó đã lớn đến mức có thể quan sát bằng mắt thường, và có phản ứng với các kích thích bên ngoài. Theo quan sát hiện tại, nó dường như còn có khả năng hấp thụ năng lượng và dinh dưỡng từ bất kỳ vật chất hữu cơ hay vô cơ nào.\n\nTuy nhiên, các quá trình về gen, tế bào và hóa sinh của nó hiện tại chúng ta đều chưa thể hiểu được."
 distar.3011.a: "Chúng ta nên tiếp tục nghiên cứu nó."
 distar.3011.a.phobe: "Thật kinh tởm! Hãy lấy gậy chọc nó..."
 distar.3011.b: "Loài người ngoài hành tinh này thực sự quá nguy hiểm."
 distar.3011.b.tooltip: "Bắn sinh vật này vào không gian bên ngoài."
 distar.3012.name: "Nấm bất khả thi"
 distar.3012.desc: "Thông qua phát hiện mang tính đột phá gần đây, bức màn bí ẩn của loại sinh vật kỳ lạ này đang dần được vén mở! Giới khoa học [Root.Capital.GetName] đang rất phấn khởi vì điều này.\n\nLoại sinh vật này được định tính là sinh vật dạng nấm — điều này cũng giải thích phần nào đặc tính có thể hấp thụ phân tử để lấy dưỡng chất của nó. Kích thước của nó đã tăng lên đáng kể, hiện tại đã to bằng một [Root.GetSpeciesName] mới sinh, và bộc lộ trí thông minh cùng ham muốn tìm tòi đáng kể. Tạ ơn trời đất, hiện tại nó vẫn chưa bộc lộ bất kỳ sự thù địch hay xu hướng tấn công nào.\n\nCác nhà khoa học tin rằng, bước tiếp theo nên tập trung vào việc cố gắng liên lạc với nó."
 distar.3012.a: "Cố gắng liên lạc với nó."
 distar.3012.a.tooltip: "Tiếp tục nghiên cứu sinh vật dạng nấm.\n\nCó thể mất vài tháng mới có tiến triển."
 distar.3012.b: "$distar.172.b$. Phong tỏa mẫu vật vào phòng chân không."
 distar.3012.b.tooltip: "Bắn sinh vật dạng nấm này vào không gian sâu."
 distar.3013.name: "Nấm bất khả thi: Những từ đầu tiên"
 distar.3013.desc: "Loài nấm nhỏ gần đây đã bắt đầu biết nói!\n\nTừ đầu tiên nó thốt ra là một âm họng: 'Nivlac'. Mặc dù phát âm không mấy liền mạch, nhưng nó lại lặp đi lặp lại từ này một cách không biết mệt mỏi. Do đó, các nhà khoa học đã tự hào đặt tên cho sinh vật nấm này là §Y$NAME_Nivlac$§!. Sau đó, ngôn ngữ của nó phát triển thần tốc, hiện nay đã có thể diễn đạt thành công toàn bộ bảy loại cảm xúc cơ bản — và sự diễn đạt này đều do chính nó trải nghiệm những cảm xúc đó mà thành. Nó còn có thể tự sinh sản đúng hạn — bằng cách phát tán bào tử — theo tốc độ này, chẳng mấy chốc phòng thí nghiệm sẽ không còn chỗ chứa đám nấm này nữa.\n\nTính đến hiện tại, $NAME_Nivlac$ vẫn chưa biểu hiện bất kỳ sự thù địch hay xu hướng hung hãn nào."
 distar.3013.a.xenophile: "Tuyệt quá. Mỗi [Root.GetSpeciesName] nên có một con!"
 distar.3013.a: "Tốt lắm. Xã hội [Root.GetAdj] chắc chắn có thể tận dụng tốt nó."
 distar.3013.a.swarm: "Xã hội [Root.GetAdj] có thể sử dụng chúng... làm thức ăn chăn nuôi."
 distar.3013.a.serv: "Thật là một sinh vật hữu cơ quý giá. Các [Root.GetSpeciesNamePlural] chúng ta phải chăm sóc họ thật tốt mới được."
 distar.3013.a.assi: "Tốt lắm, vậy hãy để họ đồng hóa vào xã hội của chúng ta."
 distar.3013.a.assi.tooltip: "Trên [nivlac_joint_planet.GetName] sẽ tạo ra tối đa §Y500§!£pop£§H dân số $NAME_Nivlac$§!."
 distar.3013.a.tooltip: "Lấp đầy các nhà ở còn trống trên [nivlac_joint_planet.GetName] bằng £pop£§H dân số $NAME_Nivlac$§!."
 distar.3013.b: "Họ nên có quê hương của riêng mình."
 distar.3013.b.no_room.kill: "Chúng ta không còn đủ không gian nữa. Hãy thiêu rụi chúng đi, vậy là xong."
 distar.3013.b.no_room.kill.tooltip: "Tiêu diệt bầy sinh vật nấm này."
 distar.3013.b.tooltip: "Các nhà khoa học của chúng ta sẽ đưa đám $NAME_Nivlacs$ trong phòng thí nghiệm đến một hành tinh thích hợp dành riêng cho họ.\n\nDự kiến cần một thời gian mới có tiến triển mới."
 distar.3015.name: "Sinh vật bất khả thi: $NAME_Nivlac$"
 distar.3015.desc: "Sinh vật ngoại lai từng được phát hiện trên [impossible_organism_planet.GetName], và bị chúng ta bắn vào không gian sâu vì lý do quá nguy hiểm, dường như không lâu sau đó đã hạ cánh thành công xuống [nivlac_planet.GetName].\n\nNó không chỉ sống sót sau vụ va chạm, mà còn xây dựng quê hương mới trên hành tinh mới này. Nó sinh sôi nảy nở, tạo ra một lượng dân số đáng kể, và đã thành công gia nhập hàng ngũ các loài du hành vũ trụ.\n\nHọ tự gọi mình là $NAME_Nivlac$. Thật không may, họ dường như vẫn nhớ rõ việc chúng ta đã mặc kệ sống chết của họ."
 distar.3016.name: "$NAME_Nivlac$"
 distar.3016.desc: "Các nhà khoa học của chúng ta hân hạnh thông báo rằng, kế hoạch đưa $NAME_Nivlac$ đến hành tinh thích hợp đã thành công rực rỡ.\n\nKể từ khi sinh vật dạng nấm trẻ tuổi đặt chân lên [nivlac_planet.GetName], đà tăng trưởng bùng nổ cũng được tiếp diễn. Nó đã thành công tập hợp được một cộng đồng nhỏ, gần đây thậm chí còn nghiên cứu ra công nghệ siêu ánh sáng — không nghi ngờ gì nữa, đây là nhờ vào những công nghệ mà chúng ta để lại.\n\nChúng ta sẽ tiếp tục quan sát chặt chẽ sự phát triển của chúng."
 distar.3017.name: "[Root.Owner.GetSpeciesName] và $NAME_Nivlac$"
 distar.3017.desc: "Hành động tích hợp sinh vật nấm $NAME_Nivlac$ vào xã hội [Root.Owner.GetAdj] đang được tiến hành.\n\nMối quan hệ giữa $NAME_Nivlacs$ và [Root.Owner.GetSpeciesNamePlural] hiện đang rất hòa hợp, và loài của chúng ta có vẻ rất lạc quan về việc chung sống lâu dài với loài đối phương."
 distar.3017.desc.assim: "Tiến trình đồng hóa sinh vật nấm $NAME_Nivlac$ vào xã hội [Root.Owner.GetAdj] đang diễn ra sôi nổi.\n\nMặc dù $NAME_Nivlac$ không mấy sẵn lòng với quá trình này, nhưng ý thức của họ cuối cùng sẽ thăng hoa trở thành một phần của [Root.GetAdj]."
 distar.3017.a.tooltip: "£pop£§H dân số $NAME_Nivlac$§! đã được thêm vào [nivlac_joint_planet.GetName]."
 distar.3017.a.assi.tooltip: "£pop£§H dân số $NAME_Nivlac$§! đã được thêm vào [nivlac_joint_planet.GetName]."
 distar.3017.a.serv.tooltip: "£pop£§H dân số $NAME_Nivlac$§! đang tận hưởng sự phục vụ hết mình trong những nơi ở mới xây trên [nivlac_joint_planet.GetName]."
 ### Nhà Khoa Học Mắc Kẹt ###
 distar.3020.name: "Nhà Khoa Học Bị Mắc Kẹt"
 distar.3020.desc: "Đống đổ nát trên [From.GetName] thuộc về một nhà khoa học bị mắc kẹt - [stranded_scientist_leader.GetName] - tự xưng là thuộc về một giống loài mà chúng ta chưa từng biết đến, [stranded_scientist_species.GetName].\n\nBằng cách nào đó, cô ta đã liên lạc được với sĩ quan khoa học [Root.GetLeaderName] trên [Root.GetName] từ trong đống đổ nát và yêu cầu được giải cứu. Cô giải thích rằng cú rơi là do hỏng cảm biến định vị, và cho biết mình đã không thể rời khỏi tiểu hành tinh này trong vài năm rồi.\n\nCô ta khẳng định mình sở hữu kiến thức khoa học vượt xa người thường và là một tài sản vô cùng hữu ích. Cô nói rằng việc mình sống sót được ở đây lâu đến vậy chính là minh chứng cho năng lực của bản thân."
 distar.3020.a: "Có lẽ cô ấy sẽ gia nhập với chúng ta."
 distar.3020.a.tooltip: "§Y[stranded_scientist_leader.GetName]§!, một $scientist_with_icon$ cấp 6, gia nhập [Root.Owner.GetName] và sẽ chia sẻ những kiến thức công nghệ mà cô ấy nắm giữ."
 stranded_scientist_background: "§Y[Root.GetName]§! được phát hiện đang mắc kẹt tại §Y[Root.GetBackgroundPlanet]§! có môi trường [Root.GetHomeWorldBiome]"
 distar.3020.b: "Không. Kệ cô ta đi."
 distar.3020.b.tooltip: "Chúng ta mặc kệ cho [stranded_scientist_leader.GetName] tự sinh tự diệt."
 distar.3021.name: "Chia Sẻ Kiến Thức"
 distar.3021.desc: "Nhà khoa học mới gia nhập gần đây, [stranded_scientist_leader_clone.GetName], đang tận dụng hiệu quả kiến thức của mình. Những hiểu biết mà cô ấy chia sẻ đã đưa nghiên cứu vật lý của chúng ta lên một tầm cao mới."
 distar.3021.a.tooltip: "Nghiên cứu của chúng ta về §YCông nghệ§! £physics£ đã có bước tiến sâu hơn."
 ### Thợ Mỏ Nhuyễn Thể ###
 distar.3030.name: "Thợ Mỏ Nhuyễn Thể"
 distar.3030.desc: "Quan sát thêm [molluscoid_miners_planet.GetName], chúng ta phát hiện ra những cấu trúc giống ngôi nhà trên bề mặt là nơi ở của một loài nhuyễn thể. Những ngôi nhà này ở trạng thái rất sơ khai, được xây bằng đất sét trộn với chất tiết ra giống như phân.\n\nLoài nhuyễn thể này có mức độ nhận thức bán thông minh và trí tuệ hạn chế. Ngoài việc sinh tồn, xã hội và cuộc sống của chúng xoay quanh việc đào bới khoáng sản. Khoáng sản đào được sẽ đem trưng bày để nâng cao địa vị xã hội của kẻ đào được.\n\nTuy nhiên, cách chúng dò tìm khoáng sản vẫn chưa được làm rõ, sĩ quan khoa học [Root.GetLeaderName] đã vô cùng kinh ngạc trước khả năng đánh hơi ra lượng lớn quặng của chúng.\n\nMặc dù công nghệ và hầu hết mọi mặt khác của loài nhuyễn thể này đều tụt hậu so với chúng ta, nhưng chúng có thể giúp ích rất lớn cho khả năng khai khoáng của đế quốc."
 distar.3030.a: "Thú vị đấy. Hãy nghiên cứu sâu hơn về chúng."
 distar.3030.b: "Đến khai thác mỏ quặng của chúng."
 distar.3031.desc: "Sinh vật nhuyễn thể sống trên [molluscoid_miners_planet.GetName] sử dụng một phương pháp kỳ lạ để tìm kiếm khoáng sản.\n\nTheo quan sát, chúng có thể tiết ra một loại dịch từ da, ngấm vào đất và tiếp tục đào sâu xuống. Bằng cách nào đó, chất tiết này có khả năng cảm ứng; miễn là chuỗi liên kết không bị đứt, nó sẽ truyền thông tin về cho sinh vật. Bằng cách này, chúng có thể lập bản đồ cấu trúc ngầm quy mô cực lớn và phát hiện ra các mỏ quặng mà chất tiết chạm tới.\n\nNếu có thể hòa nhập giống loài này vào xã hội của chúng ta, hoặc đơn giản là ứng dụng kỹ thuật này để nâng cấp quy trình, các cơ sở sản xuất khoáng sản của chúng ta chắc chắn sẽ hưởng lợi lớn."
 distar.3031.a: "Đồng ý. Bắt đầu quá trình hòa nhập."
 distar.3031.a.evopre: "Mặc kệ khoáng sản đi, thu hoạch gen của chúng."
 distar.3031.b: "Được. Chúng ta sẽ tận dụng những kiến thức này."
 distar.3031.c: "Không. Cứ khai thác hành tinh của chúng."
 distar.3032.name: "Hòa Nhập Nhuyễn Thể"
 distar.3032.desc: "Giống loài nhuyễn thể đã hòa nhập thành công vào xã hội [Root.Owner.GetAdj].\n\nĐể thúc đẩy quá trình này, chúng ta đặt tên cho chúng là §Y[molluscoid_miners_species.GetName]§!. Loài [molluscoid_miners_species.GetName] có bản tính hiền lành, làm việc chăm chỉ, và hiện tại sản lượng khoáng sản của chúng ta đã được ghi nhận tăng lên đáng kể."
 distar.3032.a.tooltip: "Thêm §Y600§! £pop£ §H[molluscoid_miners_species.GetName]§! vào §Y[Root.Capital.GetName]§!."
 distar.3032.b: "Chúng... ở đâu đó quanh đây thôi."
 distar.3032.b.tooltip: "Do mật độ dân số trên [Root.Capital.GetName] rất cao, số lượng loài [molluscoid_miners_species.GetName] lại quá ít ỏi nên đáng tiếc là chúng hầu như không mang lại ảnh hưởng gì đến đời sống thường ngày."
 distar.3033.name: "Lập Bản Đồ Khoáng Sản"
 distar.3033.desc: "Một hệ thống có khả năng khảo sát nhanh chóng địa hình ngầm và dò tìm các mỏ quặng ẩn chứa bên trong đã được đưa vào sử dụng.\n\nBằng cách lợi dụng các tia bức xạ sao và tia vũ trụ không thể xuyên qua khoáng chất, chúng ta có thể thu thập dữ liệu về trữ lượng quặng bên trong các thiên thể. Việc này giống như chụp X-quang trực tiếp cho chúng vậy, dù là tiểu hành tinh hay một phần của hành tinh đều có thể được dò tìm chuẩn xác.\n\nCác nhà khoa học của chúng ta gọi đó là kỹ thuật lập bản đồ khoáng sản, nó sẽ cải thiện đáng kể hiệu suất khai thác của chúng ta."
 ### Cỗ Máy Ngoài Hành Tinh ###
 distar.3040.name: "Cỗ Máy Ngoài Hành Tinh"
 distar.3040.desc: "Quét sâu hơn cho thấy cỗ máy vẫn đang hoạt động, nhưng mục đích của nó thì vẫn là một bí ẩn.\n\nSĩ quan khoa học [Root.GetLeaderName] nói rằng chưa từng thấy thứ gì như thế này. Một vài vật liệu có vẻ quen thuộc, nhưng phần lớn đều là sản phẩm ngoài hành tinh chưa từng thấy, kể cả các linh kiện và cấu trúc của nó.\n\nCỗ máy có vẻ như có một bảng điều khiển, trên đó có một vật thể rất bắt mắt: một cần gạt lớn, cong, làm từ vật liệu không xác định."
 distar.3040.a: "Kéo cần gạt."
 distar.3040.a.tooltip: "Sĩ quan khoa học [Root.GetLeaderName] kéo cái cần gạt kỳ lạ xuống."
 distar.3040.b: "Tháo tung nó ra."
 distar.3040.b.tooltip: "Cỗ máy đã bị tháo dỡ, các linh kiện đã được thu hồi."
 distar.3041.name: "Cỗ Máy Ngoài Hành Tinh"
 distar.3041.desc: "Chuyện gì đã xảy ra sau khi kéo cần gạt vẫn chưa rõ ràng.\n\nBảng điều khiển đó chớp nháy liên tục và rung bần bật. Một làn sóng năng lượng khổng lồ bắn vọt lên không trung, hướng vào không gian sâu thẳm. Các nhà khoa học gần đó đều cảm thấy một luồng năng lượng tạt qua, nhưng không có bằng chứng vật lý trực tiếp nào.\n\nSĩ quan khoa học [Root.GetLeaderName] không hiểu chuyện gì vừa xảy ra. Cỗ máy ngoài hành tinh ngay lập tức chìm vào im lặng, không còn bất kỳ phản ứng năng lượng nào nữa."
 distar.3041.a: "Thật kỳ lạ. Tháo nó ra xem sao."
 distar.3041.b: "Thú vị đấy. Nhanh chóng nghiên cứu cỗ máy này."
 distar.3041.b.tooltip: "Thêm hiệu ứng §YCỗ Máy Ngoài Hành Tinh§! cho [asteroid_target.GetName]:\n£physics£ §G+7§!"
 distar.3042.name: "Xung Năng Lượng"
 distar.3042.desc: "Sau khi các nhà khoa học của chúng ta kéo cần gạt, cỗ máy phóng ra một chấn xung năng lượng khổng lồ, tạo ra sự biến dạng và gợn sóng trong khoảng không, xé toạc một lỗ sâu trong §Y[system_one.GetName]§!.\n\nSau khi năng lượng dư thừa tan biến, lỗ sâu và khu vực lân cận dần ổn định lại, hiện tại có vẻ đã đủ an toàn để đi qua. Về phần cái gì đang chờ đón ở phía bên kia, các nhà khoa học của chúng ta không dám chắc.\n\nBản thân cỗ máy đã chìm lại vào im lặng, không còn phát ra bất kỳ chỉ số bất thường nào."
 ### Quái Xế Quỹ Đạo ###
 distar.3050.name: "Quái Xế Quỹ Đạo"
 distar.3050.desc: "Nỗ lực quét vật thể bay tốc độ cao trên quỹ đạo tầm cao của [From.GetName] đã thất bại. Vật thể nhanh chóng biến mất khỏi tầm nhìn, và các thiết bị trên tàu khoa học hoàn toàn không thể theo kịp tốc độ của nó.\n\nMặc dù lực hấp dẫn của [From.GetName] rất lớn, nhưng vật thể này vẫn di chuyển với tốc độ khó tin. Hoặc bản thân nó sở hữu thuộc tính phi thường nào đó, hoặc đây là một kỳ tích được tạo ra bởi hiện tượng dị thường của lực hấp dẫn.\n\nTốc độ của vật thể dường như đang tăng dần. Sĩ quan khoa học [Root.GetLeaderName] cho rằng kể cả không có sự can thiệp từ bên ngoài, nó rất có thể sắp bị văng khỏi quỹ đạo."
 distar.3050.a: "Tìm cách làm nó chậm lại."
 distar.3050.a.tooltip: "Triển khai thiết bị bay không người lái để kéo nó lại, nhằm làm giảm quán tính."
 distar.3050.b: "Tìm cách chặn nó lại."
 distar.3050.b.tooltip: "Vứt rác không gian ra cản đường nhằm làm chệch quỹ đạo của nó."
 distar.3050.c: "Tránh xa thứ này ra."
 distar.3050.c.tooltip: "Rời khỏi khu vực nguy hiểm, để vật thể này tự sinh tự diệt."
 distar.3051.name: "Đánh Chặn Thành Công Vật Thể Siêu Tốc"
 distar.3051.desc: "Thiết bị bay đã thành công ngăn chặn chuyến bay quanh quỹ đạo của vật thể không xác định.\n\nNó thả dây kéo vật thể, giảm tốc độ dần dần, và cuối cùng hướng nó về phía [Root.GetName] để tiến hành thu hồi.\n\nVật thể này trông giống một chiếc hộp, làm từ chất liệu ngoài hành tinh, bên ngoài có những gờ nổi như mạch máu chạy thẳng tới một cơ cấu hình cầu ở trên đỉnh. Về phần bên trong chứa thứ gì thì hiện tại vẫn chưa rõ."
 distar.3051.desc.1: "Rác không gian được ném ra đã va chạm thành công với vật thể không xác định, làm giảm tốc độ bay và khiến nó rơi khỏi quỹ đạo. [Root.GetName] đã thu hồi thành công nó ngay sau đó.\n\nVật thể này trông giống một chiếc hộp, làm từ chất liệu ngoài hành tinh, bên ngoài có những gờ nổi như mạch máu chạy thẳng tới một cơ cấu hình cầu ở trên đỉnh. Về phần bên trong chứa thứ gì thì hiện tại vẫn chưa rõ."
 distar.3051.a: "Mở nó ra."
 distar.3051.b: "Nghiên cứu nó."
 distar.3051.c: "Vứt nó đi."
 distar.3051.c.tooltip: "Bắn chiếc hộp ngoài hành tinh này vào không gian sâu thẳm."
 distar.3052.name: "Thất Lạc Vật Thể Siêu Tốc"
 #distar.3052.desc: "Thiết bị bay đã bám thành công vào vật thể không xác định, nhưng khối lượng tăng thêm và sự thay đổi quỹ đạo đã nhanh chóng kéo cả hai văng khỏi quỹ đạo, lăn lông lốc vào không gian sâu thẳm với tốc độ cao."
 #distar.3052.desc.1: "Mảnh vỡ được đẩy ra đã va chạm thành công với vật thể lạ. Thật không may, thay vì giảm tốc độ, mảnh vỡ lại hất văng nó khỏi quỹ đạo, khiến nó lăn vào không gian sâu thẳm với tốc độ cao."
 distar.3055.name: "Chiếc Hộp Ngoài Hành Tinh Đã Mở"
 distar.3055.desc: "Sau một thời gian dài nỗ lực, các nhà khoa học của chúng ta cuối cùng đã xuyên thủng lớp vật liệu bên ngoài của chiếc hộp.\n\nBên trong hộp chứa ba vật chứa nhỏ, mỗi vật chứa một loại chất lỏng khác nhau - một màu §Rđỏ§!, một màu §Bxanh dương§!, và một màu §Gxanh lá cây§!. Những chất lỏng này phổ biến hơn so với vật chứa bên ngoài, các nhà khoa học đã xác định chúng là môi trường chỉnh sửa gen.\n\nVì một lý do không rõ nào đó, dung dịch bắt đầu phân hủy nhanh chóng sau khi được lấy ra khỏi vật chứa ngoài hành tinh, nhưng chúng ta vẫn có đủ thời gian để bắt đầu tổng hợp nhân tạo một trong số chúng và áp dụng cho giống loài của mình. Hiện tại có thể khẳng định tác dụng của chúng chắc chắn là có lợi, nhưng cụ thể có lợi ra sao thì chưa rõ."
 distar.3055.desc.1: "Sau một thời gian dài nỗ lực, các nhà khoa học của chúng ta cuối cùng đã xuyên thủng lớp vật liệu bên ngoài của chiếc hộp.\n\nBa vật chứa nhỏ bên trong hộp quả thực chứa những chất lỏng khác nhau - một màu §Rđỏ§!, một màu §Bxanh dương§!, và một màu §Gxanh lá cây§!. Những chất lỏng này phổ biến hơn so với vật chứa bên ngoài, các nhà khoa học đã xác định chúng là môi trường chỉnh sửa gen.\n\nVì một lý do không rõ nào đó, dung dịch bắt đầu phân hủy nhanh chóng sau khi được lấy ra khỏi vật chứa ngoài hành tinh, nhưng chúng ta vẫn có đủ thời gian để bắt đầu tổng hợp nhân tạo một trong số chúng và áp dụng cho giống loài của mình. Hiện tại có thể khẳng định tác dụng của chúng chắc chắn là có lợi, nhưng cụ thể có lợi ra sao thì chưa rõ."
 distar.3055.a: "Sử dụng dung dịch màu §Rđỏ§!."
 distar.3055.a.tooltip: "Sử dụng dung dịch màu đỏ để biến đổi giống loài [Root.Owner.GetSpeciesName]."
 distar.3055.b: "Sử dụng dung dịch màu §Gxanh lá cây§!."
 distar.3055.b.tooltip: "Sử dụng dung dịch màu xanh lá cây để biến đổi giống loài [Root.Owner.GetSpeciesName]."
 distar.3055.c: "Sử dụng dung dịch màu §Bxanh dương§!."
 distar.3055.c.tooltip: "Sử dụng dung dịch màu xanh dương để biến đổi giống loài [Root.Owner.GetSpeciesName]."
 distar.3055.d.evopred: "Đừng có do dự nữa, uống cạn hết đi!"
 distar.3055.d.evopred.tooltip: "§YMột trong hai kết quả sẽ xảy ra:§!\n§Y50%§! cơ hội nhận được bùa lợi của toàn bộ dung dịch.\n§Y50%§! cơ hội không có gì xảy ra."
 distar.3055.d: "Bán hết đi."
 distar.3055.d.tooltip: "Bán các vật chứa này cho người trả giá cao nhất."
 distar.3056.name: "Thành Phần Hộp Ngoài Hành Tinh"
 distar.3056.desc: "Các [Root.GetScientistPlural] của chúng ta cuối cùng đã điều tra được tình hình bên trong mà không làm hỏng chiếc hộp. Thông qua hệ thống sóng âm tối tân, họ đã xác nhận thành công nội dung bên trong chiếc hộp.\n\nNhững vật phẩm bên trong khá khó hiểu, hay có thể nói là ngoài sức tưởng tượng. Trong đó có ba vật chứa nhỏ, mỗi vật chứa một loại chất lỏng không xác định.\n\nChiếc hộp này có thể mở ra một cách an toàn, nhưng để tìm ra cách mở thì cần phải nghiên cứu thêm."
 distar.3056.a: "Mở nó ra."
 distar.3056.a.tooltip: "Nghiên cứu về chiếc hộp đã đẩy nhanh quá trình tìm hiểu của chúng ta về kiến thức §YVật lý§! £physics£."
 #Ký tự xuống dòng "\n" ở trên là có chủ đích, để đặt chữ "Vật lý" và ký hiệu trên cùng một dòng
 distar.3056.b: "Bán nó đi."
 distar.3056.b.tooltip: "Bán chiếc hộp cho người trả giá cao nhất."
 distar.3056.c: "Dùng tia bức xạ để dò tìm."
 distar.3056.c.tooltip: "Thông qua phân tích kích hoạt neutron, chúng ta có thể hiểu rõ hơn về thành phần và vật liệu làm ra chiếc hộp."
 distar.3057.name: "Hoàn Tất Chỉnh Sửa Gen"
 distar.3057.desc.all: "Chúng ta từ lâu đã tinh thông khả năng tổng hợp và phát triển các nhiễm sắc thể độc đáo, kết quả không có gì đáng ngạc nhiên. Chúng ta đã thành công tiêm cả ba loại dung dịch màu §Rđỏ§!, màu §Gxanh lá cây§! và màu §Bxanh dương§! cho giống loài [root.GetSpeciesName].\n\nGiống loài của chúng ta giờ đây hòa đồng, dễ thích nghi và sống thọ hơn."
 distar.3057.desc.stronger: "Dung dịch chỉnh sửa gen màu §Rđỏ§! đã được tiêm thành công vào người dân [Root.GetSpeciesName].\n\nDựa trên những quan sát ban đầu ở các đối tượng thử nghiệm đầu tiên, dung dịch này dường như khiến chúng ta trở nên hòa đồng hơn."
 distar.3057.desc.adaptive: "Dung dịch màu §Gxanh lá cây§! đã được dùng thành công để biến đổi người dân [Root.Owner.GetSpeciesName].\n\nDựa trên quan sát đợt thử nghiệm đầu tiên, dung dịch này có vẻ giúp tăng cường khả năng thích nghi với môi trường của chúng ta."
 distar.3057.desc.longlived: "Dung dịch màu §Bxanh dương§! đã được dùng thành công để biến đổi người dân [Root.Owner.GetSpeciesName].\n\nDựa trên quan sát đợt thử nghiệm đầu tiên, dung dịch này có vẻ giúp kéo dài tuổi thọ của chúng ta."
 distar.3057.desc: "Mặc dù kết quả ban đầu rất khả quan, nhưng quá trình chỉnh sửa gen cuối cùng đã thất bại, bởi vì dung dịch này không tương thích với bộ gen phổ biến của [Root.GetSpeciesAdj]."
 ### Khe Nứt Hít Thở ###
 distar.3060.name: "Khe Nứt Hít Thở"
 distar.3060.desc: "Theo quan sát hiện tại, hiện tượng dị thường được phát hiện trên [breathing_rift_object.GetName] có vẻ là một khe nứt không gian cực kỳ hiếm gặp. Rất có thể khối lượng khổng lồ của [breathing_rift_object.GetName] đã góp phần tạo ra nó, nhưng chúng ta vẫn chưa thể hiểu được bản chất của nó.\n\nKhe nứt không chỉ khúc xạ và cản trở ánh sáng, mà dường như còn hút ánh sáng vào rồi nhả ra, lặp đi lặp lại như vậy - giống hệt như đang hít thở.\n\nHiện tại, lực hấp dẫn lớn của khe nứt rất có thể đã kéo theo những thứ khác vào trong. Chúng ta nên hành động cẩn trọng."
 distar.3060.a: "Trước khi có phát hiện gì thêm, nhất định phải quan sát chặt chẽ."
 distar.3060.a.tooltip: "Phái tàu thăm dò quan sát để giám sát chặt chẽ."
 distar.3060.b: "Chúng ta có thể nghiên cứu nó từ khoảng cách an toàn."
 distar.3060.c: "[Root.GetName] đã rơi vào vòng nguy hiểm. Nhanh chóng rời đi."
 distar.3061.name: "Khe Nứt Hít Thở - Khoáng Sản"
 distar.3061.desc: "Đã nhiều tháng trôi qua kể từ khi phát hiện ra khe nứt gần [breathing_rift_object.GetName], nhưng không có sự cố nào xảy ra. Tuy nhiên, chúng ta vừa nhận được báo cáo về một lượng lớn đá giàu khoáng sản đang tuôn ra từ đó.\n\nChỉ chờ chúng ta đến thu thập.\n\nChúng ta sẽ tiếp tục quan sát khe nứt."
 distar.3061.desc.repeat: "[breathing_rift_object.GetName] lại phun ra một lượng lớn vật phẩm. Lần này là tàn tích của các tiểu hành tinh, phần lớn vẫn còn rất nhiều khoáng sản.\n\nChỉ chờ chúng ta đến thu thập.\n\nChúng ta sẽ tiếp tục quan sát khe nứt."
 distar.3061.a: "Tuyệt vời, tiến hành thu thập ngay lập tức."
 distar.3062.name: "Khe Nứt Hít Thở - Mảnh Vỡ"
 distar.3062.desc: "Đã nhiều tháng trôi qua kể từ khi phát hiện ra khe nứt gần [breathing_rift_object.GetName], nhưng không có sự cố nào xảy ra. Tuy nhiên, chúng ta vừa nhận được báo cáo về một lượng lớn các mảnh vỡ phế liệu đang tuôn ra từ đó.\n\nChỉ chờ chúng ta đến thu thập.\n\nChúng ta sẽ tiếp tục quan sát khe nứt."
 distar.3062.desc.repeat: "[breathing_rift_object.GetName] lại phun ra một lượng lớn vật phẩm. Lần này là những mảnh vỡ trôi dạt vào hệ sao, có lẽ là tàn tích từ một trận chiến cổ đại nào đó.\n\nChỉ chờ chúng ta đến thu thập.\n\nChúng ta sẽ tiếp tục quan sát khe nứt."
 distar.3062.a: "Tuyệt vời, tiến hành thu thập ngay lập tức."
 #distar.3063.name: "Khe Nứt Hít Thở - Sinh Vật Lạ"
 #distar.3063.desc: "Máy quét gần đây đã ghi nhận một đợt tăng vọt mức năng lượng đáng kể từ khe nứt gần [breathing_rift_object.GetName].\n\nChuyện xảy ra ngay sau đó đã khiến các nhà khoa học của chúng ta rơi vào hoảng loạn. Một sinh vật khổng lồ, vô danh đã thoát khỏi khe nứt và trôi dạt vào hệ sao.\n\nCho dù có làm gì thì chúng ta cũng nên cực kỳ cẩn trọng."
 distar.3064.name: "Khe Nứt Hít Thở - Đóng Cửa"
 distar.3064.desc: "Dữ liệu mới nhất từ tàu thăm dò quan sát khe nứt cho thấy nó đã biến mất. Sau khi hít vào hơi thở cuối cùng, khe nứt tự đóng lại, không để lại bất kỳ dấu vết năng lượng nào chứng tỏ nó từng tồn tại."
 distar.3064.a: "Thật đáng tiếc."
 distar.3064.a.tooltip: "Tuy nhiên, dữ liệu thu thập được đã thúc đẩy tiến độ nghiên cứu của chúng ta về kiến thức §YVật lý§! £physics£."
 ####################################
 #Dự Án Đặc Biệt
 ####################################
 ### Tiểu Hành Tinh Trojan ###
 trojan_asteroid_project: "Tiểu Hành Tinh Trojan"
 trojan_asteroid_project_DESC: "Sau khi các thiết bị bay bị tiêu diệt, chúng ta có thể tiến hành điều tra sâu hơn vào bên trong tiểu hành tinh."
 ### Sinh Vật Bất Khả Thi ###
 impossible_organism_project_1: "Sinh Vật Bất Khả Thi"
 impossible_organism_project_1_DESC: "[impossible_organism_science_ship.GetName] đã lấy mẫu thành công từ một sinh vật sống cực kỳ dai dẳng trên bề mặt đầy độc tố của [impossible_organism_planet.GetName].\n\nCác nhà sinh vật học của chúng ta muốn tiến hành nghiên cứu chi tiết hơn về nó."
 impossible_organism_project_2: "Sinh Vật Bất Khả Thi: Tiếp Tục"
 impossible_organism_project_2_DESC: "Sinh mệnh thể được tìm thấy trên [impossible_organism_planet.GetName] đã thể hiện khả năng sinh trưởng tuyệt vời trong môi trường khắc nghiệt.\n\nCó vẻ như muốn giải mã những bí ẩn giấu trong hệ thống gen, tế bào và sinh hóa của nó thì bắt buộc phải nghiên cứu thêm."
 ### Thợ Mỏ Nhuyễn Thể ###
 molluscoid_miners_project_1: "Thợ Mỏ Nhuyễn Thể"
 molluscoid_miners_project_1_DESC: "Tiến hành nghiên cứu loài nhuyễn thể này, cố gắng tìm hiểu xem làm thế nào chúng có thể phát hiện ra mạch khoáng sản một cách dễ dàng đến vậy."
 molluscoid_miners_project_2: "Hòa Nhập Nhuyễn Thể"
 molluscoid_miners_project_2_DESC: "Lập tức bắt tay vào việc hòa nhập những thợ mỏ nhuyễn thể này vào xã hội [Root.Owner.GetAdj]."
 molluscoid_miners_project_3: "Sản Xuất Khoáng Sản"
 molluscoid_miners_project_3_DESC: "Bắt đầu nghiên cứu và ứng dụng hệ thống có khả năng khảo sát địa hình ngầm và lập bản đồ tốc độ cao, nhằm nâng cao hiệu suất sản xuất khoáng sản."
 ### Quái Xế Quỹ Đạo ###
 speed_demon_open_box_project: "Cạy Mở Hộp Ngoài Hành Tinh"
 speed_demon_open_box_project_DESC: "Bắt tay vào việc cạy mở chiếc hộp ngoài hành tinh được tìm thấy trên quỹ đạo của [speed_demon_orbit_body.GetName]."
 speed_demon_learn_more_project: "Nghiên Cứu Hộp Ngoài Hành Tinh"
 speed_demon_learn_more_project_DESC: "Nghiên cứu chiếc hộp ngoài hành tinh được tìm thấy trên quỹ đạo của [speed_demon_orbit_body.GetName] để tìm ra những thứ chứa bên trong."
 ### Khe Nứt Hít Thở ###
 breathing_rift_project: "Hít Vào, Thở Ra"
 breathing_rift_project_DESC: "Quan sát khe nứt không gian được tìm thấy gần [breathing_rift_object.GetName], chờ xem có thứ gì chui ra từ đó không."
 story.101.aa: "$story.201.aa$"
 story.101.bb: "$story.201.bb$"
 story.101.bb.exter: "Việc nghiên cứu có thể sẽ đẩy nhanh các chiến dịch tiêu diệt trong tương lai."
 story.101.cc: "$story.201.cc$"
 story.101.aa.amoebahunt: "Mỗi khi tiêu diệt một hạm đội Amip Không Gian sẽ nhận được §G+1000§! £energy£"
 story.105.bb: "Những chiếc roi này thật kỳ diệu."
 story.105.aa: "Lấy lại một vài mẫu mô."
 story.107.name: "Đã Thần Phục Amip"
 story.107.desc: "Khi ở gần các bầy Amip Không Gian, việc ngừng xả một số bức xạ nhất định từ lõi phản ứng của hạm đội dường như có thể tránh làm chúng nổi giận.\n\nNhờ vào hành động này, chúng không còn coi chúng ta là mối đe dọa nữa, và chúng ta cũng nhờ đó mà có thể quan sát chúng ở khoảng cách gần."
 story.107.a: "Tuyệt vời."
 story.107.a.tooltip: "Thêm hiệu ứng §Y$pacified_amoebas$§!. Có tác dụng sau:\n§HAmip Không Gian§! giờ đây chuyển sang trạng thái §GKhông thù địch§!"
 pacified_amoeba_tt: "§HAmip Không Gian§! giờ đây chuyển sang trạng thái §GKhông thù địch§!"
 story.201.aa: "Chỉ là con mồi thôi."
 story.201.aa.crystalhunt: "Mỗi khi tiêu diệt một hạm đội Thực Thể Pha Lê sẽ nhận được §G+500§! £minerals£"
 story.201.bb: "Thật là những sinh vật kỳ diệu."
 story.201.cc: "Chúng ta có thể học cách chung sống."
 story.207.name: "Đã Thần Phục Pha Lê"
 story.207.desc: "Thực Thể Pha Lê dường như cộng hưởng với một số tần số nhất định, đây cũng là một trong số ít những tương tác giữa chúng và môi trường xung quanh. Bản chất và mục đích của việc phát ra sóng vô tuyến hiện chưa rõ ràng, nhưng hiện tại hạm đội của chúng ta có thể sử dụng sóng vô tuyến để bắt chước và ngụy trang thành Thực Thể Pha Lê."
 story.207.a: "Đó là sự cộng hưởng."
 story.207.a.tooltip: "Thêm hiệu ứng §Y$pacified_crystals$§!. Có tác dụng sau:\n§HThực Thể Pha Lê§! giờ đây chuyển sang trạng thái §GKhông thù địch§!"
 #phá hủy trạm pha lê
 story.222.name: "Đập Vỡ Pha Lê"
 story.222.desc: "Chúng ta đã thành công tiêu diệt cấu trúc pha lê tại [FromFrom.solar_system.GetName]. Quá trình khó khăn hơn tưởng tượng, và chúng ta đã thu hồi được một vài mảnh vỡ để phục vụ nghiên cứu. Như vậy, chúng ta hẳn là đã có thể bắt chước đặc tính tái tạo được thể hiện bởi ma trận pha lê đã chạm trán trong trận chiến."
 story.305.aa: "$story.201.aa$"
 story.305.bb: "Thiết bị tự động thật kỳ diệu."
 #phá hủy trạm drone
 story.332.name: "$story.333.name$"
 story.332.desc: "Chúng ta đã phá hủy căn cứ Drone Khai Khoáng, và thu hồi thành công phần lớn khoáng sản đã qua tinh chế cùng các hợp kim quý giá được lưu trữ trong đó."
 story.332.a: "Của cải không thể đong đếm."
 story.332.b: "…vẫn còn một thiết bị kỳ lạ"
 CRYSTALS_PROJECT: "Nghiên Cứu Pha Lê"
 CRYSTALS_PROJECT_DESC: "$CRYSTALS_1_PROJECT_DESC$"
 CRYSTALS_PACIFICATION_PROJECT: "Thần Phục Thực Thể Pha Lê"
 CRYSTALS_PACIFICATION_PROJECT_DESC: "Các Thực Thể Pha Lê được quan sát thấy trong một số hệ sao đang ở trạng thái không ổn định, có thể sẽ gây ra nguy hiểm."
 DRONES_PROJECT: "Nghiên Cứu Drone"
 DRONES_PROJECT_DESC: "$DRONES_1_PROJECT_DESC$"
 AMOEBAS_PROJECT: "Nghiên Cứu Amip Không Gian"
 AMOEBAS_PROJECT_DESC: "$AMOEBAS_1_PROJECT_DESC$"
 AMOEBAS_PACIFICATION_PROJECT: "Thần Phục Amip"
 AMOEBAS_PACIFICATION_PROJECT_DESC: "Không rõ vì lý do gì, hạm đội của chúng ta dường như sẽ chọc giận Amip Không Gian. Nếu có thể xác định được nguyên nhân, có lẽ sẽ làm giảm đi tính hung hăng của Amip, thậm chí là hoàn toàn che giấu hạm đội của chúng ta khỏi các giác quan của chúng."
 CLOUDS_PROJECT: "Nghiên Cứu Đám Mây"
 CLOUDS_PROJECT_DESC: "$CLOUDS_1_PROJECT_DESC$"
 crystal_hunting_buff: "Thợ Săn Pha Lê"
 crystal_hunting_buff_desc: "Sau trận chiến, chúng ta sẽ tự động thu hồi mảnh vỡ của Thực Thể Pha Lê, mỗi khi đánh bại một hạm đội sẽ nhận được £minerals£ §G500§!."
 crystal_focus: "Tập Trung Pha Lê"
 crystal_focus_desc: "Phương tiện truyền dẫn cao cấp được phát triển dựa trên cấu trúc độc đáo bên trong Thực Thể Pha Lê có thể giảm thiểu hao tổn điện trở trong quá trình sản xuất và phân phối năng lượng."
 pacified_crystals: "Thần Phục Thực Thể Pha Lê"
 pacified_crystals_desc: "Bằng cách sử dụng sóng ngắn phát thanh ở tần số đặc biệt, chúng ta có thể ngụy trang hạm đội thành Thực Thể Pha Lê, do đó loài sinh vật vũ trụ này sẽ không còn coi chúng ta là mối đe dọa nữa."
 amoeba_hunting_buff: "Thợ Săn Amip"
 amoeba_hunting_buff_desc: "Sau trận chiến, chúng ta đã thu thập xác của Amip, và thu hoạch được các hợp chất hữu cơ có giá trị đáng kể từ các cơ quan nội tạng của chúng, mỗi khi đánh bại một hạm đội sẽ nhận được £energy£ §G1000§!."
 pacified_amoebas: "Thần Phục Amip"
 pacified_amoebas_desc: "Hạm đội sẽ kiểm soát chặt chẽ lượng bức xạ phát ra khi tiếp cận Amip Không Gian, do đó loài amip này sẽ không còn coi chúng ta là mối đe dọa nữa."
 drone_hunting_buff: "Sát Thủ Drone"
 drone_hunting_buff_desc: "Rõ ràng những Drone Khai Khoáng này là sản phẩm sản xuất hàng loạt. Chỉ cần tìm ra điểm yếu của một chiếc, thì cũng coi như là đã giải mã được toàn bộ."
 drone_mining_techniques: "Kỹ Thuật Khai Khoáng Bằng Drone"
 drone_mining_techniques_desc: "Thông qua việc sử dụng công nghệ thu được từ Drone Khai Khoáng, cuối cùng chúng ta đã có thể khai thác hiệu quả những mạch khoáng sản mà trước đây vốn bị coi là không bõ công khai thác."
 cloud_hunting_buff: "Kẻ Hủy Diệt Đám Mây"
 cloud_hunting_buff_desc: "Điện tích của Đám Mây Hư Không sẽ dao động theo các chu kỳ tốc độ cao có thể nhìn thấy được. Nếu có thể tiến hành ném bom tốc độ cao với thời gian chuẩn xác, sẽ tạo ra năng lượng cực kỳ bất ổn trong cấu trúc của nó, khiến các cá thể bên trong bị kích hoạt."
 void_loops: "Vòng Lặp Hư Không"
 void_loops_desc: "Những thuộc tính dị thường của Đám Mây Hư Không đã mở ra một cánh cửa mới cho việc nghiên cứu vật lý."
 sr_yurantic: "$sr_yuranic$"
 sr_yurantic_desc: "$sr_yuranic_desc$"
