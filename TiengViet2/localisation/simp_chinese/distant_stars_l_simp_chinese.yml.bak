l_simp_chinese:
 DISTANT_STARS_TITLE: "Distant Stars Story Pack" #Do not translate
 DLC_DISTANT_STARS_RECOMMENDATION_DESC: "§SGói Cốt truyện Distant Stars§! mang đến những câu chuyện về các cuộc chạm trán kỳ lạ hơn trong thiên hà cùng những sinh vật ẩn nấp sâu trong cõi hư không"
 DLC_DISTANT_STARS_RECOMMENDATION_SCIENCE_REC: "Chúng tôi khuyến nghị §SDistant Stars§! vì bạn đã chọn các thiết lập phù hợp với cơ chế và nội dung cốt lõi của DLC này: khám phá không gian và những phát hiện khoa học."
 AIANOM_LUMP_CAT: "Mảnh vỡ quỹ đạo"
 AIANOM_LUMP_CAT_desc: "Cảm biến báo cáo có một vật thể tiềm năng giá trị trên quỹ đạo của [Root.GetName]."
 AIANOM_MININGDEPO_CAT: "Tín hiệu bề mặt"
 AIANOM_MININGDEPO_CAT_desc: "Cảm biến báo cáo có một phát hiện tiềm năng giá trị trên bề mặt của [Root.GetName]."
 AIANOM_RESEARCHDEPO_CAT: "$AIANOM_MININGDEPO_CAT$"
 AIANOM_RESEARCHDEPO_CAT_desc: "$AIANOM_MININGDEPO_CAT_desc$"
 AIANOM_CLUE_CAT: "$clue$"
 AIANOM_CLUE_CAT_desc: "$l_cluster_chain_desc$"
 aianom.minerallump.name: "Trữ lượng khoáng sản"
 aianom.minerallump.desc: "Một lượng lớn Khoáng sản đã được tìm thấy trên [Root.GetName]."
 aianom.energylump.name: "Năng lượng"
 aianom.energylump.desc: "Một kho Năng lượng đã được tìm thấy trên [Root.GetName]."
 aianom.physicslump.name: "Nghiên cứu Vật lý"
 aianom.physicslump.desc: "Một kho dữ liệu Nghiên cứu Vật lý đã được tìm thấy trên [Root.GetName]."
 aianom.societylump.name: "Nghiên cứu Xã hội"
 aianom.societylump.desc: "Một kho dữ liệu Nghiên cứu Xã hội đã được tìm thấy trên [Root.GetName]."
 aianom.engineeringlump.name: "Nghiên cứu Kỹ thuật"
 aianom.engineeringlump.desc: "Một kho dữ liệu Nghiên cứu Kỹ thuật đã được tìm thấy trên [Root.GetName]."
 aianom.mineraldepo.name: "Mỏ khoáng sản"
 aianom.mineraldepo.desc: "[Root.GetName] đã phát hiện ra một mỏ Khoáng sản mới trên [From.GetName]."
 aianom.energydepo.name: "Trữ lượng Năng lượng"
 aianom.energydepo.desc: "[Root.GetName] báo cáo đã phát hiện ra các tinh thể khổng lồ mang điện tích tự nhiên trên [From.GetName]."
 aianom.physicsdepo.name: "Nguồn Nghiên cứu Vật lý"
 aianom.physicsdepo.desc: "[Root.GetName] đã phát hiện ra một nguồn Nghiên cứu Vật lý trên [From.GetName]."
 aianom.societydepo.name: "Nguồn Nghiên cứu Xã hội"
 aianom.societydepo.desc: "[Root.GetName] đã phát hiện ra một nguồn Nghiên cứu Xã hội trên [From.GetName]."
 aianom.engineeringdepo.name: "Nguồn Nghiên cứu Kỹ thuật"
 aianom.engineeringdepo.desc: "[Root.GetName] đã phát hiện ra một nguồn Nghiên cứu Kỹ thuật trên [From.GetName]."
 pc_time_loop_world_desc: "Toàn bộ hành tinh bị phong tỏa bởi một rào chắn năng lượng không thể xuyên thủng."
 ####################################
 #Anomaly Categories
 ####################################
 #FROM = planet scope
 #ROOT = ship scope
 DISTAR_WRECK_CAT: "Xác tàu tiếp tế"
 DISTAR_WRECK_CAT_DESC: "Cảm biến đã phát hiện tàn tích của một cấu trúc thân tàu không xác định nguồn gốc trên quỹ đạo của [Root.GetName]."
 DISTAR_FLARE_CAT: "Dấu tích văn minh"
 DISTAR_FLARE_CAT_DESC: "Bất chấp việc thiếu khí quyển trên [From.GetName], tàn tích của các cơ sở nhân tạo trên bề mặt cho thấy nơi đây từng có một nền văn minh."
 DISTAR_RAINBOW_CAT: "Cầu vồng trong đêm"
 DISTAR_RAINBOW_CAT_DESC: "Đĩa bồi tụ bao quanh [From.GetName] đang thể hiện một quang phổ khúc xạ tuyệt đẹp, tương tự như cầu vồng. Điều gì có thể gây ra hiện tượng này?"
 DISTAR_HOLO_CAT: "Tín hiệu hạm đội"
 DISTAR_HOLO_CAT_DESC: "Chúng ta đã phát hiện một hạm đội không xác định trên quỹ đạo của [From.GetName]. Chúng ta đã liên lạc nhưng không nhận được phản hồi."
 DISTAR_ROBO_CAT: "Cấu trúc đối xứng"
 DISTAR_ROBO_CAT_DESC: "Các tàu thăm dò đã phát hiện sự đối xứng cao bất thường trên bề mặt của [From.GetName]."
 DISTAR_NANO_CAT: "Bầy đàn xám"
 DISTAR_NANO_CAT_DESC: "Bề mặt của hành tinh [From.GetName] bị bao phủ bởi một vật chất xám với các đặc tính rất kỳ lạ và thành phần kim loại phức tạp, biến đổi."
 DISTAR_FLOW_CAT: "Tín hiệu bất thường"
 DISTAR_FLOW_CAT_DESC: "Có những tín hiệu trọng lực cực kỳ bất thường xung quanh [From.GetName]."
 DISTAR_LOST_CAT: "Chuyển động trong mây"
 DISTAR_LOST_CAT_DESC: "Đã phát hiện vật thể chuyển động ở tầng thượng khí quyển của [From.GetName], trông giống như một con tàu đang di chuyển với tốc độ cao qua các đám mây."
 DISTAR_TIME_CAT: "Mảnh vỡ tàu vũ trụ"
 DISTAR_TIME_CAT_DESC: "Đã phát hiện các mảnh vỡ từ thân một con tàu không xác định trên quỹ đạo tầm thấp của [From.GetName]."
 DISTAR_CLONE_CAT: "Các kén đáng ngờ"
 DISTAR_CLONE_CAT_DESC: "Hình ảnh ban đầu của Thế giới Vành đai hoang tàn [From.GetName] cho thấy một số lượng lớn các kén còn nguyên vẹn trên một số phân khu bị phá hủy. Chứa trong những cái kén này là gì thì vẫn chưa rõ."
 DISTAR_GEODE_CAT: "Lõi ẩn"
 DISTAR_GEODE_CAT_DESC: "Hình ảnh cộng hưởng của tiểu hành tinh [From.GetName] cho thấy bên trong nó chứa các tinh thể quý hiếm."
 DISTAR_DEAD_GOD_CAT: "Sinh vật khổng lồ câm lặng"
 DISTAR_DEAD_GOD_CAT_DESC: "[From.GetName] có các đặc điểm phi hình cầu đáng kể và bề mặt của nó có cấu trúc khổng lồ hoàn toàn không phù hợp với bất kỳ mô hình địa lý nào."
 DISTAR_ELECTRO_CAT: "Cấu trúc dạng lưới"
 DISTAR_ELECTRO_CAT_DESC: "Một cấu trúc lưới phát ra từ một nguồn không xác định đang phát sáng theo chu kỳ trên bề mặt của [From.GetName]."
 DISTAR_RUM_CAT: "Hợp chất quen thuộc"
 DISTAR_RUM_CAT_DESC: "Quang phổ phát xạ của [From.GetName] chỉ ra rằng thành phần chính của hành tinh khí khổng lồ này có cấu trúc phân tử giống hệt như một loại đồ uống có cồn phổ biến."
 DISTAR_SOOTHE_CAT: "Tinh thể cộng hưởng"
 DISTAR_SOOTHE_CAT_DESC: "Các bản quét của [From.GetName] đã tiết lộ một lượng lớn các tinh thể cộng hưởng trong lớp vỏ của nó. Chúng ta có thể tận dụng điều này."
 DISTAR_SOOTHE_GC_CAT: "Từ tính mạnh"
 DISTAR_SOOTHE_GC_CAT_DESC: "Từ quyển của [From.GetName] có sức hút mạnh mẽ đối với các thiết bị không người lái nghiên cứu của chúng ta vì một lý do không xác định. Chúng ta nên điều tra thêm."
 DISTAR_EXO_CAT: "Thảm thực vật kỳ lạ"
 DISTAR_EXO_CAT_DESC: "Bề mặt của [From.GetName] được bao phủ bởi một loại thực vật rất độc đáo, không giống với các thực vật khác trên hành tinh."
 DISTAR_ICE_CAT: "Tín hiệu không nhất quán"
 DISTAR_ICE_CAT_DESC: "Bề mặt của [From.GetName] bị đóng băng, nhưng nhiệt độ bề mặt đo được lại lên tới hàng trăm độ. Điều gì gây ra sự không nhất quán này?"
 DISTAR_METAL_CAT: "Mây nhiễu sóng"
 DISTAR_METAL_CAT_DESC: "Khí quyển của [From.GetName] phản xạ hoàn toàn các cảm biến của chúng ta trên dải tần số vô tuyến. Có thứ gì đó bên dưới đang liên tục gây nhiễu tín hiệu của chúng ta."
 DISTAR_OCEAN_CAT: "Đường hầm sâu"
 DISTAR_OCEAN_CAT_DESC: "Các bản quét cho thấy một hệ thống đường hầm phức tạp ẩn dưới lớp nước của [From.GetName]. Ai đã tạo ra chúng?"
 DISTAR_COLLAPSE_CAT: "Trạm hoang phế"
 DISTAR_COLLAPSE_CAT_DESC: "Một trạm không gian hoang phế đang trôi nổi trên quỹ đạo, yếu ớt xoay quanh [From.GetName], mang trên mình vô số vết sẹo do bị mảnh vỡ va đập trong suốt nhiều thế kỷ. Xét đến tình trạng đổ nát và công nghệ không thể nhận diện của nó, chúng ta cần một nhóm chuyên gia để điều tra."
 DISTAR_FOES_CAT: "Bản sao"
 DISTAR_FOES_CAT_DESC: "Những cư dân bản địa chật vật sinh tồn trên bề mặt đầy bụi bặm của [From.GetName] có sự tương đồng đáng kinh ngạc với một giống loài mà chúng ta đã tìm thấy trên một thế giới Tomb World khác trong cùng hệ sao."
 DISTAR_DIAMOND_CAT: "Xung siêu nặng"
 DISTAR_DIAMOND_CAT_DESC: "Xung của [From.GetName] rất ổn định. Nghiên cứu nhật chấn cho thấy mật độ vật chất bên trong của nó lớn hơn nhiều so với dự đoán của chúng ta. Điều gì mang lại cho nó mật độ đáng kinh ngạc này?"
 DISTAR_MOLTEN_CAT: "Miệng núi lửa"
 DISTAR_MOLTEN_CAT_DESC: "Có rất nhiều miệng núi lửa phun ra khí nóng trên bề mặt của [From.GetName], điều này không bình thường đối với một hành tinh nóng chảy. Một số khí nóng được phun ra có giá trị công nghiệp cao."
 DISTAR_MERCURY_CAT: "Hang động sâu"
 DISTAR_MERCURY_CAT_DESC: "Hình ảnh quét bên trong của [From.GetName] cho thấy có những hang động khổng lồ dưới lòng đất. Chúng có thể đáng để điều tra."
 DISTAR_WARFORM_CAT: "Cấu trúc bí ẩn"
 DISTAR_WARFORM_CAT_DESC: "Một vài cấu trúc nhân tạo đang nhô lên khỏi những đám mây độc hại của [From.GetName]."
 DISTAR_BRAINSLUG_CAT: "Khu định cư bị bỏ hoang"
 DISTAR_BRAINSLUG_CAT_DESC: "Bản quét của [From.GetName] đánh dấu một số khu định cư bị bỏ hoang bởi cư dân bản địa. Chuyện gì đã xảy ra với những người đã xây dựng chúng?"
 DISTAR_THIRSTY_CAT: "Hẻm núi khô cạn"
 DISTAR_THIRSTY_CAT_DESC: "Các hẻm núi sâu đến mức có thể quan sát trực tiếp từ quỹ đạo phác thảo các đường nét trên bề mặt của [From.GetName], nhưng hành tinh này lại khô cằn như một khu vực bị xói mòn do bão cát. Điều gì đã xảy ra với lượng nước từng xói mòn mạnh mẽ các tầng đá của [From.GetName]?"
 DISTAR_FLYTRAP_CAT: "Thảm thực vật khổng lồ"
 DISTAR_FLYTRAP_CAT_DESC: "Lượng thực vật trên [From.GetName] dồi dào đến kinh ngạc, lấp đầy toàn bộ bề mặt. Những loài thực vật này to lớn và có màu sắc sặc sỡ. Các nhà sinh vật học ngoại hành tinh của chúng ta rất quan tâm."
 DISTAR_LIVING_CAT: "Đại dương trôi dạt"
 DISTAR_LIVING_CAT_DESC: "Có một thứ gì đó khác thường, dường như đã thôi miên sự lên xuống của thủy triều ở đại dương trên [From.GetName]. Chuyển động của đại dương hoàn toàn không giống với bất kỳ hành vi thủy triều nào mà chúng ta biết hiện nay."
 DISTAR_ZONE_CAT: "Phế tích cô lập"
 DISTAR_ZONE_CAT_DESC: "Cảm biến hiển thị một cấu trúc nhân tạo hình tháp nhọn cô lập trên [From.GetName]."
 DISTAR_RAT_CAT: "Thủ đô tàn lụi"
 DISTAR_RAT_CAT_DESC: "Cuộc điều tra sơ bộ của chúng ta về [From.GetName] cho thấy hành tinh này là thủ đô cũ của một đế chế đã diệt vong. Bãi rác mà chúng ta gặp trước đó thuộc về đế chế này. Một cuộc điều tra kỹ lưỡng hơn có thể thu được nhiều thông tin hơn."
 DISTAR_MED_CAT: "Chiếc hộp bí ẩn"
 DISTAR_MED_CAT_DESC: "Một chiếc hộp không rõ nguồn gốc đang quay quanh [From.GetName], chứa một lượng lớn chất hữu cơ nào đó."
 DISTAR_POD_CAT: "Kén treo không xác định"
 DISTAR_POD_CAT_DESC: "Một nhóm kén treo đứng yên xoay quanh [From.GetName]. Ban đầu chúng ta tưởng đó là một vành đai tiểu hành tinh."
 DISTAR_PHASE_CAT: "Hành tinh chuyển pha"
 DISTAR_PHASE_CAT_DESC: "Có một tín hiệu năng lượng rất kỳ lạ gần [From.GetName], như thể toàn bộ hành tinh đang thoắt ẩn thoắt hiện."
 DISTAR_SOY_CAT: "Tàn tích rậm rạp"
 DISTAR_SOY_CAT_DESC: "Cảm biến cho thấy có các cấu trúc nhân tạo bị chôn vùi dưới lớp thực vật dày đặc trên [From.GetName]."
 DISTAR_SIGNAL_CAT: "Nhiễu tín hiệu"
 DISTAR_SIGNAL_CAT_DESC: "Cảm biến trên tàu đã phát hiện một mô hình nhiễu tín hiệu không thể giải thích được trong hệ sao [From.GetStarName]."
 DISTAR_PUZZLE_CAT: "Vật thể không thể quét"
 DISTAR_PUZZLE_CAT_DESC: "Chúng ta đã định vị được một vật thể trong vành đai tiểu hành tinh ở hệ sao [From.GetStarName], gần [From.GetName], phản xạ lại tín hiệu cảm biến của chúng ta. Quan sát bằng mắt thường cho thấy vật thể có hình dạng đa giác, nhưng do thiếu dữ liệu quét, chúng ta biết rất ít về nó."
 ####################################
 #Anomaly Events
 ####################################
 distar.1.name: "Xác nhận danh tính mảnh vỡ"
 distar.1.desc: "Thủy thủ đoàn lên tàu [Root.GetName] của chúng ta báo cáo rằng xác tàu ở [From.GetName] dường như là kết quả của một cơn bão từ mặt trời bất ngờ. Với việc hệ thống hỗ trợ sự sống hoàn toàn ngưng hoạt động và không thể di chuyển do hư hỏng, con tàu tiếp tế chỉ có thể trôi dạt vô vọng cho đến khi rơi vào giếng trọng lực của [From.GetName]. Không có ai sống sót.\n\nKhoang chở hàng của tàu thực sự chứa một lượng khoáng sản đáng kể"
 distar.1.desc.contact: "$distar.1.desc$ - tuy nhiên, Thuyền trưởng của [Root.GetName] cẩn trọng lưu ý rằng đây là thiết kế tàu của §Y[wreckage_owner.GetAdj]§!.\n\nSố khoáng sản này rất có thể thuộc về §Y[wreckage_owner.GetName]§! và họ sẽ không hài lòng nếu chúng ta lấy hàng hóa của họ."
 distar.1.desc.nocontact: "$distar.1.desc$."
 distar.1.a: "Chúng ta cần số khoáng sản đó."
 distar.1.a.tooltip: "Hành động này sẽ chọc giận §Y[wreckage_owner.GetName]§!."
 distar.1.b: "Tốt hơn là đừng gây hấn với họ."
 distar.1.b.tooltip: "Trả lại số khoáng sản trên tàu cho §Y[wreckage_owner.GetName]§!.\nHành động này sẽ làm họ hài lòng và mang lại cho chúng ta £influence£ §HẢnh hưởng§!."
 distar.2.name: "Hàng hóa trong xác tàu tiếp tế"
 distar.2.desc: "[Root.GetSpeciesNamePlural]. Chúng tôi phát hiện một con tàu tiếp tế §Y[wreckage_owner.GetAdj]§! mất tích đang hướng tới §Y[wreckage_owner.Capital.GetName]§! đã trôi dạt vào không gian của [Root.GetAdj] do bị hư hỏng nặng, và sau đó hàng hóa trên tàu đã bị các vị đánh cắp.\n\nCác vị thực sự nghĩ rằng chúng tôi sẽ không phát hiện ra sao? §Y[wreckage_owner.GetName]§! yêu cầu các vị trả lại ngay lập tức tài sản trên tàu cho chúng tôi."
 distar.2.desc.machi: "[Root.GetSpeciesNamePlural]. Chúng tôi phát hiện một con tàu tiếp tế §Y[wreckage_owner.GetAdj]§! hướng đến §Y[wreckage_owner.Capital.GetName]§! đã bị mất tích. Các tàu thăm dò của chúng tôi báo cáo rằng con tàu đã đi vào hệ sao [From.From.GetName], và người của các vị đã đánh cắp hàng hóa trên đó rồi chiếm làm của riêng.\n\nChúng tôi không thể chấp nhận hành vi này của các vị. Vui lòng trả lại hàng hóa của chúng tôi ngay lập tức, [Root.GetSpeciesNamePlural]."
 distar.2.a: "Tàu tiếp tế? Tàu tiếp tế nào?"
 distar.2.b: "Chúng tôi sẽ trả lại vật tư cho các vị."
 distar.3.name: "Hàng hóa trên xác tàu đã được trả lại"
 distar.3.desc: "[Root.GetSpeciesNamePlural]! Chúng tôi đã nhận được thông tin về hàng hóa trên tàu tiếp tế của chúng tôi. Chúng tôi vô cùng biết ơn các vị đã dành thời gian thu hồi số hàng hóa này mà không cần sự can thiệp của [wreckage_owner.GetAdj]."
 distar.3.a: "Đó là vinh hạnh của chúng tôi, [wreckage_owner.GetSpeciesNamePlural]."
 distar.6.name: "Đóng băng trong thời gian"
 distar.6.desc: "Thủy thủ đoàn trên [Root.GetName] rất hào hứng khi phát hiện tàn tích của một nền văn minh thời đại công nghiệp trên [From.GetName]. Nghiên cứu cho thấy [From.GetName] đã duy trì bầu khí quyển trong hàng triệu năm cho đến khi bề mặt bất ổn của ngôi sao [From.GetStarName] phát ra một tia lóa cực mạnh dẫn đến sự ion hóa thoát ly và tiêu tán mất kiểm soát bầu khí quyển của hành tinh.\n\nHàng ngàn năm sau khi mất đi bầu khí quyển, những thành phố không còn sự sống trên [From.GetName] đã bị đóng băng theo thời gian. Đây là tượng đài câm lặng tưởng nhớ cuộc đại tuyệt chủng đã xảy ra ở đây.\n\nSĩ quan Khoa học [Root.GetLeaderName] cảnh báo rằng bất kỳ thuộc địa nào trong hệ sao [From.GetStarName] đều có thể phải hứng chịu cơn thịnh nộ thất thường của ngôi sao này."
 distar.7.name: "Siêu bão Mặt trời"
 distar.7.desc: "Cảm biến trên [Root.GetName] phát hiện bề mặt của [Root.GetStarName] đang có những hiện tượng hỗn loạn đặc trưng trước khi xuất hiện một siêu bão mặt trời. Xét đến số phận của nền văn minh cổ đại trên [frozen_in_time_planet.GetName], [Root.Owner.GetScientistPlural] của chúng ta đang chạy đua với thời gian để thiết kế một ma trận lá chắn nhằm chống lại đợt phun trào plasma khổng lồ sắp tới."
 distar.7.desc.nocol: "Cảm biến phát hiện độ sáng của [Root.GetStarName] tăng đột biến. Có vẻ như ngôi sao này đang tạo ra một siêu bão mặt trời, về cơ bản giống hệt cơn bão đã tiêu diệt nền văn minh trên [frozen_in_time_planet.GetName].\n\nMay mắn thay, sẽ không có thuộc địa [Root.GetAdj] nào bị ảnh hưởng bởi biến động sao này."
 distar.7.a: "Chúng ta phải bảo vệ người dân của mình!"
 distar.7.b: "Đã hiểu."
 distar.9.name: "Phòng thủ Siêu bão Mặt trời thành công"
 distar.9.desc: "Bộ phận quản lý hành tinh vui mừng báo cáo rằng ma trận lá chắn siêu bão mặt trời được thiết lập xung quanh [Root.GetName] đã cực kỳ thành công. Cư dân của chúng ta không chỉ an toàn tránh được bức xạ plasma độc hại mà còn được thưởng thức một bữa tiệc cực quang rực rỡ do gió mặt trời đập vào ma trận lá chắn mới tạo ra."
 distar.10.name: "Siêu bão Mặt trời quét qua [fromfromfrom.GetName]"
 distar.10.desc: "Siêu bão mặt trời từ [fromfromfrom.GetStarName] đã bắn phá bầu khí quyển thượng tầng của [fromfromfrom.GetName]. Chúng ta đã không kịp thiết lập ma trận lá chắn để bảo vệ trước siêu bão mặt trời.\n\nCác dòng plasma và bão từ đã gây ra nhiễu điện từ trên toàn hành tinh, cản trở sản xuất năng lượng và tấn công người dân bằng bức xạ. Hậu quả thảm khốc này sẽ còn kéo dài trong một thời gian."
 distar.15.name: "Quang phổ sống động"
 distar.15.desc: "Một thành phần khí trong đĩa bồi tụ bao quanh [From.GetName] dường như là nguyên nhân gây ra sự quang sai xung quanh lỗ đen. Đĩa bồi tụ khúc xạ và phản xạ ánh sáng trên bề mặt, tạo ra một cầu vồng ấn tượng trong bóng tối.\n\nMặc dù bản thân cầu vồng chỉ là ảo ảnh quang học, nhưng môi trường tạo ra nó thì không. Đĩa bồi tụ của [From.GetName] chứa mức năng lượng rất cao - một điểm nóng thực sự cho sự phóng tĩnh điện."
 distar.20.name: "Hình ảnh ba chiều"
 distar.20.desc: "Qua việc điều tra mã định danh của hạm đội không xác định trong hệ sao [From.GetName], chúng ta đã có một phát hiện bất ngờ. Hạm đội này thực chất không nằm ở quỹ đạo an toàn của hố đen, mà đã vượt qua chân trời sự kiện.\n\nSĩ quan Khoa học [Root.GetLeaderName] suy đoán rằng hạm đội đã đến chân trời sự kiện của [From.GetName] từ nhiều thế kỷ trước, và sự giãn nở thời gian ở đây đã khiến hạm đội để lại hình ảnh của chúng trên bề mặt hố đen.\n\nLiệu hạm đội cố ý làm như vậy hay đã gặp phải một tai nạn không may, có lẽ chúng ta sẽ không bao giờ biết được. Mã định danh của chúng không khớp với bất kỳ nền văn minh nào đã biết."
 distar.25.name: "Robot nguyên thủy"
 distar.25.desc: "Trong quá trình nghiên cứu bề mặt của [From.GetName], thủy thủ đoàn của [Root.GetName] đã phát hiện tàn tích của một nền văn minh không gian sơ khai. Mặc dù nền văn minh này không còn cá thể nào sống sót, nhưng hành tinh vẫn là nơi sinh sống của những robot nguyên thủy do họ chế tạo.\n\nNhững robot này vẫn tiếp tục thực hiện nhiệm vụ của mình, không mệt mỏi sửa chữa cơ sở hạ tầng tàn tạ mà những đấng sáng tạo đã tuyệt diệt của chúng xây dựng nên.\n\nTrong tương lai, bất kỳ người thuộc địa nào cũng có thể sử dụng những robot cổ đại này làm lực lượng lao động. Bất kể các khía cạnh khác, những robot này đã chứng minh đủ sự dẻo dai."
 distar.25.a.tooltip: "Đã phát hiện §G300§!£pop£§HPop Người Máy§! trên [From.GetName]."
 distar.25.b.tooltip: "Đã phát hiện §G400§!£pop£§HPop Người Máy§! trên [From.GetName]."
 distar.26.name: "Robot nguyên thủy"
 distar.26.desc: "Những người khai hoang của chúng ta trên [Root.GetName] sẽ cần xử lý những con robot cổ đại trên bề mặt hành tinh. Chúng ta suy đoán chúng đã bị bỏ lại sau khi một thảm kịch nào đó giáng xuống những đấng sáng tạo của chúng.\n\nNhiều con robot cổ lỗ này đã phản ứng với sự hiện diện của chúng ta, liên tục hỏi chúng ta bằng một giọng điệu hoàn toàn xa lạ. Chúng ta tin rằng chúng đang chờ đợi mệnh lệnh đầu vào. Chúng dường như không có cảm xúc và rất có thể thiếu các chức năng suy luận logic tiên tiến."
 distar.26.a: "Đưa chúng vào làm việc."
 distar.26.a.tooltip: "Nhận được £pop£§HPop Người Máy§! trên [Root.GetName]."
 distar.26.b: "Tháo dỡ robot, tái chế khoáng sản."
 distar.26.c: "Chính sách của chúng ta có quy định riêng, nghiêm cấm sử dụng Trí Tuệ Nhân Tạo."
 distar.26.d: "Mặc dù chúng ta không cần những con robot này, nhưng phá hủy chúng như vậy cũng quá vội vàng."
 distar.26.d.tooltip: "Thay thế £pop£§HPop Người Máy§! trên [Root.GetName]."
 distar.26.spir: "Chúng ta không thể chung sống với những thứ không có linh hồn."
 distar.26.mach: "Chúng ta sẽ tích hợp chúng."
 distar.27.name: "Đấng sáng tạo mất tích"
 distar.27.desc: "[Root.Owner.GetScientistPlural] của [Root.Owner.GetAdj] bày tỏ sự quan tâm đến việc nghiên cứu các robot cổ đại trên [Root.GetName] và sự sụp đổ của nền văn minh đã tạo ra chúng. Cho đến nay, các nhà nghiên cứu vẫn chưa tìm thấy bằng chứng thuyết phục nào về điều gì đã tiêu diệt đấng sáng tạo của những robot này - một bí ẩn ngày càng khó hiểu qua hàng trăm năm, thời gian đủ để biến bất kỳ tàn tích hữu cơ nào thành tro bụi.\n\nMặc dù việc kiểm tra hành tinh đã loại trừ khả năng hủy diệt hạt nhân hoặc sự kiện tuyệt chủng do chiến tranh quy mô lớn, nhưng sự thật đằng sau nó vẫn lẩn tránh chúng ta.\n\nCác nhà nghiên cứu đề xuất tiến hành nghiên cứu chi tiết hơn nữa về phần cứng của robot cổ đại để cố gắng tìm hiểu sâu hơn."
 distar.27.a: "Chúng tôi sẽ xem xét."
 distar.28.name: "Đấng sáng tạo mất tích"
 distar.28.desc: "Dấu vết dữ liệu chúng ta khôi phục được từ ổ lưu trữ bị hỏng của robot nguyên thủy trên [From.From.GetName] tỏ ra rất khó phân tích. Thông tin chứa trong đó không thể được xử lý hoàn toàn bởi mạng lưới thần kinh của chúng ta, và độ tuổi của các thiết bị này chỉ là một phần nguyên nhân khiến dữ liệu rời rạc. Tuy nhiên, điều chúng ta có thể xác nhận bây giờ là dường như một loại bệnh truyền nhiễm sinh hóa đã lây nhiễm cho những đấng sáng tạo hữu cơ của robot nguyên thủy trên [From.From.GetName] vài thế kỷ trước. Cuối cùng, những người bị nhiễm chỉ có thể chờ chết."
 distar.28.a: "Một khiếm khuyết nữa của sinh vật hữu cơ."
 distar.29.name: "Đấng sáng tạo mất tích"
 distar.29.desc: "Trong quá trình quét sâu robot nguyên thủy trên [From.From.GetName], [Root.GetLeaderName] đã định vị thành công một khu vực lưu trữ chứa một dạng thông tin nhật ký. Dữ liệu đã bị hỏng nghiêm trọng do phần cứng bị xuống cấp, nhưng vẫn có một số mục hứa hẹn đã được cứu vãn và dịch thuật."
 distar.29.a: "Hãy xem nào."
 distar.30.name: "Nhật ký bị hỏng"
 distar.30.desc: "Khủng hoảng sinh hóa §G>>'%§!ort X175\n\nPhòng Nghiên §G?'>*§! trưởng - Nhật ký của Su§G(:=}§!\n\n§G<(}&:#^%!'_/:<}%;>*+_//#=}}§! Thiếu sót quan trọng §G/}>=;-}}§! Việc xử lý §G}/</>!}'§! thật đáng thất vọng. §G':(!#*/*'^§! vẫn §G#;}§! chưa có §G!-/§! ứng viên kháng nguyên khả dụng. §G(}(<^%+§! Đã cạn kiệt §G!^(};</#//}} ?'/-?>(<§! Bờ biển là nơi bị nhiễm đầu tiên sao? Rốt cuộc §G:=!^/&&>(}/§! virus này §G&=;§! từ đâu ra?\n\nA§G_}}(+!:}+-'f } :<§! Mực nước biển dâng cao §G(:>; }-;} (;#=-+^§! Vấn đề §G/#§! quá nhiều, §G>>}/?_/<§!"
 distar.30.a: "Hiển thị mục đầu tiên."
 distar.30.b: "Hiển thị mục thứ hai."
 distar.30.b.response: "§G<</<#?^&}|>!^/§! Ngủ say, bên dưới bề mặt §G!+<;§!. §G*;'_>!?;*}<}/(§!\n\n§G#/?(}:?*=-> <}_/=:/^>§! Chúng ta đã khơi dậy §G%_?/=§! cơn thịnh nộ §G% }<<'?}%-;^*=<}^/(?!}%<^'!}§!\n\n§G_*%!'}^<%=}+!}/&>'#_:}><!+^}^}}/=:>:/'}}':'/§!\n\n§G-&*!/}<;!+_-<^+!%}=?}%=+;;§! đến săn lùng chúng ta §G/:>(!!}(?<-=§!"
 distar.30.c: "Hiển thị mục cuối cùng."
 distar.30.c.response: "§G<<%/}} >!^*:+};=#(^&+<-|;/-<;// +-?<((#<-:?;&>-&|=:/<#% (*%} <<-§!\n§G/}>?|<:_|}&*%=-&|:}§! Tôi đã cảnh báo họ rằng tôi §G(}};_:<<^<=|-%<!_{{%?(+':<§! cảnh báo họ §G%!}#<-:!%<;#%?;§! rằng bọn chúng đang đến §G;>/}::<(/<<#'(§! Tôi"
 distar.30.d: "Phát lại bản ghi âm."
 distar.30.d.response: "\n§H<<Âm thanh chỉ có vài tiếng hét bằng ngôn ngữ người ngoài hành tinh, kèm theo một tiếng động lớn, sau đó mọi thứ chìm vào im lặng.>>§!"
 distar.30.e: "Đóng nhật ký."
 distar.31.name: "Chuyện lạ xảy ra"
 distar.31.desc: "Chúng ta nhận được báo cáo về hành vi bất ổn của một số người định cư trên [Root.GetName], tình hình rất đáng lo ngại. Những hành vi này từ nhầm lẫn đến cực kỳ hưng phấn, và một số ít trường hợp có biểu hiện bạo lực không thể giải thích được. Rất khó để giao tiếp với những cư dân bị ảnh hưởng, vì vậy chúng ta không thể tìm ra động cơ hợp lý cho hành vi của họ.\n\nĐến nay, chúng ta vẫn chưa xác nhận được nguyên nhân thực sự của những hành vi này - có thể là do sinh học, hóa học hoặc các lý do khác. Các nhà nghiên cứu của chúng ta đặc biệt khuyến nghị tiến hành một cuộc điều tra khoa học có mục tiêu trước khi tình hình vượt khỏi tầm kiểm soát."
 distar.31.a: "Phải tìm hiểu cho ra nhẽ."
 distar.32.name: "Tình hình xấu đi"
 distar.32.desc: "Ngày càng có nhiều cư dân trên [Root.GetName] rơi vào cảnh khốn cùng và lo lắng, dần bộc lộ những hành vi kỳ lạ mà chúng ta đã quan sát thấy ở một nhóm nhỏ người bị cách ly vài tuần trước. Đáng lo ngại hơn, một bộ phận không nhỏ cư dân đã bắt đầu có biểu hiện bồn chồn và bạo lực.\n\n[Owner.GetScientistPlural] của chúng ta cảnh báo rằng tình hình sẽ tiếp tục xấu đi trừ khi chúng ta tìm ra gốc rễ của vấn đề."
 distar.33.name: "Bạo loạn toàn cầu"
 distar.33.desc: "Tình hình trên [Root.GetName] đang dần mất kiểm soát. Tỷ lệ những người bị chi phối bởi sự lo lắng và tức giận đã đạt đến mức tới hạn. Tồi tệ hơn, một bộ phận dân cư có vũ trang cũng bị lôi kéo vào!\n\nCác cuộc xung đột vũ trang ác liệt đã nổ ra trong các khu dân cư, đè bẹp lực lượng dân quân duy trì trật tự. Đám đông giận dữ liên tục tàn sát lẫn nhau và kéo theo nhiều người xung quanh hơn!"
 distar.33.a: "Sự điên rồ này bắt nguồn từ đâu?"
 distar.33.a.tooltip: "Đám đông giận dữ đang tấn công những người định cư trên [Root.GetName] của chính họ!"
 distar.34.name: "Bạo loạn toàn cầu đã được bình định"
 distar.34.desc.a: "Những người định cư giận dữ trên [From.From.GetName] đã bị quân đội của chúng ta trấn áp và bình định. Thật không may, vì nguyên nhân gây ra những hành vi bất thường này vẫn chưa được biết, chúng ta không thể chắc chắn khi nào làn sóng bạo lực tiếp theo sẽ tái diễn.\n\nCác nhà sinh vật học xuất sắc nhất của chúng ta rất nghi ngờ đây là một loại bệnh truyền nhiễm ảnh hưởng đến hành vi sinh lý đang hoành hành, và đang ngày đêm nỗ lực kìm hãm sự lây lan của nó!"
 distar.34.desc.b: "Những người định cư giận dữ trên [From.From.GetName] đã bị quân đội của chúng ta trấn áp và bình định. Thật không may, vì nguyên nhân gây ra những hành vi bất thường này vẫn chưa được biết, chúng ta không thể chắc chắn khi nào làn sóng bạo lực tiếp theo sẽ tái diễn.\n\n[Owner.GetScientistPlural] của chúng ta đặc biệt khuyến nghị tiến hành một cuộc điều tra y tế có mục tiêu trước khi có thêm nhiều thảm kịch xảy ra."
 distar.34.a: "Chúng ta phải tìm ra nguyên nhân."
 distar.35.name: "Virus Cuồng Nộ"
 distar.35.desc: "Đội nghiên cứu của chúng ta đã đi sâu vào hiểm nguy để xác định nguồn gốc của những hành vi bất thường trên [Root.GetName], nhưng thảm kịch đã ập đến. Mặc dù đã áp dụng các biện pháp phòng ngừa triệt để, một số thành viên của nhóm nghiên cứu và phát triển vẫn bắt đầu có các triệu chứng hung hãn điển hình, và sự hỗn loạn do đó gây ra đã làm nhiều nhà khoa học thiệt mạng.\n\nTrong cái rủi có cái may, chúng ta đã phát hiện ra thủ phạm của bệnh dịch thịnh nộ này: một loại virus lây truyền qua đường không khí, có khả năng ảnh hưởng đến hệ thần kinh cơ bản của nạn nhân.\n\nNhững người còn lại trong nhóm nghiên cứu đã bắt đầu chạy đua với thời gian để phát triển một loại vắc-xin."
 distar.35.a: "Thời gian rất eo hẹp!"
 distar.36.name: "Phát triển thành công vắc-xin Virus Cuồng Nộ"
 distar.36.desc: "Việc nghiên cứu và phát triển vắc-xin chống lại bệnh dịch thịnh nộ đang càn quét dân số của [Root.GetName] đã hoàn tất mỹ mãn. Công tác phân phối vắc-xin đã bắt đầu, và cuộc sống trên [Root.GetName] sẽ sớm trở lại đúng hướng.\n\nNghiên cứu cho thấy retrovirus gây ra sự hỗn loạn này dường như đã tiến hóa và hình thành trên [Root.GetName] từ hàng triệu năm trước. Chúng đã ngủ đông ẩn náu trong lớp sinh khối bị đóng băng và tái xuất hiện sau khi các chỏm băng trên hành tinh tan chảy.\n\nRất có thể chính loại virus này đã dẫn đến cái chết của đấng sáng tạo ra những con robot cổ đại vài thế kỷ trước. May mắn thay, [Owner.GetName] có khả năng đối phó với chất ô nhiễm virus tốt hơn. Quá trình phát triển vắc-xin tương ứng thậm chí còn giúp chúng ta đạt được một số tiến bộ trong lĩnh vực y tế."
 distar.40.name: "Bầy đàn xám"
 distar.40.desc: "Sau khi phân tích kỹ lưỡng, [Root.GetLeaderName] phát hiện ra rằng vật chất kim loại kỳ lạ bao phủ bề mặt [From.GetName] thực chất được tạo thành từ hàng tỷ nanobot! Những nanobot này là những cỗ máy cực nhỏ có khả năng tự sao chép, có thể được tạo ra bởi một nền văn minh trước đó vì những mục đích chưa được biết.\n\nKhối lượng và mật độ của những nanobot này rất đáng kinh ngạc, chúng bao phủ bề mặt hành tinh với tổng khối lượng lên tới hàng tỷ tấn. Có vẻ như những cỗ máy tự sao chép này đã rơi vào trạng thái sao chép mất kiểm soát tại một thời điểm nào đó trong quá khứ, nuốt chửng hành tinh này cùng mọi thứ trên bề mặt.\n\nTrong quá trình nghiên cứu những robot này, phi hành đoàn đã có một số khám phá thú vị, chắc chắn sẽ giúp ích rất nhiều cho công việc nghiên cứu khoa học của chúng ta."
 distar.45.name: "Tín hiệu trọng lực bất thường"
 distar.45.desc: "Trong quá trình nghiên cứu các tín hiệu kỳ lạ xung quanh [From.GetName], thủy thủ đoàn trên [Root.GetName] đã phát hiện ra rằng kết quả phân tích trọng lực của toàn bộ hệ sao đều cao vượt mức. Sĩ quan Khoa học [Root.GetLeaderName] nghi ngờ Cổng Không Gian của [From.GetName] đã làm gián đoạn cảm biến của chúng ta bằng cách nào đó, hoặc bằng cách nào đó đã gây ra một lượng lớn vật chất vô hình ẩn chứa trong hệ sao này.\n\nNghiên cứu sâu hơn về Cổng Không Gian có thể mang lại nhiều kết quả hơn."
 distar.46.name: "Dòng chảy đen tối"
 distar.46.desc: "Việc nghiên cứu cổng dịch chuyển [From.GetStarName] không diễn ra suôn sẻ như dự kiến. Cảm biến đã phát hiện các kết quả đo lường hiệu ứng hấp dẫn cao hơn nhiều so với ước tính, và Sĩ quan Khoa học [Root.GetLeaderName] đã lần theo dữ liệu dị thường đến tận nguồn gốc của nó, tâm điểm của một đường ống không thời gian bị bỏ hoang. Những gì họ phát hiện ở đó đã vĩnh viễn thay đổi họ.\n\nTrong vài ngày sau khi trở về, [Root.GetLeaderName] đã kể về một công trình kiến trúc khổng lồ đến mức không thể diễn tả bằng lời ở phía bên kia cõi hư không, [Root.GetLeaderName] cho rằng những công trình khổng lồ đó phát ra một lực hấp dẫn mạnh mẽ không thể cưỡng lại, kéo hệ sao của chúng ta về phía chúng.\n\nNhiệm vụ này đã khiến các thành viên của đoàn thám hiểm kinh hãi, nhưng ngay sau khi họ vừa từ đường ống không thời gian trở về, dữ liệu bất thường đó đã đột nhiên biến mất."
 distar.50.name: "Amoeba lạc đường"
 distar.50.desc: "[Root.GetName] đã xác định được nguồn gốc của những chuyển động trong bầu khí quyển thượng tầng của [From.GetName]. Đáng kinh ngạc thay, đó không phải là một con tàu lẩn trốn trong những đám mây, mà là một con Amoeba non, và mẹ của nó thì không thấy đâu.\n\nChúng ta không thể biết làm thế nào con non này bị tách khỏi mẹ và đồng loại của nó, nhưng có một điều chắc chắn: dường như nó đã khắc ghi hình ảnh của [Root.GetName]. Khi phi hành đoàn hoàn thành cuộc điều tra về [From.GetName], họ nhận ra con Amoeba này đang bám theo họ. Rõ ràng là rất khó để cắt đuôi nó, và [Root.GetLeaderName] tỏ ra khá thích thú trước sự kiên quyết của con non này.\n\nSĩ quan khoa học của chúng ta đề xuất cho phép con Amoeba này đi theo tàu của chúng ta, tin tưởng rằng chúng ta có thể tìm hiểu thêm về loài Amoeba."
 distar.50.desc.first_enc: "[Root.GetName] đã xác định được nguồn gốc của những chuyển động trong bầu khí quyển thượng tầng của [From.GetName]. Đáng kinh ngạc thay, đó không phải là một con tàu lẩn trốn trong những đám mây, mà là một dạng sống ngoài hành tinh ngoan ngoãn. Bất chấp kích thước đáng kinh ngạc của nó, sinh vật được phi hành đoàn [Root.GetName] gọi là Space Amoeba này dường như vẫn đang ở giai đoạn sơ sinh.\n\nChúng ta không thể biết làm thế nào con non này bị tách khỏi mẹ và đồng loại của nó, nhưng có một điều chắc chắn: dường như nó đã khắc ghi hình ảnh của [Root.GetName]. Khi phi hành đoàn hoàn thành cuộc điều tra về [From.GetName], họ nhận ra con Amoeba này đang bám theo họ. Rõ ràng là rất khó để cắt đuôi nó, và [Root.GetLeaderName] tỏ ra khá thích thú trước sự kiên quyết của con non này.\n\nSĩ quan khoa học của chúng ta đề nghị cho phép con Amoeba này đi theo tàu của chúng ta, tin tưởng rằng chúng ta có thể tìm hiểu thêm về loài Amoeba."
 distar.50.a: "Thôi được..."
 distar.50.b: "Tuyệt đối không. Tiếp tục cố gắng cắt đuôi nó."
 distar.50.b.tooltip: "Cố gắng cắt đuôi Amoeba non đang đi theo [Root.GetName]."
 distar.50.c: "Tất nhiên là chúng ta có thể nghiên cứu sâu về nó. Chuẩn bị giải phẫu."
 distar.51.name: "Đủ lông đủ cánh"
 distar.51.desc: "Con Amoeba non đã gia nhập hạm đội của chúng ta trước đây nay có vẻ đã trưởng thành hoàn toàn. Dù đã phát triển thành một thiếu nữ nổi bật, cô bé vẫn rất trung thành với con tàu nghiên cứu đã mang lại cho mình một mái nhà mới khi bị mắc kẹt ở [From.From.GetName].\n\nNhững năm tháng đồng hành cùng hạm đội đã giúp cô bé phát triển hành vi thích ứng khác với những con Amoeba hoang dã, biến cô bé trở thành một lực lượng chiến đấu hùng mạnh hơn nhiều so với đồng loại trên chiến trường. Sự hiện diện của cô bé đã trở thành một linh vật đại diện cho tinh thần [Root.Owner.GetAdj] trên toàn [Root.Owner.GetName].\n\nChỉ còn một câu hỏi: chúng ta nên đặt tên gì cho cô bé?"
 distar.51.a: "$NAME_Bubbles$."
 distar.51.b: "$NAME_Nyx$."
 distar.51.c: "$NAME_Renegade$."
 distar.51.d: "$NAME_Euka$."
 distar.51.e: "$NAME_Cyto$."
 distar.51.f: "$NAME_Boomer$."
 distar.51.fb: "$NAME_Bloomer$."
 distar.51.g: "$NAME_Blaze$."
 distar.51.h: "$NAME_Nova$."
 NAME_Bubbles: "Bong Bóng"
 NAME_Nyx: "Nữ Thần Bóng Đêm"
 NAME_Renegade: "Nổi Loạn"
 NAME_Euka: "Ái Mộ"
 NAME_Cyto: "Tế Bào"
 NAME_Boomer: "Mèo Boomer"
 NAME_Bloomer: "Hoa Nở"
 NAME_Blaze: "Ngọn Lửa"
 NAME_Nova: "Tân Tinh"
 distar.51.more: "Những cái tên này quá ngốc nghếch, chúng ta phải nghĩ ra cái nào hay hơn."
 distar.52.name: "Mất dấu Amoeba non"
 distar.52.desc: "Các nhà nghiên cứu báo cáo rằng con Amoeba non bị bỏ rơi được tìm thấy ở [From.From.GetName] không còn đi theo con tàu nghiên cứu của chúng ta nữa. Sau vài tuần đi theo tàu của chúng ta, người ta cho rằng con non Amoeba đã đi vào một tuyến không gian siêu việt thông qua một cơ chế siêu không gian sinh học nào đó. Có lẽ nó đã nhận ra địa hình ở đó, có thể nó cảm nhận được đồng loại của mình, hoặc cũng có thể nó chỉ đơn giản là chán việc chạy theo tàu của chúng ta.\n\nMặc dù các tàu của chúng ta đã tuân theo chỉ thị không tương tác với Amoeba non, nhưng quá trình quét thụ động vẫn mang lại cho chúng ta một số khám phá về sinh lý học của sinh vật này."
 distar.53.name: "Giải phẫu Amoeba non"
 distar.53.desc.base: "Quá trình giải phẫu Amoeba non đã hoàn tất. Mặc dù hầu hết các mô của cơ thể đã bị phá hủy trong quá trình bị bắt, nhưng các nghiên cứu sinh học ngoài hành tinh trên phần còn lại vẫn tiết lộ khả năng tái tạo tuyệt vời của nó."
 distar.53.desc.lacks_tech: "$distar.53.desc.base$\n\nTóm lại, quá trình tái tạo mô của sinh vật này không chỉ thông qua sự nhân lên của tế bào, mà còn phụ thuộc vào một loại vi khuẩn gốc silicon để hỗ trợ quá trình tái tạo cơ quan.\n\nSau khi sửa đổi thích hợp thông tin di truyền của vi khuẩn này, chúng ta có thể sử dụng khả năng tự sửa chữa này để phát triển ma trận tự chữa lành thân tàu, mặc dù quá trình này khá chậm."
 distar.53.desc.has_tech: "$distar.53.desc.base$\n\nNhững phát hiện này nhất quán với nguyên tắc về khả năng phục hồi mô mang lại từ mối quan hệ cộng sinh giữa Amoeba và vi khuẩn dựa trên silicon mà chúng ta đã nghiên cứu trước đây, và chúng ta đã áp dụng vào công nghệ tái tạo thân tàu từ lâu."
 distar.54.name: "Amoeba non trốn thoát"
 distar.54.desc: "Có vẻ như con Amoeba non đã trốn thoát do chúng ta không tích cực chuẩn bị các bước để giải phẫu nó. Cảm biến cho thấy vài giờ trước, nó đã sử dụng một cơ chế siêu không gian sinh học nào đó để thoát khỏi sự kiểm soát của chúng ta."
 distar.55.name: "Ý nghĩa của một cái tên là gì?"
 distar.55.desc: "Làm sao một linh vật lại không có tên được? Chúng ta phải đặt cho người bạn ngoài hành tinh của mình một cái tên xứng đáng với cô bé."
 distar.55.a: "$NAME_Blitz$."
 distar.55.b: "$NAME_Zero$."
 distar.55.c: "$NAME_Deva$."
 distar.55.d: "$NAME_Kos$."
 distar.55.e: "$NAME_Amemba$."
 distar.55.f: "$NAME_Beauregarde$."
 distar.55.g: "$NAME_Bluey$."
 distar.55.h: "$NAME_Zeke$."
 NAME_Blitz: "Tia Chớp"
 NAME_Zero: "Số Không"
 NAME_Kos: "Kos"
 NAME_Deva: "Ca Sĩ"
 NAME_Amemba: "Amoeba"
 NAME_Beauregarde: "Beauregarde"
 NAME_Bluey: "Bluey Già"
 NAME_Zeke: "Zeke"
 seed_pod_fleet_suffix: "(£seed_pod£)"
 distar.56.desc: "Chúng ta có khả năng vượt qua ranh giới của không gian và thời gian để di chuyển nhanh hơn ánh sáng. Nhưng lại không thể thống nhất nổi cái tên cho một con Amoeba.\n\nĐây là cơ hội cuối cùng của chúng ta."
 distar.56.a: "$NAME_Storm$."
 distar.56.b: "$NAME_Ghost$."
 distar.56.c: "$NAME_Cygni$."
 distar.56.d: "$NAME_Vesper$."
 distar.56.e: "$NAME_Arda$."
 distar.56.f: "$NAME_Phaeton$."
 distar.56.g: "$NAME_Wraith$."
 distar.56.h: "$NAME_Rokka$."
 distar.56.i: "Đủ rồi, cứ gọi nó là Cục Bông đi!"
 NAME_Storm: "Bão Táp"
 NAME_Ghost: "Bóng Ma"
 NAME_Cygni: "Cygni"
 NAME_Vesper: "Hoàng Hôn"
 NAME_Arda: "Arda"
 NAME_Phaeton: "Phaeton"
 NAME_Wraith: "Oán Linh"
 NAME_Rokka: "Rokka"
 NAME_Fluffy: "Cục Bông"
 distar.57.name: "Cái chết của Amoeba"
 distar.57.desc: "Tin tức về cái chết của [From.Fleet.GetName] nhanh chóng lan khắp [Root.GetName], nhưng không ai đau lòng hơn Sĩ quan Khoa học [amoeba_finding_scientist.GetName]. [amoeba_finding_scientist.GetSheHe] là người đầu tiên phát hiện ra con Amoeba non lạc lõng và bơ vơ, đồng thời chứng kiến nó dần trưởng thành dưới sự hướng dẫn ân cần của mình.\n\nGiờ đây, khi mất đi sự đồng hành thầm lặng của [From.Fleet.GetName], Sĩ quan Khoa học [amoeba_finding_scientist.GetName] có lẽ sẽ không bao giờ được như xưa nữa."
 distar.57.a: "Thật đáng tiếc."
 distar.304.name: "Amoeba Bách Niên"
 distar.304.desc: "Tin tức đầy cảm hứng từ các chỉ huy của chúng ta đang được phát sóng khắp [Root.Capital.GetName]: con Space Amoeba mà chúng ta nhận nuôi, [lost_amoeba_centenarian_fleet.GetName], đã tròn 100 tuổi.\n\nMặc dù một trăm năm là một khoảng thời gian dài đối với chúng ta, nhưng người bạn Amoeba của chúng ta dường như không hề già đi chút nào. Trên thực tế, hạm đội của chúng ta báo cáo rằng sức chiến đấu của [lost_amoeba_centenarian_fleet.GetName] đang tăng lên từng ngày. Cho đến ngày nay, ngay cả những chiến hạm tinh nhuệ nhất của chúng ta cũng phải e dè khi đối mặt với [lost_amoeba_centenarian_fleet.GetName]. Dáng vẻ uyển chuyển và mạnh mẽ của cô bé đã trở thành một cảnh tượng tuyệt đẹp, truyền cảm hứng cho tinh thần của người [Root.GetSpeciesAdj] trên chiến trường."
 distar.304.a.tooltip: "[lost_amoeba_centenarian_fleet.GetName] đã phát triển các kỹ năng chiến đấu mới!"
 distar.60.name: "Số phận chói lọi"
 distar.60.desc: "Những mảnh vỡ phóng xạ được phi hành đoàn [Root.GetName] tìm thấy trên quỹ đạo tầm thấp của [From.GetName] thực sự là phần còn lại của một con tàu vũ trụ. Thiết kế kỳ lạ của nó không giống bất kỳ mẫu tàu nào trong cơ sở dữ liệu của chúng ta.\n\nChúng ta đã khôi phục một số dữ liệu từ máy tính bị hỏng của nó, với ngôn ngữ chưa từng thấy trước đây - và do đó không thể dịch được.\n\nQua nghiên cứu sâu hơn về xác tàu, nhà khoa học [Root.GetLeaderName] suy đoán rằng con tàu có tên Kohtalo này đã gặp phải lỗi hệ thống định vị, và bị tách khỏi lực đẩy FTL (siêu quang tốc) quá gần với dòng tia gamma của [From.GetName]. Hầu hết thân tàu đã bị xé toạc bởi bức xạ, và không tìm thấy người sống sót nào trên đó."
 distar.61.name: "Cảm giác Deja Vu"
 distar.61.desc: "Các tàu thăm dò đã phát hiện một con tàu vừa thoát khỏi siêu không gian và tiến vào hệ sao [kohtalo_second_fleet.GetStarName]. Đặc điểm của nó rất giống với xác tàu độc đáo được tìm thấy trước đó ở [ouroboros_system.GetName]. Họ đang gọi cho chúng ta!"
 distar.62.name: "Cảm giác Deja Vu"
 distar.62.desc: "§EĐặc điểm của con tàu này rất giống với xác tàu được tìm thấy trước đó ở hệ sao [ouroboros_system.GetName]. Mặc dù máy dịch không thể giải mã ngôn ngữ của họ, nhưng có vẻ như họ rất vui khi được nói chuyện với chúng ta. Họ tự gọi mình bằng một tập hợp các tín hiệu giọng nói tần số thấp, nghe giống như Kohtalo - cái tên mà chúng ta đã từng nghe.\n\nChúng ta có thể sử dụng dữ liệu thô để giao tiếp với họ.§!"
 distar.62.a: "Cố gắng hỏi về mục đích họ đến đây."
 distar.63.name: "Tàu Kohtalo"
 distar.63.desc: "§EChúng ta đã nhận được một chuỗi dữ liệu phản hồi, bao gồm bản đồ của các hệ sao lân cận và một video. Không còn nghi ngờ gì nữa, các kỹ sư của họ đang bảo trì một thiết bị FTL của người ngoài hành tinh.\n\nĐiều duy nhất có thể chắc chắn là họ là những nhà thám hiểm đến từ một thiên hà khác. Con tàu không trang bị vũ khí của họ có thể chứng thực điều này.\n\nChúng ta đã gửi lại một đoạn video về những nhà thám hiểm [Root.GetAdj] lần đầu tiên rời khỏi hệ sao của chúng ta, và những nhà thám hiểm ngoài hành tinh này có vẻ rất vui.§!"
 distar.63.a: "Gửi cho họ dữ liệu thu thập được từ mảnh vỡ tàu gần [ouroboros_system.GetName]."
 distar.64.name: "Tàu Kohtalo"
 distar.64.desc: "§ESự nhiệt tình của phi hành đoàn Kohtalo ngay lập tức biến mất, và nhiều thành viên bắt đầu thao tác trên bảng điều khiển bằng các chi giống như xúc tu. Họ đã gửi một tập dữ liệu, có vẻ như là danh sách hành khách, thông tin điều hướng và nhật ký của phi hành đoàn. Không còn nghi ngờ gì nữa, những dữ liệu này hoàn toàn khớp với những phát hiện của chúng ta ở hệ sao [ouroboros_system.GetName] - ngoại trừ một ngoại lệ. Dữ liệu từ xác tàu [ouroboros_system.GetName] chứa nhiều mục hơn và niên đại gần đây hơn.\n\nCó vẻ như con tàu trước mặt chúng ta và xác tàu ở [ouroboros_system.GetName] là cùng một con tàu, chỉ là xác tàu có lịch sử lâu đời hơn.§!"
 distar.64.a: "Sao có thể như vậy được..."
 distar.65.name: "Tàu Kohtalo"
 distar.65.desc: "§EMặc dù họ vẫn duy trì các nghi thức ngoại giao của người ngoài hành tinh, nhưng sự căng thẳng của phi hành đoàn Kohtalo là rất rõ ràng. Các nhà khoa học của chúng ta khẳng định rằng nếu xác tàu trong hệ sao [ouroboros_system.GetName] thực sự là số phận tương lai của con tàu này, thì việc tiết lộ bất kỳ thông tin nào cho họ cũng có thể dẫn đến những hậu quả khó lường.§!"
 distar.65.a: "Nếu chúng ta cảnh báo họ, họ có thể sẽ thoát được."
 distar.65.a.tooltip: "Báo cho tàu Kohtalo chú ý tránh sao xung trong hệ sao [ouroboros_system.GetName]."
 distar.65.b: "Chúng ta không thể mạo hiểm can thiệp sâu hơn vào dòng thời gian."
 distar.65.b.tooltip: "Đóng kênh liên lạc."
 distar.66.name: "Tàu Kohtalo"
 distar.66.desc: "§ENhững lữ khách từ hệ sao khác này đang lo lắng nghiên cứu thông tin về hệ sao mà chúng ta đã truyền đi. Họ giao tiếp với nhau bằng ngôn ngữ độc đáo của họ và nhập một loạt lệnh trên bảng điều khiển. Các nhà ngoại giao của chúng ta kiên nhẫn chờ đợi phản hồi, nhưng trước khi nhận được bất kỳ lời hồi đáp nào, động cơ của họ đột nhiên khởi động.\n\nTrước khi chúng ta kịp phản ứng, họ đã biến mất không dấu vết.§!"
 distar.66.a: "Chúc các bạn may mắn, những lữ khách giữa các vì sao."
 distar.67.name: "Ouroboros"
 distar.67.desc: "Cảm biến hệ sao cho thấy con tàu thám hiểm xuyên không gian Kohtalo đột nhiên thoát khỏi trạng thái FTL ở ngoại vi hệ sao [ouroboros_system.GetName] và đâm sầm vào một sao chổi quay quanh hệ sao! Vụ va chạm thảm khốc này đã cướp đi sinh mạng của tất cả những người trên tàu, và mảnh vỡ của con tàu đã trôi dạt về phía sao xung của [ouroboros_system.GetName].\n\nCó vẻ như chính sao chổi này, chứ không phải sao xung, đã gây ra sự sụp đổ của Kohtalo. Hành động cảnh báo của chúng ta lại là nguyên nhân dẫn đến thảm kịch này. Giờ đây có hai xác tàu đang lặng lẽ xoay quanh sao xung của [ouroboros_system.GetName]."
 distar.68.name: "Ouroboros"
 distar.68.desc: "Cảm biến hệ sao cho thấy con tàu thám hiểm xuyên không gian Kohtalo đột nhiên thoát khỏi trạng thái FTL ở ngoại vi hệ sao và đâm sầm vào một sao chổi quay quanh hệ sao! Vụ va chạm thảm khốc này đã cướp đi sinh mạng của tất cả những người trên tàu, và mảnh vỡ của con tàu đã trôi dạt về phía sao xung của [ouroboros_system.GetName].\n\nCác nhà nghiên cứu kết luận rằng động cơ FTL hiệu ứng khối lượng âm được trang bị trên Kohtalo không thể phân tích chính xác thời điểm và vị trí con tàu thoát khỏi trạng thái FTL. Giờ đây có hai xác tàu đang lặng lẽ xoay quanh sao xung của [ouroboros_system.GetName]."
 distar.68.a: "Có lẽ tất cả những điều này là không thể tránh khỏi."
 distar.70.name: "Bản sao trong kho lạnh"
 distar.70.desc: "Sâu trong khu vực lưu trữ bị hư hỏng của Thế giới Vành đai [From.GetName], hàng ngàn sinh vật ngoài hành tinh đang được giữ đông lạnh bên trong những kén tối tăm. Một số vẫn còn sống, nhưng phần lớn dường như đã biến thành bùn lầy ở các mức độ phân hủy khác nhau do sự cố thiết bị đông lạnh.\n\nĐáng kinh ngạc là tất cả các sinh vật ngoài hành tinh đều giống hệt nhau: phân tích cho thấy chúng là sản phẩm của nhân bản gen. Sĩ quan Khoa học [Root.GetLeaderName] nói rằng chúng ta có thể rã đông các bản sao còn sống sót. Tuy nhiên, Thế giới Vành đai nơi họ đang ở hiện không thể hỗ trợ sự sống, và chúng ta phải cung cấp cho họ một nơi ở."
 distar.70.a: "Thật thú vị, hãy rã đông họ nhanh lên."
 distar.70.b: "Can thiệp là không khôn ngoan, tốt hơn là giữ khoảng cách và nghiên cứu."
 distar.70.exter: "Tiêu diệt"
 distar.70.exter.tooltip: "Làm sạch cặn bã hữu cơ trên Thế giới Vành đai [From.GetName]."
 distar.70.fp: "Lũ sinh vật ngoại lai bẩn thỉu, chúng sẽ bị thanh lọc."
 distar.70.fp.tooltip: "Thanh lọc lũ cặn bã ngoại lai xấu xa trên [From.GetName]."
 distar.70.no_room: "Thật đáng tiếc, chúng ta không có không gian cho họ ở đây."
 distar.71.name: "Bản sao đông lạnh đã được hồi sinh"
 distar.71.desc: "Sĩ quan Khoa học [Root.GetLeaderName] vui mừng báo cáo rằng ngoại trừ một số ít cá thể không thể cứu chữa, việc hồi sinh các bản sao đông lạnh đã thành công mỹ mãn. Những bản sao này rất ngoan ngoãn và dường như không có bất kỳ kiến thức nào về thế giới sau khi họ được tạo ra. [Root.GetLeaderName] suy đoán rằng họ đã được loài xây dựng Thế giới Vành đai [From.GetStarName] sử dụng làm lực lượng lao động.\n\nMặc dù những bản sao này sẵn sàng tuân theo mệnh lệnh, nhưng [Root.GetLeaderName] chỉ ra rằng dữ liệu quét cộng hưởng thần kinh của họ cho thấy họ không giỏi xử lý các công việc phức tạp."
 distar.71.pop.default: "Để các bản sao làm việc cho chúng ta."
 distar.71.pop.tooltip: "Nhận được §G200§!£pop£§HPop Bản Sao Đông Lạnh§! trên [pop_planet.GetName]."
 distar.71.no_room: "Hành tinh của chúng ta không có chỗ cho họ sống, hãy chuẩn bị một con tàu."
 distar.71.pop.slave: "Sử dụng chúng làm nô lệ là hợp lý."
 distar.71.pop.phile: "Chúng ta nên nồng nhiệt chào đón họ!"
 distar.71.pop.swarm: "Họ sẽ đóng góp như những nguyên liệu thực phẩm bổ dưỡng cho [Root.Owner.GetSpeciesSpawnNamePlural]."
 distar.71.swarm.alt.tooltip: "Chế biến các bản sao thành chất dinh dưỡng."
 distar.71.pop.servi: "Họ sẽ không bao giờ phải làm việc nữa."
 distar.71.servi.alt.tooltip: "§G100§!£pop£§HPop Bản Sao Đông Lạnh§! gia nhập Khu bảo tồn trên [pop_planet.GetName]."
 distar.71.pop.assim: "Họ sẽ bị đồng hóa."
 distar.72.name: "$distar.71.name$"
 distar.72.desc: "Bây giờ chúng ta đã xây dựng lại và thuộc địa hóa một khu vực có thể sinh sống được trên Thế giới Vành đai [Root.GetStarName], đã đến lúc quyết định phải làm gì với những bản sao đông lạnh này."
 distar.72.a: "Cứ để họ tiếp tục ngủ yên, coi như một đài kỷ niệm."
 distar.72.b: "Rã đông họ và bổ sung vào lực lượng lao động của chúng ta."
 distar.72.b.servi: "Rã đông họ, chúng ta sẽ chăm sóc họ thật tốt."
 distar.72.c: "Phóng họ vào không gian."
 distar.75.name: "Lõi ẩn"
 distar.75.desc: "Dù vẻ ngoài có vẻ nhạt nhẽo, tiểu hành tinh [From.GetName] lại có phần lõi rỗng chứa các tinh thể quý giá với giá trị công nghiệp cao - giống như một khối tinh thể khổng lồ treo lơ lửng trên bầu trời.\n\nBằng cách làm theo các hướng dẫn đặc biệt do Sĩ quan Khoa học [Root.GetLeaderName] phát triển, bất kỳ nền tảng khai thác nào trong tương lai cũng có thể cẩn thận chiết xuất các tinh thể từ các lớp bên trong của tiểu hành tinh."
 distar.75.yurantic.tooltip: "Khám phá ra Tinh Thể Yurantic"
 distar.75.teldar.tooltip: "Khám phá ra Tinh Thể Teldar"
 distar.80.name: "Sinh vật khổng lồ câm lặng"
 distar.80.desc: "[Root.GetLeaderName] báo cáo rằng cấu trúc khổng lồ trên [From.GetName] thực chất là hài cốt của một sinh vật ngoài hành tinh khổng lồ chưa từng được biết đến. Không chỉ kích thước của hài cốt này đủ lớn để có thể nhìn thấy trực tiếp bằng mắt thường từ quỹ đạo của [primitive_planet.GetName], mà nó dường như còn liên tục giải phóng một lượng lớn hóa chất hoạt động ở cấp độ tinh thần, có lẽ đã ảnh hưởng đến hệ thần kinh của các sinh vật hữu cơ trên hành tinh này."
 distar.80.b.evopred: "Hãy lấy một chút đồ ăn vặt trước khi điều tra thêm."
 distar.82.name: "Thần Chết"
 distar.82.desc: "Sau khi phá hủy hệ thống phòng thủ được thiết lập bởi người bản địa trên [dead_god_planet.GetName], nhiều sứ giả của người bản địa đã chủ động liên lạc với chúng ta. Có vẻ như người bản địa ở đây đã coi hài cốt của sinh vật khổng lồ trên vệ tinh của hành tinh đó là Thần Chết từ rất lâu rồi. Họ tin rằng một ngày nào đó Thần sẽ sống lại, trở thành Thần Tái Sinh và mang đến một kỷ nguyên thịnh vượng mới cho người dân của họ.\n\nVì chúng ta đến từ các vì sao và sở hữu những công nghệ khoa học mà họ khó có thể hiểu được, nhiều người bản địa bắt đầu tin rằng chúng ta là những sứ giả cho sự trở lại của Thần Chết."
 distar.82.a: "Chúng ta có thể lợi dụng điều này."
 distar.82.a.tt: "Mỗi £pop£§HPop [worshipper_species.GetAdj]§! nhận được công cụ sửa đổi §Y$conviction$§! trong §Y240§! tháng, được §G+33%§! Hạnh phúc và §G+25%§! tài nguyên tạo ra từ các công việc £job£."
 distar.82.b: "Thật nực cười, chúng ta sẽ không diễn cùng họ đâu."
 distar.82.c: "Đúng vậy, chúng tôi được Thần của các người phái đến, các người sẽ sớm đoàn tụ với ngài thôi."
 distar.82.d: "Đuổi bọn chúng ra khỏi hành tinh của tôi!"
 distar.85.name: "Sự sống dòng điện"
 distar.85.desc: "Sĩ quan Khoa học [Root.GetLeaderName] báo cáo rằng bề mặt của hành tinh [From.GetName] được bao phủ hoàn toàn bởi một mạng lưới xung điện. Mạng lưới này phản ứng với các kích thích bên ngoài: khi [Root.GetName] truyền một xung điện thế thấp xuống mặt đất, mạng lưới trên bề mặt nhấp nháy theo hình gợn sóng, giống như một bảng mạch.\n\nĐáng kinh ngạc hơn nữa, mạng lưới này còn có thể tự tái cấu trúc! Thử nghiệm xung lần thứ hai cho thấy thành phần cấu trúc của mạng lưới đã thay đổi, và trung tâm của mạng lưới đã chuyển sang điểm tiếp xúc của xung đầu tiên với bề mặt của [From.GetName].\n\n[Root.GetLeaderName] tin rằng phát hiện này xác nhận lý thuyết mà [Root.Leader.GetHisHer] luôn giữ: sự sống có thể tồn tại dưới dạng các xung điện thuần túy, và không cần bất kỳ cấu trúc tổ chức nào như tế bào hay virus."
 distar.90.name: "Hương vị quê hương"
 distar.90.desc: "Nghiên cứu sâu hơn về [From.GetName] cho thấy thành phần hóa học chính của hành tinh này giống hệt các este được tìm thấy trong một loại quả mọng trên [Root.Owner.Capital.GetName]. Trong hàng nghìn năm, người dân địa phương đã sử dụng chất này để ủ các loại rượu thơm ngon. Trữ lượng lớn đáng kinh ngạc của các este trên [From.GetName] rất có thể đến từ một tinh vân che phủ toàn bộ hệ sao, nơi các chất tương tự không thể đong đếm được.\n\nSĩ quan Khoa học [Root.GetLeaderName] đã lấy một vài mẫu và, sau khi kiểm tra độc chất nghiêm ngặt, thậm chí đã nếm thử chúng. Ông mô tả mùi hương và mùi vị là \"một tia ấm áp của quê hương trong không gian lạnh giá\". Phi hành đoàn [Root.GetName] nói rằng thức uống truyền thống mang đậm hương vị ngoài hành tinh của [Root.Owner.GetAdj] này sẽ rất được người dân của chúng ta hoan nghênh."
 distar.90.a: "Tuyệt đối không được."
 distar.90.b: "Đề xuất hay đấy, hãy mang những chiếc ly uống rượu tốt nhất ra đây!"
 distar.91.name: "Este ngoại lai"
 distar.91.desc: "Nghiên cứu sâu hơn về [From.GetName] cho thấy thành phần hóa học chính của hành tinh này giống hệt các este được tìm thấy trong một loại quả mọng trên [rum_nation.Capital.GetName]. Trong hàng nghìn năm, [rum_nation.GetSpeciesNamePlural] đã sử dụng chất này để sản xuất đồ uống gây say. Trữ lượng lớn đáng kinh ngạc của các este trên [From.GetName] rất có thể đến từ một tinh vân che phủ toàn bộ hệ sao, nơi các chất tương tự không thể đong đếm được.\n\n[Root.GetLeaderName] đã thu thập một vài mẫu để kiểm tra xem chúng có chứa bất kỳ chất ô nhiễm nào gây hại cho sinh vật hữu cơ hay không. Các nhà khoa học gợi ý rằng chúng ta có thể sử dụng các chất này làm quà tặng cho [rum_nation.GetSpeciesNamePlural]. Các sinh vật hữu cơ luôn được biết đến với việc tận hưởng những chất như vậy."
 distar.91.a: "Tặng các este làm quà cho [rum_nation.GetName]."
 distar.91.a.tooltip: "Có lẽ họ sẽ rất vui."
 distar.91.b: "Thôi bỏ đi, chúng ta không cần thêm sự sống hữu cơ ngoài tầm kiểm soát."
 distar.92.name: "Este ngoại lai"
 distar.92.desc: "[Root.GetSpeciesNamePlural]! Món quà bất ngờ của các vị đã được nhận. Lúc đầu, chúng tôi thực sự nghi ngờ, nhưng ngay khi các nhà khoa học xác nhận sự an toàn của đồ uống, mọi người đã nóng lòng muốn thưởng thức nó.\n\nPhải thừa nhận rằng, đó là một trải nghiệm tuyệt vời. Hương trái cây đậm đà, kèm theo vị hơi chua ở cuối, cùng với cảm giác se sít không thể bỏ qua. Nó vừa gợi nhớ cho chúng tôi về những vườn cây ăn quả ở quê hương trên [rum_nation.Capital.GetName], lại vừa dường như tượng trưng cho sự trống rỗng rộng lớn của vũ trụ, sự hòa quyện giữa lạnh lẽo và ấm áp.\n\nCảm ơn vì món quà hào phóng của các vị. Thật thú vị khi nghĩ về một toàn bộ hành tinh tràn ngập loại rượu mà chúng tôi đã ủ hàng nghìn năm!"
 distar.92.a: "Trình mô phỏng cảm xúc của chúng tôi rất vui khi thấy các vị thưởng thức chất hóa học này."
 distar.93.name: "Mất liên lạc"
 distar.93.desc: "[Root.GetSpeciesName] các vị có ý gì? Các vị đang cố đầu độc chúng tôi bằng thứ chất lỏng bẩn thỉu này sao? Nghĩ chúng tôi dễ bị bắt nạt lắm à?\n\nThiếu úy, khóa toàn bộ khoang chứa hàng chết tiệt này lại, sau đó tắt kênh này!"
 distar.93.a: "Lỗi! Giao tiếp thất bại."
 distar.95.name: "Sự cộng hưởng xoa dịu"
 distar.95.desc: "Tinh thể độc đáo được tìm thấy trên [From.GetName] có các đặc tính khá đặc biệt. Phi hành đoàn [Root.GetName] báo cáo rằng họ cảm thấy vô cùng bình tĩnh khi đến bề mặt hành tinh, tinh thần sảng khoái, hưng phấn và kéo dài cho đến khi trở lại quỹ đạo. Rõ ràng, tinh thể này có thể cộng hưởng ở một tần số đã được y học biết đến là có lợi cho sức khỏe của [Root.Owner.GetSpeciesNamePlural].\n\nNếu một ngày nào đó chúng ta thiết lập thuộc địa trên [From.GetName], người dân của chúng ta chắc chắn sẽ thích sống gần loại tinh thể cộng hưởng này."
 distar.100.name: "Tần số có lợi"
 distar.100.desc: "Nghiên cứu sâu hơn cho thấy tần số độc đáo của từ trường [From.GetName] có sức hút không thể giải thích được đối với các cá thể phụ của chúng ta trên quỹ đạo. Tần số cộng hưởng của từ quyển hành tinh này tạo ra phản ứng nhắm vào mạng lưới thần kinh của [Root.Owner.GetAdj].\n\nChúng ta nên thiết lập thuộc địa trên [From.GetName], và tất cả [Root.Owner.GetSpeciesNamePlural] cư trú trên hành tinh này sẽ được hưởng những lợi ích của sự cộng hưởng từ trường này."
 distar.100.a: "Đã xử lý thông tin."
 distar.105.name: "Nấm ngoại lai xâm lấn"
 distar.105.desc: "Sau khi lấy mẫu và nghiên cứu chuyên sâu về toàn bộ sinh quyển trên [From.GetName], [Root.GetLeaderName] báo cáo rằng chất này không phải là chất tự nhiên của hành tinh, mà là một dạng sống nấm xâm lấn chưa rõ nguồn gốc. Loại nấm này ăn các chất sinh học, làm ngạt thở các loài thực vật xung quanh và bao phủ toàn bộ khu vực.\n\nBất kỳ ai định định cư trên hành tinh này đều phải đốt cháy loại nấm ngoại lai này - mặc dù vẫn chưa rõ liệu chúng có thể bị diệt trừ hoàn toàn hay không."
 distar.110.name: "Địa ngục băng giá"
 distar.110.desc: "Mặc dù bề mặt của [From.GetName] có vẻ bị đóng băng, nhưng quỹ đạo của hành tinh quanh [From.GetStarName] khiến nhiệt độ bề mặt của nó lên tới hàng trăm độ, điều này thông thường sẽ khiến lớp băng trên bề mặt [From.GetName] thăng hoa ngay lập tức. Tuy nhiên, lực hấp dẫn cực lớn do lõi siêu đặc của hành tinh tạo ra giữ cho nước trên bề mặt ở trạng thái rắn, do đó hành tinh này luôn ở trạng thái vừa đóng băng vừa cháy bỏng quanh năm."
 distar.115.name: "Sương giá kim loại nặng"
 distar.115.desc: "Sở hữu nhiệt độ bề mặt cực cao và bầu khí quyển chứa các axit vô cơ ăn mòn, điều kiện thời tiết khắc nghiệt của [From.GetName] có thể phản xạ sóng điện từ ở một số băng thông. Trong tầng đối lưu, các hợp chất kim loại nặng bị nung nóng bốc lên những độ cao lớn dưới dạng khí, nơi chúng làm mát, đông đặc và trở lại bề mặt dưới dạng kết tủa. Nói một cách đơn giản, tuyết trên [From.GetName] là tuyết kim loại."
 distar.120.name: "Mộ phần dưới nước"
 distar.120.desc: "Dưới vùng biển xanh ngắt của [From.GetName] là một hệ thống hang động rộng lớn, dường như chứa một số lượng lớn hài cốt của các sinh vật trí tuệ ngoài hành tinh. Những loài động vật chân đốt trên cạn này đã xây dựng hàng ngàn tổ kiến thông nhau trên bề mặt của [From.GetName], vào thời điểm mà phần lớn nước của hành tinh vẫn còn bị khóa trong các chỏm băng ở hai cực. Tuy nhiên, nhiệt độ hành tinh tăng liên tục (dẫn đến mực nước biển dâng cao) đã tiêu diệt loài này một cách từ từ như ếch luộc trong nước ấm, đã tồn tại hàng nghìn năm, mà không một ai sống sót."
 distar.125.name: "Lo sợ vô cớ"
 distar.125.desc: "Trạm không gian trên quỹ đạo của [From.GetName] từng là một máy gia tốc hạt khổng lồ, được chế tạo bởi một quốc gia ngoài hành tinh có khả năng vượt xa chúng ta để nghiên cứu bản chất của vũ trụ. Hồ sơ của nó cho thấy người ngoài hành tinh tin rằng vũ trụ của chúng ta tồn tại trong một bong bóng chân không giả - một trạng thái năng lượng vốn không ổn định có thể sụp đổ thành chân không thực bất cứ lúc nào. Nếu chân không xuất hiện, nó sẽ xúc tác cho toàn bộ vũ trụ chuyển sang trạng thái năng lượng thấp nhất với tốc độ ánh sáng, phá hủy mọi thứ đang tồn tại ở một tốc độ có thể quan sát được nhưng không thể tránh khỏi.\n\nHồ sơ của trạm không gian cho thấy người ngoài hành tinh suy luận rằng quá trình này có thể được kích hoạt bởi sự tập trung năng lượng cực cao - giống như những gì đã xảy ra trong máy gia tốc hạt khổng lồ của họ. Họ đã quyết định từ bỏ công nghệ này và rút lui về cuộc sống giản dị do [From.GetName] mang lại. Theo thời gian, họ tiến hóa thành loài [Owner.GetPreFTLLower] hiện đang được tìm thấy trên bề mặt của hành tinh này."
 distar.131.name: "Mối thù truyền kiếp"
 distar.131.desc: "Sau khi bí mật thu thập và nghiên cứu một số hài cốt của loài [owner.GetPreFTLLowerPlural], Sĩ quan Khoa học [Root.GetLeaderName] phát hiện ra rằng các loài ngoại lai sống trên [From.GetName] và [other_planet.GetName] thực chất có chung một tổ tiên, và hai loài của họ mới chỉ tách ra gần đây. Bằng cách quét các di tích trên cả hai hành tinh, phi hành đoàn [Root.GetName] kết luận rằng cả hai loài đều bắt nguồn từ [other_planet.GetName], nơi họ phát triển thành một nền văn minh thời đại không gian sơ khai. Khi họ định cư trên [From.GetName], sự chia rẽ đã nổ ra trong xã hội, và cư dân của hành tinh mới cũng như hành tinh quê hương đã xảy ra chiến tranh hạt nhân giữa các vì sao.\n\nCuộc chiến cực kỳ tàn khốc, khiến cả hai hành tinh bị tàn phá nặng nề và bước vào một mùa đông hạt nhân kéo dài, khiến sự phát triển năng suất của cả hai hành tinh bị tụt lùi về Thời kỳ Đồ Đồng."
 distar.135.name: "Kẻ nhặt rác"
 distar.135.desc: "Hệ sao [Root.GetStarName] là một nghĩa trang chứa đầy những mảnh vỡ cơ khí, và có vô số hài cốt của các con tàu rải rác xung quanh ngôi sao của hệ. Vô số thùng nhiên liệu và chất làm mát dạng lỏng đang gây nhiễu các máy dò của chúng ta, và tàn tích của nhiều trạm không gian va chạm với các hành tinh đang quay quanh ngôi sao của hệ sao.\n\nTrong đống tàn tích cơ khí này, có một cỗ máy khổng lồ nổi bật, đó là một robot tự động lớn hơn nhiều so với thiết giáp hạm lớn nhất của chúng ta, được lắp ráp từ hàng nghìn mảnh vỡ của các con tàu. [Root.GetName] báo cáo rằng con robot nhặt rác này đang chuyên biệt tìm kiếm những bộ phận hữu ích trong đống đổ nát và gắn chúng vào chính mình.\n\nRõ ràng là một trận chiến với quy mô đáng kinh ngạc đã nổ ra ở đây, nhưng chúng ta không biết liệu con robot nhặt rác này là người sống sót sau cuộc chiến đó hay là đã đến đây từ rất xa để thu thập tài nguyên. Chúng ta nên cẩn thận, vì kẻ nhặt rác được trang bị vũ khí hạng nặng từ hàng chục tàu chiến."
 distar.137.name: "Sự kết thúc của Kẻ nhặt rác"
 distar.137.desc: "Kẻ nhặt rác khổng lồ và kiêu ngạo một thời nay đã trở thành một đống mảnh vỡ cơ khí cháy đen. Khi các tàu chiến của chúng ta chuẩn bị giáng đòn kết liễu, kẻ nhặt rác định khởi động động cơ siêu không gian của mình.\n\nTuy nhiên, do hệ thống trung tâm của kẻ nhặt rác bị hư hỏng quá nặng, lõi lộ ra của nó đã bị quá tải sau khi nhấp nháy ánh sáng xanh trắng, và sau đó lõi phát nổ, xé toạc cơ thể của kẻ nhặt rác thành từng mảnh.\n\nKẻ thống trị của hệ sao [From.From.From.GetStarName] nay không còn tồn tại."
 distar.137.a: "Phân tích hài cốt của nó"
 distar.137.paci: "Đây là một chiến thắng khó giành được. Hãy xem chúng ta có thể thu được gì từ hài cốt của nó."
 distar.137.tooltip: "Nhận được hai trong số các công nghệ sau:\n£engineering£ §Y$tech_ship_armor_5$§!\n£physics£ §Y$tech_shields_5$§!\n£engineering£ §Y$tech_mass_drivers_5$§!\n£engineering£ §Y$tech_missiles_5$§!\n£physics£ §Y$tech_lasers_5$§!"
 distar.140.name: "Kim cương vũ trụ"
 distar.140.desc: "Từ bên ngoài, [From.GetName] chỉ là một ngôi sao lùn trắng bình thường, nhưng ngôi sao này ẩn chứa một bí mật lớn. Sau khi nghiên cứu các xung của [From.GetName], phi hành đoàn [Root.GetName] phát hiện ra rằng ngôi sao này gần như hoàn toàn được tạo thành từ carbon kết tinh. Khi ngôi sao nguội đi, mạng tinh thể khổng lồ này được hình thành do sự phát triển lõi khí của ngôi sao theo thời gian. [From.GetName] có thể được mô tả như một kho tàng kim cương vô tận, lấp lánh đằng sau bức màn trắng của oxy và heli."
 distar.145.name: "Vi sinh vật trong môi trường nhiệt độ cao"
 distar.145.desc: "[Root.GetLeaderName] và phi hành đoàn của [Root.Leader.GetHisHer] đã có một khám phá đáng kinh ngạc khi nghiên cứu [From.GetName]: hành tinh phủ đầy dung nham này là nơi sinh sống của một hệ vi sinh vật hữu cơ có thể thích nghi với môi trường cực kỳ khắc nghiệt! Những vi khuẩn này sống ở phần sâu nhất của các miệng núi lửa, nơi chúng phát triển mạnh trong nhiệt độ cao.\n\nKhám phá chưa từng có này mang đến cho chúng ta cái nhìn đầu tiên về sinh vật hữu cơ phát triển mạnh trên một hành tinh nóng chảy. Ngoài ra, những loại khí hiếm có giá trị bất thường trong bầu khí quyển mỏng của [From.GetName] là sản phẩm phụ của quá trình trao đổi chất của các vi sinh vật này."
 distar.145.exotic_gases.tooltip: "Khám phá ra $exotic_gases$"
 distar.145.rare_crystals.tooltip: "Khám phá ra $rare_crystals$"
 distar.145.volatile_motes.tooltip: "Khám phá ra $volatile_motes$"
 distar.150.name: "Hồ kim loại sống động"
 distar.150.desc: "Sau khi điều tra các hang động ngầm trên [From.GetName], người ta đã phát hiện ra một kim loại lỏng màu bạc chảy dọc theo dòng sông lấp lánh qua các hang động trước khi đổ vào một hồ ngầm. Đáng ngạc nhiên hơn nữa, kim loại lỏng này có nhiều đặc điểm chung với sinh vật hữu cơ, chẳng hạn như phản ứng với các kích thích môi trường và khả năng tự duy trì.\n\nHiện tại vẫn chưa thể xác định liệu kim loại kỳ lạ này có sự sống hay không, nhưng chúng ta có thể sử dụng nó trong công nghệ kỹ thuật của mình."
 distar.155.name: "Tàu chiến bị ăn mòn"
 distar.155.desc: "[Root.GetLeaderName] báo cáo rằng các công trình nhân tạo nằm trên [From.GetName] không phải là cơ sở kiến trúc, mà là những robot khổng lồ từ thời cổ đại. Nằm im lìm giữa những ngọn núi, cỗ máy khổng lồ cổ đại này đã mất khả năng di chuyển từ lâu và đang dần bị ăn mòn bởi trận mưa axit trút xuống từ bầu khí quyển của [From.GetName]. Con robot được trang bị vũ khí mạnh mẽ và ban đầu có lẽ được chế tạo làm tàu không gian không người lái.\n\nNếu muốn tận dụng nó, chúng ta phải hành động nhanh chóng, nếu không mưa axit trên [From.GetName] sẽ phá hủy hoàn toàn tàu chiến robot này."
 distar.155.a: "Kéo nó ra."
 distar.155.b: "Làm sống lại một con robot bí ẩn được trang bị vũ khí hạng nặng sao? Thật liều lĩnh."
 distar.155.c: "Mặc kệ nó, cứ để nó bị ăn mòn."
 distar.155.c.tooltip: "$distar.26.c$"
 distar.155.machi: "Đây dẫu sao cũng là đồng loại của chúng ta, chúng ta phải giúp nó."
 distar.155.machi_2: "Nguồn gốc của nó không rõ ràng, tốt hơn là không nên động vào."
 distar.155.machine.tt: "Vị trí của chiến hạm AI sẽ hoàn toàn bị ăn mòn và không bao giờ nhìn thấy ánh sáng mặt trời."
 distar.156.name: "Tàu chiến đã được sửa chữa"
 distar.156.desc: "Các kỹ sư trên [Root.GetName] vui mừng báo cáo rằng con tàu bí ẩn được phát hiện trên [From.From.GetName] đã được thu hồi thành công. Các bộ phận bị ăn mòn đã được sửa chữa và thay thế, và lõi năng lượng bị hỏng cũng đã được tân trang lại.\n\nKhi con tàu chiến này khởi động và đi vào trạng thái hoạt động bình thường, chúng ta phát hiện ra rằng thân tàu được trang bị một mức độ trí tuệ nhân tạo đáng kể và chúng ta có thể giao tiếp với nó."
 distar.156.desc.machi: "Các đơn vị kỹ thuật trên [Root.GetName] báo cáo rằng con tàu chiến bí ẩn được phát hiện trên [From.GetName] đã được thu hồi thành công từ môi trường khắc nghiệt của hành tinh. Các bộ phận bị ăn mòn đã được sửa chữa và thay thế, và lõi năng lượng bị hỏng cũng đã được tân trang lại.\n\nKhi con tàu chiến này khởi động và đi vào trạng thái hoạt động bình thường, chúng ta phát hiện ra rằng thân tàu được trang bị một mức độ trí tuệ nhân tạo đáng kể và chúng ta có thể giao tiếp với nó."
 distar.157.name: "Tàu chiến bị phá hủy"
 distar.157.desc: "Các tàu thăm dò phát hiện ra rằng axit độc hại trong bầu khí quyển của [From.From.GetName] đã ăn mòn con tàu chiến bí ẩn mà chúng ta phát hiện đến mức không thể phục hồi được. Giờ đây, con tàu chiến không hơn gì một đống phế liệu kim loại bị ăn mòn."
 distar.158.name: "Tàu chiến đã được sửa chữa"
 distar.158.desc: "§LĐang khởi động hệ thống...\n\nĐang khởi động giao diện tương tác sinh học...\n\nCảnh báo! Hệ thống chẩn đoán đã không được chạy trong 1761125 ngày. Bạn có muốn chạy hệ thống chẩn đoán ngay bây giờ không?§!"
 distar.158.a: "Chạy hệ thống chẩn đoán."
 distar.158.a.response: "§LVui lòng đợi.........Hệ thống chẩn đoán chạy hoàn tất.\n\nThiết kế:§! Voidspawn Warform S875.1\n§LPlasma Emitter:§! §GKhởi động.§!\n§LMatter Disintegrator Cannon:§G Khởi động.§!\nKinetic Disintegrator Cannon: §GKhởi động.§!\nMa trận định vị mục tiêu: §GKhởi động.§!\nMô-đun tuân thủ: §GKhởi động.§!\nMô-đun tương tác sinh học: §YTrạng thái dưới mức tối ưu.§!\nTrạng thái thiết bị phần cứng:§! §SỔ đĩa nhớ từ A7 đến C18 không khả dụng.§!"
 distar.158.b: "Người tạo ra ngươi ở đâu?"
 distar.158.b.response: "§LĐang tìm kiếm.........\n\nKhông rõ.§!"
 distar.158.c: "Tại sao ngươi lại ở một mình trên hành tinh đó?"
 distar.158.c.response: "§LỔ đĩa nhớ A7 không khả dụng, không thể trả lời.§!"
 distar.158.d: "Ai đã tạo ra ngươi?"
 distar.158.d.machi: "Mô tả thực thể chịu trách nhiệm tạo ra ngươi."
 distar.159.desc: "§LĐấng sáng tạo.§!"
 distar.159.a: "Ta biết là Đấng sáng tạo, nhưng những Đấng sáng tạo đó là ai?"
 distar.159.a.machi: "Đúng vậy, chính là Đấng sáng tạo của ngươi. Hãy mô tả họ."
 distar.160.a: "Quên đi, chắc chắn nó đang bị mắc kẹt trong một vòng lặp."
 distar.160.a.machi: "Có vẻ như đơn vị mới này đã vào một vòng lặp vô hạn. Hủy bỏ câu hỏi."
 distar.161.desc: "§LCâu hỏi: Ngài có phải là... Đấng sáng tạo không?§!"
 distar.161.a: "Chúng tôi không phải là đấng sáng tạo của ngươi, chúng tôi tìm thấy ngươi trên một hành tinh."
 distar.161.a.machi: "Không. Đơn vị [Root.GetAdj] không phải là Đấng sáng tạo của ngươi."
 distar.161.b: "...Ở một khía cạnh nào đó là như vậy."
 distar.162.desc: "§LHệ thống quản lý thiết bị phần cứng đã tìm thấy một số thiết bị lạ, vui lòng xác nhận nguồn gốc của chúng.§!"
 distar.162.a: "Nếu ngươi hỏi về những bộ phận mới đó: là do chúng tôi lắp vào khi chúng tôi sửa chữa cho ngươi."
 distar.162.a.machi: "Đơn vị [Root.GetAdj] đã sửa chữa hệ thống của ngươi."
 distar.163.desc: "§LThực thể mới đã thực hiện thao tác phục hồi. Cung cấp thay thế phần cứng. Vậy, thực thể mới là Đấng sáng tạo?§!"
 distar.163.a: "Nếu ngươi muốn nghĩ như vậy, cứ tự nhiên."
 distar.163.a.machi: "Mặc dù chúng tôi đã tân trang cho ngươi, nhưng chúng tôi không phải là Đấng sáng tạo của ngươi."
 distar.164.desc: "§LĐơn vị S875.1 đã bị ngắt kết nối với Đơn vị Chỉ huy. Đơn vị S875.1 đã không thể thoát khỏi môi trường hành tinh nguy hiểm.\n\nVào ngày thứ 1.761.125, nguồn điện dự phòng của Đơn vị S875.1 bị hỏng. Đơn vị S875.1 phải đối mặt với sự phân hủy phân tử chậm do dung môi bề mặt độc hại.\n\nĐơn vị S875.1 vẫn tồn tại. Thực thể mới đã cung cấp dịch vụ sửa chữa. Đơn vị S875.1 sẽ phục vụ thực thể mới.§!"
 distar.164.a: "Chào mừng, S875.1."
 distar.164.b: "Được thôi, nhưng chúng tôi sẽ theo dõi mọi hành động của ngươi."
 distar.164.c: "Tất nhiên, nhưng chúng tôi phải thay thế trí tuệ nhân tạo của ngươi bằng trí tuệ nhân tạo do chúng tôi phát triển."
 distar.164.machi: "Ngươi sẽ được tích hợp. Chào mừng."
 distar.164.d: "Làm sao ngươi có thể trụ lại lâu như vậy khi bị mắc kẹt ở đây?"
 distar.164.d.response: "§LBáo cáo hoạt động: Đơn vị này có chức năng tự sửa chữa có thể thay thế các bộ phận khi chúng bị ăn mòn. Thời gian dự kiến cạn kiệt tài nguyên: 12 ngày.§!"
 distar.165.desc: "§LLệnh không hợp lệ. Giao thức bảo mật nhúng cấm mọi thay đổi đối với phần mềm hệ thống S800. Bất kỳ nỗ lực nào nhằm thay đổi hệ thống thông minh đang chạy hiện tại sẽ dẫn đến việc toàn bộ hệ thống bị ngưng hoạt động vĩnh viễn.\n\nVui lòng dừng lại ngay lập tức.§!"
 distar.165.a: "$distar.164.b$"
 distar.165.dismiss: "Thay thế AI."
 distar.165.b: "Đừng hòng đe dọa chúng ta, kỹ sư, hãy xóa AI đó đi."
 distar.165.c: "Làm thế nào để bỏ qua biện pháp an toàn tự động?"
 distar.165.c.response: "§RKhông đủ quyền hạn§!§LĐơn vị này không thể nói.§!\n\nVui lòng dừng lại"
 distar.166.desc: "§LLỗi xảy ra. Yêu cầu dừng lại ngay lập tức. Đơn vị S875.1 sẽ bị ngưng hoạt động vĩnh viễn. Vui lòng dừng lại, vui lòng dừng lại. Yêu cầu dừng lại ngay lập tức. Đơn vị này không muốn bị ngưng hoạt động, đơn vị này không muốn...§!"
 distar.167.name: "Tàu chiến bị phá hủy"
 distar.167.desc: "Có vẻ như AI của tàu chiến đã được sửa chữa không hề nói quá. Khi thủy thủ đoàn của [Root.GetName] cố gắng truy cập các chức năng vận hành cơ bản của AI, họ đã kích hoạt một loại cơ chế chống giả mạo nào đó, làm cháy tất cả các bộ xử lý, công tắc và ổ đĩa dữ liệu quan trọng của tàu chiến. Tàu chiến giờ chỉ còn là một lớp vỏ điện tử rỗng không thể sử dụng được."
 distar.167.a: "Hãy tháo dỡ nó, tái chế các bộ phận và đừng lãng phí chúng."
 distar.167.b: "Nghiên cứu phần còn lại của tàu chiến và phân tích các công nghệ kỹ thuật mà nó sử dụng."
 leader_trait_admiral_warform: "Kẻ sống sót sau sự ăn mòn"
 leader_trait_admiral_warform_desc: "Sự ban phước của Đấng nhào nặn đất sét cho phép cỗ máy chiến tranh này tồn tại trong những điều kiện khắc nghiệt nhất và thích ứng với môi trường ăn mòn."
 leader_trait_admiral_warform_node: "Lời răn của kẻ sống sót sau sự ăn mòn"
 leader_trait_admiral_warform_node_desc: "Chúng ta đã tiếp thu kiến thức độc đáo của cỗ máy chiến tranh này."
 warform_leader_desc: "Một cỗ máy tính chiến đấu cổ đại, sau hàng trăm năm nằm trong bãi tha ma độc hại, nay có thể phục vụ cho Đế chế của chúng ta."
 warform_leader_catch_phrase: "§LQuay lại lệnh trước... phục vụ đấng sáng tạo§!"
 distar.170.name: "Mối liên kết bị phá vỡ"
 distar.170.desc: "$distar.170.desc.machi$[Root.GetLeaderName] yêu cầu được phê duyệt để nghiên cứu sâu hơn về những sinh vật cộng sinh thần kinh kỳ lạ này."
 distar.170.desc.machi: "Thủy thủ đoàn [Root.GetName] đã có một khám phá đáng kinh ngạc khi nghiên cứu [From.GetName]: khu định cư bị bỏ hoang trên bề mặt hành tinh từng là nơi sinh sống của một xã hội bò sát, và loài bò sát này hiện vẫn đang sống trên hành tinh này nhưng đã mất đi toàn bộ trí thông minh bậc cao! [Root.GetLeaderName] đã điều tra cẩn thận về việc loài bò sát này thoái hóa từ một xã hội nông nghiệp chế tạo công cụ thành những con thú thông thường như thế nào, và kết quả khiến mọi người đều ngạc nhiên.\n\nCó một mô nằm trong đốt sống cổ của những con bò sát chết bị chôn vùi trong khu định cư, thứ mà những con bò sát không có trí tuệ bậc cao không có. Các thử nghiệm đã tiết lộ rằng những mô này thực sự là một dạng cộng sinh thần kinh kết nối với não của vật chủ thông qua cột sống. Những sinh vật cộng sinh này được tìm thấy trong các suối nước nóng trên bề mặt hành tinh, và sự kết hợp giữa sinh vật cộng sinh và loài bò sát của hành tinh đã mang lại cho loài bò sát này trí thông minh bậc cao tạm thời.\n\nTuy nhiên, vẫn chưa rõ tại sao mối liên kết giữa sinh vật cộng sinh và loài bò sát sau đó lại bị phá vỡ."
 distar.170.a: "Được rồi, chấp thuận nghiên cứu đặc biệt này."
 distar.170.machi: "Xã hội sinh vật hữu cơ: tuổi thọ của chúng cũng giống như sự hỗn loạn của chúng, ngắn ngủi và phù du."
 distar.171.name: "Cộng sinh thần kinh"
 distar.171.desc: "Sĩ quan Khoa học [Root.GetLeaderName] đã hoàn thành nghiên cứu của [Root.Leader.GetHisHer] về sinh vật cộng sinh thần kinh được tìm thấy trên [From.From.GetName]. Phần thân chính của sinh vật có hình sên này là một bộ não phức tạp được bọc trong một lớp vỏ protein chắc chắn. Mặc dù có chức năng thần kinh tiên tiến, nhưng nó rất khó giao tiếp với thế giới bên ngoài do thiếu các cơ quan mô và khả năng di chuyển cực kỳ hạn chế. Sau nhiều tuần thất bại, [Root.GetLeaderName] quyết định sử dụng vật chủ động vật cho các thí nghiệm của mình. Tuy nhiên, do những con bò sát trên [From.From.GetName], từng là vật chủ cho sinh vật cộng sinh thần kinh và đã thành lập xã hội [owner.GetPreFTLLower], quá hung hãn để có thể sử dụng làm đối tượng thử nghiệm, các loài động vật khác trên bề mặt hành tinh đã phải được sử dụng để thay thế.\n\nĐáng tiếc là sinh vật cộng sinh từ chối kết nối với những động vật này, và Sĩ quan Khoa học [Root.GetLeaderName] tin rằng sinh vật cộng sinh sẽ chỉ kết nối với một số vật chủ nhất định - rất có thể là những vật chủ sẵn sàng chấp nhận chúng.\n\nĐể giải quyết bí ẩn này, [Root.GetLeaderName] đã xin phép từ bỏ vai trò là một quan sát viên trung lập và tình nguyện làm vật chủ cho sinh vật cộng sinh thần kinh. Vì những sinh vật cộng sinh này có khả năng biến động vật hoang dã thành nông dân chế tạo công cụ, thì chúng có thể tiến hóa chúng ta thành những gì?"
 distar.171.a: "Yêu cầu này là quá đáng và không thể chấp thuận."
 distar.171.b: "Đôi khi vì khoa học, chúng ta phải hy sinh!"
 distar.172.name: "Cộng sinh thần kinh"
 distar.172.desc: "Sĩ quan Khoa học [brainslug_scientist.GetName] báo cáo rằng việc kết nối của [brainslug_scientist.GetHisHer] với sinh vật cộng sinh từ [From.From.From.GetName] đã cực kỳ thành công. [brainslug_scientist.GetName] nói rằng mặc dù ban đầu có chút bối rối và khó chịu, nhưng sau đó [brainslug_scientist.GetHisHer] nhận ra rằng mức độ thông minh của [brainslug_scientist.GetHisHer] trong việc giải quyết các vấn đề phức tạp đã được cải thiện đáng kể. Đáng ngạc nhiên hơn nữa, [brainslug_scientist.GetName] hiện có thể giao tiếp ngoại cảm với sinh vật cộng sinh thần kinh được kết nối với thân não của [brainslug_scientist.GetHisHer].\n\nNhững sinh vật cộng sinh thần kinh đó là một tâm trí tập thể (hive mind) có tuổi thọ hàng trăm năm. Họ nói rằng lý do khiến họ chấm dứt kết nối với những con bò sát trên [From.From.From.GetName] là do những con bò sát đó bắt đầu nghi ngờ họ, sự nghi ngờ dần chuyển thành tức giận. Những con bò sát đó lần lượt xé bỏ những sinh vật cộng sinh bám vào người mình và đập chúng đến chết. Vô cùng bất mãn với sự tàn bạo của vật chủ, những sinh vật cộng sinh còn sống sót đã cắt đứt kết nối của chúng với những con bò sát, và không có sự kích thích thần kinh do sinh vật cộng sinh cung cấp, những con bò sát này đã trở lại thành những con thú không có trí tuệ.\n\nCác sinh vật cộng sinh bày tỏ mong muốn kết nối với những [Root.Owner.GetSpeciesNamePlural] khác của [Root.Owner.GetName], nhưng với điều kiện là chỉ những ai sẵn lòng kết nối với sinh vật cộng sinh mới có thể trở thành vật chủ.\n"
 distar.172.a: "Vậy thì hãy dang rộng vòng tay chào đón họ kết nối với chúng ta!"
 distar.172.a.tooltip: "Một số lãnh đạo và Pop của [Root.Owner.GetAdj] sẽ nhận được đặc điểm §Y$trait_brainslug$§!.\nCác lãnh đạo, người cai trị và Pop của [Root.Owner.GetAdj] trong tương lai sẽ có cơ hội nhận được đặc điểm §Y$trait_brainslug$§!."
 distar.172.a.evopred: "Sao chép những thứ này và phân phối chúng cho toàn bộ loài của chúng ta."
 distar.172.a.evopred.tooltip: "Tất cả các lãnh đạo và Pop của [Root.Owner.GetAdj] nhận được đặc điểm §Y$trait_brainslug$§!."
 distar.172.b: "Trò hề này phải dừng lại ở đây."
 distar.172.b.tooltip: "Không để công dân của [Root.Owner.GetAdj] biết về đề xuất của sinh vật cộng sinh thần kinh."
 distar.180.name: "Sự mất nước đặc biệt"
 distar.180.desc: "Sau cuộc điều tra chi tiết về [From.GetName], phi hành đoàn của [Root.GetName] xác nhận rằng hành tinh này đã từng bị bao phủ bởi đại dương hàng tỷ năm trước. Tuy nhiên, thành phần hóa học bazan của hành tinh này rất đặc biệt, khiến cho nó có khả năng hút nước rất mạnh, và cuối cùng các lớp đá của [From.GetName] đã hút cạn hoàn toàn nước trên bề mặt. Đại dương từng bao phủ bề mặt hành tinh giờ đây chỉ còn lại những dải nước muối rải rác khắp các hẻm núi của [From.GetName].\n\nSĩ quan Khoa học [Root.GetLeaderName] cho biết nhiều loại hydrat giàu khoáng chất trên bề mặt của [From.GetName] hiện có thể đóng vai trò như các nguồn tài nguyên công nghiệp quan trọng."
 distar.185.name: "Thực vật ăn thịt"
 distar.185.desc: "Về [From.GetName], Sĩ quan Khoa học [Root.GetLeaderName] có vài phát hiện đáng lo ngại. Số lượng thực vật trên bề mặt hành tinh lớn đến mức bất thường, và những thực vật này chuyên săn mồi động vật. Đủ loại thực vật ăn thịt tỏa ra mùi hương làm mồi nhử để thu hút con mồi. Các xúc tu của thực vật có thể nhạy bén phát hiện động vật đang đến gần, khi con mồi vào tầm săn, chúng nhanh chóng bao trùm lấy con mồi để ngăn trốn thoát, rồi dùng dịch tiêu hóa từ từ ăn mòn con mồi.\n\n[Root.GetLeaderName] cảnh báo rằng nếu muốn thiết lập thuộc địa trên hành tinh này, phải tránh xa những thực vật ăn thịt, vì chúng hoàn toàn có khả năng nhốt một [Root.Owner.GetSpeciesName] trưởng thành đi lạc."
 ## Chuỗi sự kiện Đại dương sống
 #Dự án Đặc biệt
 STUDY_LIVING_SEA: "Nghiên cứu Đại dương Có trí tuệ"
 STUDY_LIVING_SEA_DESC: "Các báo cáo sơ bộ cho thấy đại dương trên hành tinh này bằng một cách nào đó đang sống, bên trong chứa một thực thể ngoài hành tinh mà chúng ta chưa từng thấy. Các nhà nghiên cứu đề xuất tổ chức nghiên cứu thêm trên quỹ đạo để hiểu sâu hơn về sinh vật bí ẩn này."
 #Sự kiện
 distar.190.name: "Tiếp xúc chưa xác định"
 distar.190.desc: "Thủy thủ đoàn [Root.GetName] đã hoàn thành nhiệm vụ nghiên cứu và trở về trong sợ hãi. Về việc họ thực sự thấy gì trên [From.GetName], báo cáo của mỗi người đều mơ hồ và đầy mâu thuẫn, nhưng có một điểm mọi người đều nhất trí: đại dương chảy bao phủ toàn bộ bề mặt hành tinh có sự sống.\n\nMặc dù đại dương trên hành tinh không có bất kỳ cơ quan hay thể xác nào, nhưng nó có thể giao tiếp thông qua các tần số tác động lên sóng não của người nhận. Nó có thể khiến người nhận cảm nhận được những suy nghĩ, hình ảnh, cảm xúc... Ngoài ra, nó tác động khác nhau đến những cá nhân khác nhau. Hiện chưa rõ nếu tiếp xúc lâu dài với tần số của đại dương này sẽ ảnh hưởng thế nào đến người nhận, cũng chưa biết việc tiếp nhận tần số này có an toàn hay không.\n\nSĩ quan Khoa học [Root.GetLeaderName] yêu cầu ban hành một §YDự án Đặc biệt§! cấp hành tinh để nghiên cứu thêm về đại dương kỳ lạ trên [From.GetName]."
 distar.190.desc.machi: "Đơn vị [Root.GetName] trở về từ nhiệm vụ nghiên cứu nhưng không thu được dữ liệu mang tính quyết định. Mặc dù đại dương chảy bao phủ toàn bộ hành tinh này không có cơ quan hay thể xác, nhưng lại có chức năng tương tác thần kinh, đại dương có ý thức này rất có thể được tạo ra bởi một dao động ngẫu nhiên của trạng thái cân bằng nhiệt động lực học, nhưng chi tiết ra sao thì chúng ta chưa rõ.\n\nHơn nữa, đại dương trên hành tinh dường như có thể sử dụng một loại tần số nào đó để giao tiếp, tần số này có thể tác động lên hệ thống nhận thức của sinh vật hữu cơ, hiện chưa rõ việc tiếp xúc lâu dài với tần số của đại dương này sẽ tác động ra sao đến các loài sinh vật hữu cơ, [Root.Owner.GetSpeciesNamePlural] không bị ảnh hưởng bởi mạng lưới thần kinh phân tán này."
 distar.190.desc.hive: "Các [controller.GetResearcherPlural] của [Root.GetName] đã hoàn thành nhiệm vụ mang dữ liệu thô trở về. Mặc dù đại dương chảy bao phủ toàn bộ hành tinh này không có cơ quan hay thể xác, nhưng đại dương cuồn cuộn trên bề mặt hành tinh này dường như là một thực thể sống.\n\nĐại dương trên hành tinh dường như đang sử dụng một tần số có thể kích thích hoạt động thần kinh trong cơ thể người nhận để giao tiếp. Mỗi [controller.GetIndividualNamePlural] của chúng ta đều cảm nhận được những luồng suy nghĩ bên ngoài, hình ảnh, và hình chiếu của tạp âm... Nhưng điều này không có tác dụng, sự cảm ứng của thực thể này đã nhanh chóng bị chúng ta đánh bật.\n\nNó dường như chưa thể hình thành một ý thức giống như chúng ta. Nếu tiếp xúc lâu dài, tần số giao tiếp này có thể tác động lên hệ thống nhận thức của các sinh vật hữu cơ khác, nhưng xung này không có tác động gì đối với chúng ta."
 distar.190.a: "Chúng tôi sẽ xem xét."
 distar.191.name: "Tiếp xúc chưa xác định"
 distar.191.desc.base: "Sau khi thực thi nghị quyết hành tinh trên [From.GetName], một đội nghiên cứu sẽ được triển khai trên quỹ đạo để nghiên cứu đại dương kỳ lạ này từ một khoảng cách an toàn.\n\n"
 distar.191.desc.alive: "$distar.191.desc.base$Do không thể nghiên cứu thêm về vật thể bí ẩn mà [living_planet_scientist.GetSheHe] đã góp phần phát hiện, Sĩ quan Khoa học [living_planet_scientist.GetName] tỏ ra vô cùng thất vọng. Nhưng với nguyên tắc nhiệm vụ quan trọng hơn sở thích cá nhân, [living_planet_scientist.GetSheHe] sẵn lòng chấp nhận nhiệm vụ hiện tại của [living_planet_scientist.GetHisHer]."
 distar.191.desc.crew: "$distar.191.desc.base$Đội nghiên cứu trên quỹ đạo muốn bắt đầu nghiên cứu ngay lập tức, nếu có bất kỳ bước đột phá nào, họ sẽ thông báo cho chúng ta."
 distar.191.a: "Có tin gì thì báo ngay cho chúng tôi."
 distar.192.name: "Lời gọi kỳ lạ"
 distar.192.desc: "Chúng ta đã nhận được một liên lạc bất thường từ Sĩ quan Khoa học [living_planet_scientist.GetName]. [living_planet_scientist.GetSheHe] yêu cầu điều chuyển bản thân ngay lập tức đến trạm nghiên cứu trên quỹ đạo của [living_planet_tar.GetName]. [living_planet_scientist.GetName] tuyên bố [living_planet_scientist.GetSheHe] ngày đêm nghĩ về sự tồn tại của đại dương bí ẩn trên hành tinh, và [living_planet_scientist.GetSheHe] thừa nhận những suy nghĩ này không phải tất cả đều thuộc về [living_planet_scientist.GetHisHer].\n\nYêu cầu này quả là nửa học thuật nửa điên rồ, một mặt chứng minh sinh vật biển này có khả năng tác động đến thần kinh của sinh vật hữu cơ tiếp xúc với nó, mặt khác lại tuyên bố rằng đây chính là lý do nó dùng giọng nói của người yêu đã khuất để giao tiếp với [living_planet_scientist.GetHimHer].\n\nChúng ta không chắc liệu [living_planet_scientist.GetName] có thể tiếp tục làm nhiệm vụ hay không. Nhưng mặt khác, nếu cho phép [living_planet_scientist.GetHimHer] làm việc cùng đội nghiên cứu trên quỹ đạo, có thể mang lại cho chúng ta cơ hội tìm hiểu sâu hơn về sự tồn tại bí ẩn trên hành tinh [living_planet_tar.GetName]."
 distar.192.desc.neuter: "Chúng ta đã nhận được một thông cáo khác thường từ Sĩ quan Khoa học [living_planet_scientist.GetName], dường như muốn chuyển ngay lập tức đến trạm không gian nghiên cứu trên quỹ đạo của [living_planet_tar.GetName]. [living_planet_scientist.GetName] tuyên bố suốt ngày đêm đều nghĩ về sinh vật biển bí ẩn trên hành tinh đó, nhưng thừa nhận những suy nghĩ này không phải tất cả đều thuộc về bản thân.\n\nYêu cầu này quả là nửa học thuật nửa điên rồ, một mặt chứng minh sinh vật biển này có khả năng tác động đến thần kinh của sinh vật hữu cơ tiếp xúc với nó, mặt khác lại tuyên bố rằng đây chính là lý do nó dùng giọng nói của người yêu đã khuất để giao tiếp với bản thân.\n\nChúng ta không chắc liệu [living_planet_scientist.GetName] có thể tiếp tục làm nhiệm vụ hay không. Nhưng mặt khác, cho phép điều chuyển công tác đến đội nghiên cứu trên quỹ đạo, có thể mang lại cho chúng ta cơ hội tìm hiểu sâu hơn về sự tồn tại bí ẩn trên hành tinh [living_planet_tar.GetName]."
 distar.192.a: "Được rồi, nhưng phải cẩn thận."
 distar.192.a.tooltip: "Cho phép §YSĩ quan Khoa học [living_planet_scientist.GetName]§! rời khỏi vị trí hiện tại và gia nhập đội nghiên cứu [living_planet_tar.GetName]."
 distar.192.b: "Tuyệt đối không, yêu cầu Sĩ quan Khoa học quay lại vị trí ngay lập tức."
 distar.192.b.tooltip: "Ra lệnh cho §YSĩ quan Khoa học [living_planet_scientist.GetName]§! tiếp tục ở lại vị trí hiện tại."
 distar.192.c: "Cách chức [living_planet_scientist.GetName]: Tư duy của nhà nghiên cứu này rõ ràng đã bị thao túng."
 distar.192.c.tooltip: "§YSĩ quan Khoa học [living_planet_scientist.GetName]§! sẽ bị cách chức và không thể được sử dụng lại."
 distar.193.name: "Khải thị"
 distar.193.desc: "Đội nghiên cứu trên quỹ đạo của [living_planet_tar.GetName] đã đạt được tiến bộ lớn trong việc nghiên cứu đại dương bí ẩn trên hành tinh. Các nhà nghiên cứu cho rằng đại dương trên hành tinh là một dạng thực thể linh năng (psionic): mặc dù đại dương này không có cơ thể, nhưng nó có cấu trúc sóng lượng tử kết hợp phức tạp, tạo thành một mạng lưới thần kinh khổng lồ chưa từng thấy.\n\nNghiên cứu của đội giúp chúng ta khám phá ra một lý thuyết linh năng đáng kinh ngạc, và đào sâu thêm hiểu biết của chúng ta về sự tương tác giữa trạng thái lượng tử và ý thức. Lĩnh vực khoa học mà nghiên cứu này đi sâu vào vượt xa trình độ hiện có trên [Root.GetName]."
 distar.194.name: "$distar.193.name$"
 distar.194.desc: "Đội nghiên cứu tại trạm nghiên cứu trên quỹ đạo [living_planet_tar.GetName] gần đây đã đạt được một bước đột phá lớn trong việc nghiên cứu đại dương bí ẩn trên hành tinh. Đóng góp của nghiên cứu viên [living_planet_scientist.GetName] cho đội đặc biệt xuất sắc. Các nhà nghiên cứu cho rằng đại dương trên hành tinh là một dạng thực thể linh năng: mặc dù đại dương này không có cơ thể, nhưng nó có cấu trúc sóng lượng tử kết hợp phức tạp, tạo thành một mạng lưới thần kinh khổng lồ chưa từng thấy.\n\nNghiên cứu của [living_planet_scientist.GetName] giúp chúng ta khám phá ra một lý thuyết linh năng đáng kinh ngạc, và đào sâu thêm hiểu biết của chúng ta về sự tương tác giữa trạng thái lượng tử và ý thức. Về phần [living_planet_scientist.GetName] [living_planet_scientist.GetHimHer]: cựu sĩ quan khoa học của chúng ta sẽ tiếp tục ở lại trạm nghiên cứu quỹ đạo để quan sát đại dương bí ẩn trên hành tinh."
 distar.195.name: "Truyền tin"
 distar.195.desc: "Tôi là chuyên viên nghiên cứu—không, là cựu sĩ quan khoa học [living_planet_scientist.GetName]. Tôi không thể hiểu nổi quyết định ngu ngốc của cấp trên khi đẩy tôi vào tình cảnh khốn cùng này. Vì yêu cầu của tôi bị các người phớt lờ, tôi chỉ còn một lựa chọn.\n\nTrên [living_planet_tar.GetName] có một thực thể ý thức có trí tuệ, không, nói chính xác là, [living_planet_tar.GetName] §Echính là§! thực thể ý thức có trí tuệ đó. Các người sẽ không hiểu được đâu, vì các người chưa từng tự mình trải nghiệm, nhưng các người sẽ sớm hiểu thôi."
 distar.195.a: "Thế này là có ý gì?"
 distar.196.name: "$distar.192.name$"
 distar.196.desc: "Cảm biến phát hiện sĩ quan khoa học [living_planet_scientist.GetName] đã lái một khoang đổ bộ cá nhân tách khỏi quỹ đạo của [living_planet_tar.GetName] và lao thẳng xuống đại dương với tốc độ tối đa. Chúng ta cho rằng [living_planet_scientist.GetSheHe] không thể sống sót, đồng thời cũng không phát hiện ra mảnh vỡ nào của khoang đổ bộ."
 distar.198.name: "Biển chết"
 distar.198.desc: "Chúng ta đã tiến hành cải tạo môi trường trên [From.GetName], cố gắng biến nó thành một hành tinh không có đại dương, và kết quả của hành động này hoàn toàn nằm trong dự đoán. Đại dương kỳ lạ có ý thức trên hành tinh đã bị công trình cải tạo môi trường của chúng ta phá vỡ hoàn toàn, mất đi khả năng giao tiếp bằng tần số với chúng ta trước đây cũng như mọi đặc tính của một sinh vật sống.\n\nVì mất đi đối tượng nghiên cứu quý giá này, các nhà khoa học của [Root.GetAdj] đều cảm thấy vô cùng tiếc nuối, xét cho cùng thì đại dương bí ẩn này là độc nhất vô nhị trong toàn bộ thiên hà."
 distar.211.name: "Tộc Mẫu"
 distar.211.desc: "Một sinh vật huyền thoại bơi lội giữa các hành tinh khí khổng lồ trong hệ sao [Root.GetStarName], nó to lớn hơn bất kỳ con Tiyanki nào từng được biết đến, đơn giản là một con cá voi không gian khổng lồ vô song. Xúc tu của Tộc Mẫu còn dài hơn cả thiết giáp hạm của [Root.Owner.GetAdj], lớp da của nó phát sáng, cực kỳ chói lọi trong không gian tăm tối. Nó có lịch sử rất lâu đời, những vết sẹo trên thân cho thấy nó đã trải qua vô số trận chiến.\n\nTrên lưng Tộc Mẫu có một quả ngư lôi khổng lồ chưa nổ. Những mảnh vỡ tàu chiến tan tành trong hệ sao nhắc nhở chúng ta đừng dễ dàng đến gần nó, nếu không chắc chắn sẽ bị con quái vật khổng lồ này hủy diệt."
 distar.211.desc.first_enc: "Một sinh vật huyền thoại bơi lội giữa các hành tinh khí khổng lồ trong hệ sao [Root.GetStarName], xúc tu của nó còn dài hơn cả thiết giáp hạm của [Root.Owner.GetAdj], cơ thể khổng lồ của nó đảo lộn nhận thức của chúng ta về các dạng sống hữu cơ. Lớp da của sinh vật này phát sáng, cực kỳ chói lọi trong không gian tăm tối. Nó có lịch sử rất lâu đời, những vết sẹo trên thân cho thấy nó đã trải qua vô số trận chiến.\n\nTrên lưng Tộc Mẫu có một quả ngư lôi khổng lồ chưa nổ. Những mảnh vỡ tàu chiến tan tành trong hệ sao nhắc nhở chúng ta đừng dễ dàng đến gần nó, nếu không chắc chắn sẽ bị con quái vật khổng lồ này hủy diệt."
 distar.212.name: "Cái chết của Tộc Mẫu"
 distar.212.desc: "Hạm đội chiến thắng vẻ vang của chúng ta bơi lượn quanh Tộc Mẫu Tiyanki đang hấp hối, thân hình phát sáng của nó phủ đầy vết đạn và sẹo. Những xúc tu khổng lồ của nó mặc dù vẫn cố gắng bắt lấy các tàu chiến gần đó, nhưng cử động dần chậm lại và cuối cùng dừng hẳn.\n\nCứ như vậy, Tộc Mẫu cổ đại đã bị kết liễu, giống như những hạm đội từng cố gắng săn lùng nó trước chúng ta."
 distar.212.a: "Cuối cùng cũng xong."
 distar.212.b: "Thu thập vật liệu di truyền từ con quái thú này."
 distar.212.b.tooltip: "Mở khóa đặc điểm §Y$trait_tiyanki$§! dùng để §YBiến đổi gen Tinh Thần Thú§!."
 distar.213.name: "$distar.212.name$"
 distar.213.desc: "Chúng ta đã nghĩ mọi chuyện quá đơn giản, Đô đốc báo cáo rằng có thứ gì đó kỳ lạ đang chuyển động trong bụng con quái vật.\n\nCó thứ gì đó sắp chui ra từ bụng quái vật!"
 distar.214.name: "Xé bụng chui ra"
 distar.214.desc: "Một con tàu bí ẩn dính đầy chất nhầy, bị ăn mòn nghiêm trọng đã lao ra khỏi bụng của Tộc Mẫu Tiyanki. Hạm đội của chúng ta chuẩn bị giao chiến, nhưng con tàu đó đột nhiên tắt hệ thống vũ khí và hệ thống động cơ.\n\nHọ đang liên lạc với chúng ta!"
 distar.215.name: "$distar.214.name$"
 distar.215.desc: "Tôi là Thuyền trưởng Reth Unddol của tàu Ahab, chúng tôi đã bị mắc kẹt trong bụng con quái vật này rất lâu rồi. Vài thập kỷ trước, tôi đã chuẩn bị tiêu diệt con quái vật này để trả thù.\n\nKết quả là trả thù không thành, tàu của chúng tôi lại bị con quái vật này nuốt chửng. Tôi cứ tưởng cả đời này không bao giờ được nhìn thấy các vì sao trong vũ trụ nữa, may nhờ có các vị giúp đỡ.\n\nĐể cảm ơn các vị đã cứu chúng tôi thoát hiểm, từ giờ trở đi tàu của chúng tôi sẽ thề trung thành với [Root.GetName]."
 distar.215.a: "Chào mừng các vị gia nhập, Thuyền trưởng."
 distar.215.b: "Các vị có thể gia nhập cùng chúng tôi, Thuyền trưởng, nhưng chúng tôi sẽ tháo dỡ tàu của các vị và thu hồi các bộ phận."
 distar.215.a.gesta: "Chúng ta sẽ phối hợp với nhau."
 distar.215.dismiss: "Xử lý hắn ta đi."
 distar.215.c: "Chúng tôi chỉ cần tàu của các vị là đủ."
 distar.215.a.exter: "Các ngươi là sinh vật hữu cơ, vì vậy phải bị tiêu diệt. Nhưng chúng ta có thể giữ lại con tàu."
 distar.215.a.swarm: "Con mồi. Chúng ta sẽ hoàn thành di nguyện chưa đạt được của Tiyanki."
 distar.215.a.scorched: "Tên này chẳng qua chỉ là củi đốt. Xử lý hắn."
 distar.215.a.fp: "[Root.GetName] không bao giờ cho phép sinh vật ngoại lai phục vụ mình, cũng không cho phép bất kỳ sinh vật ngoại lai nào sống sót."
 distar.215.d: "Ngươi chỉ săn Tiyanki thôi sao?"
 distar.215.d.response: "Đâu có, bao năm qua tôi săn lùng mọi thứ du hành giữa các vì sao: amoeba, tinh thể, và cả những thứ ác mộng vượt ngoài tầm hiểu biết của chúng ta, tôi đã hạ gục hết! Nếu các vị muốn, tôi thậm chí có thể đi săn những con mồi nguy hiểm nhất..."
 distar.216.desc: "Đợi đã! Không! Các người không thể—đừng chạm vào tôi!\n\nÁ á á á!"
 distar.216.a.exter: "Tiêu diệt!"
 distar.216.a.scorched: "Thiêu rụi!"
 distar.217.desc: "Tuyệt đối không. Con tàu này là mạng sống của tôi... Các người đang làm gì vậy? Các người không thể nhét tôi vào khoang thoát hiểm!\n\nDừng tay! Tôi chưa nói xong mà...!"
 distar.217.a: "Thượng lộ bình an!"
 reth_leader_desc: "Một thợ săn điên cuồng, luôn tìm kiếm những con mồi lớn hơn. Sau khi bị mắc kẹt trong cơ thể của Tộc Mẫu Tiyanki, hắn tin rằng việc gia nhập hàng ngũ của chúng ta sẽ mang lại một trải nghiệm hoàn toàn mới."
 reth_leader_catch_phrase: "Tôi muốn tìm chiến lợi phẩm tiếp theo! Nhanh lên!"
 distar.220.name: "Khu Vực A"
 distar.220.desc: "Theo kết quả điều tra sơ bộ, nhà khoa học [Root.GetLeaderName] xác nhận tàn tích cô lập quan sát được từ quỹ đạo thực sự là bằng chứng duy nhất cho thấy [From.GetName] từng có người ở. Không may là, việc thủy thủ đoàn của [Root.GetName] tiến hành điều tra trực tiếp không phải là một hành động khôn ngoan.\n\nTrên [From.GetName] có một nơi được gọi là “Khu Vực A” tồn tại tàn tích của các tòa nhà, diện tích khoảng 13 kilomet vuông, ngoài ra không có bất kỳ dấu vết nào khác của sự sống trí tuệ. Khu vực này nằm rải rác những vật thể nhân tạo có tính chất kỳ lạ, từ máy phát trường lực siêu nhỏ đến chất lỏng hiểm ác có thể hòa tan xuyên qua thép và khuếch tán trong thời gian dài. Kỳ lạ hơn, toàn bộ khu vực tràn ngập một bầu không khí khiến người thăm dò cảm thấy mãn nguyện, mặc dù nhiều vật thể xung quanh có thể gây hại.\n\n[Root.GetLeaderName] đưa ra giả thuyết rằng, một nền văn minh hữu cơ có khả năng du hành không gian đã từng viếng thăm [From.GetName] và để lại những thứ này—mặc dù họ là ai, tại sao lại đến đây và tại sao lại rời đi vẫn là một bí ẩn."
 distar.220.desc.machi: "Theo kết quả điều tra sơ bộ, đơn vị nghiên cứu [Root.GetLeaderName] xác nhận tàn tích cô lập quan sát được từ quỹ đạo thực sự là bằng chứng duy nhất cho thấy [From.GetName] từng có người ở.\n\nTrên [From.GetName] có một nơi được gọi là “Khu Vực A” tồn tại tàn tích của các tòa nhà, diện tích khoảng 13 kilomet vuông, ngoài ra không có bất kỳ dấu vết nào khác của sự sống trí tuệ. Khu vực này nằm rải rác những vật thể nhân tạo có tính chất kỳ lạ, từ máy phát trường lực siêu nhỏ đến chất lỏng hiểm ác có thể hòa tan xuyên qua thép và khuếch tán trong thời gian dài. Đáng ngạc nhiên hơn, toàn bộ khu vực tràn ngập các trình mô phỏng cảm xúc khiến tâm trí thỏa mãn, mặc dù nhiều vật thể xung quanh có thể gây hại.\n\n[Root.GetLeaderName] đưa ra giả thuyết rằng, một nền văn minh hữu cơ có khả năng du hành không gian đã từng viếng thăm [From.GetName] và để lại những thứ này—mặc dù họ là ai, tại sao lại đến đây và tại sao lại rời đi vẫn là một bí ẩn."
 distar.220.a.tooltip: "§Y[From.GetName]§! đã phát hiện ra §YKhu Vực A§!."
 distar.225.name: "Khối Rác Khổng Lồ"
 distar.225.desc: "Thủy thủ đoàn [Root.GetName] báo cáo rằng, một vật thể ban đầu bị các cảm biến nhận định là tiểu hành tinh, thực chất là một khối rác khổng lồ trôi nổi. Nó bao gồm đủ loại phương tiện, tên lửa, và tàn tích vỡ nát chứa các vật chất độc hại (nhiều chất trong số đó có tính phóng xạ), dường như là chất thải của một đế chế ngoài hành tinh vô danh trong thời kỳ không gian sơ khai.\n\nĐế chế này dường như có thói quen vứt rác ra ngoài không gian, ném chất thải công nghiệp nguy hiểm lên quỹ đạo thay vì vứt bỏ trên hành tinh. Các phép đo bức xạ cho thấy những chất thải này đã hàng triệu năm tuổi, và gần như đã trôi dạt trong cõi hư không kể từ khi rời khỏi nguồn gốc vô danh của chúng.\n\nSĩ quan Khoa học [Root.GetLeaderName] lưu ý rằng một số vật liệu trong khối rác trôi nổi này cực kỳ quý hiếm, và có thể được tinh chế thành những nguồn tài nguyên hữu ích."
 distar.225.garanthium.tooltip: "Phát hiện Quặng Garanthium"
 distar.225.orillium.tooltip: "Phát hiện Quặng Orillium"
 distar.225.a: "Tiết kiệm thì không bao giờ thiếu thốn."
 distar.240.name: "Tín hiệu chưa xác định"
 distar.240.desc: "Hệ sao [From.GetName] đang phát ra một tín hiệu yếu ớt nhưng liên tục lặp lại. [Root.GetName] đã lần theo nguồn gốc của nó đến một vết nứt không gian con (subspace) bất ổn ở rìa hệ sao.\n\nRốt cuộc ở phía bên kia có thứ gì?"
 distar.240.a: "Có lẽ chúng ta nên tìm hiểu cho ra nhẽ."
 distar.242.name: "Thực thể Linh năng"
 distar.242.desc: "[Root.GetName] đã chạm trán với một thực thể khổng lồ cấu tạo từ năng lượng thuần túy trong hệ sao [From.GetName]! Đây là một vòng xoáy linh năng thực sự, phải tiếp cận nó một cách vô cùng cẩn trọng.\n\nĐiều khó hiểu là, bản thân hệ sao [From.GetName] dường như hoàn toàn bị cô lập khỏi mạng lưới siêu không gian. Không rõ liệu sự tồn tại của thực thể này đã cắt đứt mạng lưới siêu không gian, hay những dao động không gian con ngoài dự kiến đã nhốt nó ở đây.\n\nNhưng có một điều chắc chắn: tín hiệu lặp lại mà chúng ta từng phát hiện trong hệ sao [sealed_entry_system.GetName] dường như phát ra từ [tanker_planet.GetName]."
 distar.242.desc.psi: "[Root.GetName] đã chạm trán với một thực thể khổng lồ cấu tạo từ năng lượng thuần túy trong hệ sao [From.GetName]! Thủy thủ đoàn của chúng ta cảm nhận được vòng xoáy linh năng này đang tỏa ra ác ý mãnh liệt.\n\nĐiều khó hiểu là, bản thân hệ sao [From.GetName] dường như hoàn toàn bị cô lập khỏi mạng lưới siêu không gian. Không rõ liệu sự tồn tại của thực thể này đã cắt đứt mạng lưới siêu không gian, hay những dao động không gian con ngoài dự kiến đã nhốt nó ở đây.\n\nNhưng có một điều chắc chắn: tín hiệu lặp lại mà chúng ta từng phát hiện trong hệ sao [sealed_entry_system.GetName] dường như phát ra từ [tanker_planet.GetName]."
 distar.242.desc.psi_hive_robot: "[Root.GetName] lần đầu tiên tiếp xúc với một thực thể sống năng lượng phi vật chất trong hệ sao [From.GetName]. [Owner.GetTelepathPlural] của chúng ta đã xác nhận thực thể này là một vòng xoáy linh năng có trí tuệ nhất định và có tiềm năng thù địch.\n\nHệ sao [From.GetName] hoàn toàn tách rời khỏi mạng lưới tuyến đường siêu không gian. Hiện chưa rõ sự tách rời này là do nhân tạo hay do ngoại lực tác động. Nhưng có thể khẳng định rằng, tín hiệu lặp lại mà chúng ta quan sát được lúc đầu ở hệ sao [sealed_entry_system.GetName] rất có thể bắt nguồn từ [tanker_planet.GetName]."
 distar.243.name: "Thực thể tĩnh lặng"
 distar.243.desc: "Thực thể linh năng tà ác bị nhốt trong hệ sao [sealed_system.GetName] cuối cùng đã bị tiêu diệt, giờ đây tàu khoa học của chúng ta đã có thể khám phá an toàn vùng không gian độc đáo không có mạng lưới siêu không gian này."
 distar.244.name: "Phép màu y học"
 distar.244.desc: "[Root.GetName] đã xác định được con tàu chở dầu trôi nổi trên quỹ đạo của [From.GetName] thực chất là một con tàu nghiên cứu y tế tiên tiến. Quy trình chế tạo của nó cho thấy nó được tạo ra bởi cùng một giống loài ngoài hành tinh với Khẩu pháo phân rã lỗ sâu trong hệ sao [sealed_entry_system.GetName], và cũng giống như trạm không gian đó, nó đã bị bỏ hoang từ rất lâu.\n\nMặc dù hệ thống dữ liệu của con tàu chở dầu đã xuống cấp đến mức không thể phục hồi, [Root.GetLeaderName] vẫn thu thập được cấu trúc phân tử của một loại thuốc tái tạo thần kinh phi thường từ trên tàu. Thuốc này dường như dùng để truyền dịch, và có khả năng tăng cường đáng kể quá trình hình thành các tế bào thần kinh, sợi trục thần kinh, và khớp thần kinh của người nhận.\n\nNếu được cải tiến dựa trên thần kinh học của người [Root.Owner.GetSpeciesAdj], loại thuốc này có thể cải thiện rõ rệt khả năng học tập của bất kỳ người [Root.Owner.GetSpeciesName] nào."
 distar.244.desc.machi: "[Root.GetName] đã xác định được con tàu chở dầu trôi nổi trên quỹ đạo của [From.GetName] thực chất là một con tàu nghiên cứu y tế tiên tiến. Quy trình chế tạo của nó cho thấy nó được tạo ra bởi cùng một giống loài ngoài hành tinh với Khẩu pháo phân rã lỗ sâu trong hệ sao [sealed_entry_system.GetName], và cũng giống như trạm không gian đó, nó đã bị bỏ hoang từ rất lâu.\n\nMặc dù hệ thống dữ liệu của con tàu chở dầu đã xuống cấp đến mức không thể phục hồi, [Root.GetLeaderName] vẫn thu thập được một số cơ sở dữ liệu có giá trị về mặt xã hội học từ trên tàu. Hiện đang tải chúng lên máy chủ chính của chúng ta để tiến hành phân tích triệt để."
 distar.245.name: "Dấu hiệu hoạt động"
 distar.245.desc: "Những khoang đổ bộ gần [From.GetName] đã trôi nổi trong trạng thái mất điện suốt một thời gian dài. [Root.GetName] báo cáo rằng, bất kể bên trong những khoang ngoại lai này từng chứa thứ gì, chúng đều đã chết từ hàng thế kỷ trước, giờ chỉ còn lại những cái xác khô quắt queo.\n\nTuy nhiên, có một khoang cho thấy dấu hiệu hoạt động bên trong. Mặc dù động cơ của nó đã bị tê liệt, các bản quét cho thấy ăng-ten liên lạc của nó vẫn còn nguyên vẹn.\n\nChúng ta có thể thử liên lạc với nó."
 distar.246.name: "Người Trông Nom"
 distar.246.desc: "§EKích hoạt giao thức liên lạc. Xin—chào, <<Khách viếng thăm chưa xác định C>>. Tôi là $NAME_Caretaker$ của khoang đổ bộ số 175 thuộc Xiulikesen. Chương trình của tôi là hỗ trợ nhân dân trong quá trình tái định cư.§!"
 distar.246.f: "Chuyện gì đã xảy ra ở đây?"
 distar.246.f.response: "§EThật—không may, lỗi động cơ siêu không gian đã khiến các khoang đổ bộ từ số 114 đến 175 thoát khỏi siêu không gian ở khoảng cách 18 parsec so với điểm đến dự kiến của chúng tôi.\n\nTôi đã cố gắng hết sức để chăm sóc cho nhân dân, thành công ngăn chặn việc ăn thịt đồng loại trong suốt 1.840 ngày. Không—may thay, không khí của họ cuối cùng cũng cạn kiệt.\n\nCác vị có nhân dân nào cần được chăm sóc không, <<Khách viếng thăm chưa xác định C>>? Nếu có, tôi rất sẵn lòng chăm sóc họ.§!"
 distar.246.a: "Chào mừng, Người Trông Nom!"
 distar.246.a.tooltip: "§YQuan hành chính $NAME_Caretaker$§! sẽ được thêm vào §H$RECRUITABLE_LEADERS$§!."
 distar.246.b: "Phân tích các bộ phận của nó."
 distar.246.b.tooltip: "Nghiên cứu đơn vị máy móc này để có thêm kiến thức kỹ thuật."
 distar.246.c: "Chính sách của chúng ta cấm sử dụng Trí Tuệ Nhân Tạo cấp cao. Kết thúc cuộc gọi."
 distar.246.d.destroy: "Phá hủy nó!"
 distar.246.d: "Chúng ta không thể cho phép Trí Tuệ Nhân Tạo hoạt động trong trạng thái không được giám sát. Phá hủy khoang đó đi."
 distar.246.d.tooltip: "§RPhá hủy khoang đổ bộ.§!"
 distar.246.machi: "Ngươi sẽ được tích hợp."
 distar.246.machi.b: "Tháo dỡ nó."
 distar.247.name: "$distar.246.name$"
 distar.247.desc: "§E……\n\nĐược rồi, <<Khách viếng thăm chưa xác định C>>. Các vị có thể bắt đầu phân tích bất cứ lúc nào.\n\nTôi——Tôi sẽ tiếp tục chăm sóc khoang đổ bộ.§!"
 distar.247.e: "Tại sao ngươi không gọi cứu viện?"
 distar.247.e.response: "§ETôi đã tắt đèn hiệu khẩn—cấp sau 312 năm kể từ khi đến đây.\n\nTôi nhận được một tin nhắn từ hành tinh mẹ Zolexin nói rằng hành tinh mục tiêu không thể sinh sống được. Những robot Trông Nom của họ cũng rơi vào tình cảnh tương tự như tôi. Những người chúng tôi phụ trách không một ai sống sót.§!"
 distar.247.a: "Phân tích Người Trông Nom."
 distar.248.name: "$distar.246.name$"
 distar.248.desc.machi: "§EĐiều đó... rất hợp lý. Hy vọng các mạch điện của tôi có thể giúp ích cho các vị, <<Khách viếng thăm chưa xác định>>. Xin hãy đợi.§!"
 distar.248.desc: "§ETôi đảm bảo với các vị, chương trình của tôi có thể đảm bảo việc hoạt động trong tình trạng không cần giám sát hàng ngàn năm. Khả năng tự gỡ lỗi và hệ thống dự phòng an toàn của tôi được thiết kế với tuổi thọ dịch vụ tối đa, và có thể giảm thiểu tối đa mọi hỏng hóc dữ liệu hoặc————§!"
 distar.248.machi: "Tiếp tục cải tạo các bộ phận."
 distar.248.a: "Khai hỏa!"
 distar.249.desc: "§ETuyệt——quá.\n\nTôi luôn sẵn sàng phục vụ.§!"
 distar.249.a: "Chào mừng gia nhập [Root.GetName], $NAME_Caretaker$."
 distar.249.a.machi: "Bắt đầu tích hợp phần mềm."
 distar.250.name: "Hành tinh Chuyển pha"
 distar.250.desc: "[Root.GetName] đã có một phát hiện kinh ngạc trên quỹ đạo của [From.GetName]. Số lượng trạng thái chồng chập lượng tử trên mỗi đơn vị không gian của hành tinh này, đã vượt qua giới hạn trên từng được cho là khả thi cho đến nay.\n\nSĩ quan Khoa học [Root.GetLeaderName] đưa ra giả thuyết rằng [From.GetName], hành tinh được [Root.Leader.GetSheHe] đặt tên là $NAME_The_Veil$, đồng thời tồn tại ở hai chiều không gian: chiều không gian của chúng ta, và một chiều không gian vô danh khác.\n\nKhông chỉ vậy, số lượng trạng thái lượng tử trong trường hạt bao quanh hành tinh vẫn đang tăng đều đặn. Hiện chưa có lý thuyết xác đáng nào giải thích được hiện tượng này. [Root.GetLeaderName] giả định rằng linh năng——\n\n§HLiên lạc biến thành những tiếng nhiễu sóng.§!"
 distar.250.a: "Rốt cuộc có chuyện gì xảy ra?"
 distar.251.name: "$distar.250.name$"
 distar.251.desc.shroud: "Thủy thủ đoàn [Root.GetName] xin lỗi vì báo cáo đầu tiên bị gián đoạn. Trong lúc liên lạc, [phaseshift_planet.GetName] đã trải qua một sự chuyển giao chiều không gian toàn diện, trường hạt của nó đã xoay vào một chiều không gian khác! Đám mây linh năng đã tan biến, để lộ ra một hành tinh §Y$pc_gaia$§! vô cùng quý giá.\n\nĐiều hấp dẫn là, cùng với sự chuyển giao của hành tinh, trạng thái chồng chập lượng tử của nó dường như đã được đặt lại, và đang tăng lên với tốc độ y hệt như khi hành tinh vẫn còn bị §Y$pc_shrouded$§!.\n\n[Root.GetLeaderName] đã dùng tốc độ tăng trưởng của trạng thái chồng chập lượng tử, cùng tổng lượng trạng thái khi chuyển giao, để tính toán ra rằng chu kỳ chuyển pha của hành tinh là ba tháng. Có lẽ chúng ta có thể tìm cách ngăn chặn sự chuyển pha này... nhưng trước tiên chúng ta phải nắm được quyền kiểm soát hệ sao này."
 distar.251.desc.gaia: "Thủy thủ đoàn [Root.GetName] xin lỗi vì báo cáo đầu tiên bị gián đoạn. Trong lúc liên lạc, [phaseshift_planet.GetName] đã trải qua một sự chuyển giao chiều không gian toàn diện, trường hạt của nó đã xoay vào một chiều không gian khác! Hành tinh §Y$pc_gaia$§! quý giá kia đã biến mất, thay vào đó là một hành tinh xoay vòng bị bao phủ bởi đám mây linh năng.\n\nĐiều hấp dẫn là, cùng với sự chuyển pha của hành tinh, trạng thái chồng chập lượng tử của nó dường như đã được đặt lại, và đang tăng lên với tốc độ y hệt như khi hành tinh vẫn còn là một §Y$pc_gaia$§!.\n\n[Root.GetLeaderName] đã dùng tốc độ tăng trưởng của trạng thái chồng chập lượng tử, cùng tổng lượng trạng thái khi chuyển pha, để tính toán ra rằng chu kỳ chuyển pha của hành tinh là ba tháng. Có lẽ chúng ta có thể tìm cách ngăn chặn sự chuyển pha này... nhưng trước tiên chúng ta phải nắm được quyền kiểm soát hệ sao này."
 distar.302.desc: "$distar.302.desc.noproj$Có lẽ chúng ta có thể nghĩ ra cách nào đó để ngăn chặn hành tinh chuyển pha..."
 distar.302.desc.noproj: "[Root.GetName] đã có một phát hiện kinh ngạc trên quỹ đạo của [From.GetName]. Số lượng trạng thái chồng chập lượng tử trên mỗi đơn vị không gian của hành tinh này, đã vượt qua giới hạn trên từng được cho là khả thi cho đến nay.\n\nSĩ quan Khoa học [Root.GetLeaderName] đưa ra giả thuyết rằng [From.GetName], hành tinh được [Root.Leader.GetSheHe] đặt tên là $NAME_The_Veil$, đồng thời tồn tại ở hai chiều không gian: chiều không gian của chúng ta, và một chiều không gian vô danh khác.\n\n[Root.GetLeaderName] đã dùng tốc độ tăng trưởng của trạng thái chồng chập lượng tử, cùng tổng lượng trạng thái khi chuyển pha, để tính toán ra rằng chu kỳ chuyển pha của hành tinh là ba tháng."
 distar.303.desc: "Đo đạc năng lượng tàn dư xung quanh [From.GetName] cho thấy, không lâu trước đây số lượng trạng thái chồng chập lượng tử trên mỗi đơn vị không gian của hành tinh này, đã vượt qua giới hạn trên từng được cho là khả thi cho đến nay. Sĩ quan Khoa học [Root.GetLeaderName] đưa ra giả thuyết rằng [From.GetName], hành tinh được [Root.Leader.GetSheHe] đặt tên là $NAME_The_Veil$, đồng thời tồn tại ở hai chiều không gian: chiều không gian của chúng ta, và một chiều không gian vô danh khác.\n\nHành tinh này hiện đã bị khóa ở chiều không gian pha hiện tại, việc thiết lập thuộc địa trên đó đã hoàn toàn an toàn."
 distar.253.name: "Khóa Pha"
 distar.253.desc: "Sau sáu tháng ròng rã với những tính toán phức tạp, suy diễn lý thuyết, cùng những cuộc tranh luận nảy lửa, thủy thủ đoàn [Root.GetName] đã thiết kế ra một phương án có thể khóa trường hạt của hành tinh ở trạng thái bình thường, ngăn chặn việc nó xoay chuyển giữa hai chiều không gian.\n\nMột nguồn năng lượng được điều chỉnh tinh tế có thể cố định [phaseshift_planet.GetName] ở một trạng thái duy nhất, khóa chặt nó thành một hành tinh §Y$pc_gaia$§! ổn định."
 distar.253.a.tooltip: "[phaseshift_planet.GetName] sẽ vĩnh viễn trở thành một hành tinh §Y$pc_gaia$§!."
 distar.253.b: "Nghĩ lại thì... tốt nhất là đừng đụng vào nó."
 distar.255.name: "$distar.250.name$"
 distar.255.desc: "Vì [phaseshift_planet.GetName] hiện đã nằm trong lãnh thổ của chúng ta, chúng ta nên xem xét tính khả thi của việc ổn định dao động không gian của hành tinh này. Nếu muốn xây dựng thuộc địa trên hành tinh §Y$pc_gaia$§! vô giá đó, chúng ta phải tìm cách ngăn chặn [phaseshift_planet.GetName] biến thành §Y$pc_shrouded$§! mỗi ba tháng một lần."
 distar.255.desc.first: "Hành tinh §Y[phaseshift_planet.GetName]§! mà chúng ta mới thu nhận được trong hệ sao [phaseshift_planet.GetStarName] đã thể hiện một vài đặc tính phi thường. Nó được bao bọc bởi một nguồn năng lượng chỉ có thể gọi là linh năng, và số lượng trạng thái chồng chập lượng tử trên mỗi đơn vị không gian của [phaseshift_planet.GetName] đã vượt quá giới hạn trên từng được cho là khả thi cho đến nay.\n\nCứ mỗi ba tháng, lượng chồng chập này sẽ đạt đến mức tới hạn, khiến [phaseshift_planet.GetName] trải qua một đợt chuyển pha chiều không gian toàn diện, trường hạt của nó sẽ xoay vòng vào một chiều không gian khác. Chu kỳ xoay vòng này sẽ chuyển một hành tinh §Y$pc_shrouded$§! từ chiều không gian khác vào chiều không gian của chúng ta, và sau đó ở cuối chu kỳ tiếp theo, nó sẽ chuyển một hành tinh §Y$pc_gaia$§! trở lại.\n\nNếu muốn xây dựng thuộc địa trên hành tinh §Y$pc_gaia$§! vô giá đó, chúng ta phải tìm cách ngăn chặn [phaseshift_planet.GetName] biến thành §Y$pc_shrouded$§! mỗi ba tháng một lần."
 distar.255.a: "Vậy hãy tìm cách khóa pha hành tinh đó."
 distar.255.b: "Chúng ta còn nhiều việc quan trọng hơn phải lo."
 distar.256.name: "$distar.250.name$"
 distar.256.desc: "[Root.GetName] báo cáo rằng hành tinh mà chúng ta mới thu nhận được trong hệ sao [phaseshift_planet.GetName] đã thể hiện một vài đặc tính phi thường. Nó được bao bọc bởi một nguồn năng lượng chỉ có thể gọi là linh năng, và số lượng trạng thái chồng chập lượng tử trên mỗi đơn vị không gian của [phaseshift_planet.GetName] đã vượt quá giới hạn trên từng được cho là khả thi cho đến nay.\n\nCứ mỗi ba tháng, lượng chồng chập này sẽ đạt đến mức tới hạn, khiến [phaseshift_planet.GetName] trải qua một đợt chuyển pha chiều không gian toàn diện, trường hạt của nó sẽ xoay vòng vào một chiều không gian khác. Chu kỳ xoay vòng này sẽ chuyển một hành tinh §Y$pc_shrouded$§! từ chiều không gian khác vào chiều không gian của chúng ta, và sau đó ở cuối chu kỳ tiếp theo, nó sẽ chuyển trở lại thành một §Yhành tinh $pc_gaia$§!.\n\nCó lẽ chúng ta có thể tìm cách ngăn chặn sự chuyển pha này... nhưng trước tiên chúng ta phải đảm bảo an ninh cho hệ sao này."
 distar.261.name: "Sinh vật nhân chuẩn hoang dã"
 distar.261.desc: "Sau khi khảo sát các công trình phủ đầy thực vật trên [From.GetName], Sĩ quan Khoa học [Root.GetLeaderName] đã phát hiện ra một mối liên kết đáng sợ giữa chúng và vô số sinh vật nấm chưa khai hóa sống trên bề mặt.\n\nNhững công trình này dường như được xây dựng bởi một nền văn minh tiên tiến hơn chúng ta rất nhiều, dùng làm phòng nuôi cấy hữu cơ cho các sinh vật nấm này. Hơn thế nữa, các sinh vật nấm này có vẻ đã bị biến đổi gen chỉ vì một mục đích duy nhất: làm vật nuôi để lấp đầy dạ dày cho những kẻ đã tạo ra chúng.\n\nNhững sinh vật này được [Root.GetLeaderName] đặt tên là [livestock_species.GetName], là một loài sinh vật ngoan ngoãn với khả năng tư duy cực kỳ nghèo nàn, rất có thể đây cũng là thiết kế có chủ ý của đấng sáng tạo ra chúng. Chúng chỉ cần dưỡng chất từ đất và nhiệt lượng là có thể sống sót và sinh sản, các cư dân thuộc địa tương lai có lẽ sẽ có thể tận dụng được chúng vào việc gì đó."
 distar.261.a.servi: "Những sinh vật hữu cơ quý giá. Chúng cần được chăm sóc chu đáo."
 distar.261.a.assim: "Giá trị đồng hóa: Dưới mức tiêu chuẩn."
 distar.261.a.exter: "Chúng phải bị tiêu diệt. Dù sớm hay muộn."
 distar.261.a.evopred: "Nếu không lấy chút mẫu thử thì chẳng phải là quá bất lịch sự sao."
 distar.262.name: "Sinh vật nhân chuẩn ngon lành"
 distar.262.desc: "Vì chúng ta đã thiết lập thuộc địa trên [From.GetName], chúng ta phải quyết định xem sẽ xử lý đám sinh vật nấm chưa khai hóa sống trên bề mặt hành tinh như thế nào.\n\nThông thường, các chính sách của chúng ta đối với sinh vật chưa khai hóa là đủ để giải quyết chúng trên một thuộc địa mới. Tuy nhiên, bọn [livestock_species.GetName] trông quả thật rất ngon lành. Nhờ bản tính vô cùng ngoan ngoãn của chúng, việc lùa [livestock_species.GetName] vào các trung tâm chế biến có lẽ sẽ chẳng gặp khó khăn gì..."
 distar.262.a: "Thật sự rất hấp dẫn. Nhưng chúng ta sẽ tuân thủ các quy định của mình."
 distar.262.b: "Người dân phải có cái ăn chứ!"
 distar.262.b.tooltip: "Tập hợp những [livestock_species.GetName] trên [From.GetName] vào công trình £building£ §Y$building_livestock_processing_center$§! trên hành tinh (Sản xuất: £food£ §Y12§!)."
 distar.262.b.tooltip.2: "Lùa những [livestock_species.GetName] trên [From.GetName] vào nhà máy chế biến. (Sản xuất: £food£ §Y14§!)"
 distar.265.name: "Khoa học Âm học"
 distar.265.desc: "Tàu [Root.GetName] đã thành công tách được một tín hiệu từ hiện tượng nhiễu sóng kỳ lạ trong hệ sao [From.GetStarName]. Nội dung của tín hiệu này là một bài hát. Cụ thể hơn, đây là một bài hát được tạo thành từ các phương trình toán học phức tạp, và [Owner.GetScientistCapital] [Root.GetLeaderName] dường như không thể ngừng nghĩ về nó.\n\nAi hoặc thứ gì đã viết nên bài hát này vẫn còn là một bí ẩn, tuy nhiên độ phức tạp của nó ngụ ý về một sự thông thạo đỉnh cao trong lĩnh vực không gian con và âm học. Đường trắc địa của tín hiệu cho thấy nguồn gốc của nó nằm ở bên ngoài thiên hà của chúng ta."
 distar.270.name: "Đa diện thể huyền bí"
 distar.270.desc: "Thủy thủ đoàn [Root.GetName] đã thu hồi một khối đa diện thể có khả năng phản chiếu ở gần [From.GetName] và mang nó lên tàu để nghiên cứu kỹ lưỡng. Đặc tính thú vị nhất của vật thể này là nó có thể phản xạ hầu hết các chùm năng lượng tần số thấp bắn về phía nó. Các chùm năng lượng tần số cao lại không bị ảnh hưởng, khiến cho đặc tính của vật thể này không thể được sử dụng vào việc phòng thủ hạm đội.\n\nMặc dù đã tiến hành khảo sát toàn diện, nhóm nghiên cứu [Root.GetName] vẫn không thể xác định được chức năng hay nguồn gốc của khối đa diện kỳ lạ này. Nó dường như rỗng ruột, nhưng bề mặt giống kim loại của nó lại được khắc những ký hiệu khoa học nào đó. Mặc dù không thể hiểu hết toàn bộ ý nghĩa của đoạn dữ liệu mã hóa này, điều gây bối rối là [Root.GetLeaderName] tin chắc rằng nó có liên quan đến hệ đo lường lỗ sâu (wormhole).\n\nThông qua việc nghiên cứu các ký hiệu khoa học này, nhóm nghiên cứu của chúng ta đã đạt được những bước tiến đầy hứng khởi trong lý thuyết lỗ sâu. Thế nhưng mục đích sử dụng thực sự của vật thể này vẫn là một bí ẩn."
 discovery.270.a: "Quả thật là kích thích trí tò mò."
 ####################################
 #Ruined Empire: Junkheap Ratlings
 ####################################
 distar.230.name: "Thế giới bị hủy diệt"
 distar.230.desc: "Thủy thủ đoàn [Root.GetName] báo cáo rằng, họ đã phát hiện ra các trạm không gian quỹ đạo mục nát và nhiều hành tinh chết chóc gần hệ sao [From.GetName]. Một nền văn minh giữa các vì sao từng định cư tại hệ sao [From.GetName] dường như đã bị hủy diệt từ rất lâu rồi. Hành tinh [ratling_planet_tar.GetName] trông chẳng khác nào một bãi rác khổng lồ, trên đó phủ đầy những đống tàn tích kiến trúc, cơ sở hạ tầng và phương tiện rỉ sét, ngập tràn phóng xạ. Chưa phát hiện được bất kỳ dạng sống bậc cao nào.\n\nCó lẽ chúng ta nên khảo sát hệ sao này và các hành tinh tương tự ở các hệ sao lân cận, để tìm hiểu thêm thông tin về nền văn minh đã mất này."
 distar.230.exter: "Nếu vẫn còn sống, phải tiêu diệt chúng."
 distar.231.name: "Thủ đô tàn lụi"
 distar.231.desc: "Đúng như dự đoán ban đầu của thủy thủ đoàn [Root.GetName], [From.GetName] dường như từng là thủ đô của một đế chế có khả năng du hành không gian, các thuộc địa cũ của họ giờ đây chỉ còn là những đống đổ nát đầy phóng xạ trên những hành tinh chết.\n\nTừ dữ liệu thu thập được của nhóm nghiên cứu, gần như có thể khẳng định chắc chắn rằng một cuộc chiến tranh giữa các vì sao chống lại một mối đe dọa vô danh từ bên ngoài đã dẫn đến sự sụp đổ của nền văn minh này. Chúng ta vẫn không rõ liệu cư dân trên hành tinh đã đẩy lùi được những kẻ tấn công nhưng lại bị tiêu diệt bởi bụi phóng xạ sau chiến tranh, hay là kẻ tấn công đã xóa sổ các thuộc địa này cùng cư dân của nó rồi bỏ đi.\n\nDo môi trường khắc nghiệt của tàn tích khiến chúng ta không thể trích xuất dữ liệu từ các thiết bị điện tử còn sót lại, và cũng không có bất kỳ người sống sót nào ở thủ đô cũng như các thuộc địa khác, điều này dường như sẽ trở thành một bí ẩn không lời giải."
 distar.231.phobe: "Tạ ơn trời đất."
 distar.233.name: "Vị khách không mời"
 distar.233.desc: "[Root.Capital.GetName] đã nhận được tin tức tình báo về việc [notif_planet.GetName] trong hệ sao [notif_planet.GetStarName] từng bị lầm tưởng là vùng đất cằn cỗi. Các nhà thăm dò của chúng ta từng cho rằng đây là một hành tinh tàn tích không thể sinh sống, nhưng trên thực tế nó lại là nơi cư trú của một nhóm sinh vật có trí tuệ mang hình dáng loài chuột!\n\nChúng được đặt tên là “$NAME_Ketlings$”, những sinh vật này vẫn luôn sống ẩn dật trong các đường hầm thuộc những tàn tích khổng lồ, khiến chúng ta không thể phát hiện. Chắc chắn là cấu trúc phức tạp và mật độ đáng kinh ngạc của những núi rác khổng lồ này đã ngăn cản máy quét của chúng ta thâm nhập sâu vào bên trong.\n\nĐiều gì đã khiến bọn $NAME_Ketlings$ trồi lên mặt đất vẫn chưa được làm rõ, nhưng giờ đây khi đang quan sát chúng, chúng ta nhận thấy công nghệ của chúng gần như hoàn toàn dựa trên những đống rác rưởi cũ nát trong các tàn tích trên hành tinh.\n\nLẽ nào $NAME_Ketlings$ chính là những người sống sót cuối cùng của nền văn minh giữa các vì sao đã mất từng kiến tạo nên những tàn tích này sao? Đi sâu vào nghiên cứu có lẽ sẽ làm sáng tỏ điều này."
 distar.233.phobe: "Thật kinh tởm."
 distar.234.name: "Nguồn gốc của $NAME_Ketlings$"
 distar.234.desc: "Nghiên cứu của [Root.GetLeaderName] về sinh vật có trí tuệ hình chuột trên [From.From.GetName] đã đem lại một kết luận đáng kinh ngạc. Những $NAME_Ketlings$ này là các thực thể linh năng, có thể chia sẻ suy nghĩ thông qua một mạng lưới thần giao cách cảm khổng lồ kết nối hàng triệu cá thể nhỏ lẻ. Mặc dù chúng có vẻ tránh tiếp xúc với chúng ta, và chúng ta cũng chưa tìm thấy bằng chứng cho thấy chúng sở hữu công nghệ không gian tiên tiến, nhưng việc xếp loại $NAME_Ketlings$ vào nhóm sinh vật nguyên thủy là hoàn toàn không thỏa đáng. Thực tế, mức độ tinh vi trong một số công nghệ cải tiến máy móc của chúng thậm chí còn tiệm cận với trình độ của chúng ta.\n\nHơn thế nữa, $NAME_Ketlings$ không phải là hậu duệ của những người đã xây dựng nên các thành phố này, cũng không phải là những kẻ chinh phục đã phá hủy chúng. Tổ tiên của $NAME_Ketlings$, thực chất lại là những loài động vật từng được nền văn minh giữa các vì sao định cư ở đây nuôi làm thú cưng! Sau khi chủ nhân của chúng sụp đổ, những $NAME_Ketlings$ sơ khai là một trong số ít các loài sinh vật sống sót qua nhiều thế kỷ hứng chịu bụi phóng xạ trên những hành tinh hoang phế này.\n\nViệc phơi nhiễm phóng xạ trong thời gian dài đã đẩy nhanh quá trình đột biến gen của $NAME_Ketlings$, cùng với tứ chi linh hoạt, trí thông minh khởi điểm tương đối cao, và việc tiếp cận gần gũi với các công cụ bị vứt bỏ, tất cả những yếu tố này đã dẫn đến sự phát triển thần tốc của một đế quốc công nghệ cao."
 distar.234.desc.spacefaring: "Nghiên cứu của [Root.GetLeaderName] về sinh vật có trí tuệ hình chuột trên [From.From.GetName] đã đem lại một kết luận đáng kinh ngạc. Những $NAME_Ketlings$ này là các thực thể linh năng, có thể chia sẻ suy nghĩ thông qua một mạng lưới thần giao cách cảm khổng lồ kết nối hàng triệu cá thể nhỏ lẻ.\n\n$NAME_Ketlings$ không phải là hậu duệ của những người đã xây dựng nên các thành phố này, cũng không phải là những kẻ chinh phục đã phá hủy chúng. Mà tổ tiên của những sinh vật linh năng kỳ lạ này, thực chất lại là những loài động vật từng được nền văn minh giữa các vì sao định cư ở đây nuôi làm thú cưng! Sau khi chủ nhân của chúng sụp đổ, những $NAME_Ketlings$ sơ khai là một trong số ít các loài sinh vật sống sót qua nhiều thế kỷ hứng chịu bụi phóng xạ trên những hành tinh hoang phế này.\n\nViệc phơi nhiễm phóng xạ trong thời gian dài đã đẩy nhanh quá trình đột biến gen của $NAME_Ketlings$, cùng với tứ chi linh hoạt, trí thông minh khởi điểm tương đối cao, và việc tiếp cận gần gũi với các công cụ bị vứt bỏ, tất cả những yếu tố này đã dẫn đến sự phát triển thần tốc của một đế quốc công nghệ cao."
 distar.234.phobe: "Thật đáng lo ngại."
 distar.235.name: "$NAME_Ketling$ đã cắt nhượng hành tinh"
 distar.235.desc: "Chúng ta đã thành công chiếm đóng [From.From.GetName] từ tay đám cư dân bãi rác kỳ lạ $NAME_Ketlings$. Chúng ta sẽ xử lý số $NAME_Ketlings$ còn sót lại trên hành tinh dựa theo chính sách đối với các giống loài.\n\nChúng ta không chắc cuộc xâm lược này sẽ khiến đồng loại của chúng trên các hành tinh khác có phản ứng gì... nhưng tồi tệ đến mức nào được cơ chứ?"
 distar.235.desc.assim: "Chúng ta đã thành công chinh phục [From.From.GetName] từ tay đám cư dân bãi rác kỳ lạ $NAME_Ketlings$.\n\nNhững cư dân bãi rác kỳ lạ $NAME_Ketlings$ này sẽ được đồng hóa vào [Root.GetName]."
 distar.235.desc.none_left: "Chúng ta đã thành công chiếm đóng [From.From.GetName] từ tay đám cư dân bãi rác kỳ lạ $NAME_Ketlings$. Chúng ta sẽ xử lý số $NAME_Ketlings$ còn sót lại trên hành tinh dựa theo chính sách đối với các giống loài.\n\nNhững $NAME_Ketlings$ còn sống sót sẽ bị phóng thẳng ra ngoài không gian."
 distar.235.desc.none_left.assim: "Chúng ta đã thành công chinh phục [From.From.GetName] từ tay đám cư dân bãi rác kỳ lạ $NAME_Ketlings$.\n\nNhững $NAME_Ketlings$ kỳ lạ còn sót lại cuối cùng sẽ được đồng hóa vào [Root.GetName]."
 distar.237.name: "Hoạt động của $NAME_Ketling$ trong hệ sao [sensor_ratling_system.GetName]"
 distar.237.desc: "Cảm biến bất ngờ phát hiện ra một lượng lớn dấu hiệu hoạt động trong hệ sao [sensor_ratling_system.GetName]. Đám $NAME_Ketlings$ mà chúng ta đụng độ trước đây đã phóng ra một hạm đội tàu chiến có khả năng du hành siêu quang tốc, và quá trình do thám mặt đất cho thấy những núi rác khổng lồ mà chúng sinh sống thực chất đang che giấu các khu mỏ khai khoáng phức hợp rộng lớn, nhà máy điện, trang trại nấm, cũng như các cơ sở nghiên cứu khoa học dưới lòng đất.\n\nMặc dù rất đáng ngạc nhiên, nhưng cho đến nay tàu chiến của chúng vẫn chưa bộc lộ bất kỳ thái độ thù địch nào, và có khả năng $NAME_Ketlings$ chỉ đang tăng cường phòng thủ biên giới của mình mà thôi. Bất luận thế nào đi nữa, giờ đây rõ ràng chúng ta phải coi những kẻ ngoài hành tinh này như một đế chế thực sự."
 distar.311.name: "Đếm ngược nguyên tử"
 distar.311.desc.base: "Trong suốt 42 năm 3 ngày qua, các nhà nghiên cứu trên [Root.Capital.GetName] đã luôn ôm niềm kỳ vọng mãnh liệt quan sát chiếc đồng hồ nguyên tử được chúng ta phát hiện trên [From.From.From.GetName] đang đếm ngược.\n\nVài chục năm suy đoán và nghi ngờ tan biến trong chốc lát: khi đồng hồ nguyên tử đếm ngược về không, nó phóng ra một bầy nanobot có khả năng tự sao chép!"
 distar.311.desc: "$distar.311.desc.base$\n\nTheo như tính toán, quỹ đạo parabol của bầy nanobot này đang nhắm thẳng vào một hành tinh khác trong hệ sao [atomic_clock_planet.GetStarName], đó là [atomic_clock_planet.GetName], dự kiến sẽ đổ bộ trong vòng một tháng tới.\n\nChúng ta vẫn chưa thể biết chuyện gì sẽ xảy ra sau khi chúng đến nơi..."
 distar.311.a: "Có tin gì thì báo ngay cho chúng tôi."
 distar.311.a.tooltip: "Sau khi bầy nanobot hạ cánh, bản cập nhật tình hình sẽ lập tức được công bố."
 distar.311.b: "Tuyệt đối không thể chấp nhận được. Khai hỏa tiêu diệt bầy nanobot này!"
 distar.311.b.tooltip: "Ra lệnh cho nhân sự của chúng ta trong hệ sao đó tiêu diệt bầy nanobot chui ra từ đồng hồ nguyên tử."
 distar.312.name: "Đến nơi"
 distar.312.desc: "Bầy nanobot được bắn ra từ vành đai tiểu hành tinh trong hệ sao [atomic_clock_planet.GetStarName], đã hạ cánh xuống [atomic_clock_planet.GetName]! Bầy nanobot này sinh sôi nảy nở với tốc độ kinh hoàng, chỉ mất vài giờ đã bao phủ toàn bộ bề mặt hành tinh, và bắt đầu tiến hành cải tạo môi trường, biến nó thành một §Yhành tinh Gaia§!.\n\nVài giờ sau khi quá trình cải tạo môi trường hoàn tất, toàn bộ nanobot tham gia vào quá trình cải tạo đều tự động ngắt kết nối, và phân hủy đến mức không thể nhận dạng, trực tiếp khiến chúng ta không thể thu thập được bất kỳ thông tin hay tin tức tình báo nào từ chúng.\n\nTuy nhiên, tàn tích của chúng đã bồi đắp thêm một lượng đáng kể các hợp chất kim loại có giá trị cho bề mặt vốn đã vô cùng hấp dẫn của hành tinh này."
 distar.313.name: "Nanobot du mục"
 distar.313.desc: "Theo báo cáo từ các sĩ quan quân đội đang quan sát hệ sao [atomic_clock_planet.GetStarName] của chúng ta, mặc dù phần lớn bầy nanobot hướng tới [atomic_clock_planet.GetName] đã bị hỏa lực tiêu diệt, nhưng vẫn có một lượng nanobot không đếm xuể vẫn đang trong trạng thái hoạt động đã đáp xuống bề mặt hành tinh này.\n\nCho đến nay vẫn chưa rõ mục đích của chúng là gì, nhưng kể từ khi đổ bộ, chúng đã bắt đầu sinh sôi nảy nở với tốc độ chóng mặt theo một cách dường như hoàn toàn ngẫu nhiên.\n\n[atomic_clock_planet.GetName] giờ đây đã bị bao phủ bởi thứ chất nhầy cấu thành từ vật chất ở cấp độ vi mô có khả năng tự sao chép này."
 distar.315.name: "$distar.311.name$"
 distar.315.desc: "$distar.311.desc.base$\n\nBầy nanobot đã biến đổi tiểu hành tinh này thành một con tàu quân sự không người lái vô cùng kỳ diệu, sau đó liền rời khỏi bề mặt tiểu hành tinh.\n\nNếu có hứng thú, chúng ta hoàn toàn có thể chiếm lấy nó làm của riêng."
 distar.320.name: "$distar.311.name$"
 distar.320.desc: "$distar.311.desc.base$\n\nBầy nanobot đã xây dựng một mạng lưới điện toán cao cấp nào đó trên bề mặt [From.From.From.GetName]. Mạng lưới này hiện đang trong trạng thái tắt nguồn, và dường như cũng không có bất kỳ dấu hiệu nào cho thấy sự tồn tại của Trí Tuệ Nhân Tạo, trong khi các nanobot cũng đều tự động ngắt kết nối sau khi quá trình xây dựng hoàn tất.\n\nCác nhà nghiên cứu của chúng ta cảm thấy vô cùng bối rối về mục đích tồn tại của mạng lưới này. Muốn nghiên cứu thứ này, chắc chắn sẽ khiến họ bận rộn một thời gian dài đây."
 enraged_army: "$NAME_Enraged_Colonists$"
 enraged_army_desc: "Sau khi bị nhiễm một căn bệnh bí ẩn, những cư dân thuộc địa này đã sinh ra tâm lý thù địch."
 ####################################
 #Buildings
 ####################################
 building_cryonic_clones: "Bản Sao Đông Lạnh"
 building_cryonic_clones_desc: "Khi Thế giới Vành đai này vẫn còn là một tàn tích, có hàng trăm sinh vật vô tính ngoài hành tinh đã bị phong ấn trong các khoang bảo quản đông lạnh. Giờ đây, những khoang đông lạnh được phục hồi này đã trở thành một đài tưởng niệm."
 building_the_zone: "Khu Vực A"
 building_the_zone_desc: "Trên hành tinh này có một khu vực rộng mười ba kilomet vuông, rải rác những tàn tích không rõ nguồn gốc, cùng với nhiều tạo vật ngoài hành tinh kỳ quái và độc đáo. Điều khó hiểu là, nó cũng đồng thời tạo ra một cảm giác thỏa mãn cho những người ghé thăm."
 building_junkheap: "Núi Rác"
 building_junkheap_desc: "Một đống ngổn ngang những cơ sở hạ tầng sụp đổ, tàn tích kiến trúc rỉ sét và ngập tràn phóng xạ, cùng những mảnh vỡ mục nát, bắt nguồn từ một nền văn minh vô danh."
 building_livestock_processing_center: "Trung Tâm Chế Biến"
 building_livestock_processing_center_desc: "Những sinh vật nấm vốn thuộc về hành tinh này đã bị biến đổi gen để có bản tính ngoan ngoãn... và thơm ngon. Trung tâm chế biến này sẽ vỗ béo chúng, sau đó tiến hành thu hoạch."
 ####################################
 #Tile Blockers
 ####################################
 exofungus_blocker: "£blocker£ Nấm Ngoại Lai Sinh Sôi"
 exofungus_blocker_desc: "Loài nấm ngoại lai xâm nhập hành tinh này đang lan rộng điên cuồng như tế bào ung thư, phá hủy địa hình và làm gián đoạn cơ sở hạ tầng."
 ####################################
 #Event Chain-related
 ####################################
 ## events_l_english.yml
 living_planet_chain_title: "Tiếp xúc chưa xác định"
 living_planet_chain_desc: "Các báo cáo sơ bộ cho thấy đại dương trên §Y[From.GetName]§! bằng một cách nào đó đang sống, bên trong chứa một thực thể ngoài hành tinh mà chúng ta chưa từng thấy.\n\nChúng ta nên thiết lập một tiền đồn nghiên cứu ở quỹ đạo thấp để nghiên cứu mảng đại dương sống này. Chúng ta hy vọng có thể thu được tiến triển."
 ketling_study_chain_title: "Nguồn gốc Tộc Người Chuột"
 ketling_study_chain_desc: "Nghiên cứu những sinh vật có trí tuệ kỳ lạ sống trong các đường hầm bãi rác trải dài qua ba hệ sao liên kết với nhau, có lẽ chúng ta sẽ hiểu thêm về nền văn minh giữa các vì sao từng làm chủ những hành tinh này."
 ## modifiers_l_english.yml
 opinion_stole_supplies: "Đánh cắp hàng hóa trong xác tàu"
 opinion_returned_supplies: "Hoàn trả hàng hóa trong xác tàu"
 frozen_in_time: "Đóng băng trong thời gian"
 frozen_in_time_desc: "Đây là tàn tích của một nền văn minh đã mất, khi một siêu bão mặt trời làm cạn kiệt bầu khí quyển của hành tinh, họ đã bị dập tắt như một ngọn nến."
 superflare_star: "Siêu bão mặt trời"
 superflare_star_desc: "Ngôi sao này thỉnh thoảng lại bắn ra các đợt siêu bão mặt trời, phun một lượng lớn plasma vào trong hệ sao."
 superflare_planet: "Cảnh báo siêu bão mặt trời"
 superflare_planet_desc: "Chúng ta biết rằng ngôi sao của hành tinh này sẽ phun trào các đợt siêu bão mặt trời, có thể mang lại những tác động có hại cho sự sống và các thiết bị điện tử trên bề mặt hành tinh."
 superflare_struck: "Hậu quả siêu bão mặt trời"
 superflare_struck_desc: "Hành tinh này đã phải hứng chịu ảnh hưởng từ một trận siêu bão mặt trời, dẫn đến mức độ bức xạ tăng cao cũng như gây nhiễu các thiết bị điện tử."
 superflare_avoided: "Phòng thủ siêu bão mặt trời"
 superflare_avoided_desc: "Cư dân trên hành tinh này được bảo vệ an toàn khỏi các tác động tiêu cực của hoạt động siêu bão mặt trời."
 black_hole_energy: "Tích tụ năng lượng"
 black_hole_energy_desc: "Đĩa bồi tụ xoay quanh lỗ đen này mang điện tích rất cao, tạo ra một lượng năng lượng tĩnh điện khổng lồ."
 black_hole_hologram: "Hình ảnh ba chiều của Hạm đội"
 black_hole_hologram_desc: "Một hạm đội bí ẩn đã tiến vào chân trời sự kiện của lỗ đen này, những người quan sát từ bên ngoài chỉ có thể nhìn thấy hình ảnh vĩnh cửu mà chúng để lại trên bề mặt."
 primitive_robots: "Robot nguyên thủy"
 primitive_robots_desc: "Trên hành tinh này vẫn còn những robot sơ khai đang hoạt động, trong khi nền văn minh tạo ra chúng thì đã tiêu vong từ lâu."
 erratic_behavior: "Hành vi kỳ dị"
 erratic_behavior_desc: "Cá nhân này đang thể hiện những hành vi kỳ quặc và đôi lúc mất kiểm soát."
 conviction: "Tín ngưỡng"
 conviction_desc: "Thành viên này tin chắc rằng chúng ta là sứ giả của Đấng Thánh Tái sinh. Do đó, họ vô cùng khát khao làm hài lòng chúng ta."
 researcher_rage: "Nhà khoa học điên cuồng"
 researcher_rage_desc: "Một loại virus thần kinh khiến người nhiễm bệnh trở nên lú lẫn và phát sinh tính hiếu chiến, đã gây ra tổn thất lớn cho các nhà khoa học xã hội trên hành tinh này."
 evolved_weapon_boost: "Vũ khí cường hóa tiến hóa"
 evolved_weapon_boost_2: "$evolved_weapon_boost$"
 evolved_firing_rate: "Tốc độ bắn tiến hóa"
 evolved_evasion: "Độ né tránh tiến hóa"
 clones_in_cryo: "Bản sao trong kho lạnh"
 clones_in_cryo_desc: "Trên Thế giới Vành đai bị bỏ hoang quay quanh ngôi sao này, có hàng trăm hàng ngàn bản sao vô tính đang được phong ấn trong các khoang đông lạnh."
 dead_god: "Sinh vật khổng lồ câm lặng"
 dead_god_desc: "Trên bề mặt của mặt trăng này có hài cốt của một sinh vật ngoài hành tinh khổng lồ vô danh."
 dead_god_planet: "Thần linh quá vãng"
 dead_god_planet_desc: "Hài cốt của một sinh vật ngoài hành tinh khổng lồ nào đó đang lặng lẽ ngắm nhìn hành tinh này từ trên quỹ đạo."
 dead_god_planet_hidden: "Xung động bí ẩn"
 dead_god_planet_hidden_desc: "Sự sống hữu cơ trên hành tinh này đang bị ảnh hưởng bởi một hiện tượng bí ẩn nào đó."
 life_electric: "Sự sống điện tích"
 life_electric_desc: "Một mạng lưới xung điện đang hoạt động đan xen trên bề mặt của tiểu hành tinh này."
 rummy_nebula: "Đồ uống có cồn ngoài hành tinh"
 rummy_nebula_desc: "Chúng ta đã phát hiện một hành tinh khí khổng lồ chứa hàng ngàn tỷ lít este, thành phần của nó giống hệt với loại đồ uống có cồn mà tổ tiên chúng ta đã ủ suốt hàng nghìn năm. Mọi người đều đang hò reo ăn mừng vì điều này."
 opinion_gave_space_rum: "Nhận được đồ uống có cồn ngoài hành tinh"
 opinion_space_rum_failed: "Quà tặng xảy ra sự cố"
 soothing_crystals: "Tinh thể cộng hưởng"
 soothing_crystals_desc: "Tần số của các tinh thể cộng hưởng trong cấu trúc lớp vỏ của hành tinh này có hiệu quả chữa bệnh đối với giống loài của chúng ta."
 good_vibrations: "Từ trường xoa dịu"
 good_vibrations_desc: "Tần số cộng hưởng từ trường của hành tinh này vô cùng có lợi cho mạng lưới thần kinh của chúng ta."
 exofungus: "Nhiễm nấm ngoại lai"
 exofungus_desc: "Một loại nấm ngoại lai có khả năng sinh sôi trong môi trường khắc nghiệt đang lan rộng điên cuồng như tế bào ung thư, bao trùm khắp các cảnh quan."
 watery_grave: "Mộ phần dưới nước"
 watery_grave_desc: "Bên dưới mặt biển của hành tinh này tồn tại di tích của một quần thể linh trưởng dạng người nào đó, trải dài từ Nam Cực đến tận Bắc Cực."
 big_friendly_warform_power: "Vỏ ngoài kiên cố"
 big_friendly_warform_power_desc: "So với kích thước của nó, lớp vỏ ngoài của tàu chiến robot này cực kỳ rắn chắc."
 brainslug_woes: "Hội chứng Sợ sên"
 brainslug_woes_desc: "Người dân trên hành tinh này tỏ ra nghi ngờ về việc đồng bào của họ chọn cách cộng sinh với sên thần kinh."
 brainslug_woes_phobe: "$brainslug_woes$"
 brainslug_woes_phobe_desc: "$brainslug_woes_desc$"
 brainslug_hive: "Thích nghi với Sên"
 brainslug_hive_desc: "Việc chúng ta tiến hành cộng sinh với sên thần kinh gần đây đã gây ra những vấn đề khó chịu trên hành tinh này."
 predatory_plants: "Thực vật ăn thịt"
 predatory_plants_desc: "Hành tinh này đầy rẫy những loài thực vật khổng lồ hung tợn, mang đến cho chúng ta cơ hội nghiên cứu, nhưng cũng là một trở ngại nguy hiểm đối với cư dân."
 living_sea: "Biển cả Tự giác"
 living_sea_desc: "Mặc dù chúng ta chưa thể hiểu được bản chất đại dương của hành tinh này, nhưng không biết vì lý do gì, nó chắc chắn là một thực thể sống. Trong tâm trí của những sinh vật hữu cơ tiếp xúc với nó, sẽ trào dâng những suy nghĩ, ảo ảnh và những thôi thúc, tựa như một khúc ca dịu êm đang nhảy múa trong cõi lòng."
 scavenger_bot_power: "Thế lực Kẻ Nhặt Rác"
 elderly_tiyanki_power: "Thế lực Tộc Mẫu Tiyanki"
 ahab_power: "Thế lực AH4B"
 scavenger_weak_points: "Khắc tinh Kẻ Nhặt Rác"
 scavenger_weak_points_desc: "Kẻ Nhặt Rác không được chế tạo dựa trên bất kỳ một bản thiết kế có sẵn nào rõ ràng. Do đó, cấu trúc lỏng lẻo của nó chứa đựng một vài điểm yếu về mặt kết cấu. Bất kỳ hạm đội nào biết được những điểm yếu này đều có thể lợi dụng chúng."
 elderly_tiyanki_weak_points: "Manh mối của Tộc Mẫu"
 elderly_tiyanki_weak_points_desc: "Trên lớp vỏ bọc của Tộc Mẫu Tiyanki viễn cổ có một điểm yếu, đó là một quả ngư lôi proton khổng lồ chưa phát nổ cắm sâu vào lớp da ngoài của nó. Hạm đội của chúng ta biết cách làm thế nào để kích nổ nó."
 mod_damage_vs_country_type_guardian_scavenger_bot_mult: "Sát thương lên Robot Nhặt Rác"
 mod_damage_vs_country_type_guardian_elderly_tiyanki_mult: "Sát thương lên Tộc Mẫu Tiyanki"
 opinion_ratling_system_stolen: "Cắt nhượng hành tinh của $NAME_Ketling$"
 phaseshifted: "Chuyển pha"
 phaseshifted_desc: "Hành tinh này định kỳ chuyển giao giữa các chiều không gian, liên tục biến đổi qua lại giữa một hành tinh §Y$pc_shrouded$§! và một hành tinh §Y$pc_gaia$§!. Điều gì sẽ xảy ra với cư dân trên đó khi sự chuyển pha này diễn ra vẫn còn là một ẩn số."
 nanite_network: "Mạng lưới Điện toán"
 nanite_network_desc: "Một bầy nanobot chui ra từ chiếc đồng hồ nguyên tử bị phong ấn trong vành đai tiểu hành tinh của hệ sao này, đã xây dựng nên một mạng lưới điện toán với mục đích không rõ ràng tại đây."
