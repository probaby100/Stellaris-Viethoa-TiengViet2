 strategic_coordination_center_permanently_ruined_DESC: "$strategic_coordination_center_ruined_DESC$Nó bị hư hỏng nghiêm trọng nên không thể sửa chữa được."
 strategic_coordination_center_permanently_ruined_MEGASTRUCTURE_DETAILS: ""
