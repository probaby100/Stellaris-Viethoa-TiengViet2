 building_cosmic_storm_storm_grand_theater_tt: "Độ thu hút §Y$default_storm$§!: §PCao§!"
 MESSAGE_ELECTRIC_STORM_COSMIC_STORM_SPOTTED_TITLE: "Phát hiện $electric_storm$!"
 MESSAGE_SOLAR_STORM_COSMIC_STORM_SPOTTED_TITLE: "Phát hiện $solar_storm$!"
 MESSAGE_CELESTIAL_STORM_COSMIC_STORM_SPOTTED_TITLE: "Phát hiện $celestial_storm$!"
