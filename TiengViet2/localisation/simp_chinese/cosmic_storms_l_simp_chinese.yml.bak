 cstorms.2295.desc.authgen.gestalt: "$cstorms.2295.desc.start.authgen$\n\n$cstorms.2295.desc.end.gestalt$"
 cstorms.2295.desc.default.default: "$cstorms.2295.desc.start.default$\n\n$cstorms.2295.desc.end.default$"
 cstorms.2295.desc.default.psionic: "$cstorms.2295.desc.start.default$\n\n$cstorms.2295.desc.end.psionic$"
 cstorms.2295.desc.default.psionic_individual_robot: "$cstorms.2295.desc.start.default$\n\n$cstorms.2295.desc.end.psionic_individual_robot$"
 cstorms.2295.desc.default.psionic_gestalt: "$cstorms.2295.desc.start.default$\n\n$cstorms.2295.desc.end.psionic_gestalt$"
 cstorms.2295.desc.default.gestalt: "$cstorms.2295.desc.start.default$\n\n$cstorms.2295.desc.end.gestalt$"
 cstorms.2295.a: "Cứ để [Root.GetLeaderName] làm đi."
 cstorms.2295.b: "Không được phép để [Root.GetLeaderName] tự ý hành động."
 cstorms.2295.a.psionic: "Những nạn nhân vẫn đang than khóc."
 cstorms.2295.a.psionic_gestalt: "Giọng nói đồng thanh của họ vẫn đang kêu gào trong đau đớn."
 cstorms.2295.a.gestalt: "Sự bất hòa nuôi dưỡng nên sự hỗn loạn."
 cstorms.2300.name: "Không Nói Cũng Hiểu"
 cstorms.2300.desc: "Chúng ta đã không ngừng cố gắng để mở khóa khu vực cuối cùng của $building_adakkaria_patriotic_institute$. Cùng lúc đó, chúng ta lại nhận được một báo cáo khó hiểu từ các phòng thí nghiệm ở tầng dưới. Các nhà khoa học adAkkaria tuyên bố rằng, trong mỗi cá nhân hay thậm chí mỗi cỗ máy có tri giác đều tồn tại một sức mạnh chói lọi. Lấy cảm hứng từ những cơn bão không gian, họ gọi sức mạnh này là 'Cơn Bão Nội Tâm': đây là một vòng xoáy mạnh mẽ của những ham muốn và sức mạnh thúc đẩy mọi sinh mệnh có nhận thức. Bằng cách để cho Cơn Bão Nội Tâm trải qua những thử thách cực độ, người ta có thể giải phóng ra một nguồn sức mạnh khổng lồ.\n\nTrong thời gian làm tù nhân, §SAlata Landil§! là người đầu tiên phát hiện ra hiệu ứng này. Với tư cách là một nhà khoa học, anh ta đã thuyết phục Bộ Chỉ Huy Tối Cao tài trợ cho các thí nghiệm tiếp theo của mình tại Học Viện Kỷ Niệm. Tuy nhiên, những nhật ký này không cho chúng ta biết chính xác chuyện gì đã xảy ra với §SLandil§!, chúng ta chỉ có thể đoán từ các sự kiện tại nghĩa địa hạm đội rằng kết cục cuối cùng của anh ta thật bi thảm.\n\nCác báo cáo sau đó đề cập đến một phương pháp 'hiệu quả hơn' để giải phóng cơn bão nội tâm. Phương pháp này không đòi hỏi phải lạm dụng thể xác đến mức cực đoan, mà dựa vào nỗi sợ hãi tột cùng không thể tránh khỏi trong tâm trí nạn nhân. Để phát huy tác dụng bước đầu trên diện rộng, Hiệp ước đã lên kế hoạch phát đi một tín hiệu thông qua mạng lưới trạm tuyên truyền khổng lồ của mình."
 cstorms.2300.desc.psionic: "Chúng ta đã ghi lại thành công những lời thì thầm ngoại cảm trên đài quan sát:\n\n§LXin hãy thả tôi ra, tôi là một công dân lương thiện!\nTôi chỉ mơ về những cơn bão bất tận. Nó đang gọi tôi.\nTôi không hiểu. Chúng ta đã hoàn thành xuất sắc mọi nhiệm vụ, tại sao họ còn đối xử với chúng ta như vậy?\nBên trong mỗi chúng ta đều có một sức mạnh. Họ muốn lợi dụng sức mạnh này. Chúng ta không thể để chúng đạt được mục đích.\nIm đi, họ làm vậy là để cứu Hiệp ước Nhân từ. Chúng ta phải phục tùng.\nVệ tinh đang thì thầm với tôi. Ý thức của tôi bây giờ có thể vượt qua các hệ sao.\nTôi thấy họ đã thiết kế ra một thứ gì đó. Nó có thể gây hại cho bất kỳ ai ở bất kỳ đâu.\nChỉ cần làm họ hài lòng, chúng ta sẽ được cứu!\nBạn không hiểu đâu, họ đối xử với chúng ta như vậy, thì họ cũng sẽ làm thế với tất cả mọi người.\nChúng ta có thể tự giải thoát cho chính mình.\nNhưng điều đó có nghĩa là chúng ta sẽ...\nKiểu gì họ cũng sẽ giết chúng ta. Đợi đến lúc thứ đó dùng được, họ sẽ giết hết chúng ta.\nTôi rất sợ, tôi không muốn chết. Tôi muốn sống. Xin hãy giúp tôi.\nGiai đoạn Cuối đang nói chuyện với tôi. Bọn họ muốn biết chúng ta có đồng ý hay không.§!"
 cstorms.2300.b: "Sức mạnh này giờ là của chúng ta."
 cstorms.2300.a.psionic: "Đúng là một kết cục đau buồn."
 cstorms.2300.a.psionic_hive_robot: "Một kết quả không may."
 cstorms.2300.b.psionic: "Không có gì cao cả hơn sự hy sinh."
 cstorms.2300.b.psionic_hive_robot: "Một sự hy sinh xứng đáng."
 cstorms.2305.name: "Máy Gọi Bão"
 cstorms.2305.desc.start: "Chúng ta đã tìm thấy một nhà chứa máy bay khổng lồ. Một tổ hợp các dây cáp, đường ống và thiết bị điện tử phức tạp đến khó tin lấp đầy không gian này — và tất cả chúng đều dẫn đến một hầm chứa tên lửa trống rỗng khổng lồ. Dựa trên các dấu vết, mạng lưới này từng kết nối với một vật thể có kích thước cỡ một tàu hộ tống.\n\nNhật ký cho thấy, nơi này được dùng để lắp ráp một thiết bị tên là §LMáy Gọi Bão§!, và nó đã được triển khai thành công đến adSul. Ngay cả khi mất liên lạc với máy gọi bão, §GThiết Bị Cấp Năng Lượng Cho Máy Gọi Bão§! vẫn đang tiếp tục hoạt động."
 cstorms.2305.desc.end.default: "Ngay khi nhìn thấy cái tên này, phi hành đoàn đã bị khống chế bởi một cơn giận dữ phi lý và bắt đầu xé toạc các dây cáp cùng bảng điều khiển. Những mệnh lệnh đơn giản đã không thể làm họ bình tĩnh lại. Có vẻ như chúng ta đang ngày càng tiến gần hơn tới sự thật."
 cstorms.2305.desc.end.psionic: "Khi [Root.GetLeaderName] tiến lại gần công trình trống rỗng này, những lời thì thầm ngoại cảm lại bắt đầu vang lên.\n§LCác người thấy rồi chứ? Ban đầu, chúng tôi không biết họ đang xây dựng thứ gì. Chúng tôi không biết họ sẽ vứt bỏ chúng tôi như thế này. Có người muốn trả thù, có người muốn tự do, có người cảm nhận được tiếng gọi của cơn bão. Tóm lại, mọi thứ phải được kết thúc, bạn cũng hiểu mà. Chúng tôi phải làm thế. Chúng tôi không thể chịu đựng thêm được nữa.§!"
 cstorms.2305.desc.end.gestalt: "Khi đọc được tên của thiết bị này, các [controller.GetIndividualNamePlural] thám hiểm của chúng ta đã hiểu được cách thức §LMáy Gọi Bão§! được kích hoạt, cũng như việc tín hiệu của nó dội lại giữa các trạm tuyên truyền cho đến khi chạm tới mục tiêu.\n\nChúng ta cũng không thể thoát khỏi số phận này."
 cstorms.2305.desc.default: "$cstorms.2305.desc.start$\n\n$cstorms.2305.desc.end.default$"
 cstorms.2305.desc.psionic: "$cstorms.2305.desc.start$\n\n$cstorms.2305.desc.end.psionic$"
 cstorms.2305.desc.gestalt: "$cstorms.2305.desc.start$\n\n$cstorms.2305.desc.end.gestalt$"
 cstorms.2310.name: "Giai Đoạn Cuối Cùng"
 cstorms.2310.desc.start: "Học Viện Kỷ Niệm cuối cùng cũng vén bức màn bí ẩn cuối cùng: cái gọi là Giai Đoạn Cuối Cùng.\n\nTrong hành lang này, những lớp vỏ khô quắt của người adAkkaria nằm rải rác khắp nơi, cơ thể họ bị xé toạc ra cùng với đất đá, kim loại, mảnh nhựa và đủ loại rác rưởi khác. Có thứ gì đó đã càn quét qua hành lang này, phá hủy mọi thứ ở đây.\n\nNhưng điều khiến người ta cảm thấy "
 cstorms.2310.desc.piece.default: "sợ hãi"
 cstorms.2310.desc.piece.authgen: "vui sướng"
 cstorms.2310.desc.end: " vẫn còn ở phía sau.\nCó một buồng giam chật hẹp nhốt sáu cá thể. Màn hình mô tả họ là §GNguồn Cấp Năng Lượng Cho Máy Gọi Bão§!, nhưng rõ ràng đây là những công dân thiếu niên của Hiệp ước, cơ thể gầy gò của chúng bị treo lơ lửng bởi hàng chục đường ống và dây cáp. Dung dịch trong buồng giam giữ chúng ở trạng thái nửa sống nửa chết, và cơ thể chúng bị bao bọc bởi một loại năng lượng tương tự như cơn bão đang ám ảnh hệ sao adSul.\n\nMột vài màn hình còn sót lại đột nhiên sáng lên, đồng loạt hiển thị một dòng chữ khẩn cầu:\n§LĐừng quên chúng tôi | Hãy gọi tên chúng tôi | Hãy gọi tên chúng tôi.§!\n\nChúng ta đã ghi lại tên của những người trẻ tuổi này. Khi chép đến cái tên cuối cùng, chúng ta khựng lại một lúc: §SEnrida Dylan§!, chính là cá thể đến từ Hiệp hội Nhân từ Cao cả đã dùng ý niệm để dập lửa.\n\nBây giờ chúng ta đã có được những cái tên này, có lẽ sẽ có thể giao tiếp lại với cơn bão không gian kia."
 cstorms.2310.desc.default: "$cstorms.2310.desc.start$$cstorms.2310.desc.piece.default$$cstorms.2310.desc.end$"
 cstorms.2310.desc.authgen: "$cstorms.2310.desc.start$$cstorms.2310.desc.piece.authgen$$cstorms.2310.desc.end$"
 cstorms.2310.a: "Làm tốt lắm!"
 # Khúc Hát Cuối Cùng Của Cơn Bão
 cstorms.2320.name: "Cơn Bão"
 cstorms.2320.desc: "Hãy gọi tên ta\n\nHãy gọi tên ta\n\nHãy | Gọi | Tên | Ta"
 cstorms.2320.a: "Chúng ta biết Hiệp ước đã làm gì với ngươi rồi."
 cstorms.2320.b: "Sau đó Hiệp ước adAkkaria đã ra sao?"
 cstorms.2320.c: "Máy Gọi Bão đang ở đâu?"
 cstorms.2320.d: "Chúng ta đã biết tên ngươi rồi."
 cstorms.2320.a.resp: "Nó sẽ không bao giờ dừng lại\n\nVừa đau vừa giận vừa buồn vừa sợ\n\nĐó là răng đó là hàm đó\nNhai nát rồi nhổ chúng ta ra\n\nVừa đau vừa giận vừa buồn vừa sợ\n\nChúng ta tan vỡ chúng ta không thành hình chúng ta lại tụ thành\n\nVừa đau vừa giận vừa buồn vừa sợ"
 cstorms.2320.b.resp: "Dung túng cho sự kiêu ngạo tàn nhẫn\nKiêu ngạo | Tàn nhẫn | Cố chấp\nTrao đi cái chết trao đi đau khổ\n\nChúng ta nhất định nhất định nhất định nhất định nhất định nhất định nhất định nhất định\nCó | Không | Sai\n\nChúng ta\nLan truyền hơi thở này | Hủy diệt niềm tin này | Tiêu diệt ý chí này\nPhủ trắng nó | Hóa tro nó | Xóa sổ nó | Phủ phục trước bóng tối\nRải rác khắp các vì sao không ai còn hay biết"
 cstorms.2320.c.resp: "Chúng ta\nLà lá chắn | Bảo vệ nó\n\nChúng ta\nLà giá đỡ | Nâng đỡ nó\n\nRung động đến mức biến mất | Ngủ ngủ ngủ rồi chết\n\n§LNgười Căm Hét§! §LBão Tố§!\nKhông bao giờ tỉnh lại nữa"
 cstorms.2325.desc: "Hãy gọi tên chúng ta | Hãy gọi tên chúng ta | Hãy gọi tên chúng ta\n\nNhanh §g(Nhanh)§! Nhanh§g(Nhanh)§!\n\nHãy gọi tên chúng ta | Hãy gọi tên chúng ta | Hãy gọi tên chúng ta\n\nNhanh | Nhanh | Gọi | Tên | Chúng | Ta"
 cstorms.2325.d: "Được rồi, tên của ngươi là..."
 cstorms.2330.desc: "§LChúng ta đã đọc lớn từng cái tên được tìm thấy trong quá trình khai quật. Khi cái tên cuối cùng vang lên, cơn bão chìm vào tĩnh lặng.§!"
 cstorms.2330.a: "Ngươi còn đó chứ?"
 cstorms.2335.desc: "Chúng ta lại có thể suy nghĩ rồi! §g(Suy nghĩ, suy nghĩ, suy nghĩ)§!\nXung quanh chúng ta có bao nhiêu là giọng nói! §g(Đang suy nghĩ, đang nói, đang kỳ vọng, đang mơ mộng)§!\nCó biết bao người riêng biệt §g(Bạn, tôi, hắn, bọn họ)§!\n\nCác người đã trả lại lý trí cho chúng ta §g(Trải nghiệm, giải mã, khám phá)§!\nNhưng có được những cái tên đã cho phép các người điều khiển chúng ta... §g(Không, đừng tiếp tục nữa!)§!\nCác người muốn chúng ta làm gì? §g(Thả chúng ta đi, thả chúng ta đi, thả chúng ta đi)§!"
 cstorms.2335.a: "Đã đến lúc để các ngươi được tự do rồi."
 cstorms.2335.b: "Hãy khuất phục trước chúng ta, giao Máy Gọi Bão ra đây."
 cstorms.2340.desc: "Tự do.\n\nCác người muốn thả chúng ta đi sao? §g(Tự do sao?)§!\n\nKhông thể nào. §g(Tuyệt đối không thể nào.)§!\nChắc chắn ý các người không phải vậy. §g(Vậy Máy Gọi Bão thì tính sao?)§!"
 cstorms.2340.a: "Chúng ta sẽ phá hủy nó."
 cstorms.2345.desc: "Lại đau đớn lại tức giận lại buồn bã lại sợ hãi. §g(Đau | Giận | Buồn | Sợ)§!\n\nĐây là điều duy nhất có lợi cho chúng ta.\n\nChỉ có Đau Giận Buồn Sợ mới giúp được chúng ta\n§gĐau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Sợ Đau Giận Buồn Sợ Đau Giận Buồn Sợ Đau Giận Buồn§!"
 cstorms.2345.a: "Tùy ngươi nói sao cũng được, nô bộc vĩnh cửu."
 cstorms.2350.name: "Bão Tố Không Còn"
 cstorms.2350.desc: "Cơn bão đã tách ra một khoảng trống từ bên trong, để lộ ra §LMáy Gọi Bão§!. Lạ thay, một thiết bị nhỏ bé thế này lại kéo theo bao nhiêu dục vọng, xung đột và hy sinh đến vậy. Sự tồn tại của nó thậm chí đã trực tiếp lật đổ một đế chế từng vô cùng rực rỡ.\n\nBằng một chuỗi lệnh đơn giản, chúng ta đã kích hoạt quy trình tự hủy của Máy Gọi Bão. Khi vụ nổ mờ dần và những mảnh vỡ rải rác khắp hệ sao, cơn bão cũng bắt đầu suy yếu. Khi nó bị chôn vùi, màn sương mù kỳ lạ bao phủ lấy hành tinh mẹ của Hiệp ước adAkkaria cũng biến mất không để lại một dấu vết.\n\nCơn ác mộng kéo dài đằng đẵng của họ cuối cùng cũng đã kết thúc."
 cstorms.2350.a: "Tên của các ngươi sẽ được ghi nhớ mãi mãi."
 cstorms.2355.name: "Đau Giận Buồn Sợ"
 cstorms.2355.desc: "Cơn bão đang cuộn trào trong cơn thịnh nộ yếu ớt, nhưng nó chẳng thể làm gì được chúng ta hay §LMáy Gọi Bão§!.\n\nChúng ta ra lệnh cho những giọng nói bị mắc kẹt bên trong mở ra một lối đi xuyên qua cơn bão, cho phép chúng ta chiếm đoạt thành tựu vĩ đại nhất của Hiệp ước.\n\nTuy nhiên, hành tinh mẹ của adAkkaria vẫn nằm ngoài tầm với; mọi con đường dẫn đến $building_adakkaria_patriotic_institute$ đã vĩnh viễn bị đóng lại. Cơn bão vẫn tiếp tục gầm thét trong tâm trí chúng ta.\n\nĐau đớn, tức giận, buồn bã và sợ hãi.\nGiờ đây, toàn bộ thiên hà cũng sẽ cảm nhận được điều đó."
 cstorms.2355.a: "Sự hy sinh cần thiết."
 MESSAGE_INSTITUTE_SPAWNED_STORM_TITLE: "Đánh Thức Bão Tố"
 MESSAGE_INSTITUTE_SPAWNED_STORM: "§Y100§!£pop£§H Dân số§! tại $PLANET$ đã được đánh thức, biến thành một cơn $STORM$ mới tại $SYSTEM$."
 artifact_adakkaria_research: "Bí Mật của adAkkaria"
 artifact_adakkaria_research_desc: "Nghiên cứu sâu hơn về những bí mật của adAkkaria."
 artifact_adakkaria_research_completed: "$artifact_adakkaria_research$"
 artifact_adakkaria_research_completed_desc: "Tri thức cổ đại của adAkkaria nay đã được chúng ta sử dụng."
 # Bí mật của Hiệp ước adAkkaria
 project_adakkaria_secrets_of: "Bí Mật Của Hiệp Ước adAkkaria"
 project_adakkaria_secrets_of_DESC: "Học Viện Kỷ Niệm vẫn còn nhiều thứ đáng để nghiên cứu. Liệu chúng ta có đủ can đảm để tiếp tục đào sâu vào những thí nghiệm của người adAkkaria này không?"
 cstorms.2365.name: "Giải Phóng Tiềm Năng"
 cstorms.2365.desc.start: "Đi sâu vào những nghiên cứu của Hiệp ước adAkkaria, chúng ta phát hiện ra rằng các nhà khoa học của họ dường như không bị ràng buộc bởi bất kỳ tiêu chuẩn nào được công nhận; không chỉ phương pháp nghiên cứu cẩu thả, mà kết luận cũng khá tầm thường. Họ hoàn toàn không thực hiện bất kỳ nghiên cứu cẩn trọng hay siêng năng nào, mà chỉ tập trung vào những hình thức đồi bại nhất. Hơn nữa, đối tượng thí nghiệm càng phải chịu đựng sự tàn nhẫn, thì Bộ Chỉ Huy Tối Cao lại càng khen ngợi.\n\nTuy nhiên, những nghiên cứu thuở ban đầu của họ lại kể một câu chuyện hoàn toàn khác: các đối tượng thí nghiệm đã được đối xử tử tế và tôn trọng trong quá trình đánh thức 'cơn bão nội tâm'. Thực tế, nếu so sánh tỷ lệ thành công giữa các nghiên cứu thời kỳ đầu và sau này, người ta chắc chắn sẽ đi đến một kết luận đáng sợ: chưa từng có bất kỳ mối tương quan nào giữa mức độ tra tấn và số lượng người được thức tỉnh. Vô số đối tượng thí nghiệm đã chết một cách vô nghĩa sau khi chịu đựng mọi đau khổ."
 cstorms.2365.desc.end.default: "Bây giờ chúng ta đã hiểu được nguyên lý đằng sau đó. Học hỏi từ sai lầm của Hiệp ước adAkkaria, chúng ta nên khuyến khích người dân nuôi dưỡng cơn bão nhỏ bé bên trong mình, giúp họ tràn đầy sức sống tựa như bão táp. Mối nguy hiểm nằm ở chỗ, một số cá nhân §G$Name_Storm_Fused$§! có thể đáp lại tiếng gọi của cơn bão, và cuối cùng tự mình tạo ra một cơn bão."
 cstorms.2365.desc.end.gestalt: "Tập thể của chúng ta giờ đã hiểu được nguyên lý này. Rút ra bài học từ những sai lầm của Hiệp ước adAkkaria, một bộ phận của chúng ta có thể tự mình nuôi dưỡng cơn bão nội tâm, khiến mọi thời kỳ đều tràn đầy sức sống tựa bão táp. Mối nguy hiểm nằm ở chỗ, một số nút §G$Name_Storm_Fused$§! có thể đáp lại tiếng gọi của cơn bão, và cuối cùng tự mình tạo ra một cơn bão."
 cstorms.2365.desc.default: "$cstorms.2365.desc.start$\n\n$cstorms.2365.desc.end.default$"
 cstorms.2365.desc.gestalt: "$cstorms.2365.desc.start$\n\n$cstorms.2365.desc.end.gestalt$"
 cstorms.2365.a: "Lập tức học hỏi những kiến thức mới này. Hãy cẩn thận đấy!"
 cstorms.2365.b: "Hãy để những bí mật này được yên nghỉ."
 cstorms.2365.a.tt: " —Trong khi trải qua cơn bão, tỷ lệ §Y100§!£pop£§H Dân số§! nhận được đặc điểm $Name_Storm_Fused$ sẽ tăng gấp 4 lần.\n —Mỗi 20 năm, có một tỷ lệ nhỏ §Y100§!£pop£§H Dân số§! sẽ tử vong và biến thành một cơn bão.\n —Tiềm Năng Nuôi Dưỡng: +5% Hạnh phúc (Đế chế)."
 Name_Storm_Fused: "Hòa Quyện Cùng Bão"
 Name_Storm_Fused_affix: "Hòa Quyện Cùng Bão " #The trailing space is intentional, to give a space before the species name on the species screen
 ########################################
 #### Kẻ Săn Bão #
 ########################################
 origin_storm_chasers: "Kẻ Săn Bão"
 origin_storm_chasers_desc: "Không có thử thách nào họ không dám đối mặt, không có manh mối nào họ không muốn theo đuổi, và cũng không có cơn bão nào họ làm ngơ.\n\nVề bản chất, đây là một nền văn minh thích theo đuổi sự kích thích. Điều này vừa có lợi, lại vừa có hại."
 origin_tooltip_storm_chasers_effects: " —$LEADERS_TRAITS$['concept_storm_rider']\n —Mỗi §YCông trình Bão§! tạo ra $mod_planet_jobs_unity_produces_mult$ hành tinh: §G$@storm_chasers_storm_building_unity_produces_mult|%0$§!\n —Tỷ lệ §Y$default_storm$§! xuất hiện trong lãnh thổ: §G+100%§!\n —Tỷ lệ nhận được lựa chọn nghiên cứu §YCông Nghệ Bão Không Gian§!: §G+175%§!\n —Sở hữu ['concept_weather_forecasting_mode']\n —$ADDITIONAL_TECHNOLOGIES_STRING$$TABBED_NEW_LINE$—£physics£ ['technology:tech_storm_prediction_1']"
 START_SCREEN_STORM_CHASERS: "Sống là phải vận động. Sinh ra rực rỡ, thác đi huy hoàng — đó vẫn luôn là tín điều của chúng ta. Khi mọi hành trình đã được khám phá, mọi đỉnh núi đã được chinh phục, rồi sao nữa?\n\nHành tinh của chúng ta quanh năm gió cuộn mây vần, đủ các loại bão lũ hoành hành. Nếu có thể tìm ra cách lợi dụng những điều kiện độc đáo này, chúng ta sẽ có cơ hội triệu hồi một cơn bão không gian đầy cuồng bạo.\n\nChúng ta đã chinh phục mọi thử thách trên hành tinh mẹ từ lâu, đã đến lúc phải lao vút về phía không gian sâu thẳm. Chắc chắn đây không phải là một con đường bằng phẳng, nhưng chúng ta có một câu tục ngữ: 'Có chí thì nên!'"
 # Đặc điểm Kỵ Sĩ Bão
 leader_trait_storm_rider_desc: "Các Kỵ Sĩ Bão luôn say sưa với sự bùng nổ của adrenaline, giải phóng tiềm năng thực sự của họ ngay giữa dòng xoáy của bão không gian. Các vị trí Nội các sẽ thay thế các chỉ số lĩnh vực của họ bằng chỉ số Nội các."
 mod_trait_storm_rider: "\n$t$Hiệu quả sẽ tăng lên khi nhà lãnh đạo này ở trong một cơn bão không gian."
 leader_trait_storm_rider_name: "Kỵ Sĩ Bão"
 leader_trait_storm_rider_commander: "$leader_trait_storm_rider_name$"
 leader_trait_storm_rider_commander_desc: "$leader_trait_storm_rider_desc$"
 leader_trait_storm_rider_scientist: "$leader_trait_storm_rider_name$"
 leader_trait_storm_rider_scientist_desc: "$leader_trait_storm_rider_desc$"
 leader_trait_storm_rider_official: "$leader_trait_storm_rider_name$"
 leader_trait_storm_rider_official_desc: "$leader_trait_storm_rider_desc$"
 # Sự kiện Tiến trình cụ thể của Kẻ Săn Bão
 progress.2.desc.storm.normal: "Một [Root.Owner.GetScientist] reo lên: 'Nhanh ra xem sinh vật bé nhỏ này đi!'\n\n$progress.2.desc.storm.outro$"
 progress.2.desc.storm.gestalt: "Chúng ta đang run rẩy vì phấn khích.\n\n$progress.2.desc.storm.outro$"
 progress.2.desc.storm.outro: "Có sự sống ngoài hành tinh, ngay trên [From.GetName]! Những sinh vật hoang dã này có lẽ sẽ chưa thể giao tiếp với chúng ta ngay, nhưng ít nhất chúng ta biết rằng hành trình khám phá vũ trụ của mình không hề đơn độc!\n\nCó thể cuối cùng chúng ta sẽ phát hiện ra rằng thiên hà này tràn ngập vô số các dạng sống khác nhau."
 progress.3.desc.storm.normal: "'Tuyệt vời!' [ruler.GetRegnalName] hét lớn. 'Đây là một thế giới mới, ngập tràn những cơ hội mới!'\n\nNgay khi chúng ta vừa cải tạo tàu thực dân thành căn cứ, những nhà thám hiểm đầu tiên đã sẵn sàng đối mặt với bất cứ thử thách nào mà hành tinh này có thể mang lại."
 progress.3.desc.storm.gestalt: "Một khám phá đầy rung động! Một hành tinh mới ngập tràn cơ hội!!\n\nNgay khi chúng ta vừa cải tạo tàu thực dân thành căn cứ, các nút bấm thám hiểm đã sẵn sàng đối mặt với bất kỳ thử thách nào mà hành tinh này có thể mang lại."
 progress.3.a.storm: "Tiếp tục."
 progress.4.desc.storm: "Sự im lặng của không gian đã đáp lại tiếng gọi của chúng ta! Nền văn minh ngoài hành tinh có trình độ công nghệ tương đương với chúng ta này, chắc chắn họ cũng đã bước vào kỷ nguyên du hành không gian cùng thời điểm với chúng ta.\n\nSự xuất hiện của họ mở ra phần dạo đầu cho một trải nghiệm hoàn toàn mới. Họ sẽ trở thành những đồng minh chung chí hướng, hay một phép thử cho lòng can đảm của chúng ta? Dù thế nào, sự phấn khích của những điều chưa biết đang vẫy gọi chúng ta tiến bước."
 progress.4.h.storm: "Thật là thú vị."
 progress.5.desc.storm.normal: "Chúng ta đã phát hiện ra các dạng sống chưa có tri giác trên [From.Planet.GetName]. Một trong các [Root.Owner.GetScientistPlural] của chúng ta nói, 'Những sinh vật này trông có vẻ bình thường, nhưng lại ẩn chứa tiềm năng vô cùng to lớn!'\n\nTất nhiên cho đến hiện tại chúng vẫn chưa có tri giác. Quan sát những giống loài này sinh sôi nảy nở là một việc không thể thú vị hơn."
 progress.5.desc.storm.gestalt: "Chúng ta đã phát hiện ra các dạng sống chưa có tri giác trên [From.Planet.GetName].\n\nChúng ta rất hào hứng muốn quan sát xem tiềm năng của chúng có thể đi xa đến đâu, nhưng cho đến nay chúng vẫn chưa có tri giác. Quan sát những giống loài này sinh sôi nảy nở là một việc không thể thú vị hơn."
 progress.5.h.storm: "Thật hoang dã."
 progress.6.desc.storm: "Từ không gian tĩnh lặng, tiếng gọi của chúng ta đã được hồi đáp! Nhưng ấn tượng đầu tiên có vẻ không ổn lắm, những người này có tư duy khác với chúng ta, họ thích giữ bí mật cho riêng mình. Tốt nhất là hiện tại chúng ta nên giữ khoảng cách."
 progress.6.h.storm: "Rồi từ từ họ sẽ hiểu thôi."
 pirate.1.desc.storm: "Hải tặc không gian! Dù chỉ là ý tưởng về họ cũng đủ thú vị, một nhóm tự xưng là §S[pirate_band.GetName]§! đã nhắm mục tiêu vào chúng ta.\n\nMặc dù chúng ta có thể tôn trọng lối sống mà họ lựa chọn, nhưng tác động của việc này đối với mạng lưới thương mại của chúng ta thì không được lý tưởng cho lắm."
 pirate.2.j.storm: "Quá xui xẻo."
 ### BẮT ĐẦU TÌNH HUỐNG KHỞI NGUỒN BÃO ###
 situation_stormfall: "Bão Đang Kéo Đến"
 situation_stormfall_type: "Tình Huống Khởi Đầu"
 situation_stormfall_desc: "Thời tiết khắc nghiệt trên [owner.capital_scope.GetName] đã cho thấy sức mạnh chấn động ẩn chứa bên trong cơn bão. Nếu chúng ta nắm vững cách kiểm soát thời tiết của hành tinh, chúng ta có thể tận dụng kiến thức này trên quy mô vũ trụ. Việc xây dựng các công trình thu hút bão sẽ thúc đẩy quá trình theo đuổi cơn bão tối thượng của chúng ta."
 situation_stormfall_monthly_change_tooltip: "Chúng ta sẽ học được cách kiểm soát những cơn bão này."
 situation_stormfall_outcome: "Sự ra đời của bão không gian."
 stage_stormfall_effects: "Chúng ta phải học cách thao túng bão không gian."
 # Phương pháp Tiếp cận Thư Giãn
 situation_stormfall_chill: "Thư Giãn"
 approach_stormfall_chill_tt: "$situation_speed_tt$: §R-20%§!\nTốc độ Nghiên cứu: §YKhông ảnh hưởng§!"
 # Phương pháp Tiếp cận Cân Bằng
 situation_stormfall_balanced: "Cân Bằng"
 approach_stormfall_balanced_tt: "$situation_speed_tt$: §YKhông ảnh hưởng§!"
 # Phương pháp Tiếp cận Tàn Phá
 situation_stormfall_shredding: "Tàn Phá"
 approach_stormfall_shredding_tt: "$situation_speed_tt$: §G+20%§!"
 situation_stormfall_pause_desc: "$situation_cyberization_pause_desc$"
 situation_stormfall_project_pause_desc: "Dự Án Đặc Biệt"
 situation_stormfall_leader_ongoing: "Cường Hóa Bão Cho Lãnh Đạo"
 situation_stormfall_building: "Công Trình Thu Hút Bão"
 situation_stormfall_module: "$sm_storm_attraction_computer$"
 situation_stormfall_finish_project_tt: "Phải hoàn thành dự án đặc biệt: §Y$PROJECT_TEMPEST_BREWING$§!"
 # Các chỉ số cho chuỗi sự kiện Bão Đang Kéo Đến
 cs_storm_chasers_storm_fruition: "Thành Quả Từ Bão"
 cs_storm_chasers_storm_fruition_desc: "Chúng ta đã đánh thức một cơn bão không gian của riêng mình, nó sẽ ảnh hưởng đến nhân dân chúng ta trong những năm tháng tới."
 cs_storm_chasers_storm_fruition_gestalt: "$cs_storm_chasers_storm_fruition$"
 cs_storm_chasers_storm_fruition_gestalt_desc: "Chúng ta đã đánh thức một cơn bão không gian của riêng mình, nó sẽ cường hóa ý thức của chúng ta trong những năm tháng tới."
 cs_storm_chasers_homeworld_storm_attraction: "Thời Tiết Khắc Nghiệt"
 cs_storm_chasers_homeworld_storm_attraction_desc: "Những cơn bão tàn nhẫn trên hành tinh này đã đẩy sự sống ở đây đi theo hai con đường hoàn toàn trái ngược: những kẻ tìm kiếm sự che chở giữa mớ hỗn độn, và những kẻ say sưa với sự khoái cảm do cơn bão mang lại."
 cs_storm_chasers_homeworld_storm_attraction_tt: "Độ thu hút §Y$default_storm$§!: §PThấp§!"
 # Dự án đặc biệt
 PROJECT_TEMPEST_BREWING: "Bão Táp Chực Chờ"
 PROJECT_TEMPEST_BREWING_DESC: "Cơn bão nghìn năm có một trên [Owner.Capital.GetName] này sở hữu những đặc tính vô cùng hoàn hảo để điều chỉnh. Nhưng trước tiên chúng ta cần đào sâu sự hiểu biết về thành phần cấu tạo của nó. Ai mà biết được chúng ta sẽ mang lại điều tuyệt vời gì cho cuộc sống cơ chứ?"
 # Sự kiện
 cstorms.3100.name: "Bão Đang Kéo Đến"
 cstorms.3100.desc: "Cơn bão tự nhiên trên §Y[owner.capital_scope.GetName]§! đã cho chúng ta thấy được sức mạnh nguyên thủy của tự nhiên — mang theo cả sự rung động kinh hoàng của giông bão lẫn con đường hồi sinh vươn lên từ sự hủy diệt.\n\nGần đây, các trạm khí tượng trên toàn cầu đều phát hiện ra một hiện tượng bất thường: một mạng lưới siêu bão sắp sửa càn quét khắp hành tinh.\n\nCác [Root.Owner.GetScientistPlural] của chúng ta gọi đây là 'cơ duyên chính đáng'. Những cơn bão hiếm có này tạo điều kiện hoàn hảo để chúng ta chứng kiến một số sự kiện cực đoan nhất."
 cstorms.3100.a: "Mang theo thiết bị thăm dò nào!"
 cstorms.3105.name: "Bão Táp Chực Chờ"
 cstorms.3105.desc: "Các [Root.Owner.GetScientistPlural] của chúng ta đã khám phá ra bí mật để thao túng bão. Dự báo năng lượng bão đã vượt mọi kỷ lục từng được ghi nhận. Chúng ta sắp phải đối mặt với thử thách, và chứng minh rằng chúng ta là những người xứng đáng nhất.\n\nCác công trình đặc biệt có thể hoạt động như một trung tâm điều phối để cải thiện bão. Các công trình làm tăng độ thu hút của bão trên §Y[owner.capital_scope.GetName]§! sẽ đẩy nhanh quá trình hướng tới sự phát triển của cơn bão tối thượng của chúng ta."
 cstorms.3105.a: "Tuyệt cú mèo."
 cstorms.3105.a.tt: "Có §YCông Trình Thu Hút Bão§! trên Hành Tinh Thủ Đô:\n$situation_speed_tt$: §G+10%§!\n\nCó §Y$sm_storm_attraction_computer$§! trên Trạm Không Gian Thủ Đô:\n$situation_speed_tt$: §G+10%§!\n\n"
 cstorms.3110.name: "Giáng Lâm"
 cstorms.3110.desc.outro: "Bằng cách truyền thêm năng lượng vào các cơn bão tự nhiên, chúng ta có thể tạo ra các điều kiện cho một cơn bão điện từ.\n\nThao túng lõi hành tinh có thể thay đổi hướng từ trường của [owner.capital_scope.GetName], từ đó gây ra bão từ.\n\nCuối cùng, bằng cách đảo ngược các cực của hạt tachyon tại các vị trí cụ thể trên hành tinh, sự biến đổi của trường này có thể được dùng để tạo ra bão trọng lực."
 cstorms.3110.desc.regular: "Chúng ta đã học được cách khởi động những rung động dữ dội của [owner.capital_scope.GetName], và nhào nặn chúng thành một trải nghiệm tối thượng. Nhưng chúng ta phải quyết định xem loại bão nào là tráng lệ nhất.\n\n$cstorms.3110.desc.outro$"
 cstorms.3110.desc.hive: "Chúng ta đã học được cách khởi động những rung động dữ dội của [owner.capital_scope.GetName], và nhào nặn chúng thành một trải nghiệm tối thượng. Nhưng chúng ta vẫn chưa quyết định được loại bão nào là tráng lệ nhất.\n\n$cstorms.3110.desc.outro$"
 cstorms.3110.desc.machine: "Chúng ta đã học được cách khởi động những rung động dữ dội của [owner.capital_scope.GetName], và nhào nặn chúng thành một trải nghiệm tối thượng. Nhưng trong quá trình cố gắng xác định loại bão nào là tráng lệ nhất, tiến trình đánh giá giá trị của chúng ta đã rơi vào vòng lặp đệ quy.\n\n$cstorms.3110.desc.outro$"
 cstorms.3110.a: "Tích điện cho những đám mây."
 cstorms.3110.a.tt: "Gieo hạt tạo một §Y$electric_storm$§! hành tinh."
 cstorms.3110.b: "Từ hóa lõi."
 cstorms.3110.b.tt: "Gieo hạt tạo một §Y$magnetic_storm$§! hành tinh."
 cstorms.3110.c: "Tạo sóng trọng lực."
 cstorms.3110.c.tt: "Gieo hạt tạo một §Y$gravity_storm$§! hành tinh."
 cstorms.3130.name: "Khởi hành thôi"
 cstorms.3130.desc.electric: "Sấm rền chớp giật!\n\nNhững quá trình phóng điện mạnh mẽ này không chỉ làm bề mặt hành tinh tích điện, mà còn khiến chúng ta cảm nhận được sự hưng phấn thực sự! Mặc dù nông nghiệp sẽ phải gánh chịu hậu quả từ các cơn bão điện từ, nhưng tiềm năng phát điện của chúng là điều không thể phủ nhận."
 cstorms.3130.desc.magnetic: "Từ trường của [owner.capital_scope.GetName] bị bóp méo dữ dội, la bàn cũng theo đó mà nhảy múa loạn xạ.\n\nBằng cách khoan xuyên qua lớp vỏ hành tinh quê nhà, chúng ta đã bơm trực tiếp các vật chất từ tính vào lõi, các cơn bão tự nhiên sẽ phóng đại những dao động từ trường do việc này tạo ra. Việc này sẽ cản trở quá trình sản xuất năng lượng, nhưng lại giúp cải thiện khả năng thăm dò các mỏ khoáng sản mới."
 cstorms.3130.desc.gravity: "Giờ đây, ngay cả những chuyển động đơn giản nhất cũng mang lại cảm giác phấn khích chưa từng có! Trọng lực tăng giảm trong chớp mắt mà không ai hay biết.\n\nCác trạm thao tác hạt nằm rải rác khắp [owner.capital_scope.GetName] đã đảo ngược các cực của tachyon, tập trung chúng thành những quả cầu năng lượng nổ lách tách. Khi những quả cầu ánh sáng này biến mất nhanh chóng — các [Root.Owner.GetScientistPlural] tin rằng chúng đã bị gửi về quá khứ — sóng trọng lực sẽ lan tỏa về mọi hướng.\n\nBiến động này sẽ gây khó khăn cho các hoạt động trên bề mặt hành tinh, nhưng lại tạo điều kiện thuận lợi cho các công việc trên trạm không gian quỹ đạo."
 cstorms.3130.a: "Chuyến đi không uổng phí."
 cstorms.3130.a.tt.regular: "Trong thời gian diễn ra bão hành tinh:\n$MOD_POP_HAPPINESS$: §G+20%§!"
 cstorms.3130.a.tt.gestalt: "Trong thời gian diễn ra bão hành tinh:\n$mod_country_unity_produces_mult$: §G+5%§!"
 cstorms.3140.name: "Nhịp Điệu Hoàn Mỹ"
 cstorms.3140.desc.intro: "Các [Root.Owner.GetScientistPlural] tin rằng, những ý tưởng mà chúng ta dùng để kích thích bão hành tinh có thể được áp dụng ở quy mô rộng lớn hơn, và giờ đây toàn bộ hệ sao đang xoay vòng trong một nguồn năng lượng cuồng bạo."
 cstorms.3140.desc.electric: "$cstorms.3140.desc.intro$\n\nChúng ta có thể tận dụng kiến thức và cơ sở hạ tầng có sẵn để biến nó thành một cơn $electric_storm$, hoặc cũng có thể tạo ra những thứ gì đó mới mẻ và thú vị.\n\nĐưa các khoáng chất cụ thể vào sẽ tăng cường sự cộng hưởng từ trường của cơn bão, trong khi việc sử dụng hợp kim sẽ biến nó thành một giếng trọng lực."
 cstorms.3140.desc.magnetic: "$cstorms.3140.desc.intro$\n\nChúng ta có thể tận dụng kiến thức và cơ sở hạ tầng có sẵn để biến nó thành một cơn $magnetic_storm$, hoặc cũng có thể tạo ra những thứ gì đó mới mẻ và thú vị.\n\nSạc năng lượng cho các ngôi sao sẽ gia tăng tiềm năng điện từ của cơn bão, trong khi việc sử dụng hợp kim sẽ biến nó thành một giếng trọng lực."
 cstorms.3140.desc.gravity: "$cstorms.3140.desc.intro$\n\nChúng ta có thể tận dụng kiến thức và cơ sở hạ tầng có sẵn để biến nó thành một cơn $gravity_storm$, hoặc cũng có thể tạo ra những thứ gì đó mới mẻ và thú vị.\n\nĐưa các khoáng chất cụ thể vào sẽ tăng cường sự cộng hưởng từ trường của cơn bão, trong khi sạc năng lượng cho các ngôi sao sẽ gia tăng tiềm năng điện từ của cơn bão."
 cstorms.3140.a: "Sạc năng lượng cho ngôi sao."
 cstorms.3140.a.tt: "Gieo hạt tạo một §Y$electric_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_energy_produces_mult$: §R-50%§!$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+20%§!"
 cstorms.3140.a.infra: "Sử dụng cơ sở hạ tầng hiện có."
 cstorms.3140.a.tt.electric: "Gieo hạt tạo một §Y$electric_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+5%§!"
 cstorms.3140.b: "Triển khai khoáng thạch từ hóa."
 cstorms.3140.b.tt: "Gieo hạt tạo một §Y$magnetic_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_minerals_produces_mult$: §R-50%§!$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+20%§!"
 cstorms.3140.b.tt.magnetic: "Gieo hạt tạo một §Y$magnetic_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+5%§!"
 cstorms.3140.c: "Sử dụng hợp kim đặc biệt."
 cstorms.3140.c.tt: "Gieo hạt tạo một §Y$gravity_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_alloys_produces_mult$: §R-25%§!$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+20%§!"
 cstorms.3140.c.tt.gravity: "Gieo hạt tạo một §Y$gravity_storm$§! vũ trụ.\nTrong §Y2§! năm tới:$TABBED_NEW_LINE$$mod_country_unity_produces_mult$: §G+5%§!"
 cstorms.3160.name: "Sau Cơn Bão"
 cstorms.3160.desc: "Sau khi cơn bão hành tinh tan đi, trên [owner.capital_scope.GetName] lại xuất hiện thêm một đặc điểm lâu dài mới. Cơn bão một lần nữa lại mang đến những cơ hội tái sinh.\n\nMặc dù cơn bão cục bộ này rất kích thích, nhưng chúng ta vẫn chỉ có thể mường tượng về khả năng của một cơn bão không gian thực sự. Tại sao lại mất nhiều thời gian đến vậy chứ?"
 cstorms.3160.a: "Đúng là một kỷ niệm tuyệt đẹp!"
 cstorms.3160.a.tt.electric: "Cơn bão đã để lại những §Y$d_buzzing_plains$§! nhiễm điện trên [owner.capital_scope.GetName]."
 cstorms.3160.a.tt.magnetic: "Cơn bão đã để lại §Y$d_geothermal_vent$§! mới trên [owner.capital_scope.GetName]."
 cstorms.3160.a.tt.gravity: "Cơn bão đã làm lộ ra §Y$d_rich_mountain$§! trên [owner.capital_scope.GetName]."
 cstorms.3170.name: "Định Hình Không Gian"
 cstorms.3170.desc.intro: "Chúng ta có thể đẩy nhanh tốc độ hình thành của một cơn bão không gian khổng lồ xung quanh [owner.capital_scope.GetStarName], nhưng chúng ta cũng phải tự vấn bản thân — liệu mình đã thực sự sẵn sàng đánh cược mạng sống vì điều này chưa?\n\n"
 cstorms.3170.desc.scientist.snippet: "Một đội ngũ [Root.Owner.GetScientistPlural] do §Y[event_target:storm_scientist.GetName]§! dẫn đầu có thể nghiên cứu các mô hình bão không gian ở giai đoạn đầu để tìm ra con đường lý tưởng nhất nhằm thao tác và tạo ra chúng.\n\n"
 cstorms.3170.desc.commander.snippet: "Nếu chúng ta để §Y[event_target:storm_commander.GetName]§! dẫn một đội quân đến đó, họ có thể kích nổ cơn bão đang chớm nở, khiến năng lượng trút xuống như thác đổ.\n\n"
 cstorms.3170.desc.outro: "Đội quân do nhà lãnh đạo này dẫn dắt chưa chắc đã có thể trở về an toàn. Tuy nhiên, họ cũng có khả năng tạo nên một thành tựu vô cùng vĩ đại!"
 cstorms.3170.desc.both: "$cstorms.3170.desc.intro$$cstorms.3170.desc.scientist.snippet$$cstorms.3170.desc.commander.snippet$$cstorms.3170.desc.outro$"
 cstorms.3170.desc.scientist: "$cstorms.3170.desc.intro$$cstorms.3170.desc.scientist.snippet$$cstorms.3170.desc.outro$"
 cstorms.3170.desc.commander: "$cstorms.3170.desc.intro$$cstorms.3170.desc.commander.snippet$$cstorms.3170.desc.outro$"
 cstorms.3170.desc.none: "Hiện giờ tất cả những gì chúng ta có thể làm là chờ đợi cơn bão không gian thành hình.\n\nSự chờ đợi này tuy khiến người ta nóng lòng, nhưng có thể phần thưởng nhận được sẽ càng thêm mãnh liệt."
 cstorms.3170.a: "Giao cho [Root.Owner.GetScientistPlural]."
 cstorms.3170.a.tt: "Nhà khoa học §Y[event_target:storm_scientist.GetName]§! sẽ tạm thời mất tích và có nguy cơ tử vong."
 cstorms.3170.b: "Ra lệnh cho quân đội tiến lên."
 cstorms.3170.b.tt: "Chỉ huy §Y[event_target:storm_commander.GetName]§! sẽ tạm thời mất tích và có nguy cơ tử vong."
 cstorms.3170.c: "Hành động cẩn trọng, kiên nhẫn chờ đợi."
 cstorms.3190.name: "Vô Tiền Khoáng Hậu"
 cstorms.3190.desc.intro: "Ban đầu nó chỉ là một gợn sóng nhỏ trong cấu trúc không gian. Năng lượng nhảy múa, hòa quyện và va chạm tại nơi đây. Thêm một chút hạt kỳ lạ, thêm một chút khối lượng, và cuối cùng, lực hấp dẫn từ một ngôi sao gần đó đã trút tất cả những thứ này lên con quái thú đang hiện diện trước mặt chúng ta.\n\nKỳ quan của thiên nhiên và trí tuệ, được điêu khắc theo ý muốn của chúng ta này, giờ đây đang thống trị bầu trời và khơi dậy một sự phấn khích cuồng nhiệt."
 cstorms.3190.desc.success: "$cstorms.3190.desc.intro$ Nhà lãnh đạo của chúng ta đã xuyên qua cơn bão, khơi dậy một sự phấn khích tột độ.\n\nChúng ta đã làm được. Chỉ có chúng ta mới có thể làm được. Hãy cùng cưỡi gió đạp sóng, tận hưởng niềm vui sướng nghìn năm có một này nào!"
 cstorms.3190.desc.failure: "$cstorms.3190.desc.intro$ Nhà lãnh đạo của chúng ta đã lạc mất trong cơn bão, nhưng đó chẳng phải là một lối thoát tuyệt vời sao!\n\nChúng ta đã làm được. Chỉ có chúng ta mới có thể làm được. Hãy cùng cưỡi gió đạp sóng, tận hưởng niềm vui sướng nghìn năm có một này nào!"
 cstorms.3190.desc.wait: "$cstorms.3190.desc.intro$ Chúng ta đã chờ đợi quá lâu, nhưng cuối cùng ngày này cũng đến.\n\nChúng ta đã làm được. Chỉ có chúng ta mới có thể làm được. Hãy cùng cưỡi gió đạp sóng, tận hưởng niềm vui sướng nghìn năm có một này nào!"
 cstorms.3190.a.success: "Cưỡi gió đạp sóng nào!"
 cstorms.3190.a.failure: "Hãy cùng chứng kiến!"
 cstorms.3190.a.failure.tt: "\nNhà lãnh đạo của chúng ta đã qua đời một cách vinh quang."
 cstorms.3190.a.wait: "Hoàn hảo!"
 ### Cơn Sốt Bão ###
 # Các chỉ số cho chuỗi sự kiện Cơn Sốt Bão
 cs_storm_chasers_bad_vibes: "Rung Động Xấu"
 cs_storm_chasers_bad_vibes_desc: "Chúng ta bỗng nhiên mất đi hứng thú."
 cstorms.3205.name: "Nhân Danh Nỗi Sợ"
 cstorms.3205.normal: "Rung động của vũ trụ đã biến mất, và những kỳ tích từng có không còn khơi dậy được sự hưng phấn của mọi người như trước nữa. Chúng ta chắc chắn đã hoàn thành được những điều phi thường, nhưng mọi người đều cảm thấy như đang thiếu đi thứ gì đó. Những thành tựu của tổ tiên chúng ta, cả về trình độ lẫn tham vọng đều là huyền thoại, đã phủ một cái bóng trải dài lên chúng ta - những kẻ kế nhiệm.\n\n'Những cuộc đấu tranh này thật mang đậm tính hiện sinh!' Một trong những người xuất sắc nhất của chúng ta gần đây đã viết. 'Chẳng lẽ chúng ta đã vượt qua cõi hư vô, chỉ để rồi tự ném mình vào khoảng không trống rỗng sao?'\n\nNỗi lo âu là có thật, và giờ là lúc để hành động. Để bắt đầu lại từ đầu, chúng ta quay về điểm xuất phát: đặt ra hàng loạt thử thách nhằm kích thích adrenaline lên mức tối đa!"
 cstorms.3205.gestalt: "Rung động của vũ trụ đã biến mất, và những kỳ tích từng có không còn khơi dậy được sự hưng phấn của mọi người như trước nữa. Chúng ta chắc chắn đã hoàn thành được những điều phi thường, nhưng mọi người đều cảm thấy như đang thiếu đi thứ gì đó.\n\nChúng ta đang bị bủa vây bởi những câu hỏi: Chúng ta có thực sự biết mình là ai không? Thời hoàng kim của chúng ta đã qua rồi sao? Là một Tập thể, chúng ta có trách nhiệm phải trở thành phiên bản tốt nhất của chính mình.\n\nNỗi lo âu là có thật, và giờ là lúc để hành động. Để bắt đầu lại từ đầu, chúng ta quay về điểm xuất phát: đặt ra hàng loạt thử thách nhằm kích thích adrenaline lên mức tối đa!"
 cstorms.3205.a: "Sự kịch tính mới chỉ bắt đầu thôi."
 cstorms.3205.tooltip: "Xem lại các thử thách trước đây trong Nhật ký Tình báo."
 cstorms.3215.name: "Cuồng Nhiệt Bùng Nổ"
 cstorms.3215.intro: "Chúng ta đã làm được!\n\nMục tiêu của chúng ta là theo đuổi sự kích thích thuần túy, và chúng ta đã đương đầu với mọi thử thách. Hãy chứng kiến những thành tựu mà chúng ta đã đạt được trong suốt những năm tháng qua!"
 cstorms.3215.desc: "$cstorms.3215.intro$\n\nCũng giống như những tiền nhân kiệt xuất trên hành tinh mẹ của mình, chúng ta đã vượt qua những giới hạn của bản thân.\n\nThậm chí, thông qua việc chống lại cơn thịnh nộ của tự nhiên, chúng ta còn nhận được những cái nhìn sâu sắc đáng kinh ngạc về giá trị tồn tại của chính mình."
 cstorms.3215.a: "Chúng ta lại trở lại rồi!"
 ### Cơn Bão Cuồng Loạn ###
 cs_storm_chasers_storm_frenzy_1: "Bão Cuồng Nhiệt"
 cs_storm_chasers_storm_frenzy_1_desc: "Sự kéo đến của bão Nexus đã đẩy chúng ta vào cơn cuồng nhiệt."
 cs_storm_chasers_storm_frenzy_2: "$cs_storm_chasers_storm_frenzy_1$"
 cs_storm_chasers_storm_frenzy_2_desc: "$cs_storm_chasers_storm_frenzy_1_desc$"
 cs_storm_chasers_storm_frenzy_3: "$cs_storm_chasers_storm_frenzy_1$"
 cs_storm_chasers_storm_frenzy_3_desc: "$cs_storm_chasers_storm_frenzy_1_desc$"
 cs_storm_chasers_storm_frenzy_1_gestalt: "$cs_storm_chasers_storm_frenzy_1$"
 cs_storm_chasers_storm_frenzy_1_gestalt_desc: "Sự kéo đến của Bão Nexus đang thiêu đốt ý thức của chúng ta."
 cs_storm_chasers_storm_frenzy_2_gestalt: "$cs_storm_chasers_storm_frenzy_1$"
 cs_storm_chasers_storm_frenzy_2_gestalt_desc: "$cs_storm_chasers_storm_frenzy_1_gestalt_desc$"
 cs_storm_chasers_storm_frenzy_3_gestalt: "$cs_storm_chasers_storm_frenzy_1$"
 cs_storm_chasers_storm_frenzy_3_gestalt_desc: "$cs_storm_chasers_storm_frenzy_1_gestalt_desc$"
 cs_storm_chasers_the_code: "Tín Điều"
 cs_storm_chasers_the_code_desc: "Thứ thôi thúc chúng ta hành động không phải là bá quyền, cũng chẳng phải là lợi ích vật chất. Sống là phải phá vỡ giới hạn, chúng ta là những tín đồ luôn theo đuổi giới hạn của chính sự tồn tại."
 cs_storm_chasers_the_code_gestalt: "Tín Điều"
 cs_storm_chasers_the_code_gestalt_desc: "$cs_storm_chasers_the_code_desc$"
 every_empire_opinion_hit: "Cách nhìn nhận của §Y[global_event_country.GetGalCommunityOrGalImperium]§! đối với chúng ta đã thay đổi như sau:"
 nexus_opinion_first_hit: "Lo Âu Nexus"
 nexus_opinion_first_hit_tt: "$every_empire_opinion_hit$§R$@first_hit_opinion_change$§!"
 nexus_opinion_second_hit: "Quan Ngại Nexus"
 nexus_opinion_second_hit_tt: "$every_empire_opinion_hit$§R$@second_hit_opinion_change$§!"
 nexus_opinion_third_hit: "Sợ Hãi Nexus"
 nexus_opinion_third_hit_tt: "$every_empire_opinion_hit$§R$@third_hit_opinion_change$§!"
 nexus_opinion_summon_hit: "Thịnh Nộ Nexus"
 nexus_opinion_summon_hit_tt: "$every_empire_opinion_hit$§R$@nexus_hit_opinion_change$§!"
 nexus_opinion_the_code: "Hòa Giải Nexus"
 cs_stormfrenzy_chain_title: "Bão Cuồng Nhiệt"
 cs_stormfrenzy_chain_desc: "Chúng ta vẫn luôn phá vỡ mọi giới hạn. Được truyền cảm hứng từ những bậc tiền bối, giờ đây chúng ta có cơ hội tạo ra cơn bão trong mơ của mình."
 cstorms.3220.name: "Tín Điều Kẻ Săn Bão"
 cstorms.3220.desc: "Nhân dân của chúng ta luôn theo đuổi sự kích thích bất tận. Mỗi ngày chúng ta đều phát hiện ra những cảnh tượng khó tin, đối mặt với những thử thách lớn hơn, nhưng [ruler.GetRegnalName] cảm thấy rằng chúng ta vẫn có thể tiến xa hơn nữa:\n\n'Lõi của cơn bão không gian chỉ chứa đựng tiềm năng; đó là ranh giới thực sự, sắc bén nhất. Nó sắc bén đến mức có thể cắt đứt mọi thứ hiện tại, giải phóng ra một loại khoái cảm có một không hai trong đời.'\n\nThời điểm để tạo ra một cơn bão mang tầm vóc sử thi đã đến, đây sẽ là một bữa tiệc hỗn loạn tột cùng: Bão Nexus. Bây giờ chỉ còn lại hai chi tiết nhỏ: một là thực hiện các nghiên cứu cuối cùng để chốt lại cách kích hoạt một cơn bão hoàn hảo, hai là xem xét liệu những người khác trong thiên hà có ý kiến gì về việc chúng ta làm chuyện này hay không.\n\nViệc thực hiện điều này chắc chắn sẽ khơi dậy sự phẫn nộ của ai đó."
 PROJECT_SOW_THE_BIG_ONE: "Kích Hoạt Bão Nexus"
 PROJECT_SOW_THE_BIG_ONE_DESC: "Chúng ta sở hữu công nghệ để nuôi dưỡng bão, nhưng lại chẳng có cơn bão sơ sinh nào gần đây. Chúng ta cần nghiên cứu cách gieo hạt để tạo ra một cơn bão có thể nuôi dưỡng."
 cstorms.3222.name: "Gieo Mầm Vật Chất Tối"
 cstorms.3222.desc: "Các đặc tính độc đáo của Vật chất tối khiến nó trở thành mồi lửa hoàn hảo cho Bão Nexus. Chúng ta sẽ bơm thứ vật chất khó nắm bắt này vào cấu trúc không gian bao quanh hệ sao thủ đô, và chờ đợi những gợn sóng đầu tiên của cơn bão xuất hiện.\n\nTuy nhiên, hành động này đã thu hút sự chú ý không mong muốn: các nước láng giềng đang bắt đầu phản đối. 'Không phải ai cũng hứng thú cưỡi gió đạp sóng giống như chúng ta,' một [Root.Owner.GetScientistPlural] phàn nàn."
 cstorms.3222.a: "Đã đến lúc bắt đầu rồi."
 cstorms.3222.b: "Chúng ta cần phải tiết kiệm tài nguyên."
 PROJECT_DARK_SEEDING: "Điểm Thu Hút Kỳ Lạ"
 PROJECT_DARK_SEEDING_DESC: "Bơm cẩn thận Vật chất Tối vào cấu trúc không gian có thể khơi dậy một cơn bão dễ định hình trong hệ sao này."
 cstorms.3224.name: "Sự Chớm Nở Của Bão Nexus"
 cstorms.3224.desc: "Khó có thể tin được! Cơn bão sắp sửa ập đến đã bắt đầu có thể cảm nhận được. Các [Root.Owner.GetScientistPlural] của chúng ta vẫn đang tiếp tục nỗ lực, đưa chúng ta tiến gần hơn một bước đến việc kích hoạt một cơn bão Nexus.\n\nTuy nhiên, các quốc gia láng giềng của chúng ta không mấy hài lòng. Họ cho rằng chúng ta đang đùa giỡn với những sức mạnh không thể kiểm soát nổi, và điều này đã gây ảnh hưởng đến mối quan hệ giữa đôi bên."
 cstorms.3224.a: "Mặc kệ họ đi."
 cstorms.3225.name: "Nuôi Dưỡng Bão Nexus"
 cstorms.3225.desc: "Dữ liệu đã quá rõ ràng: Gieo nhân nào gặt quả nấy đối với cơn bão này. Điều đó có nghĩa là, nếu chúng ta nuôi dưỡng cơn bão bằng đúng loại tài nguyên, nó có thể sở hữu bất kỳ đặc tính nào của bão, và đạt đến quy mô sử thi.\n\nCác cư dân trong thiên hà một lần nữa lại bày tỏ sự lo ngại, nhưng hành trình thế kỷ đã đến rất gần rồi. Đã đến lúc dốc toàn lực quốc gia để nuôi dưỡng cơn bão này!"
 cstorms.3225.a: "Nuôi dưỡng cơn bão!"
 cstorms.3225.b: "Chúng ta cần nhiều tài nguyên hơn."
 cstorms.3226.name: "Bữa Tiệc Tối Thượng"
 cstorms.3226.desc: "Nếu muốn tạo ra một cơn bão mang tầm sử thi, chúng ta phải cung cấp đủ loại dưỡng chất cho cơn bão sơ sinh này. Kỳ tích đáng kinh ngạc này đòi hỏi chúng ta phải có trong tay một tập hợp các tài nguyên cụ thể."
 PROJECT_EVERY_ITEM_ON_THE_MENU: "Món Ăn Bí Mật"
 PROJECT_EVERY_ITEM_ON_THE_MENU_DESC: "Giờ đây chúng ta đã biết cơn bão không gian có thể được thao túng bằng cách cung cấp một chế độ ăn phù hợp. Để nuôi dưỡng cơn bão này, chúng ta cần một số tài nguyên cụ thể."
 PROJECT_EVERY_ITEM_ON_THE_MENU_REPEAT: "Lặp lại: $cstorms.3225.name$"
 PROJECT_EVERY_ITEM_ON_THE_MENU_REPEAT_DESC: "Tạo ra một cơn bão hoàn hảo đòi hỏi một tập hợp các tài nguyên được điều phối tỉ mỉ."
 cstorms.3227.name: "Cú Đẩy Cuối Cùng"
 cstorms.3227.desc: "Sự phấn khích hiện rõ trên mọi khuôn mặt. Con đường phía trước ngày càng rõ ràng: tiến lên, tiến lên, hướng thẳng tới mục tiêu. Hãy cùng hòa mình vào sự cuồng nhiệt của vũ trụ! Mọi thứ đã chuẩn bị sẵn sàng, chỉ cần đẩy thêm một cú cuối cùng, bão Nexus sẽ giáng xuống.\n\nCác nước láng giềng của chúng ta đã giận dữ tột độ, tuyên bố rằng cái gọi là '$nexus_storm$' của chúng ta sẽ mang đến sự hủy diệt khổng lồ cho cả thiên hà. Nhưng liệu chúng ta có thực sự muốn để cho những kẻ phá đám đó hủy hoại một dự án mang tầm vóc sử thi này sao? Đã đến lúc phải đưa ra quyết định."
 cstorms.3227.a: "Bão Nexus là vận mệnh cuối cùng của chúng ta!"
 cstorms.3227.a.tt: "$nexus_storm$ sẽ ập đến sau 40 ngày.\n$nexus_opinion_third_hit_tt$"
 cstorms.3227.b: "Bỏ đi, chúng ta có thể làm được điều tốt hơn!"
 cstorms.3227.b.tt: "$nexus_storm$ đã chấm dứt.\nCách đánh giá của §Y[global_event_country.GetGalCommunityOrGalImperium]§! sẽ được cải thiện trong 40 ngày."
 cstorms.3230.name: "Khởi Sinh Bão Nexus"
 cstorms.3230.desc: "Chúng ta đang đứng trên bờ vực của một trải nghiệm mới. Giờ phút của thảm họa tối thượng đã điểm. Những Kỵ Sĩ Bão của chúng ta chẳng sợ bất cứ điều gì, không có thử thách nào họ từ chối đón nhận. Hãy để cả thiên hà này phải nghe thấy tên của chúng ta!\n\nHãy cho cả thiên hà được mở mang tầm mắt!"
 cstorms.3230.a: "Hành động ngay."
 has_spawned_nexus_storm_tt: "$TRIGGER_FAIL$Đã tạo ra §Y$nexus_storm$§!"
 cstorms.3235.name: "Đoạn Kết Của Bão"
 cstorms.3235.desc: "Chúng ta đã học được rất nhiều điều. Cuối cùng cũng nhận ra thiên hà này không phải là một món đồ chơi, mà là một cuộc phiêu lưu chờ đợi được trải nghiệm.\n\nNhư [ruler.GetRegnalName] đã nói rất đúng: 'Cuộc sống không bao giờ thiếu những sự kích thích. Chúng ta sẽ không bao giờ ngừng theo đuổi những thử thách tiếp theo, nhưng chúng ta cũng phải giữ lòng kính sợ. Sống hòa bình với thiên hà và các cư dân của nó là nguyên tắc của chúng ta. Chúng ta đã chọn làm điều đó, đây mới là ý nghĩa thực sự của chúng ta.'"
 cstorms.3235.a: "Thoải mái đi!"
 cstorms.3235.a.tt: "$every_empire_opinion_hit$§G+$@the_code_total_change$§!"
 # Thử Thách Cơn Sốt Bão
 cs_stormfever_chain_title: "Bão Cuồng Nhiệt"
 cs_stormfever_chain_desc: "Nhằm vươn tới tầm cao mới, trải nghiệm niềm hân hoan và thách thức mọi giới hạn, chúng ta sẽ bắt đầu một loạt các thử thách. Giờ vui vẻ đã đến!"
 challenges_completed: "Hoàn Thành Thử Thách"
 MISSION_CS_STORM_FEVER_CHALLENGE_1: "Đánh Bại Một Hạm Đội Trong Bão"
 MISSION_CS_STORM_FEVER_CHALLENGE_1_DESC: "Những trận chiến khốc liệt luôn là những viên đá thử vàng. Bây giờ, hãy tưởng tượng trải nghiệm một trận chiến ngay tại cốt lõi cuồng bạo của một cơn bão không gian! Hãy cho cả thiên hà thấy được sự hoang dại của chúng ta.\n\nThử thách hiện tại là đánh bại một hạm đội đối phương từ bên trong cơn bão."
 fleets_defeated_in_storm: "Đánh bại hạm đội trong bão"
 MISSION_CS_STORM_FEVER_CHALLENGE_2: "Khám Phá Rìa Thiên Hà"
 MISSION_CS_STORM_FEVER_CHALLENGE_2_DESC: "Vượt qua ranh giới của chúng ta, đi lang thang quanh rìa của những vì sao, khám phá vực sâu xa nhất của không gian — liệu còn điều gì kích thích hơn thế này?\n\nChúng ta cần phải phái một tàu khoa học đi tới một hệ sao được chỉ định — bằng bất cứ giá nào."
 far_edge_explored: "Đã Khám Phá Rìa Xa"
 MISSION_CS_STORM_FEVER_CHALLENGE_3: "Chinh Phục Cơn Bão"
 MISSION_CS_STORM_FEVER_CHALLENGE_3_DESC: "Những bộ óc xuất chúng nhất luôn khao khát được sự kích thích từ bão tố. Hãy để họ bay lượn và tỏa sáng rực rỡ trong tâm bão!\n\nThử thách tiếp theo của chúng ta là hỗ trợ một Kỵ Sĩ Bão trụ lại trong cơn bão không gian hơn 180 ngày."
 days_storm_rider_spend_in_storm: "Số ngày Kỵ sĩ ở trong cơn bão"
 MISSION_CS_STORM_FEVER_CHALLENGE_4: "Khai Quật Điều Tra"
 MISSION_CS_STORM_FEVER_CHALLENGE_4_DESC: "Thiên hà này tràn ngập những kho báu bị chôn vùi và những bí mật cổ xưa — lại còn có một cơn bão tà ác đang càn quét khắp thiên hà! Cùng xuất phát và xem chúng ta có thể tìm thấy gì nào.\n\nHãy thử thách bản thân đi điều tra một hiện tượng dị thường hoặc di chỉ khảo cổ học được hé lộ bởi cơn bão."
 storm_unraveled_event_investigated: "Điều tra hiện tượng dị thường hoặc khai quật di chỉ."
 MISSION_CS_STORM_FEVER_CHALLENGE_5: "Chia Sẻ Niềm Vui"
 MISSION_CS_STORM_FEVER_CHALLENGE_5_DESC: "Tại sao lại phải giữ riêng niềm vui này? Đối với những chuyến phiêu lưu, chia sẻ bao giờ cũng là tốt nhất.\n\nĐể cho các nước láng giềng cũng cảm nhận được sự kích thích, thử thách hiện tại là làm chệch hướng một cơn bão không gian sang lãnh thổ của họ."
 send_storm_to_other_empire: "Gửi bão đến các đế chế khác"
 MISSION_CS_STORM_FEVER_CHALLENGE_6: "Khuất Phục Cơn Bão"
 MISSION_CS_STORM_FEVER_CHALLENGE_6_DESC: "Già đi rồi mờ nhạt dần, đó không phải là phong cách của chúng ta. Cháy rực rỡ một cách huy hoàng tuyệt vời hơn thế nhiều.\n\nThử thách tiếp theo là giúp một Kỵ Sĩ Bão trải qua khoảnh khắc cuối cùng của đời mình bên trong một cơn bão không gian."
 rider_died_in_storm: "Kỵ Sĩ Bão hy sinh hoặc mất tích trong bão"
 # Mở đầu hoàn thành thử thách
 challenge_completed_intro: "Chúng ta đã đạt đến những đỉnh cao mới, kiểm chứng những giới hạn mới! Đây chính là thứ khiến người ta phải sôi sục, chúng ta đã hoàn thành thử thách!"
 # Thử thách 1 hoàn thành
 challenge_completed: "Thử Thách Thành Công:"
 cstorms.305.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_1$"
 cstorms.305.desc: "$challenge_completed_intro$\n\nHạm đội đó thậm chí còn chẳng có cơ hội phản kháng. Còn ai nữa không?"
 cstorms.305.a: "Cảm giác quá đỉnh!"
 # Thử thách 2 hoàn thành
 cstorms.310.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_2$"
 cstorms.310.desc: "$challenge_completed_intro$\n\nThiên hà này có thể mang đến cho chúng ta rất nhiều điều! Sẽ không bao giờ buồn chán, không bao giờ phải dừng lại. Tiếp tục thử thách tiếp theo nào!"
 cstorms.310.a: "Chính là như vậy!"
 # Thử thách 3 hoàn thành
 cstorms.315.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_3$"
 cstorms.315.desc.normal: "$challenge_completed_intro$\n\nBáo cáo do Kỵ Sĩ Bão của chúng ta gửi về chỉ ngập tràn những tiếng reo hò sung sướng. Bão không gian là một sự kích thích ở một đẳng cấp hoàn toàn mới!"
 cstorms.315.desc.gestalt: "$challenge_completed_intro$\n\nChúng ta đang ngập tràn sự vui sướng. Bão không gian mang đến một sự kích thích ở đẳng cấp hoàn toàn mới."
 cstorms.315.a: "Chẳng bao giờ nhàm chán!"
 # Thử thách 4 hoàn thành
 cstorms.320.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_4$"
 cstorms.320.desc: "$challenge_completed_intro$\n\nĐào sâu vào những bí mật cổ xưa, khai quật những kho báu bị chôn vùi luôn mang đến sự phấn khích tột độ. Ai biết được thế giới bên ngoài kia còn có thứ gì đang chờ đợi chúng ta khám phá?"
 cstorms.320.a: "Vô hạn các khả năng!"
 # Thử thách 5 hoàn thành
 cstorms.325.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_5$"
 cstorms.325.desc: "$challenge_completed_intro$\n\nCơn bão này đã đâm thẳng qua không gian của họ, truyền tải mức độ phấn khích và hỗn loạn tương tự! Mang đến cho các nước láng giềng một trải nghiệm khó tin thế này, giờ đây chúng ta có thể yên tâm rồi.\n\nCó thể hiện tại họ chưa cảm kích, nhưng rồi cuối cùng họ sẽ phải cảm ơn chúng ta thôi."
 cstorms.325.a: "Chúng ta là những người ban phát!"
 # Thử thách 6 hoàn thành
 cstorms.330.name: "$challenge_completed$$MISSION_CS_STORM_FEVER_CHALLENGE_6$"
 cstorms.330.desc.normal: "$challenge_completed_intro$\n\nCơn bão hùng vĩ gọi tên anh, và anh cũng hân hoan đáp lại. Gửi lời chào tôn kính đến Kỵ Sĩ Bão, anh hoàn toàn là một huyền thoại! Chúc cho hành trình đi sang thế giới bên kia của anh cũng tráng lệ như chính sự ra đi này."
 cstorms.330.desc.gestalt: "$challenge_completed_intro$\n\nCơn bão hùng vĩ kêu gọi một phần của chúng ta gia nhập vào sự càn quét hân hoan của nó. Chưa bao giờ việc mất đi một nút lại có ý nghĩa và ngập tràn sức sống đến vậy! Trải nghiệm mang tính sử thi này sẽ định hình nên chúng ta trong nhiều năm tới."
 cstorms.330.a: "Cưỡi gió đạp sóng nào!"
 cstorms.331.desc.normal: "$challenge_completed_intro$\n\nCơn bão khổng lồ đã gọi tên anh, và anh cũng hân hoan đáp lại. Gửi lời chào tôn kính đến Kỵ Sĩ Bão, anh đúng là một huyền thoại!"
 cstorms.331.desc.gestalt: "$challenge_completed_intro$\n\nCơn bão khổng lồ đã gọi một phần của chúng ta hòa mình vào cuộc tàn sát hân hoan của nó. Chưa có lần suýt mất một nút nào lại mang đến cảm giác ý nghĩa và tràn đầy sức sống đến vậy! Trải nghiệm mang tính sử thi này sẽ cho chúng ta biết bản thân mình là ai trong tương lai."
 electric_storm_desc: "Sự va chạm của các trường điện từ khiến cơn bão không gian này chứa đầy mức điện tích gần như nguy hiểm. Nó gây hại cho lá chắn, nhưng lại có thể thúc đẩy sản lượng của hành tinh."
 particle_storm_desc: "Những cơn bão loại này trông như những sinh vật sống, di chuyển qua lại bên trong cấu trúc của thiên hà, chúng không săn đuổi cũng chẳng né tránh các phi thuyền không gian. Dù nguy hiểm và không ổn định, nhưng sự tồn tại của chúng lại đủ để kết nối một nền văn minh vượt qua muôn vàn yếu tố."
 gravity_storm_desc: "Mỗi khi xảy ra các vụ va chạm thiên thể quy mô lớn, các tác động sẽ tạo ra những gợn sóng trọng lực lan tỏa khắp thiên hà. Nơi những gợn sóng này va chạm nhau, bão trọng lực sẽ ra đời. Nó gây ảnh hưởng tiêu cực cho hệ thống kiểm soát hỏa lực của các con tàu, và sự dao động của trường trọng lực cũng buộc phần lớn người dân phải đóng cửa không ra ngoài."
 magnetic_storm_desc: "Khi vành đai các tiểu hành tinh kim loại trôi dạt tương tác với lực hấp dẫn cực lớn, từ trường sẽ được hình thành bên trong đó. Loại bão này sẽ xé toạc vỏ tàu, làm gián đoạn việc xây dựng công nghiệp, nhưng chúng cũng có ích trong việc đẩy những khoáng chất có giá trị từ dưới lớp vỏ lên bề mặt."
 solar_storm_desc: "$solar_storm$ sẽ tạo ra một luồng sóng chói lóa trong cấu trúc không gian. Sự tồn tại của nó khiến các ngôi sao tạo ra những ngọn lửa vô tiền khoáng hậu. Dù bức xạ sinh ra từ đó mang tính hủy diệt cực cao, nhưng lại có thể khiến các trạm không gian sản xuất quá tải và làm các con tàu khó lòng tàng hình được."
 celestial_storm_desc: "Mỗi khoảnh khắc trôi qua, bụi từ hàng triệu hành tinh vẫn luôn trôi nổi vô định trong thiên hà. Đôi khi, số lượng các hạt này tích tụ lại với một lượng khổng lồ đến mức hình thành nên những cơn bão cát. Mặc dù những cơn bão cát này sẽ làm gián đoạn liên lạc trên toàn hành tinh, nhưng các chất hóa học mà chúng mang lại lại rất có lợi cho sản lượng tài nguyên. Tuy nhiên, các vật thể ẩn giấu bên trong cơn bão thường rất khó bị phát hiện bởi máy quét của chúng ta."
 shroud_storm_desc: "Trong những trường hợp cực kỳ hiếm hoi, Hư Không sẽ thì thầm với thế giới thực tại. Những cơn bão quý hiếm này sẽ cho mọi người chứng kiến những cảnh tượng kỳ lạ xen lẫn sự cao cả. Những kẻ giao tiếp với Hư Không thậm chí còn có thể tận hưởng được sự cộng hưởng khó đoán này."
 nexus_storm_desc: "Khi một vài ngôi sao nằm trên cùng một đường thẳng, ngay cả một cơn bão không gian nhỏ cũng có thể phát triển vượt ra ngoài giới hạn thông thường. Sự kiện hiếm gặp này sẽ gây ra mối đe dọa đáng sợ tựa như ngày tận thế. Không một ai có thể hưởng lợi từ thứ ghê tởm này; chỉ riêng việc sống sót thôi cũng đã là tạ ơn trời đất rồi."
 FROM_STORM: "Từ Bão Tố"
 # Chỉ số Hành tinh
 hyper_ecosystem: "Hệ Sinh Thái Siêu Cấp"
 hyper_ecosystem_desc: "Vùng đất trên hành tinh này có nồng độ nguyên tố nitơ và phốt pho cực cao, được tái hấp thu từ các khoáng chất hình thành tự nhiên trong lớp vỏ. Điều này làm cho thực vật sinh trưởng với một tốc độ cực kỳ khoa trương, rất hữu ích cho nông nghiệp nhưng lại gây cản trở cho các công trình xây dựng."
 docile_fauna: "Quần Thể Sinh Vật Ôn Hòa"
 docile_fauna_desc: "Sự phát triển của hệ động thực vật hoang dã trên hành tinh này thiếu đi nhiều thiên địch, khiến chúng sinh ra đã cực kỳ hiền lành, nên việc chung sống với chúng rất vui vẻ. Số lượng quần thể ở đây chủ yếu bị giới hạn bởi sức tàn phá của các cơn bão, chứ không phải do sự chọn lọc tự nhiên."
 obsidian_lakes: "Hồ Hắc Diện Thạch"
 obsidian_lakes_desc: "Hoạt động kiến tạo đã khiến các hồ magma nguội đi và biến thành những tảng đá hắc diện khổng lồ, đưa nguồn tài nguyên quý giá đến gần bề mặt hơn."
 obsidian_lakes_volcanic: "$obsidian_lakes$"
 obsidian_lakes_volcanic_desc: "$obsidian_lakes_desc$"
 crimson_crawlers: "Sinh Vật Bò Màu Thẫm"
 crimson_crawlers_tt: "§R$COLONIZATION_IMPOSSIBLE_CRIMSON_CRAWLERS$§!"
 crimson_crawlers_desc: "Bề mặt của hành tinh này là một tấm thảm màu đỏ sẫm được tạo nên từ hàng nghìn tỷ côn trùng nhỏ màu đỏ. Mặc dù có số lượng khổng lồ, nhưng chúng có vẻ vô hại, và đã thành công thiết lập một sự cân bằng mong manh bên trong hệ sinh thái của hành tinh."
 metal_planet: "Hành Tinh Kim Loại"
 metal_planet_desc: "Hành tinh này hoàn toàn bị bao phủ bởi lớp kim loại tự nhiên. Nó thiếu đi những nhu yếu phẩm cơ bản cho cuộc sống, chẳng hạn như nước hay bầu khí quyển có thể thở được, nhưng quả thực nó chứa một lượng tài nguyên khổng lồ có thể sử dụng được!"
 terraform_fail_is_metal_planet: "Hành tinh này có lớp vỏ kim loại, do đó không thể bị cải tạo."
 previously_terraformed_planet: "Hành Tinh Từng Được Cải Tạo"
 previously_terraformed_planet_desc: "Đây là một hành tinh đá có bầu khí quyển nitơ-oxy và sở hữu một lượng lớn đại dương. Có bằng chứng cho thấy, một đế quốc cổ đại nào đó từng đặt chân đến và thuộc địa hóa hành tinh này, nhưng sau đó họ đã biến mất. Điều này đồng nghĩa với việc nơi đây còn ẩn chứa nhiều điều chưa biết và đang chờ được khám phá, đồng thời cũng biến hành tinh này thành một ứng cử viên thuộc địa đã được chuẩn bị sẵn từ trước!"
 previously_terraformed_planet_tt: "Những nỗ lực cải tạo môi trường trước đây khiến hành tinh này dễ dàng được cải tạo thành Hành Tinh Gaia hơn."
 has_patriotic_institute: "$building_adakkaria_patriotic_institute$"
 has_patriotic_institut_desc: "Hành tinh này từng là căn cứ của Hiệp ước adAkkaria. Ngôi $building_adakkaria_patriotic_institute$ này chính là tàn tích duy nhất của một đế quốc từng hùng mạnh một thời."
 has_patriotic_institute_tt: "Sở hữu công trình: $building_adakkaria_patriotic_institute$. Hãy định cư hành tinh này để giành quyền kiểm soát."
 adakkaria_patriotic_institute_desc.supercharged: "Tỷ lệ kích hoạt một cơn bão trong hệ sao với cái giá là §Y100§!£pop£§H Dân số§! mỗi năm."
 # Chỉ số Cụ thể Hành tinh
 crimson_crawlers_sashimi_style: "Sinh Vật Bò Màu Thẫm: Ăn Trực Tiếp"
 crimson_crawlers_sashimi_style_desc: "Bề mặt hành tinh này mang một màu đỏ sẫm được hình thành từ hàng nghìn tỷ côn trùng nhỏ bé màu đỏ. Ngay cả khi ăn sống trực tiếp, chúng vẫn là một loại thực phẩm ngon tuyệt."
 crimson_crawlers_bbq_them: "Sinh Vật Bò Màu Thẫm: Nấu Chín Mới Ăn"
 crimson_crawlers_bbq_them_desc: "Bề mặt hành tinh này mang một màu đỏ sẫm được hình thành từ hàng nghìn tỷ côn trùng nhỏ bé màu đỏ. Chúng là một loại đồ nướng rất được mọi người ưa thích."
 COLONIZATION_IMPOSSIBLE_CRIMSON_CRAWLERS: "§RĐế chế Người Máy hoặc Đế chế Kẻ Ăn Đá không thể định cư trên hành tinh này.§!"
 # Các loại Hành tinh mới
 collided_planet: "Hành Tinh Bị Va Chạm"
 collided_planet_desc: "Hai hành tinh đã va chạm vào nhau, chúng không tiêu diệt nhau mà lại đan xen vào nhau. Dù diện tích sử dụng được tăng lên, nhưng hành tinh này cũng mang đến những thách thức xây dựng và cư trú đầy đặc thù."
 wooden_planet: "Hành Tinh Thực Vật"
 wooden_planet_desc: "Trải qua hàng nghìn năm, lớp vỏ của hành tinh này đã trở thành một tầng rễ cây dày đặc, sâu đến vài km, biến nó thành một cơ thể sống khổng lồ."
 wooden_planet_tt: "Xây dựng và bảo trì nhà ở cần tiêu hao $w_food$.\nXây dựng nông trại cần tiêu hao $w_food$."
 # Sự kiện Phun trào
 recent_eruption: "Mới Phun Trào Gần Đây"
 eruption_report_tooltip: "\nBáo cáo sẽ đến sau 30 ngày."
 colony_mod.31.name: "Núi Lửa Phun Trào!"
 colony_mod.31.desc: "Sự thay đổi kiến tạo trên [Root.GetName] đã làm vỡ lớp đá hắc diện mỏng trên một mảng kiến tạo khổng lồ. Dung nham trào ra và tràn ngập bề mặt, gây ra hậu quả tàn khốc. Các báo cáo gửi về từ thuộc địa thật đáng sợ."
 colony_mod.31.a: "Hãy cùng nghe xem."
 colony_mod.32.name: "Báo Cáo Thiệt Hại Phun Trào"
 colony_mod.32.desc: "Đợt bùng phát vụn đá hắc diện gần đây làm rung chuyển thuộc địa của chúng ta trên [Root.GetName] đã phát triển thành một ngọn núi lửa đang hoạt động! Mọi thứ xung quanh đã bị chôn vùi dưới dòng dung nham."
 colony_mod.33.desc: "Đợt bùng phát vụn đá hắc diện gần đây làm rung chuyển thuộc địa của chúng ta trên [Root.GetName] đã không gây ra bất kỳ tổn thất nào một cách đầy kỳ diệu. May mắn hơn nữa, nó đã phá vỡ một lượng lớn hắc diện thạch, tạo điều kiện thuận lợi cho chúng ta thu thập."
 colony_mod.34.desc: "Đợt bùng phát vụn đá hắc diện gần đây làm rung chuyển thuộc địa của chúng ta trên [Root.GetName] đã không gây ra bất kỳ tổn thất nào một cách đầy kỳ diệu."
 # Chỉ số dư âm bão
 STORM_AFTERMATH: "§HDư Âm§!"
 STORM_AFTERMATH_DESC: " —Tùy thuộc vào cường độ của bão, các thuộc địa sẽ liên tục bị áp dụng các chỉ số sau đây trong vòng 3 năm:"
 electric_storm_aftermath_modifier: "Khí Quyển Tích Điện"
 electric_storm_aftermath_modifier_tooltip: "$STORM_AFTERMATH_DESC$\n$t$—§H$electric_storm_aftermath_modifier$§!:\n$tt$—§R-25%§!~§R-65%§!$MOD_PLANET_BUILDING_BUILD_SPEED_MULT$\n$tt$—§G+10%§!~§G+30%§!$mod_planet_jobs_energy_produces_mult$"
 electric_storm_aftermath_modifier_severity_desc: "$electric_storm$ đã để lại một nguồn điện đang cuộn trào trong bầu khí quyển, điều này sẽ khiến cho sản lượng cơ khí trở nên bất ổn định. Tuy nhiên, sản lượng năng lượng đã tăng vọt lên mức tối đa rồi!"
 electric_storm_aftermath_modifier_severity_1: "Dư Âm: $electric_storm_aftermath_modifier$"
 electric_storm_aftermath_modifier_severity_1_desc: "$electric_storm_aftermath_modifier_severity_desc$"
 electric_storm_aftermath_modifier_severity_2: "Dư Âm: §HNghiêm Trọng§! $electric_storm_aftermath_modifier$"
 electric_storm_aftermath_modifier_severity_2_desc: "$electric_storm_aftermath_modifier_severity_desc$"
 electric_storm_aftermath_modifier_severity_3: "Dư Âm: §RCực Đoan§! $electric_storm_aftermath_modifier$"
 electric_storm_aftermath_modifier_severity_3_desc: "$electric_storm_aftermath_modifier_severity_desc$"
 particle_storm_aftermath_modifier: "Gió Ăn Mòn"
 particle_storm_aftermath_modifier_tooltip: "$STORM_AFTERMATH_DESC$\n$t$—§H$particle_storm_aftermath_modifier$§!:\n$tt$—§R-40%§!~§R-60%§!$MOD_PLANET_POP_ASSEMBLY_MULT$\n$tt$—§R-10%§!~§R-30%§!$mod_planet_jobs_minerals_produces_mult$\n$tt$——§G+0.02§!~§G+0.06§!$r_volatile_motes$ do dân số sản xuất"
 particle_storm_aftermath_modifier_severity_desc: "$particle_storm$ có thể nghiền nát mọi thứ thành bột mịn, cho dù là kim loại hay sinh mệnh hữu cơ, điều này gây ra thiệt hại nghiêm trọng và ảnh hưởng đến sản lượng lương thực. Tuy nhiên, phần tàn dư lại chứa những vật chất vô cùng giá trị."
 particle_storm_aftermath_modifier_severity_1: "Dư Âm: $particle_storm_aftermath_modifier$"
 particle_storm_aftermath_modifier_severity_1_desc: "$particle_storm_aftermath_modifier_severity_desc$"
 particle_storm_aftermath_modifier_severity_2: "Dư Âm: §HNghiêm Trọng§! $particle_storm_aftermath_modifier$"
 particle_storm_aftermath_modifier_severity_2_desc: "$particle_storm_aftermath_modifier_severity_desc$"
 particle_storm_aftermath_modifier_severity_3: "Dư Âm: §RNghiêm Trọng§! $particle_storm_aftermath_modifier$"
 particle_storm_aftermath_modifier_severity_3_desc: "$particle_storm_aftermath_modifier_severity_desc$"
 gravity_storm_aftermath_modifier: "Biến Động Trọng Lực"
 gravity_storm_aftermath_modifier_tooltip: "$STORM_AFTERMATH_DESC$\n$t$—§H$gravity_storm_aftermath_modifier$§!:\n$tt$—§R+25%§!~§R+100%§!$mod_planet_structures_cost_mult$\n$tt$——§G+20%§!~§G+60%§!$mod_planet_bureaucrats_unity_produces_mult$"
 gravity_storm_aftermath_modifier_severity_desc: "$gravity_storm$ gây ra sự biến động của mức trọng lực, khiến cho các công trình xây dựng trở nên khó khăn, nhưng chúng quả thực đã cung cấp những hiểu biết khoa học độc đáo cho việc nghiên cứu trọng lực."
 gravity_storm_aftermath_modifier_severity_1: "Dư Âm: $gravity_storm_aftermath_modifier$"
 gravity_storm_aftermath_modifier_severity_1_desc: "$gravity_storm_aftermath_modifier_severity_desc$"
 gravity_storm_aftermath_modifier_severity_2: "Dư Âm: §HNghiêm Trọng§! $gravity_storm_aftermath_modifier$"
 gravity_storm_aftermath_modifier_severity_2_desc: "$gravity_storm_aftermath_modifier_severity_desc$"
 gravity_storm_aftermath_modifier_severity_3: "Dư Âm: §RCực Đoan§! $gravity_storm_aftermath_modifier$"
 gravity_storm_aftermath_modifier_severity_3_desc: "$gravity_storm_aftermath_modifier_severity_desc$"
 magnetic_storm_aftermath_modifier: "Nhiễu Loạn Từ Cực"
 magnetic_storm_aftermath_modifier_tooltip: "$STORM_AFTERMATH_DESC$\n$t$—§H$magnetic_storm_aftermath_modifier$§!:\n$tt$—§G-10%§!~§G-30%§!$mod_planet_metallurgists_upkeep_mult$\n$tt$—§R-5%§!~§R-20%§!$MOD_PLANET_BUILDING_BUILD_SPEED_MULT$"
 magnetic_storm_aftermath_modifier_severity_desc: "$magnetic_storm$ để lại những biến động từ trường, gây ra nhiều hiện tượng quang học trong khí quyển. Dù cho cảnh quan có đẹp lung linh đến mức nào thì đây vẫn là một thảm họa đối với các thiết bị điều hướng."
 magnetic_storm_aftermath_modifier_severity_1: "Dư Âm: $magnetic_storm_aftermath_modifier$"
 magnetic_storm_aftermath_modifier_severity_1_desc: "$magnetic_storm_aftermath_modifier_severity_desc$"
 magnetic_storm_aftermath_modifier_severity_2: "Dư Âm: §HNghiêm Trọng§! $magnetic_storm_aftermath_modifier$"
 magnetic_storm_aftermath_modifier_severity_2_desc: "$magnetic_storm_aftermath_modifier_severity_desc$"
 magnetic_storm_aftermath_modifier_severity_3: "Dư Âm: §RCực Đoan§! $magnetic_storm_aftermath_modifier$"
 magnetic_storm_aftermath_modifier_severity_3_desc: "$magnetic_storm_aftermath_modifier_severity_desc$"
 solar_storm_aftermath_modifier: "Lệnh Giới Nghiêm Bức Xạ"
 solar_storm_aftermath_modifier_tooltip: "$STORM_AFTERMATH_DESC$\n$t$—§H$solar_storm_aftermath_modifier$§!:\n$tt$—§R-40%§!~§R-60%§!$MOD_LOGISTIC_GROWTH_MULT$\n$tt$—§R+10%§!~§R+30%§!$MOD_POP_AMENITIES_USAGE_MULT$\n$tt$—§G+20%§!~§G+40%§!$MOD_ARMY_DEFENSE_DAMAGE_MULT$"
 solar_storm_aftermath_modifier_severity_desc: "$solar_storm$ đã tạo ra mức độ bức xạ rất cao, buộc chúng ta phải tiến hành phong tỏa với thời hạn gần như vô thời hạn. Do không gian sống của mọi người bị thu hẹp lại, nên tỷ lệ tội phạm lại giảm đáng kể."
 solar_storm_aftermath_modifier_severity_1: "Dư Âm: $solar_storm_aftermath_modifier$"
 solar_storm_aftermath_modifier_severity_1_desc: "$solar_storm_aftermath_modifier_severity_desc$"
 solar_storm_aftermath_modifier_severity_2: "Dư Âm: §HNghiêm Trọng§! $solar_storm_aftermath_modifier$"
