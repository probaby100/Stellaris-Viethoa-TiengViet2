 STORM_PREFIX_2: "Bão Táp $NAME$"
 STORM_PREFIX_3: "Cơn Bão $NAME$"
 STORM_PREFIX_4: "Siêu Cuồng Phong $NAME$"
 STORM_PREFIX_5: "Gió Lốc $NAME$"
 STORM_PREFIX_6: "Gió Mùa $NAME$"
 STORM_PREFIX_7: "Cuồng Phong $NAME$"
