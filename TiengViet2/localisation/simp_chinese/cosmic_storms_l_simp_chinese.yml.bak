 mod_job_astrometeorologist_hive_per_pop: "Cứ $VALUE$ dân cung cấp §G+1§! việc làm $job_astrometeorologist_hive$"
 mod_job_astrometeorologist_hive_per_pop_short: "\nCứ $VALUE$£pop£§G+1§!£mod_job_astrometeorologist_hive_add£"
 mod_job_astrometeorologist_machine_add: "Việc làm $job_astrometeorologist_machine$"
 mod_job_astrometeorologist_machine_per_pop: "Cứ $VALUE$ dân cung cấp §G+1§! việc làm $job_astrometeorologist_machine$"
 mod_job_astrometeorologist_machine_per_pop_short: "\nCứ $VALUE$£pop£§G+1§!£mod_job_astrometeorologist_machine_add£"
 mod_job_storm_dancer_add: "Việc làm $job_storm_dancer$"
 mod_job_storm_dancer_per_pop: "Cứ $VALUE$ dân cung cấp §G+1§! việc làm $job_storm_dancer$"
 mod_job_storm_dancer_per_pop_short: "\nCứ $VALUE$£pop£§G+1§!£mod_job_storm_dancer_add£"
 mod_psionic_pop_bonus_workforce_mult: "$BONUS_WORKFORCE_FOR$ từ dân ngoại cảm"
 mod_planet_astrometeorologists_produces_mult: "Sản lượng của £job_astrometeorologist£[GetAstrometeorologistPlural]"
 mod_planet_buildings_storm_tech_upkeep_mult: "Phí bảo trì công trình bão"
 NAME_adakkaria: "Adakkaria"
 patriotic_institute_true_potential_unleashed: "Tiềm năng thực sự của Adakkaria"
 patriotic_institute_true_potential_unleashed_desc: "Sự thật đằng sau Adakkaria đã mang lại cho chúng ta sự thanh tẩy tâm hồn."
 storm_hunkered_down_modifier: "Che chắn kỹ càng"
 storm_hunkered_down_modifier_tt: "Cả §Rphí bảo trì§! và §Gsản lượng§! của §Y$building_storm_resistant_production$§! và §Y$building_advanced_storm_resistant_production$§! đều tăng gấp đôi"
 storm_hunkered_down_modifier_disabled_tt: "Kết thúc quyết định $decision_hunker_down$, §Gphí bảo trì§! của §Y$building_storm_resistant_production$§! và §Y$building_advanced_storm_resistant_production$§! giảm một nửa, nhưng §Rsản lượng§! cũng sẽ trở về mức bình thường."
 cultivated_worldscaping_modifier: "$decision_cultivated_worldscaping$"
 cultivated_worldscaping_modifier_desc: "Để tạo ra vẻ đẹp hình khối trang nhã, địa hình ở đây được nhào nặn tỉ mỉ, còn nhu cầu sinh hoạt thì xếp sau. Cây cối trong vườn được chọn lọc, chỉ trồng một loại duy nhất để loại bỏ mọi thứ có thể phá hỏng sự hài hòa chung."
 cultivated_worldscaping_modifier_tt: "- Số khu vực tối đa §Y+3§!\n- Số khu vực tài nguyên tối đa: §G+75%§!\n- Mức bảo vệ khỏi §Y$default_storm$§! §G+10%§!\n- Độ sống được §R-20%§!"
 # Quyết định hành tinh
 decision_hunker_down: "Sẵn sàng Nghênh đón"
 decision_hunker_down_desc: "Cư dân trên hành tinh này lo sợ điều tồi tệ nhất sẽ xảy ra, vì vậy họ đã áp dụng mọi biện pháp để phòng ngừa thiệt hại do bão vũ trụ mang lại."
 decision_stop_hunker_down: "Kết thúc $decision_hunker_down$"
 decision_stop_hunker_down_desc: "Vì cơn bão vũ trụ đã qua đi, chúng ta không cần phải nơm nớp lo sợ nữa. Nhưng liệu mọi thứ có thực sự trở lại 'bình thường' không?"
 decision_cultivated_worldscaping: "Kiến tạo Thế giới"
 decision_cultivated_worldscaping_desc: "Hãy kiến tạo hành tinh này thành một tuyệt tác đối xứng hoàn hảo. Cảnh quan hình học thuần túy như vậy sẽ mang lại sự tĩnh lặng cho tâm hồn."
 decision_cultivated_worldscaping_natural_blockers_fail_tt: "§RPhải dọn dẹp tất cả các chướng ngại vật tự nhiên £blocker£ trước tiên§!"
 # Civics
 civic_astrometeorology: "Nghiên cứu Khí tượng Vũ trụ"
 civic_astrometeorology_desc: "Mang trong mình sự tôn kính đối với sức mạnh của tự nhiên, chủng tộc này không ngừng nghiên cứu cơ chế hoạt động nội tại của khí hậu tự nhiên. Sau khi bước chân ra những vì sao, họ đã thể hiện sự hứng thú tột độ với khí tượng vũ trụ. Cốt lõi tham vọng của họ chính là khám phá bão vũ trụ, một hiện tượng vừa quyến rũ vừa có sức tàn phá khủng khiếp.\n"
 civic_astrometeorology_effect_tooltip: "$t$-$AVAILABLE_BUILDINGS$£building£['building:building_astrometeorology_observation_center']$TABBED_NEW_LINE$-$ADDITIONAL_BUILDINGS_STRING$£building£§Y$building_astrometeorology_observation_center$§!"
 civic_astrometeorology_hive: "Mô hình Khí hậu"
 civic_astrometeorology_hive_desc: "Khi giống loài này bước chân ra các vì sao, ý thức tập hợp của họ đã bị cuốn hút bởi các hiện tượng khí tượng không gian. Bầy đàn mở rộng lãnh thổ vì một mục tiêu cao cả: nghiên cứu tác động của bão vũ trụ lên môi trường xung quanh, và khám phá những kỳ quan đó. Vì mục đích này, họ không ngần ngại đích thân bước vào bão tố."
 civic_astrometeorology_hive_effect_tooltip: "$civic_astrometeorology_effect_tooltip$"
 civic_astrometeorology_machine: "Mô hình Khí hậu"
 civic_astrometeorology_machine_desc: "Sự thấu hiểu về các thế lực tự nhiên đã ảnh hưởng sâu sắc đến đế chế máy móc này, ý thức tập hợp của đế chế cống hiến hết mình cho việc nghiên cứu các hiện tượng tự nhiên, cần mẫn ghi chép lại mọi hiện tượng khí tượng không gian độc đáo với một thái độ thiêng liêng và trang trọng. Trọng tâm nghiên cứu của họ là bão vũ trụ, hiện tượng kỳ lạ và mang sức tàn phá lớn nhất."
 civic_astrometeorology_machine_effect_tooltip: "$civic_astrometeorology_effect_tooltip$"
 civic_astrometeorology_megacorp: "Khai thác Khí tượng"
 civic_astrometeorology_megacorp_desc: "Hiệu ứng môi trường không phải là nguồn tài nguyên miễn phí để khai thác thì còn có thể là gì nữa? Tập đoàn khổng lồ này chuyên thu thập tối đa kiến thức từ các hiện tượng khí tượng không gian và bán chúng cho người trả giá cao nhất."
 civic_astrometeorology_megacorp_effect_tooltip: "$civic_astrometeorology_effect_tooltip$$TABBED_NEW_LINE$-£building£§Y$building_private_research_initiative$§!$megacorp_civic_branch_office_building_effect$"
 civic_storm_callers: "Cuồng tín Bão tố"
 civic_storm_callers_desc: "Từ thuở sơ khai, xã hội này đã biết sử dụng các nghi thức để gọi bão. Năm tháng trôi qua, họ không ngừng áp dụng các đổi mới công nghệ để nâng cao tính hiệu quả của nghi thức. Và khi thời đại không gian đến, họ có thể áp dụng kiến thức này giữa các vì sao."
 civic_storm_callers_effect_tooltip: "-$AVAILABLE_BUILDINGS$£building£['building:building_storm_summoning_theater']\n-Thay thế vị trí [entertainer.GetIcon]§H[entertainer.GetName]§! bằng vị trí £job_storm_dancer£§H$job_storm_dancer$§!\n-$SPECIES_TRAITS$['trait:trait_storm_touched']"
 civic_storm_callers_megacorp: "Nghệ sĩ Bão tố"
 civic_storm_callers_megacorp_desc: "Tập đoàn truyền thông khổng lồ này khởi đầu chỉ là một tổ chức chuyên phát sóng đơn giản các nghi thức thiêng liêng, sau đó vị trí của các nhà tiên tri và tu sĩ đã được thay thế bởi những nghệ sĩ biểu diễn đầy sức hút, họ đều đang cạnh tranh khốc liệt trên đường đua thu hút bão vũ trụ."
 civic_storm_callers_megacorp_effect_tooltip: "$civic_storm_callers_effect_tooltip$\n-Công trình doanh nghiệp £building£§Y$building_amusement_megaplex$§! tạo thêm §YGiá trị Chi nhánh§! và bổ sung §G+50§! vị trí £job_merchant£§YThương gia§! cho thủ đô của chúng ta."
 mod_capital_storm_diplo_weight_mult: "$MOD_DIPLO_WEIGHT_MULT$ khi thủ đô bị §YBão Vũ trụ§! ảnh hưởng"
 storm_devotion_diplo_weight_modifier: "$civic_storm_callers$"
 storm_devotion_corporate_diplo_weight_modifier: "$civic_storm_callers_megacorp$"
 civic_environmental_architects: "Kiến trúc sư Môi trường"
 civic_environmental_architects_desc: "Sau hàng triệu năm dày công nuôi dưỡng sự cân bằng hoàn hảo trên thế giới quê hương của mình, xã hội này đã sẵn sàng đối mặt với những môi trường khắc nghiệt nhất trong vũ trụ. Người dân tin tưởng mãnh liệt rằng thế giới tự nhiên có thể được định hình, kiểm soát và hoàn thiện. Đây không phải là việc thuần hóa môi trường, mà là để theo đuổi sự hoàn hảo."
 civic_environmental_architects_negative_effect_tooltip: "-$HOMEWORLD$ khởi đầu với hai £blocker£§HChướng ngại vật Tự nhiên§!"
 civic_environmental_architects_effect_start: "-$ADDITIONAL_TECHNOLOGIES_STRING$§HCông nghệ§! £society£ để dọn dẹp £blocker£['concept_natural_blockers'] trên §HThế giới Quê hương§!\n-§HCông nghệ§! £society£ dọn dẹp £blocker£§HChướng ngại vật Tự nhiên§! sẽ xuất hiện dưới dạng §HTùy chọn nghiên cứu vĩnh viễn§! khi thiết lập thuộc địa.\n-§HKiểm soát Tự nhiên§!['concept_ascension_perk'] được thay thế bằng Quyết định Hành tinh §H$decision_cultivated_worldscaping$§!['concept_decision']\n-Mỗi £blocker£§HChướng ngại vật Tự nhiên§! trên các £planet£['concept_planets'] đã thuộc địa hóa:"
 civic_environmental_architects_effect_tooltip: "$civic_environmental_architects_effect_start$\n$t$-Sản lượng tài nguyên từ công việc: §R-10%§!\n$t$-Tốc độ tăng trưởng Dân số: §R-10%§!\n$t$-Phí bảo trì Dân số: §R+15%§!"
 civic_environmental_architects_hive: "Bầy đàn Kiến tạo"
 civic_environmental_architects_hive_desc: "Là một phần của môi trường sinh học vĩ đại, những bầy đàn này có thể nhận diện các cơ hội tiềm ẩn trong tự nhiên. Để đạt được mục tiêu chung, họ cố gắng kiểm soát và tái định hình các hệ sinh thái."
 civic_environmental_architects_hive_effect_tooltip: "$civic_environmental_architects_effect_start$\n$t$-Sản lượng tài nguyên từ công việc: §R-10%§!\n$t$-Tốc độ lắp ráp Dân số: §R-10%§!\n$t$-Phí bảo trì Dân số: §R+15%§!"
 civic_environmental_architects_machine: "Giao thức Chăm sóc"
 civic_environmental_architects_machine_desc: "Sau khi những người đi trước hữu cơ qua đời, các tạo tác máy móc của họ vẫn duy trì khuynh hướng thiên về thẩm mỹ. Thế giới tự nhiên chính là mảnh đất màu mỡ để hiện thực hóa chủ nghĩa hoàn hảo đã được lập trình của họ."
 civic_environmental_architects_machine_effect_tooltip: "$civic_environmental_architects_hive_effect_tooltip$"
 civic_environmental_architects_megacorp: "Công ty Địa kỹ thuật"
 civic_environmental_architects_megacorp_desc: "Nhân viên của tập đoàn khổng lồ này đã quen sống trong những chiếc lồng son. Vì vậy, bất kể họ đi đến đâu, nơi đó đều phải biến thành một chiếc lồng son."
 civic_environmental_architects_megacorp_effect_tooltip: "$civic_environmental_architects_effect_tooltip$\n-£building£§Y$building_executive_retreat$§!$megacorp_civic_branch_office_building_effect$"
 # Edicts
 edict_auto_hunker_down: "Giao thức Phòng vệ Dày đặc"
 edict_auto_hunker_down_desc: "Tất cả các hành tinh bị §Y$default_storm$§! ảnh hưởng đều có thể kích hoạt Quyết định Hành tinh §Y$decision_hunker_down$§! trước khi mối nguy hiểm qua đi."
 edict_auto_hunker_down_tt: "Có tự động kích hoạt Quyết định Hành tinh §Y$decision_hunker_down$§! khi §Y$default_storm$§! ập đến hay không.\n\n$storm_hunkered_down_modifier_tt$"
 edict_storm_repel_field: "Trường Xua đuổi Bão"
 edict_storm_repel_field_desc: "Tăng hiệu suất hoạt động của công nghệ xua đuổi bão."
 edict_storm_attraction_field: "Trường Thu hút Bão"
 edict_storm_attraction_field_desc: "Tăng hiệu suất hoạt động của công nghệ thu hút bão."
 # Councilors
 councilor_astrometeorology: "Chuyên gia Dự báo Trưởng"
 councilor_astrometeorology_female: "$councilor_astrometeorology$"
 councilor_astrometeorology_desc: "$TITLE$ chịu trách nhiệm dự báo mọi biến đổi thời tiết không gian."
 councilor_astrometeorology_megacorp: "Giám đốc Dự báo"
 councilor_astrometeorology_megacorp_female: "$councilor_astrometeorology_megacorp$"
 councilor_astrometeorology_megacorp_desc: "Trách nhiệm của $TITLE$ là khám phá những hiệu ứng môi trường mang lại lợi ích cao nhất."
 councilor_storm_callers: "Đại Quan Quản lý Bão"
 councilor_storm_callers_female: "$councilor_storm_callers$"
 councilor_storm_callers_desc: "$TITLE$ là đại diện cho phần quan trọng và phức tạp nhất trong tinh thần cống hiến của chúng ta."
 councilor_storm_callers_megacorp: "Người Dẫn chương trình Bão tố"
 councilor_storm_callers_megacorp_female: "$councilor_storm_callers_megacorp$"
 councilor_storm_callers_megacorp_desc: "Một buổi diễn vĩ đại nhất cần một người dẫn chương trình xuất chúng nhất."
 councilor_storm_callers_modifier_tooltip: "-Cơ hội nhận được Tùy chọn Nghiên cứu §YCông nghệ Bão Vũ trụ§!: §G+5%§!\n-Phí bảo trì công trình liên quan đến §Y$default_storm$§!: §G-5%§!"
 councilor_environmental_architects: "Kiến trúc sư Hành tinh Trưởng"
 councilor_environmental_architects_female: "$councilor_environmental_architects$"
 councilor_environmental_architects_desc: "$TITLE$ tận dụng vật liệu tự nhiên trên các thuộc địa để nhào nặn chúng thành những ngôi nhà mới."
 councilor_environmental_architects_megacorp: "Giám đốc Cảnh quan"
 councilor_environmental_architects_megacorp_female: "$councilor_environmental_architects_megacorp$"
 councilor_environmental_architects_megacorp_desc: "$TITLE$ chịu trách nhiệm cải thiện môi trường sống cho tất cả nhân viên."
 councilor_environmental_architects_modifier_tooltip: "Chi phí dọn dẹp chướng ngại vật: §G-2%§!\n$mod_planet_jobs_worker_produces_mult$: §G+1%§!"
 # Economic categories
 planet_astrometeorologists: "$job_astrometeorologist_plural$"
 planet_storm_dancers: "$job_storm_dancer_plural$"
 planet_buildings_storm_tech: "Công trình Bão Vũ trụ"
 # Traits
 trait_storm_touched: "Chạm Khắc Bởi Bão"
 trait_storm_touched_desc: "Đắm mình trong bão vũ trụ, lấp đầy tâm hồn mộ đạo của $trait_storm_touched$."
 trait_storm_touched_modifier_tooltip: "Khi ở trong §Y$default_storm$§!:$TABBED_NEW_LINE$$MOD_POP_BONUS_WORKFORCE_MULT$: §G+10%§!$TABBED_NEW_LINE$Tiêu thụ Tiện nghi: §G-10%§!"
 trait_storm_fused: "Dung Hợp Bão Tố"
 trait_storm_fused_desc: "Những người dung hợp bão tố đã học được cách xây dựng những cơn bão nhỏ trong lòng trong hành trình nỗ lực đạt được giác ngộ."
 trait_storm_fused_modifier_tooltip: "Khi ở trong §Y$default_storm$§!:\n$MOD_POP_BONUS_WORKFORCE_MULT$: §G+10%§!\n$MOD_POP_HAPPINESS$: §G+5%§!"
