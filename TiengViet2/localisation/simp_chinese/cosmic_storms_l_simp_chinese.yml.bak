 ### Galactic Community Resolutions ###
 ######################################
 # Common strings
 storm_tech: "§YCông nghệ Bão Vũ trụ§!"
 storm_tech_plural: "§YCông nghệ Bão Vũ trụ§!"
 storm_tech_cost: "Chi phí $storm_tech$:"
 storm_tech_draw_chance: "Cơ hội rút được Tùy chọn Nghiên cứu $storm_tech$:"
 storm_tech_draw_guaranteed: "§GĐảm bảo xuất hiện§! $storm_tech_draw_chance$"
 unity_from_storms: "$r_unity$ tạo ra từ mỗi hệ sao bị ảnh hưởng bởi §Y$default_storm$§!:"
 unity_from_storms_nomadic: "Lượng $r_unity$ tạo ra từ mỗi §YTàu Ark§! hoặc §YTrạm dừng§! trong bão:"
 output_from_storm_protection_buildings: "Sản lượng của [farmer.GetIcon][GetFarmerPlural], [miner.GetIcon][GetMinerPlural] và [technician.GetIcon][GetTechnician] đến từ §YCông trình Chống Bão Vũ trụ§!:"
 breach_galactic_law: "§RVi phạm Luật Thiên hà§!"
 breach_galactic_law_intro: "Áp dụng các điều khoản sau đây sẽ $breach_galactic_law$:"
 emergency_fund_contribution: "Đóng góp §YQuỹ Khẩn cấp§! hàng tháng tăng lên:"
 resolution_category_space_weather_exploitation_stances: "Khai thác Khí hậu Vũ trụ"
 resolution_space_weather_exploitation_repeal_desc: "Việc xử lý bão vũ trụ ra sao phải là trách nhiệm của mỗi quốc gia, chứ không nên do Cộng đồng Thiên hà gánh vác."
 resolution_cosmic_storms_shared_knowledge: "Chia sẻ Kiến thức Bão"
 resolution_cosmic_storms_shared_knowledge_desc: "Bão vũ trụ có tầm ảnh hưởng rất rộng; do đó, mọi kiến thức về hành vi của chúng nên được chia sẻ bình đẳng."
 resolution_cosmic_storms_shared_knowledge_tooltip: "$storm_tech_cost$ §G-25%§!\n\n$storm_tech_draw_chance$ §G+20%§!\n\n$unity_from_storms$ §G+1§!"
 resolution_cosmic_storms_shared_knowledge_nomad_tooltip: "$unity_from_storms_nomadic$§G+1§!"
 resolution_cosmic_storms_shared_knowledge_repeal: "Bãi bỏ $resolution_cosmic_storms_shared_knowledge$"
 resolution_cosmic_storms_shared_knowledge_repeal_desc: "$resolution_space_weather_exploitation_repeal_desc$"
 resolution_cosmic_storms_shared_knowledge_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_shared_knowledge$§!."
 resolution_cosmic_storms_protection_initiative: "Sáng kiến Khảo sát Bão"
 resolution_cosmic_storms_protection_initiative_desc: "Đã đến lúc chủ động xuất kích. Khuyến khích đổi mới sẽ cho phép ta tận dụng tốt hơn giá trị kinh tế của các cơn bão vũ trụ."
 resolution_cosmic_storms_protection_initiative_tooltip: "$output_from_storm_protection_buildings$ §G+10%§!\n\n$unity_from_storms$ §G+1§!\n\n$storm_tech_draw_chance$ §G+50%§!"
 resolution_cosmic_storms_protection_initiative_nomad_tooltip: "$unity_from_storms_nomadic$§G+1§!"
 resolution_cosmic_storms_protection_initiative_repeal: "Bãi bỏ $resolution_cosmic_storms_protection_initiative$"
 resolution_cosmic_storms_protection_initiative_repeal_desc: "$resolution_space_weather_exploitation_repeal_desc$"
 resolution_cosmic_storms_protection_initiative_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_protection_initiative$§!, đưa §Y$resolution_cosmic_storms_shared_knowledge$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_galactic_management: "Quản lý Bão Thiên hà"
 resolution_cosmic_storms_galactic_management_desc: "Việc phòng chống bão vũ trụ thúc đẩy ta cải thiện hiệu suất, nhưng vẫn còn nhiều điều đang chờ được khám phá."
 resolution_cosmic_storms_galactic_management_tooltip: "$output_from_storm_protection_buildings$ §G+20%§! \n\n$storm_tech_cost$ §G-50%§! \n\n$storm_tech_draw_chance$ §G+75%§!\n\n$unity_from_storms$ §G+2§!"
 resolution_cosmic_storms_galactic_management_nomad_tooltip: "$unity_from_storms_nomadic$§G+2§!"
 resolution_cosmic_storms_galactic_management_repeal: "Bãi bỏ $resolution_cosmic_storms_galactic_management$"
 resolution_cosmic_storms_galactic_management_repeal_desc: "$resolution_space_weather_exploitation_repeal_desc$"
 resolution_cosmic_storms_galactic_management_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_galactic_management$§!, đưa §Y$resolution_cosmic_storms_protection_initiative$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_utilization_protocols: "Sáng kiến Tận dụng Bão"
 resolution_cosmic_storms_utilization_protocols_desc: "Từ giờ trở đi, chúng ta chắc chắn phải làm tốt công tác phòng vệ trước bão vũ trụ, nhưng cũng không thể vì thế mà ngừng việc khai thác và tận dụng chúng."
 resolution_cosmic_storms_utilization_protocols_tooltip: "$output_from_storm_protection_buildings$ §G+20%§! \n\n$storm_tech_draw_guaranteed$\n\n$unity_from_storms$ §G+2§!\n\n$breach_galactic_law_intro$$TABBED_NEW_LINE$-Tàu không được trang bị §YBảo vệ Bão Vũ trụ§!"
 resolution_cosmic_storms_utilization_protocols_nomad_tooltip: "$unity_from_storms_nomadic$§G+2§!"
 resolution_cosmic_storms_utilization_protocols_repeal: "Bãi bỏ $resolution_cosmic_storms_utilization_protocols$"
 resolution_cosmic_storms_utilization_protocols_repeal_desc: "$resolution_space_weather_exploitation_repeal_desc$"
 resolution_cosmic_storms_utilization_protocols_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_utilization_protocols$§!, đưa §Y$resolution_cosmic_storms_galactic_management$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_manipulation_mandate: "Chỉ thị Thao túng Bão"
 resolution_cosmic_storms_manipulation_mandate_desc: "Sứ mệnh của chúng ta là thống trị các cơn bão vũ trụ, sức mạnh của tự nhiên vốn dĩ phải phục vụ chúng ta."
 resolution_cosmic_storms_manipulation_mandate_tooltip: "$output_from_storm_protection_buildings$ §G+30%§!\n\n$storm_tech_cost$ §G-80%§!\n\n$storm_tech_draw_guaranteed$\n\n$unity_from_storms$ §G+3§!\n\n$breach_galactic_law_intro$$TABBED_NEW_LINE$-Tàu không được trang bị §YBảo vệ Bão Vũ trụ§!$TABBED_NEW_LINE$-Hành tinh không có §YCông trình Bão Vũ trụ§!"
 resolution_cosmic_storms_manipulation_mandate_nomad_tooltip: "$unity_from_storms_nomadic$§G+3§!"
 resolution_cosmic_storms_manipulation_mandate_repeal: "Bãi bỏ $resolution_cosmic_storms_manipulation_mandate$"
 resolution_cosmic_storms_manipulation_mandate_repeal_desc: "$resolution_space_weather_exploitation_repeal_desc$"
 resolution_cosmic_storms_manipulation_mandate_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_manipulation_mandate$§!, đưa §Y$resolution_cosmic_storms_utilization_protocols$§! trở thành Luật Thiên hà."
 resolution_category_storm_environmentalists_stances: "Bảo vệ Môi trường Bão"
 resolution_space_storm_environmentalists_stances_repeal_desc: "Cộng đồng Thiên hà không nên quyết định cách thức xử lý bão vũ trụ của một quốc gia."
 resolution_cosmic_storms_advanced_storm_studies: "Nghiên cứu Bão Chuyên sâu"
 resolution_cosmic_storms_advanced_storm_studies_desc: "Bão là một lực lượng tuyệt đẹp của tự nhiên xứng đáng để chúng ta học hỏi và tôn trọng."
 resolution_cosmic_storms_advanced_storm_studies_tooltip: "$storm_tech_cost$ §R+20%§!"
 resolution_cosmic_storms_advanced_storm_studies_repeal: "Bãi bỏ $resolution_cosmic_storms_advanced_storm_studies$"
 resolution_cosmic_storms_advanced_storm_studies_repeal_desc: "$resolution_space_storm_environmentalists_stances_repeal_desc$"
 resolution_cosmic_storms_advanced_storm_studies_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_advanced_storm_studies$§!."
 resolution_cosmic_storms_galactic_emergency_relief: "Cứu trợ Khẩn cấp Thiên hà"
 resolution_cosmic_storms_galactic_emergency_relief_desc: "Chúng ta phải viện trợ cho các quốc gia bị ảnh hưởng bởi bão vũ trụ."
 resolution_cosmic_storms_galactic_emergency_relief_tooltip: "Mở khóa §YQuỹ Khẩn cấp§!, mỗi thành viên của [global_event_country.GetCommunityOrImperium] cần phải đóng góp §R5%§! sản lượng $r_energy$.\n\nKhi các thành viên [global_event_country.GetCommunityOrImperium] bị ảnh hưởng bởi §Y$default_storm$§!, với mỗi hệ sao gặp nạn, họ sẽ nhận được §G+3§! $r_energy$ mỗi tháng.\n\n$storm_tech_cost$ §R+30%§!"
 resolution_cosmic_storms_galactic_emergency_relief_repeal: "Bãi bỏ $resolution_cosmic_storms_galactic_emergency_relief$"
 resolution_cosmic_storms_galactic_emergency_relief_repeal_desc: "$resolution_space_storm_environmentalists_stances_repeal_desc$"
 resolution_cosmic_storms_galactic_emergency_relief_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_galactic_emergency_relief$§!, đưa §Y$resolution_cosmic_storms_advanced_storm_studies$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_storm_encouragement_mandate: "Chỉ thị Thúc đẩy Bão"
 resolution_cosmic_storms_storm_encouragement_mandate_desc: "Thông qua việc giải phóng các hạt và năng lượng quan trọng, bão vũ trụ truyền sức sống vào thiên hà, tái tạo các hành tinh và hệ sao mà chúng đi qua. Dòng chảy tự nhiên của chúng không nên bị cản trở."
 resolution_cosmic_storms_storm_encouragement_mandate_tooltip: "$emergency_fund_contribution$ §R10%§!\n\n$storm_tech_cost$ §R+50%§!\n\n$breach_galactic_law_intro$$TABBED_NEW_LINE$-§YCông nghệ Xua đuổi Bão§!"
 resolution_cosmic_storms_storm_encouragement_mandate_repeal: "Bãi bỏ $resolution_cosmic_storms_storm_encouragement_mandate$"
 resolution_cosmic_storms_storm_encouragement_mandate_repeal_desc: "$resolution_space_storm_environmentalists_stances_repeal_desc$"
 resolution_cosmic_storms_storm_encouragement_mandate_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_storm_encouragement_mandate$§!, đưa §Y$resolution_cosmic_storms_galactic_emergency_relief$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_control_restrictions: "Hạn chế Thao túng Bão"
 resolution_cosmic_storms_control_restrictions_desc: "Thiên hà là một hệ thống khổng lồ và liên kết chặt chẽ với nhau, bão vũ trụ là một phần quan trọng trong đó. Hành vi can thiệp vào bão sẽ vi phạm luật thiên hà."
 resolution_cosmic_storms_control_restrictions_tooltip: "$storm_tech_cost$ §R+65%§!\n\n$breach_galactic_law_intro$$TABBED_NEW_LINE$-§YCông nghệ Xua đuổi Bão§!$TABBED_NEW_LINE$-§YCông nghệ Thu hút Bão§!"
 resolution_cosmic_storms_control_restrictions_repeal: "Bãi bỏ $resolution_cosmic_storms_control_restrictions$"
 resolution_cosmic_storms_control_restrictions_repeal_desc: "$resolution_space_storm_environmentalists_stances_repeal_desc$"
 resolution_cosmic_storms_control_restrictions_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_control_restrictions$§!, đưa §Y$resolution_cosmic_storms_storm_encouragement_mandate$§! trở thành Luật Thiên hà."
 resolution_cosmic_storms_preservation_initiative: "Sáng kiến Bảo tồn Bão"
 resolution_cosmic_storms_preservation_initiative_desc: "Bất kỳ hành vi thao túng bão nào cũng đều là sự báng bổ thiên nhiên."
 resolution_cosmic_storms_preservation_initiative_tooltip: "$emergency_fund_contribution$ §R15%§!\n\n$storm_tech_cost$ §R+80%§!\n\n$breach_galactic_law_intro$$TABBED_NEW_LINE$-§YCông nghệ Xua đuổi Bão§!$TABBED_NEW_LINE$-§YCông nghệ Thu hút Bão§!$TABBED_NEW_LINE$-§YSắc lệnh $edict_storm_repel_field$§!$TABBED_NEW_LINE$-§YSắc lệnh $edict_storm_attraction_field$§!"
 resolution_cosmic_storms_preservation_initiative_repeal: "Bãi bỏ $resolution_cosmic_storms_preservation_initiative$"
 resolution_cosmic_storms_preservation_initiative_repeal_desc: "$resolution_space_storm_environmentalists_stances_repeal_desc$"
 resolution_cosmic_storms_preservation_initiative_repeal_effect_success: "Bãi bỏ nghị quyết §Y$resolution_cosmic_storms_preservation_initiative$§!, đưa §Y$resolution_cosmic_storms_control_restrictions$§! trở thành Luật Thiên hà."
 country_storms: "Bão"
 mod_resolution_category_space_weather_exploitation_stances_vote_strength_mult: "Sức mạnh biểu quyết cho các nghị quyết thuộc §Y$resolution_category_space_weather_exploitation_stances$§!"
 mod_resolution_category_storm_environmentalists_stances_vote_strength_mult: "Sức mạnh biểu quyết cho các nghị quyết thuộc §Y$resolution_category_storm_environmentalists_stances$§!"
 # These are not shown since storm_unity_gain_modifier is hidden from the country list
 mod_country_storms_unity_produces_add: ""
 storm_unity_gain_modifier: ""
 particle_storm_ship_unity_gain_modifier: "$storm_unity_gain_modifier$"
 ###########################################
 # Relics #
 ###########################################
 # Weather Manipulator
 r_weather_manipulator: "Thiết bị Ức chế Nhiễu loạn"
 r_weather_manipulator_desc: "Đây là một phiên bản tiên tiến hơn của bộ máy mà tập đoàn thương mại Inetian đã dùng để thao túng bão vũ trụ. Theo mặc định, thiết bị này sẽ gia tăng hiệu suất cho tất cả các công nghệ liên quan đến bão của chúng ta, nhưng nếu được sử dụng đúng cách, nó thậm chí có thể xua đuổi tất cả các cơn bão ra khỏi biên giới."
 storm_relic_repelling_field_modifier: "Kích hoạt Thiết bị Ức chế Nhiễu loạn"
 storm_relic_repelling_field_modifier_tt: "Tạo ra một trường xua đuổi §Y$default_storm$§! cỡ §MĐại§! xung quanh thủ đô đế chế, kéo dài trong 36 tháng."
 # Temporary effect used by the Inetian Precursor Digsite C
 storm_timed_repelling_field_modifier: "Kích hoạt Thiết bị Ức chế Nhiễu loạn Cục bộ"
 storm_timed_repelling_field_modifier_tt: "Tạo ra một trường xua đuổi §Y$default_storm$§! cỡ §HVừa§! xung quanh thủ đô đế chế, kéo dài trong 18 tháng."
 # The Tempest Invocator
 r_the_tempest_invocator: "Thiết bị Triệu hồi Bão"
 r_the_tempest_invocator_desc: "Ngay cả khi thiết bị này đã tắt, năng lượng ẩn chứa bên trong nó vẫn rất rõ ràng. Liệu chúng ta có thực sự dám mạo hiểm kích hoạt một cơn bão dữ dội lên những cá nhân xuất chúng nhất của mình không? Vì vinh quang của đế chế, sự hy sinh là điều tất yếu."
 r_the_tempest_invocator_active_effect_tt: "Tạo ra một cơn ['concept_nexus_storm'] trong hệ sao bạn đã chọn.\n$t$Khi hệ sao đã được chọn, phải §PHiến tế§! một $scientist_with_icon$."
 r_the_tempest_invocator_requirement_fail_tt: "$TRIGGER_FAIL$§RKhông có $scientist_with_icon$ nào để hiến tế.§!"
 r_the_tempest_invocator_started_placing_fail_tt: "$TRIGGER_FAIL$§RHệ thống triệu hồi bão đã được kích hoạt.§!"
 tempest_invocator_active_modifier: "Xua đuổi Bão"
 concept_nexus_storm: "$nexus_storm$"
 ###############################
 #### Effects #
 ###############################
 # Emergency fund effects
 emergency_fund: "Quỹ Khẩn cấp"
 set_galactic_emergency_fund_active: "$emergency_fund$ đã được kích hoạt"
 unset_galactic_emergency_fund_active: "$emergency_fund$ đã bị vô hiệu hóa"
 set_emergency_fund_contribution_rate: "Đóng góp cho $emergency_fund$: $tax_rate$"
 ###########################################
 # Anomalies #
 ###########################################
 STORMS_ANOM_ANTS: "Sao chổi Hữu cơ"
 STORMS_ANOM_ANTS_DESC: "Sau khi bão vũ trụ đi qua, một ngôi sao chổi với thành phần cực kỳ bất thường đã xuất hiện. Có vẻ như nó được cấu thành từ các vật liệu hữu cơ. [solar_system.Owner.GetScientistPlural] của chúng ta đang rất nóng lòng muốn điều tra."
 cstorms.5020.name: "Hành tinh Kiến"
 cstorms.5020.desc: "Chúng ta phát hiện ra rằng ngôi sao chổi này thực chất là một tổ khổng lồ, tràn ngập vô số loài côn trùng nhỏ bé. Đuôi sao chổi cũng không phải là sương băng, mà là khí thải thoát ra từ các phản ứng hóa học bên trong tổ.\n\nLớp vỏ tổ được làm từ xác côn trùng chết, bảo vệ những sinh vật bên trong khỏi môi trường khắc nghiệt của không gian. Chúng ta cũng tìm thấy một số loại nấm sống ký sinh trên tổ. Có một mối quan hệ cộng sinh phức tạp bên trong: nấm sống nhờ vào khí thải, còn côn trùng thì lấy nấm làm thức ăn."
 cstorms.5020.a: "Bắt giữ chiếc tổ này."
 cstorms.5020.b: "Quan sát từ xa, không chạm vào."
 STORMS_ANOM_STAT: "Thành phần Đáng ngạc nhiên"
 STORMS_ANOM_STAT_DESC: "Vật thể đang xoay trên quỹ đạo này được mang đến bởi một cơn bão vũ trụ quét qua. Trông nó giống như một trạm không gian, nhưng kết quả quét cấu trúc lại có phần khó hiểu. Chúng tôi đề nghị nên tiến hành điều tra."
 cstorms.5030.name: "Khải huyền Đình trệ"
 cstorms.5030.desc: "[Root.Owner.GetScientistPluralCapital] báo cáo rằng phần lớn trạm không gian này được chế tạo từ các vật liệu cố định thông thường, những thứ đang chật vật để giữ cho trạm không bị vỡ vụn. Khi chúng ta tiến sâu hơn vào cấu trúc, vật liệu cấu thành trạm dần chuyển từ hợp kim kim loại sang nhựa và các chất liệu khác.\n\nỞ khu vực lõi, chúng ta tìm thấy một cỗ máy đang hoạt động hết công suất, liên tục phân tách các nguyên liệu hữu cơ và biến chúng thành những thứ mà ta đã thấy trước đó.\n\nSau khi chạy các mô hình mô phỏng DNA, [Root.Owner.GetScientistPlural] của chúng ta chỉ có thể kết luận rằng những nguyên liệu này rất có thể từng là những cư dân cũ của trạm không gian."
 cstorms.5030.evopred: "Hãy xem chúng ta có thể khám phá thêm điều gì."
 STORMS_ANOM_BRAIN: "Sự Phân rã Hiện sinh"
 STORMS_ANOM_BRAIN_DESC: "Kể từ khi một cơn $shroud_storm$ hoành hành qua hệ sao này, chúng ta bắt đầu liên tục nhận được những tín hiệu kỳ lạ. Tuy nhiên, khi [Root.Owner.GetScientistPlural] cố gắng đáp lại, tín hiệu lại bị ngắt. Các nhà khoa học đề nghị cử một tàu nghiên cứu đến điều tra."
 cstorms.5025.name: "Bão Não"
 cstorms.5025.desc: "Đây là một khám phá ngoài dự kiến: Một cụm não bộ. Hàng trăm cơ quan xử lý hữu cơ nhầy nhụa từ đủ loại sinh vật được kết nối với nhau, lơ lửng trong một buồng chứa khổng lồ hình quả bóng. Nó dường như đã bị bỏ hoang, trôi dạt trong không gian sâu thẳm sau khi cơn $shroud_storm$ vừa qua tan biến.\n\nBên trong buồng chứa có một hệ thống cảm biến đáng kinh ngạc được kết nối trực tiếp với các bộ não, cùng một module thông tin có khả năng gọi các tàu thuyền và truyền tín hiệu, thứ mà trước đó nó đã dùng với chúng ta.\n\nBây giờ có vẻ như chính những bộ não này đã liên hệ với chúng ta, giải thích chuỗi tín hiệu kia. [Root.Owner.GetScientistPlural] của chúng ta tin rằng mục đích ban đầu của thiết bị này là để kiểm tra phản ứng của sinh vật hữu cơ đối với $shroud_storm$. Cân nhắc đến lượng năng lượng tâm linh không ổn định còn sót lại bên trong những bộ não lơ lửng này, việc cố gắng kết nối với chúng có thể sẽ mang lại nguy hiểm."
 # Terrestrial Telescopes
 terrestial_telescope_category: "Kính viễn vọng Không gian"
 terrestial_telescope_category_desc: "Máy quét của [fleet.GetName] cho thấy có một trạm không gian bị bỏ hoang đang trôi dạt trong hệ sao [From.GetStarName].\n\nCó vẻ như nó bị một cơn bão vũ trụ quét qua cuốn tới đây. Không phát hiện thấy sự sống bên trong, cũng không có bất kỳ dạng tín hiệu năng lượng nào. Nổi bật ở hai bên trạm là một cặp kính viễn vọng khổng lồ. Cặp thiết bị quang học này trông rất tiên tiến, nhưng kích thước của chúng lại quá khổ so với trạm không gian. Toàn bộ công nghệ và cấu trúc của trạm vẫn còn khá lạ lẫm với chúng ta.\n\nChúng ta có thể thử tái khởi động cụm kính viễn vọng này, điều đó có thể mang lại vài góc nhìn thú vị."
 cstorms.1605.name: "Kính viễn vọng Không gian"
 cstorms.1605.desc: "[Root.Owner.GetScientistPlural] của chúng ta đã phải tốn khá nhiều công sức mới lên được trạm và tái khởi động kính viễn vọng, rốt cuộc thì không có gì làm khó được họ. Tuy nhiên, nơi mà kính viễn vọng hướng tới lại không có gì đặc biệt đáng chú ý.\n\nChúng ta phát hiện rải rác xung quanh trạm là một số hiện vật thú vị, đó là những bức ảnh sắc nét được chụp bởi kính viễn vọng, đặt trong những khung hình tinh xảo. Những bức ảnh này đều chụp các cơn bão vũ trụ, chúng ghi lại chi tiết mọi cơn bão quét qua hệ sao này và mỗi lần đều chụp rất nhiều tấm. Người điều khiển kính viễn vọng đã thay đổi tiêu cự, chụp từ nhiều góc độ khác nhau, thậm chí còn cố ý nghiêng ống kính một cách đầy tính nghệ thuật để phô diễn vẻ đẹp tráng lệ nhất của bão.\n\nSau khi điều tra kỹ lưỡng, khám phá duy nhất của chúng ta trên trạm bỏ hoang này chính là những tác phẩm nghệ thuật thú vị đó. Chúng ta sẽ lưu trữ chúng lại, để hậu thế có thể chiêm ngưỡng những hình ảnh hiếm hoi, đầy sức mạnh và vẻ đẹp này."
 STORMS_ANOM_POLYCHROMATIC: "Ngôi sao Đa sắc"
 STORMS_ANOM_POLYCHROMATIC_DESC: "Bão vũ trụ khi quét qua hệ sao [from.solar_system.GetName] đã làm thay đổi diện mạo của ngôi sao tại đây. Dưới hệ quả của bão, lớp nhật hoa của ngôi sao này hiện ra những luồng xoáy rực rỡ, phun trào những ngọn lửa rực rỡ đủ màu sắc ra mọi hướng. Hiện tượng này rất đáng để phân tích thêm."
 cstorms.5035.name: "$STORMS_ANOM_POLYCHROMATIC$"
 cstorms.5035.desc: "[root.leader.GetName] báo cáo về những thay đổi kỳ diệu trong phản ứng nhiệt hạch của [From.GetStarName] kể từ khi [from.GetAffectedStormType] quét qua.\n\nRõ ràng, cơn bão này đã kích hoạt một chuỗi phản ứng hạt nhân bất ngờ nào đó trong lõi sao, khiến vùng đối lưu của nó liên tục giải phóng [from.GetEarnedResources].\n\nNhững phản ứng phức tạp và đặc biệt này đã tạo ra những luồng sáng đa sắc khác thường mà chúng ta quan sát thấy. Dù sao đi nữa, trong một thời gian, đây sẽ luôn là một nguồn tài nguyên xứng đáng để nghiên cứu kỹ lưỡng."
 cstorms.5035.a: "Nghiên cứu quy trình mới này."
 cstorms.5035.b: "Thu thập những tài nguyên mới này."
 STORMS_ANOM_TRIPLETS: "Bộ ba Tiểu hành tinh"
 STORMS_ANOM_TRIPLETS_DESC: "Một cơn bão vũ trụ quét qua đã khiến ba tiểu hành tinh mới xuất hiện trong hệ sao [from.solar_system.GetName]. Những thiên thể này có khuynh hướng chuyển hướng ngẫu nhiên rất khó giải thích, do đó không thể dự đoán được quỹ đạo của chúng. Sự việc này cần được nghiên cứu thêm."
 cstorms.5040.name: "$STORMS_ANOM_TRIPLETS$"
 cstorms.5040.desc: "[root.leader.GetName] phát hiện ra rằng, các tiểu hành tinh lắng đọng trong hệ sao [from.solar_system.GetName] có từ tính rất không ổn định, khiến chúng nảy ngẫu nhiên trên từ quyển hiện có của hệ sao.\n\n[root.leader.GetName] đã làm ổn định chúng bằng cách gắn máy bù trừ từ trường vào từng tiểu hành tinh, chuẩn hóa quỹ đạo của chúng và giúp chúng sẵn sàng cho việc khai thác tài nguyên."
 STORMS_ANOM_TRAVELLERS: "Tín hiệu Cầu cứu Hậu thảm họa"
 STORMS_ANOM_TRAVELLERS_DESC: "Trong đống đổ nát của cơn §H[from.GetAffectedStormType]§!, một tín hiệu cầu cứu không xác định đã được phát hiện từ hệ sao §H[from.solar_system.GetName]§!."
 cstorms.5050.name: "Lữ khách Lệch hướng"
 cstorms.5050.desc: "Chúng ta đã xác định được nguồn gốc của tín hiệu cầu cứu trong hệ sao §H[from.solar_system.GetName]§!, đó là một con tàu buôn bị hư hại nặng nề nhưng vẫn còn hoạt động.\n\nPhi hành đoàn tuyên bố họ đã bị §H[from.GetAffectedStormType]§! thổi bay một chặng rất xa khỏi đường bay dự kiến. Cơn bão cũng đã làm cháy rụi động cơ, khiến con tàu cùng những thứ bên trong bị mắc kẹt trong không gian của chúng ta.\n\nNếu chúng ta có thể giúp đỡ, họ sẵn sàng giao nộp một phần hàng hóa."
 cstorms.5050.a: "Đồng ý giúp đỡ họ."
 cstorms.5050.evopred: "Chúng ta có thể cung cấp viện trợ để đổi lấy một vài mẫu gen."
 cstorms.5050.b: "Chúc họ may mắn."
 cstorms.5050.c.genocide: "Đoạt mạng họ và cướp lấy hàng hóa."
 cstorms.5050.d.devouring_swarm: "Một bữa ăn miễn phí."
 STORMS_COSMIC_SLUDGE: "Bùn Vũ trụ"
 STORMS_COSMIC_SLUDGE_DESC: "Trong hậu quả của §H[from.GetAffectedStormType]§!, máy dò khối lượng theo dõi hệ §H[from.solar_system.GetName]§! đã thu được những kết quả dị thường.\n\nQuá trình chẩn đoán hệ thống không phát hiện lỗi kỹ thuật nào trong thiết bị, do đó những kết quả này cần được điều tra thêm."
 cstorms.5060.name: "$STORMS_COSMIC_SLUDGE$"
 cstorms.5060.desc: "Những kết quả đọc dị thường trong hệ sao §H[from.solar_system.GetName]§! bắt nguồn từ một mảng mảnh vỡ bất thường do hậu quả của cơn §H[from.GetAffectedStormType]§! để lại.\n\nThực thể trôi nổi này được tạo ra từ một khối bùn vũ trụ vô định hình, rèn dũa dưới áp suất cực độ của cơn bão. Vô số nguyên tố cấu thành của nó đã hình thành nên một hợp chất hoạt tính độc đáo.\n\nNghiên cứu sâu về thành phần hóa học của nó có thể mang lại những hiểu biết quý giá về khí tượng học không gian trong các điều kiện tạo ra nó."
 cstorms.5060.a: "Nghiên cứu thành phần của nó."
 cstorms.5060.b: "Tháo dỡ nó."
 STORMS_SHATTERED_SATTELITE: "Vệ tinh vỡ nát"
 STORMS_SHATTERED_SATTELITE_DESC: "Trong dư âm của §H[from.GetAffectedStormType]§!, một vật thể lạ đã được phát hiện trong hệ sao §H[from.solar_system.GetName]§!. Nghiên cứu sâu hơn về mảnh vỡ này có thể mang lại những góc nhìn quý giá."
 cstorms.5070.name: "$STORMS_SHATTERED_SATTELITE$"
 cstorms.5070.desc: "Vật thể trong hệ sao §H[from.solar_system.GetName]§! là xác của một vệ tinh nhân tạo cổ đại, mang theo hệ thống cảm biến thời tiết liên sao cực kỳ phức tạp. Chúng ta tin rằng nó đã trôi dạt xuyên qua không gian cùng với §H[from.GetAffectedStormType]§!.\n\nNó đã hư hại quá nặng để có thể sửa chữa, nhưng cơ sở dữ liệu trung tâm chứa một lượng lớn thông tin mà chúng ta có thể tận dụng.\n\nMọi thứ còn lại của vệ tinh giờ chỉ có thể trục vớt làm phế liệu."
 STORMS_EVISCERATED_FAUNA: "Vật thể lạ"
 STORMS_EVISCERATED_FAUNA_DESC: "Cảm biến trong hệ sao §H[from.solar_system.GetName]§! vừa phát hiện một vật thể không xác định bị §H[from.GetAffectedStormType]§! cuốn vào đây trong thời gian gần đây.\n\nCần khảo sát cận cảnh để xác định bản chất của sự bất thường này."
 cstorms.5080.name: "Tàn dư hữu cơ"
 cstorms.5080.desc.common: "Chúng ta phát hiện ra rằng, vật thể kỳ lạ trong hệ sao §H[from.solar_system.GetName]§! thực chất là một khối tàn dư hữu cơ khổng lồ từ một loài sinh vật không gian nào đó. Do mọi đặc điểm nhận dạng đã bị cơn bão không gian xé nát, ta không thể phân loại chính xác những mảnh vỡ sinh học này."
 cstorms.5080.desc.swarm: "May mắn thay, phần lớn vẫn còn ăn được."
 cstorms.5080.desc.default: "[leader.GetName] tin chắc rằng việc khám nghiệm chi tiết khối sinh khối này sẽ tiết lộ thêm thông tin về nguồn gốc của nó, cũng như tác động của §Y[from.GetAffectedStormType]§! đối với các sinh vật không gian tương tự."
 cstorms.5080.a: "Chúng ta đang đói."
 cstorms.5080.b: "Khám nghiệm ngay tại chỗ."
 cstorms.5080.c: "Tiêu hủy mấy thứ này đi."
 FORENSIC_DISSECTION_PROJECT: "Khám nghiệm chi tiết"
 FORENSIC_DISSECTION_PROJECT_DESC: "Chúng ta đã tìm thấy tàn tích của một loài sinh vật chưa xác định bị cơn bão không gian cuốn trôi tại hệ sao §H[solar_system.GetName]§!. Tiến hành khám nghiệm bộ hài cốt này có thể làm sáng tỏ thêm nhiều thông tin."
 cstorms.5085.name: "$FORENSIC_DISSECTION_PROJECT$"
 cstorms.5085.desc: "Dù đã khám nghiệm cẩn thận, khối thịt này thuộc về loài nào vẫn là một ẩn số. Sức tàn phá khủng khiếp ở tâm bão đã xóa sạch mọi đặc điểm nhận dạng và dấu vết di truyền của nó.\n\nTuy nhiên, trong quá trình nghiên cứu, chúng ta đã có thêm góc nhìn mới về cấu trúc của §Ycơn bão không gian§!, hiểu rõ hơn về sức tàn phá của nó đối với sinh khối ngoài hành tinh."
 cstorms.5085.evopred: "Một bữa ăn hấp dẫn."
 STORMS_DISPLACED_TIYANKI: "Tiyanki đi lạc"
 STORMS_DISPLACED_TIYANKI_DESC: "Cảm biến của tôi vừa phát hiện tín hiệu của ba con Tiyanki trong tàn dư của $default_storm$ tại hệ sao §H[solar_system.GetName]§!."
 cstorms.5090.name: "$STORMS_DISPLACED_TIYANKI$"
 cstorms.5090.desc.common: "Tín hiệu của ba con Tiyanki trong hệ sao §H[solar_system.GetName]§! được xác định là một nhóm cá thể non đang đi lạc và suy dinh dưỡng.\n\n§Y$default_storm$§! đã chia cắt bầy con này khỏi đàn lớn, buộc chúng phải tự sinh tồn.\n\nCó vẻ như chúng khó lòng sống sót lâu ngoài không gian sâu thẳm. Cảm biến cho thấy chúng đang cố gắng phát tín hiệu gọi bầy nhưng không có kết quả."
 cstorms.5090.desc.swarm: "Chúng ta có thể khuếch đại tiếng kêu cứu của chúng, dùng chúng làm mồi nhử để câu một bữa ăn lớn hơn."
 cstorms.5090.desc.default: "Hệ thống liên lạc của chúng ta có thể được dùng để khuếch đại tiếng kêu cứu của chúng, thu hút bầy đàn của chúng tiến vào hệ sao này."
 cstorms.5090.a.default: "Khuếch đại tín hiệu của chúng."
 cstorms.5090.a.swarm: "Đặt mồi cho bẫy."
 cstorms.5090.b.default: "Tự nhiên luôn tàn nhẫn."
 cstorms.5090.b.machine: "Kích hoạt giao thức tận diệt."
 cstorms.5090.b.swarm: "Một bữa ăn miễn phí."
 cstorms.5090.c: "Cho chúng một mái nhà mới"
 cstorms.5090.c.tt: "Thêm 3 §Y$NAME_Tiyanki_Hatchling$§! có độ hiếm ngẫu nhiên vào ['concept_vivarium'] của bạn"
 REUNITE_POD_PROJECT: "Đoàn tụ bầy đàn"
 REUNITE_POD_PROJECT_DESC: "Ba con Tiyanki non bị bão không gian cuốn đi đang lang thang trong hệ sao [this.solar_system.GetName]. Chúng ta có thể giúp chúng đoàn tụ bằng cách khuếch đại tiếng kêu để thu hút bầy đàn của chúng đến đây."
 cstorms.5095.name: "Tiyanki đoàn tụ"
 cstorms.5095.desc.common: "Sau khi nghe thấy tiếng kêu gọi được khuếch đại của ba con non, những con Tiyanki trưởng thành đã xuất hiện trở lại tại hệ sao §H[solar_system.GetName]§!.\n\nNhững con Tiyanki trẻ đã trở về với bầy, giờ đây đã vui vẻ và khỏe mạnh trở lại.\n\nTiyanki mẹ đã để lại một lượng lớn mảnh vỡ vật chất gần tàu khoa học của chúng ta, dường như để cảm ơn sự giúp đỡ. Đáng ngạc nhiên là món quà kỳ lạ này chứa khá nhiều vật liệu có thể sử dụng được."
 cstorms.5095.desc.swarm: "Tất nhiên, những con to xác này mới là con mồi thực sự; chúng ta đã sẵn sàng để đi săn."
 ###########################################
 # Chuỗi sự kiện #
 ###########################################
 ### Chuỗi sự kiện Hành tinh Va chạm
 collided_planets_category: "Hành tinh Va chạm"
 collided_planets_category_desc: "Hàng tỷ năm trước, hai hành tinh đã va chạm tại đây. Trong tàn dư của sự hủy diệt, một hành tinh độc nhất vô nhị đã ra đời."
 cs_collided_planet_chain_title: "Hành tinh Va chạm"
 cs_collided_planet_chain_desc: "Bóng đen thảm họa luôn đe dọa sự cân bằng mong manh trên hành tinh kỳ lạ này."
 cstorms.1200.name: "Quá khứ hệ sao đôi"
 cstorms.1200.desc: "Kể từ khoảnh khắc phát hiện ra [From.Planet.GetName], nó đã luôn thu hút ánh nhìn của chúng ta.\n\nTrong một thiên hà rộng lớn và hỗn loạn như thế này, việc hai thiên thể va chạm không phải là chuyện hiếm. Tuy nhiên, trong những vụ va chạm trước đây, ít nhất một hoặc cả hai hành tinh đều sẽ bị phá hủy.\n\nVụ va chạm tạo nên [From.Planet.GetName] của hiện tại đã xảy ra từ hàng triệu năm trước, nhưng hai hành tinh này lại duy trì một sự cân bằng kỳ lạ, thậm chí còn hình thành được một bầu khí quyển có khả năng duy trì sự sống trong suốt quá trình đó."
 cstorms.1205.name: "Sự cân bằng mong manh"
 cstorms.1205.desc: "Tình hình trên 'Hành tinh Va chạm' nguy hiểm hơn dự đoán rất nhiều. Chuỗi động đất gần đây đã xé toạc những vết sẹo ở khu vực từng xảy ra va chạm, lượng lớn dung nham phun trào từ dưới lòng đất. Sự nóng lên toàn cầu và tro bụi núi lửa che khuất bầu trời đã bắt đầu ảnh hưởng đến nhiều dạng sinh vật trên bề mặt hành tinh.\n\nTồi tệ hơn, theo kết quả dự báo, nếu chúng ta không thể ổn định cặp hành tinh này trong 50 năm tới, hoạt động kiến tạo mảng sẽ ngày càng dữ dội và cuối cùng sẽ khiến [From.Planet.GetName] vỡ vụn!"
 cstorms.1210.name: "Lột xác tái sinh"
 cstorms.1210.desc: "Những nhà địa chất hàng đầu của chúng ta đã tập hợp lại và đưa ra hai phương án khả thi để cứu lấy [From.Planet.GetName] khỏi hoạt động địa chất kinh hoàng này.\n\nKế hoạch đầu tiên là ổn định tình trạng hiện tại, mặc dù việc lấp đầy các ngọn núi lửa quanh khu vực va chạm sẽ mất hàng thế kỷ, nhưng chúng ta có thể cẩn thận khoan các lỗ trên bề mặt để giảm áp lực lớp vỏ, tránh mất ổn định các mảng kiến tạo. Tàn tích núi lửa sẽ được sử dụng để cải tạo hành tinh, tạo nên một môi trường sinh thái ổn định.\n\nKế hoạch thứ hai tham vọng hơn nhiều, thay vì giảm áp lực lớp vỏ, chúng ta có thể lợi dụng năng lượng và vật chất sinh ra từ những vụ phun trào núi lửa để tiến hành cải tạo môi trường có định hướng.\n\nPhương pháp này cho phép chúng ta định hình đa dạng môi trường sinh thái, giúp nhiều loài sinh vật khác nhau có thể sinh sống tại đây, biến hành tinh này thành một thiên đường. Tuy nhiên, khả năng thất bại của kế hoạch này là rất lớn, thậm chí có thể dẫn đến sự diệt vong hoàn toàn của hành tinh độc đáo này."
 cstorms.1210.a: "Chúng ta chọn cách ổn định tình trạng hiện tại."
 cstorms.1210.b: "Chúng ta chọn cách tận dụng tàn tích núi lửa."
 cstorms.1210.c: "Chỉ quan sát từ xa thôi."
 collided_planet_collapsing: "Hành tinh vỡ vụn"
 collided_planet_collapsing_desc: "Hoạt động địa chất mang tính hủy diệt sẽ xé toạc hành tinh va chạm — và trong quá trình đó, cả hai hành tinh đều sẽ bị diệt vong."
 collided_planet_collapsing_tt: "Hành tinh này sẽ sụp đổ sau 50 năm nữa."
 project_cosmic_storms_collidedplanet_stabilize: "Ổn định vụ va chạm"
 project_cosmic_storms_collidedplanet_stabilize_DESC: "Nếu muốn cứu hành tinh này khỏi cảnh sụp đổ, chúng ta phải làm cho nó ổn định lại."
 project_cosmic_storms_collidedplanet_harmonize: "Cải tạo hành tinh va chạm"
 project_cosmic_storms_collidedplanet_harmonize_DESC: "Hãy thực hiện kế hoạch táo bạo này để cải tạo hệ sinh thái của hành tinh va chạm. Chúng ta sẽ tạo ra một thế giới phù hợp cho mọi sự sống, hoặc sẽ đẩy hành tinh này đến bờ vực diệt vong."
 cstorms.1220.name: "Ổn định thành công"
 cstorms.1220.desc: "Nỗ lực ổn định hành tinh va chạm của chúng ta đã được đền đáp! Những trận động đất đe dọa [From.Planet.GetName] trước đó đã lắng xuống, tàn tích từ núi lửa cũng giảm nhanh chóng như dự đoán, hành tinh này đã trở lại trạng thái cân bằng mong manh ban đầu.\n\nVấn đề cải tạo môi trường hiện tại là: Nên định hướng cải tạo [From.Planet.GetName] theo hướng nào?"
 cstorms.1220.a: "Duy trì trạng thái hành tinh lục địa hiện tại."
 cstorms.1220.b: "Cải tạo thành hành tinh thảo nguyên."
 cstorms.1220.c: "Cải tạo thành hành tinh đồi núi."
 cstorms.1225.name: "Hành tinh cho muôn loài"
 cstorms.1225.desc.stabalize: "Thật kinh ngạc, ban đầu chúng ta chỉ nghĩ những nỗ lực này chỉ đủ để ổn định [collided_planets.GetName], không ngờ kết quả lại vượt xa mong đợi.\n\n$cstorms.1225.desc.def$"
 cstorms.1225.desc.def: "Hãy nhìn xem, đây là một thiên đường, một thiên đường có thể nuôi dưỡng mọi dạng sống mà bạn có thể tưởng tượng ra.\n\nCứu vớt một thế giới đang đi đến sự diệt vong và cải tạo nó thành một diện mạo đầy cảm hứng như hiện tại — còn thành tựu nào vĩ đại hơn thế này nữa? Nữ thần may mắn chắc chắn đang mỉm cười với chúng ta."
 cstorms.1230.name: "Đại tu toàn diện"
 cstorms.1230.desc: "Mặc dù bản thân hành tinh này đã sống sót, nhưng nỗ lực biến nó thành thiên đường đã đổ sông đổ biển.\n\nHoạt động kiến tạo khắc nghiệt của hành tinh đã cản trở việc cải tạo hệ sinh thái của chúng ta, nhưng tình trạng bất ổn dường như đã kết thúc. Hoạt động núi lửa đã trở về mức trước đây, mặc dù núi lửa vẫn đang hoạt động tại khu vực va chạm, nhưng khó có khả năng bùng phát mạnh mẽ trong thời gian ngắn.\n\nThời kỳ tồi tệ nhất dường như đã qua đi. Giờ đây thách thức của chúng ta là tái thiết hành tinh này."
 cstorms.1235.name: "Mái nhà vỡ vụn"
 cstorms.1235.desc: "Mọi nỗ lực nhằm cứu vớt hành tinh va chạm đang bên bờ vực hủy diệt của chúng ta đã tan thành mây khói. Dù các nhà khoa học đã áp dụng mọi biện pháp phòng ngừa có thể, nhưng mô hình của họ không bao giờ lường trước được mọi tình huống.\n\nKhi những mảnh vỡ của hành tinh dần trôi dạt vào hư không, cả thiên hà đều thương tiếc cho sự biến mất của một kỳ quan."
 cstorms.1240.name: "Va chạm, Hủy diệt"
 cstorms.1240.desc: "Quá trình hủy diệt của hành tinh va chạm diễn ra hoàn toàn đúng theo dòng thời gian chúng ta dự đoán, chính xác đến từng phần mười giây. Kỳ quan từng một thời điểm tô cho biển sao, giờ đây chẳng còn lại gì ngoài một đống đá vụn vô hồn."
 collided_planets_destroyed_tt: "Hành tinh [collided_planets.GetName] đã bị phá hủy."
 ### Chuỗi sự kiện Sinh vật bò màu thẫm
 cs_crimson_crawlers_chain_desc: "Sinh vật bò màu thẫm"
 cs_crimson_crawlers_chain_title: "Chúng ta phát hiện ra một hành tinh có bề mặt bị bao phủ bởi hàng nghìn tỷ con côn trùng màu đỏ dày đặc. Đối với chúng ta, đây rốt cuộc là tai họa hay cơ hội?"
 crimson_crawlers_category: "Bề mặt màu thẫm"
 crimson_crawlers_category_desc: "Chúng ta đã tìm thấy một hành tinh màu đỏ sẫm trong hệ sao [From.GetStarName]. Chúng ta nên tiến hành khảo sát."
 cstorms.1255.name: "Sinh vật bò màu thẫm"
 cstorms.1255.desc: "Nhìn từ xa, [From.GetName] tỏa sáng lấp lánh như những viên ngọc màu đỏ. Đối với một dị thường địa chất như vậy, nguyên nhân thông thường có thể là do đất sét hoặc các loại đất khác có lẫn kim loại cứng. Nhưng sự thật lần này lại kỳ dị hơn nhiều.\n\nĐó là bọ, hàng nghìn tỷ con bọ. Chúng tụ tập cùng nhau, bò nhúc nhích che kín toàn bộ bề mặt của [From.GetName].\n\nChúng ta nhanh chóng đặt tên cho chúng là 'Sinh vật bò màu thẫm', vòng đời sinh sản của loài động vật không xương sống này rất ngắn. Dù không phá hoại môi trường tự nhiên, nhưng việc chúng bò lúc nhúc khắp nơi khiến [From.GetName] trở nên không phù hợp để định cư.\n\nCó người đã đưa ra một đề xuất nghe có vẻ thiếu nghiêm túc để xử lý lũ côn trùng này. Kết quả quét sơ bộ cho thấy chúng có thể ăn được, có lẽ chúng ta có thể dùng chúng như một nguồn thực phẩm mới chăng? Dù sao đi nữa, ít nhất chúng ta cũng nên cử người đi khảo sát trước."
 project_cosmic_storms_crimson_crawlers: "Thức ăn 'tinh thần'"
 project_cosmic_storms_crimson_crawlers_DESC: "Bề mặt [From.Planet.GetName] hoàn toàn bị bao phủ bởi những loài côn trùng đỏ hiền lành này. Muốn hành tinh này trở nên có thể định cư được, trước tiên phải xử lý lũ bọ này. Tuy nhiên, chúng có vẻ là một nguồn thức ăn khá tốt, có lẽ chúng ta có thể bắt đầu từ khía cạnh đó."
 cstorms.1260.name: "Món ăn khác thường"
 cstorms.1260.desc: "Ban đầu, mọi người đều cảm thấy ý tưởng dùng lũ sinh vật bò màu thẫm này làm thức ăn thật lố bịch. Nhưng sau khi mang một phần mẫu bọ về tàu, mọi người lại thấy việc ăn chúng không phải là không thể chấp nhận được.\n\nLũ bọ này đúng là kỳ quan của tạo hóa, hệ thần kinh vô cùng tiên tiến, nhưng lại không có bộ não hay cơ quan xử lý trung tâm. Quan trọng hơn, phần thịt nhạt màu của chúng trơn tuột và mọng nước đến bất ngờ, ngay cả khi ăn sống, lớp vỏ ngoài màu đỏ thẫm nếm cũng rất giòn và ngon.\n\nVấn đề bây giờ là, lũ bọ này phù hợp hơn để làm mẫu vật nghiên cứu, hay phù hợp hơn để làm một món ăn ngon. Chế biến chúng thành các món ăn sẽ mang lại nhiều hương vị và niềm vui hơn, nhưng ăn sống trực tiếp thì lại nhanh và đơn giản hơn nhiều, đặc biệt là nếu kết hợp với các loại gia vị phù hợp."
 cstorms.1260.a: "Nghiên cứu lũ bọ này."
 cstorms.1260.b: "Ăn sống chúng!"
 cstorms.1260.c: "Chuẩn bị xoong nồi!"
 ### Chuỗi sự kiện Mắc kẹt trong Bão
 cs_stormbound_chain_title: "Tàu mắc kẹt trong bão"
 cs_stormbound_chain_desc: "Một con tàu điềm gở đã xuất hiện trên cảm biến của chúng ta — nhưng nó đang ở ngay giữa cơn bão không gian. Chuyện gì đã xảy ra ở đó?"
 letters_of_the_manifold: "Thông điệp từ không gian đa chiều"
 stormbound_event_ship_object: "$cs_stormbound_chain_title$"
 cstorms.1310.name: "Tàu mắc kẹt lại xuất hiện"
 cstorms.1310.desc: "Chúng ta vừa nhận được một số báo cáo kỳ lạ từ hệ sao [This.GetName]. Rõ ràng, cơn bão không gian tàn phá khu vực này trước đó đã cuốn theo một con tàu không rõ nguồn gốc. Con tàu này không có mã định danh, bằng cách nào đó nó đã đi xuyên qua cơn giông bão, dường như hoàn toàn không bị ảnh hưởng bởi cơn bão xung quanh.\n\nCon tàu này không phản hồi lại cuộc gọi của chúng ta, và sau khi cơn bão tan đi, nó cũng biến mất không để lại một dấu vết nào. Đây có thể là do bão gây nhiễu loạn thiết bị, nhưng quan sát bằng mắt thường đã chứng minh sự thật rành rành.\n\nCó công nghệ cực kỳ tiên tiến nào đang ẩn giấu bên trong, hay đã có chuyện gì xui xẻo xảy ra? Chúng ta sẽ phải để mắt đến con tàu bí ẩn này cho đến khi nó xuất hiện trở lại."
 cstorms.1313.name: "Tàu mắc kẹt trở lại"
 cstorms.1313.desc: "Một trạm nghiên cứu ở [This.GetName] đã gửi cho chúng ta một báo cáo đáng kinh ngạc: trong lần bão không gian càn quét trước đó, một con tàu kỳ lạ suýt chút nữa đã đâm sầm vào tiền đồn. Quan sát bằng mắt thường cho thấy, con tàu này chính là con tàu điềm gở đã được báo cáo trước đó.\n\nTheo báo cáo của trạm không gian, vỏ tàu được cấu tạo từ sự dung hợp của vật chất hữu cơ kỳ dị, quặng canxi và hợp kim kim loại.\n\nKhông phát hiện bất kỳ dấu hiệu của sự sống hữu cơ nào trên tàu, điều này khiến chúng ta suy đoán liệu con tàu có được tự động hóa hay đã mất kiểm soát do một sự cố nào đó.\n\nTuy nhiên, điều khó hiểu nhất là, các mảnh vỡ không gian đã phá hủy phần lớn hệ thống động cơ đẩy của con tàu, đáng lẽ nó đã không thể thoát khỏi số phận vỡ vụn.\n\nNếu có thể điều động một tàu khoa học đi giám sát cơn bão không gian tiếp theo, biết đâu chúng ta có thể thu thập thêm thông tin về con tàu này."
 cstorms.1313.a: "Chúng ta không có thời gian để ý đến những chuyện vô bổ này."
 cstorms.1316.name: "Tiếng thì thầm trong bão"
 cstorms.1316.desc: "[stormbound_science.GetName] đã phát hiện con tàu điềm gở xuất hiện trong cơn bão từ đằng xa. Khi nó trôi qua, chúng ta đã bắt được một luồng tín hiệu cực mạnh từ trong không gian.\n\nLý do chúng ta không thể dò ra con tàu cuối cùng cũng sáng tỏ: hình thái vật lý của nó đã vươn ra ngoài ranh giới không gian đa chiều, trông như thể nó đã tiến vào một lỗ sâu nhưng lại không phải vậy. Có lẽ nhờ nguồn gốc đa chiều của cơn bão không gian mà con tàu này mới có thể quay trở lại không gian của chúng ta.\n\nBiết được điều này, khi con tàu xuất hiện lần tới, chúng ta sẽ có thể dò ra nó, và biết đâu còn có thể kéo nó trở lại thực tại của chúng ta."
 cstorms.1317.name: "Phát hiện tàu bị mắc kẹt"
 cstorms.1317.desc: "Chúng ta đã tìm thấy con tàu điềm gở tại §Y[this.GetName]§!."
 cstorms.1320.name: "Đường về nhà"
 cstorms.1320.desc: "Chính là nó! Con tàu điềm gở đang ở ngay phía trước [Root.Fleet.GetName] và đã liên lạc với chúng ta. Trên màn hình hiện ra một thực thể cơ khí đeo một chiếc mặt nạ lộng lẫy, cô tự xưng là Biting, và kể cho chúng ta nghe một câu chuyện đầy hấp dẫn.\n\nCô từng là một chỉ huy lừng danh, cũng là đại diện ưu tú của tổ chức Hiệp ước Nhân từ. Trong một chuyến tuần tra, cô cùng phi hành đoàn bị cuốn vào một cơn bão không gian, để tìm một tia hy vọng sống sót, cô đã liều lĩnh nạp quá tải 'Động cơ Đột phá' của con tàu. Công nghệ thử nghiệm này chưa từng có ai thử qua, kết quả là con tàu cùng toàn bộ phi hành đoàn đã bị mắc kẹt trong trường không gian đa chiều của cơn bão.\n\nCâu chuyện đến đây là kết thúc, cô ném ra từ con tàu bị hư hỏng nặng một chiếc hộp nhỏ, bên trong chứa một xấp tài liệu. 'Hãy mang những thứ này về đi,' Biting thỉnh cầu. Sau đó cuộc gọi kết thúc, và con tàu cũng biến mất vào cấu trúc không gian đa chiều.\n\nNhững tài liệu này đều được viết bằng ngôn ngữ ngoài hành tinh, chúng ta cần dành chút thời gian để giải mã."
 cstorms.1320.a: "Bắt đầu dịch thuật."
 cstorms.1321.name: "Thông điệp từ chiều không gian khác"
 cstorms.1321.desc: "Tài liệu trong chiếc hộp kỳ lạ đã được dịch xong. Một trong số đó ghi lại bản thiết kế 'Động cơ Đột phá' của con tàu. Mặc dù thiết bị này vẫn nằm ngoài tầm với của trình độ công nghệ hiện tại, nhưng sau khi nghiên cứu kỹ lưỡng nguyên lý cấu tạo của nó, hiểu biết của chúng ta về du hành siêu không gian đã sâu sắc hơn rất nhiều.\n\nPhần còn lại là những bức thư tay riêng tư, không có giá trị thực tế gì, nhưng lại vô cùng cảm động. Những bức thư này đều được gửi cho người thân yêu của họ, từng nét bút đong đầy nỗi nhớ nhung, niềm hy vọng và cả những nuối tiếc.\n\nCó vẻ mục đích của Biting là muốn để cho phi hành đoàn của cô có cơ hội cuối cùng liên lạc với thế giới bên ngoài. Nhưng đáng tiếc thay, chúng ta không biết phải gửi những lá thư này đi đâu, vậy nên thà giữ chúng lại, ít ra còn có thể bảo tồn thứ di sản kỳ lạ này của họ. Hoặc chúng ta cũng có thể tiêu hủy chúng, rốt cuộc thì con tàu kỳ dị cùng những lá thư nhuốm màu ma quái này cũng khiến người ta cảm thấy hơi rợn người."
 cstorms.1321.a: "Lưu trữ những bức thư này cho thế hệ sau."
 cstorms.1321.b: "Tiêu hủy những bức thư này."
 project_cosmic_storms_stormbound: "Linh hồn của bão"
 project_cosmic_storms_stormbound_DESC: "Chúng ta dò được con tàu điềm gở kia sẽ xuất hiện trong cơn bão này.\n\nHãy phái một tàu khoa học đi dụ nó ra và tóm lấy nó!"
 ### Chuỗi sự kiện Nhưng Chúng Quá Đáng Yêu!
 cs_but_they_are_cute_chain_title: "Nhưng chúng quá đáng yêu!"
 cs_but_they_are_cute_chain_desc: "Sau khi khảo sát [From.Planet.GetName], chúng ta phát hiện một sinh vật kỳ lạ. Chúng ta nên làm gì bây giờ?"
 but_they_are_cute_category: "Nhưng chúng quá đáng yêu!"
 but_they_are_cute_category_desc: "Sau khi khảo sát [From.Planet.GetName], chúng ta phát hiện một sinh vật kỳ lạ. Mặc dù chúng ta chỉ mới tiếp xúc với chúng một thời gian ngắn, nhưng điều này đã đánh thức bản năng bảo vệ trong ta. Đề nghị tiến hành nghiên cứu sâu hơn."
 cstorms.1500.name: "Nhưng chúng quá đáng yêu!"
 cstorms.1500.desc: "Sinh vật này kể từ khi được phát hiện đã thể hiện một sức hút to lớn, khơi dậy tình yêu thương và khao khát được cho ăn ở chúng ta. Bốn đôi mắt to tròn lồi ra thể hiện sự ngây thơ, thu hút mọi người đến vuốt ve bộ lông mềm như mây của nó. Nó có vẻ rất quấn quýt [Root.GetLeaderName], phần lớn thời gian đều ở trên đùi của [Leader.GetHisHer], tận hưởng sự nuông chiều của [Leader.GetHisHer], không hề thể hiện bất kỳ sự hung hãn hay hành động nguy hiểm nào, như thể nó được thiết kế có chủ đích để mang dáng vẻ vô hại này.\n\nMặc dù vậy, một số người vẫn hoài nghi, cho rằng việc giữ một loài sinh vật chưa từng được phát hiện trên tàu mà không có sự chấp thuận trước là vô trách nhiệm. [Root.GetLeaderName] thì đảm bảo rằng nó rất có thể là an toàn, nhưng cũng đồng ý rằng cần phải tiến hành một cuộc điều tra chính thức."
 cstorms.1500.a: "Điều tra rõ xem nó thực chất là cái gì."
 cstorms.1500.b: "Bác bỏ yêu cầu, tiêu hủy nó."
 cstorms.1500.evopred: "Yêu cầu bị từ chối. Ăn thịt nó."
 project_cosmic_storms_but_they_are_cute: "Kỳ quan sinh học"
 project_cosmic_storms_but_they_are_cute_DESC: "Trên một con tàu khoa học của chúng ta vừa xuất hiện một loài động vật đặc biệt thú vị và cực kỳ đáng yêu. Chúng ta phải tiến hành điều tra trước khi quyết định có giữ nó lại hay không."
 cstorms.1505.name: "Kỳ quan sinh học"
 cstorms.1505.desc: "Chúng ta không cần dùng thuốc mê, cũng không cần cưỡng ép mà vẫn có thể chạm vào và quét lớp da của con vật này, nó tỏ ra vô cùng ngoan ngoãn. Các thuyền viên đã đặt tên cho nó là Gugu dựa trên âm thanh nó phát ra khi được vuốt ve.\n\nChúng ta đã xác nhận Gugu là loài ăn tạp, lông của nó được cấu tạo từ những sợi keratin phổ biến và rất mềm. Nhưng điều thực sự kỳ diệu nằm ở bên trong, nó có thể tái tạo toàn bộ tế bào của mình, bao gồm cả hệ thống thần kinh, chỉ trong vòng một tháng. Điều này có nghĩa là nó có thể mọc lại một cơ thể với đầy đủ chức năng chỉ trong vài ngày.\n\nMột cấu trúc sinh học phức tạp như vậy dường như khó có thể là sản phẩm của tiến hóa tự nhiên. Chúng ta chưa từng thấy một sinh vật nào tương tự trước đây, vì vậy không thể xác định được bản tính của nó. Dù trông có vẻ ngoan ngoãn, nhưng nó có thể tấn công chúng ta bất cứ lúc nào. Mặc dù vậy, kể từ khi nó xuất hiện, [Root.GetLeaderName] dường như có động lực làm việc hơn bao giờ hết.\n\nChúng ta nên xử lý Gugu thế nào đây? Chúng ta có thể giữ nó lại không?"
 cstorms.1505.a: "Miễn là bạn dọn dẹp sạch sẽ."
 cstorms.1505.b: "Tiêu hủy nó đi."
 cstorms.1510.name: "Sinh vật hỗ trợ tinh thần Gugu"
 cstorms.1510.desc: "Sinh vật đáng yêu này đã được cho phép ở lại trên tàu khoa học, và hiện đã được sắp xếp ổn thỏa. Nó đã giúp xoa dịu cảm xúc của [Root.GetLeaderName], khiến cho [Leader.GetHerHim] dù đi đến đâu cũng cảm thấy sảng khoái, tinh thần của phi hành đoàn cũng cao chưa từng thấy.\n\nHy vọng kỳ quan 'tự nhiên' phi thường này sẽ tiếp tục là một người bạn đáng yêu và ngoan ngoãn của tất cả chúng ta. Nó, Gugu, sẽ thuộc về chúng ta, mãi mãi."
 cstorms.1510.a: "Tuyệt vời!"
 cstorms.1515.name: "Kết cục của Gugu"
 cstorms.1515.desc: "Cân nhắc đến việc cơ thể của con vật này quá khác thường và rõ ràng đã bị biến đổi gen, chúng ta không thể giữ nó trên tàu khoa học được. Nó rất có khả năng mang lại ảnh hưởng tiêu cực cho phi hành đoàn, và nói không chừng chủ nhân của nó sẽ đột ngột xuất hiện trong cơn thịnh nộ và đòi chúng ta trả lại. Quyết định được thi hành nhanh chóng và nhân đạo, chỉ trong chớp mắt, tiếng 'gugu' êm ái của nó đã vĩnh viễn biến mất.\n\nQuyết định này tuy có thể thông cảm được, nhưng vẫn vấp phải sự phản đối của [Root.GetLeaderName] và phi hành đoàn. Họ vẫn cần thêm chút thời gian để nguôi ngoai nỗi đau mất đi con vật kỳ lạ đáng yêu này."
 cstorms.1515.a: "Không còn lựa chọn nào khác."
 cstorms.1515.evopred: "Giữ lại một vài mẫu gen đi."
 cstorms.1520.name: "Kết cục của Gugu?"
 cstorms.1520.desc: "Sau khi tiêu hủy con vật đáng yêu này, mọi chuyện vẫn chưa kết thúc, khả năng tái tạo xuất sắc của nó dường như đã vượt quá dự đoán của chúng ta.\n\nChỉ một thời gian ngắn sau khi nó chết, từ mô tế bào tưởng chừng như đã chết hẳn đó lại sinh ra hai sinh vật giống hệt nhau. Ngay cả khi người giết chết cơ thể mẹ của chúng chính là chúng ta, những sinh mệnh mới sinh này cũng không hề tỏ ra bất kỳ sự thù địch nào.\n\nChúng ta quyết định dừng tay tại đây, thay vì mạo hiểm tạo ra cả một đội quân Gugu. [Root.GetLeaderName] và phi hành đoàn cảm thấy vô cùng hạnh phúc vì có thể giữ lại cặp sinh vật này."
 cstorms.1520.a: "Một bài học."
 ### Chuỗi sự kiện Kẻ mạo danh
 cstorms.1550.name: "Kẻ mạo danh"
 cstorms.1550.desc: "Chúng ta vừa tìm thấy một khoang thoát hiểm trôi dạt theo cơn bão tại [From.Planet.GetName]. Dù dữ liệu nhận dạng trông có vẻ giống của chúng ta, nhưng chắc chắn nó không thuộc về chúng ta. Chúng ta đã cẩn thận phản hồi lại yêu cầu liên lạc, và người trong khoang tỏ ra đặc biệt vui mừng.\n\n[event_target:the_imitator.GetHeSheCap] giải thích rằng [event_target:the_imitator.GetHeShe] đã bị cơn bão cuốn đi một thời gian và đang tìm kiếm sự giải cứu, hệ thống duy trì sự sống trên tàu của [event_target:the_imitator.GetHerHis] đã sắp cạn kiệt.\n\nKhi chúng ta yêu cầu xác minh danh tính, kẻ lạ mặt này lại biện minh một cách kỳ lạ rằng mình chính là thuyền viên của chúng ta. Đây rõ ràng là một lời nói dối, vì thuyền viên của chúng ta không thiếu một ai, tất cả đều đang ở trên tàu."
 cstorms.1550.a: "Đừng vòng vo nữa, phá hủy khoang thoát hiểm đi."
 cstorms.1550.b: "Đưa khoang thoát hiểm lên tàu."
 cstorms.1555.name: "Kẻ mạo danh"
 cstorms.1555.desc: "Chúng ta đã đưa khoang thoát hiểm lên tàu. Khi mở niêm phong khoang, sự thật đã được phơi bày, người ngoài hành tinh bên trong ngay lập tức phát ra một lời cầu xin tuyệt vọng.\n\nHóa ra người ngoài hành tinh này đã bị mắc kẹt trong khoang khi đang tiến hành kiểm tra định kỳ khoang thoát hiểm trên tàu mẹ của mình, và khoang thoát hiểm đã bị phóng ra ngoài không gian. Vô cùng xui xẻo là không có ai trên tàu phát hiện ra sự biến mất của [event_target:the_imitator.GetHeShe].\n\nSau vài tháng bị mắc kẹt, cuối cùng [event_target:the_imitator.GetHeShe] cũng sử dụng một vài vật dụng nhỏ bé tìm thấy trong khoang thoát hiểm để phát đi một loại tín hiệu mồi nhử cho những con tàu đi ngang qua. Tuy nhiên, điều này cũng không thu hút được bất kỳ sự trợ giúp nào. Tồi tệ hơn, một cơn bão không gian đã cuốn lấy khoang thoát hiểm và đẩy nó đến một nơi cách xa hệ sao mẹ hàng năm ánh sáng. Bị thôi thúc bởi sự cô đơn và nỗi sợ hãi, [event_target:the_imitator.GetHeShe] đã nghĩ ra một kế hoạch, đó là giả vờ làm thuyền viên mất tích của bất kỳ con tàu nào tình cờ đi ngang qua. Kẻ sống sót trong khoang thoát hiểm đã xin lỗi vì đã lừa dối chúng ta, nhưng [event_target:the_imitator.GetHeShe] rất biết ơn vì mình đã sống sót."
 cstorms.1555.a: "Chúng ta có lẽ sẽ cần đến một bộ óc linh hoạt như vậy."
 cstorms.1555.b: "Cung cấp phương tiện di chuyển đưa đến hành tinh có người ở gần đó."
 cstorms.1555.c: "Bỏ hắn lại. Mang khoang thoát hiểm đi."
 the_imitator_category_desc: "Trong một cuộc khảo sát gần đây, chúng ta đã phát hiện một khoang thoát hiểm đơn độc. Điều kỳ lạ là, khoang thoát hiểm này lại dùng chính dữ liệu nhận dạng của chúng ta để gửi lời chào. Khoang thoát hiểm này dường như bị cuốn đến đây bởi một cơn bão không gian quét qua hệ sao này gần đây. Đề nghị tiến hành điều tra sâu hơn."
 #Kẻ mạo danh Leader
 the_imitator_category: "Kẻ mạo danh"
 the_imitator_catch_phrase: "Tôi rất vui khi được ở đây!"
 the_imitator_leader_desc: "Sau khi bị cuốn trôi theo cơn bão không gian, tên thiên tài ranh ma nhưng lập dị này lại biết cách lật ngược thế cờ, và thường là theo hướng có lợi."
 ###########################################
 # Điểm khảo cổ #
 ###########################################
 ### Bầu trời Xanh lục
 site_green_skies: "Bầu trời Xanh lục"
 site_green_skies_intro: "Máy quét của chúng ta phát hiện một khu vực trên hành tinh liên tục phát ra những tín hiệu khá thú vị. Qua phân tích, rất có khả năng đó là di tích của một nền văn minh cổ đại đang chờ chúng ta khám phá."
 cstorms.1400.name: "Phong cách pha trộn kỳ lạ"
 cstorms.1400.desc: "Gần căn cứ của chúng ta vừa xuất hiện một khu di tích thành phố kỳ lạ.\n\nNhững công trình kiến trúc này mang đặc điểm của mọi nền văn minh mà chúng ta từng bắt gặp cho đến nay — bao gồm cả chúng ta!\n\nTuy nhiên, vật liệu cấu tạo nên những công trình này lại giống với vật liệu chúng ta sử dụng để xây dựng căn cứ trong quá trình thuộc địa hóa hành tinh. Điều này thật kỳ lạ, bởi loại vật liệu này của chúng ta không thể nào tồn tại qua hàng thập kỷ, chứ đừng nói đến khoảng thời gian mà các bản quét xác định tuổi thọ của tàn tích này.\n\nNhững di tích này khó có khả năng thuộc về một Tiền bối bí ẩn nào đó, nhưng kết quả quét lại mâu thuẫn với điều này. Rốt cuộc bí ẩn ẩn giấu ở đây là gì?"
 cstorms.1405.name: "Giông bão cận kề"
 cstorms.1405.desc: "Chúng ta đã lần theo tín hiệu tiến vào tầng ngầm của thành phố đổ nát. Thông thường, các địa điểm khảo cổ loại này sẽ có một mạng lưới giao thông ngầm kết nối với nhau, hoặc có một loạt các hầm trú ẩn. Tuy nhiên, chúng ta lại tìm thấy một hang động nhỏ rải rác những mảnh vải vụn, các hộp chứa bằng polymer, và thậm chí cả chất thải hữu cơ. Có vẻ như chúng ta không phải là những người đầu tiên khám phá nơi này.\n\nĐáng lo ngại hơn, [Root.GetLeaderName] báo cho chúng ta biết bầu trời bên ngoài đang chuyển sang màu xanh lục, một cơn bão không gian sắp hình thành trên [Fromfrom.getName]. Dù vậy, chúng ta vẫn tiếp tục tiến về phía nguồn phát tín hiệu."
 cstorms.1410.name: "Một bước đi sai lầm"
 cstorms.1410.desc: "Chúng ta tạm thời bị chặn lại bởi một cánh cửa kim loại hư hỏng nặng, nhưng cũng chẳng tốn mấy sức lực để mở ra lối đi, đằng sau cánh cửa là một nhà kho tồi tàn.\n\nTrên các kệ của nhà kho chất đầy những thiết bị công nghệ cao bỏ đi, còn sát tường là những chiếc rương được xếp cẩn thận mang logo của một vài tập đoàn nổi tiếng. Cuối cùng, chúng ta cũng đã tìm thấy nguồn phát tín hiệu bấy lâu nay: một máy phát đáp tương tự như thiết bị của chính chúng ta.\n\nSau khi đăng nhập vào thiết bị và kiểm tra cơ sở dữ liệu của nó, các [Root.Owner.GetEngineerPlural] của chúng ta đã đi đến một kết luận táo bạo: tín hiệu này được cố tình thiết kế sao cho càng bí ẩn và hấp dẫn càng tốt — nó bắt chước và kết hợp đặc điểm của các nền văn minh khác.\n\nHơn nữa, trong các rương chứa, chúng ta còn tìm thấy các mô-đun xây dựng được sử dụng cho đống đổ nát trên mặt đất.\n\nThế là chúng ta liên lạc với căn cứ, bắt đầu báo cáo những phát hiện hiện tại, nhưng cơn bão không gian đã bắt đầu gây nhiễu hệ thống liên lạc của chúng ta. Thông điệp cuối cùng chúng ta nhận được từ [Root.GetLeaderName] thật sự đáng lo ngại, có vẻ như trại trên mặt đất đang bị tấn công!"
 cstorms.1410.a: "Chuẩn bị sẵn sàng!"
 cstorms.1415.name: "Hải tặc tấn công!"
 cstorms.1415.desc: "Một hạm đội hải tặc đang ẩn nấp trong cơn bão không gian của [Fromfrom.getName]! Chính chúng là kẻ đã tấn công căn cứ của chúng ta. Lũ hải tặc này đã gửi cho chúng ta một thông điệp:\n\n§LGửi những kẻ ngốc nghếch thân mến:\n\nCảm ơn các người đã ghé thăm khu đồn trú bí mật của chúng ta.\n\nNhìn những sinh vật có vẻ thông minh như các người vừa ngửi thấy chút hơi hướm của các cổ vật hay di vật bẩn thỉu đã lập tức vứt bỏ mọi lý trí, thật khiến người ta phải cảm thán. Có lẽ các người đang mong tìm được một phương tiện để tiêu diệt những kẻ thù hùng mạnh? Xây dựng vô vàn hạm đội tiến thẳng đến chân trời sự kiện? Hay chỉ đơn giản là muốn mang lại một cuộc sống tốt đẹp cho người dân của mình? Thật là một suy nghĩ sáo rỗng làm sao.\n\nXin đừng buồn — trước các người cũng đã có rất nhiều kẻ từng đến đây, và mô hình kinh doanh của chúng ta phụ thuộc chính vào những kẻ sẽ đi theo vết xe đổ của các người.\n\nBây giờ, chỉ với 2000 điểm năng lượng, chúng ta sẽ trả lại những gì đã cướp được cho các người.\n\nNếu từ chối lời đề nghị của chúng ta, ai mà biết được chuyện tồi tệ gì sẽ xảy ra chứ, nói không chừng sẽ mang lại một cơn ác mộng nào đó cho [Leader.getHerHim] và phi hành đoàn trang bị nghèo nàn của [Leader.getHisHer], những kẻ vẫn đang mắc kẹt trên hành tinh này.\n\nHãy đưa ra một sự lựa chọn khôn ngoan.§!\n\nTrốn trong hang tạm thời vẫn an toàn, nhưng chúng ta không biết sẽ an toàn được bao lâu. Chúng ta có nên đáp ứng yêu cầu của bọn thổ phỉ này không?"
 cstorms.1415.a: "Chúng ta sẵn sàng trả tiền."
 cstorms.1415.b: "Cứ mục nát ở chốn hủy diệt đi!"
 cstorms.1415.b.tt: "[Root.GetLeaderName] đã bị bắt làm con tin."
 cstorms.1416.name: "Phản công"
 cstorms.1416.desc: "Chúng ta nhận được một thông điệp mới:\n\n§LĐáng tiếc thật, chúng ta vốn có thể dùng số tiền này để làm rất nhiều chuyện thú vị.\n\nChúng ta sẽ chuyển lời tới vị thủ lĩnh này cùng đội ngũ của [Leader.getHisHer], cứ nói rằng mạng của họ không đáng một xu. Có lẽ mấy tên buôn nô lệ gần đây hay một chiến binh đồng hóa nào đó sẽ có hứng thú. Chúng ta nghe nói cắt xén tinh thần đang là mốt mới hiện nay.\n\nTừ biệt tại đây.§!\n\nChúng ta đã dùng mọi thứ có trong tay để dựng lên các chướng ngại vật, vật tư xung quanh cũng đủ để chúng ta cầm cự một thời gian. Nhưng chắc chắn lũ hải tặc sẽ sớm chọc thủng được tuyến phòng ngự của chúng ta!"
 cstorms.1420.name: "Không sai hai lần"
 cstorms.1420.desc: "Công nghệ của lũ hải tặc này hoàn toàn không đủ sức chống đỡ cho những lời ngông cuồng của chúng. Không lâu sau, hạm đội của chúng đã trở thành một phần của hệ sinh thái trong hệ sao này.\n\nChúng ta nhanh chóng thiết lập lại liên lạc với phi hành đoàn trên mặt đất. Họ đã bị một phen khiếp vía, nhưng không ai bị thương.\n\nMặc dù không tìm thấy bất kỳ hiểu biết nào về nền văn minh cổ đại ở đây, nhưng trải nghiệm này đã dạy cho chúng ta một bài học về sự cảnh giác. Chỉ huy đội thám hiểm đã thất bại trong việc nhận ra mối nguy hiểm ngay trước mắt — chúng ta không thể phạm cùng một sai lầm như thế này trong tương lai."
 cstorms.1420.a: "Rút ra bài học."
 cstorms.1420.b: "Nhà lãnh đạo này sẽ không làm chúng ta thất vọng nữa."
 cstorms.1425.name: "Hợp tác vui vẻ"
 cstorms.1425.desc: "Chúng ta đã nhận được thông báo phản hồi:\n\n§LNếu được phép, tôi muốn gọi đây là một sự lựa chọn khôn ngoan!\n\nXin thông báo, khoản tài trợ của các người dành cho những 'doanh nhân yếu thế đang khao khát một hành tinh nghỉ dưỡng' đã được nhận thành công.\n\nRất nhanh thôi các người sẽ gặp lại thủ lĩnh và những thuyền viên được tặng kèm của mình.\n\nNgoài ra, các người có thể giới thiệu chúng ta cho tất cả các đối tác thương mại của mình.§!\n\nKhông lâu sau, chúng ta đã thiết lập lại liên lạc với phi hành đoàn trên mặt đất. Họ nói rằng mình đã bị một phen khiếp vía, nhưng không ai bị thương.\n\nMặc dù không tìm thấy bất kỳ hiểu biết nào về nền văn minh cổ đại ở đây, nhưng trải nghiệm này đã dạy cho chúng ta một bài học về sự cảnh giác. Chỉ huy đội thám hiểm đã thất bại trong việc nhận ra mối nguy hiểm ngay trước mắt — chúng ta không thể phạm cùng một sai lầm như thế này trong tương lai."
 cstorms.1425.a: "$cstorms.1420.a$"
 cstorms.1425.b: "$cstorms.1420.b$"
 NAME_green_skies_pirate_country: "Khu nghỉ dưỡng"
 NAME_green_skies_pirate_fleet: "Doanh nhân lập dị"
 KILL_EXILED_LEADER_EFFECT: "$LEADER$ đã chết vì sự kém cỏi của mình."
 FREE_HOSTAGED_LEADER_EFFECT: "$LEADER$ đã trở lại."
 green_skies_outcome_modifier: "Bây giờ chúng ta đã cảnh giác hơn với những rủi ro tiềm ẩn này."
 requires_cosmic_storms: "$dlc_requirement_string$ §ICosmic Storms§!"
 ### Giữ Vững Trận Tuyến
 site_hold_the_line: "Giữ Vững Trận Tuyến"
 site_hold_the_line_intro: "Cơn bão không gian quét qua đã để lại một món quà kỳ lạ: một khu liên hợp quỹ đạo thuộc về hệ thống trạm cư trú đã cũ. Nếu đổ bộ lên đó, rất có thể chúng ta sẽ kích hoạt được nó."
 cstorms.1275.name: "Bí ẩn mới"
 cstorms.1275.desc: "Mặc dù khu liên hợp quỹ đạo này đã bị cơn bão không gian kéo lê băng qua các hệ sao, nhưng có vẻ nó không bị hư hại nhiều. Chúng ta phát hiện ra các khu dân cư và không gian thương mại bên trong trạm cư trú gần như vẫn còn nguyên vẹn. Những khu vực này sạch bong không một hạt bụi, cứ như thể chưa từng có ai sử dụng qua.\n\nChào đón chúng ta trong phòng điều khiển trung tâm là một hệ thống đầu vào gây hoa mắt chóng mặt: đủ các loại mặt đồng hồ không hề có hướng dẫn, các cần gạt được thiết lập khác nhau, cùng vô số nút bấm nhấp nháy đủ màu sắc theo những khoảng thời gian có vẻ là ngẫu nhiên. May mắn thay, cuối cùng chúng ta cũng tìm được một cuốn sổ tay. Tin rằng chỉ cần dịch thành công, chúng ta có thể kích hoạt lại trạm cư trú này."
 cstorms.1280.name: "Ghi đè thủ công"
 cstorms.1280.desc: "Đáng tiếc thay, đánh giá trước đó của chúng ta đã quá lạc quan: cuốn sổ tay được dịch ra cũng khó hiểu y như hệ thống điều khiển này. Không chỉ thiếu mất một nửa số trang, hình ảnh minh họa còn chứa vô số các thiết lập ký hiệu học, và nửa còn lại của cuốn sổ thì lại được viết bằng một loại chữ tượng hình không thể giải mã nổi.\n\nTuy nhiên, trang cuối cùng lại hiển thị một tần số liên lạc kèm theo một chuỗi ký tự có thể dịch là 'bàn trợ giúp'. Bây giờ chúng ta đang thử kết nối với tần số này."
 cstorms.1285.name: "Cuộc gọi của bạn rất quan trọng với chúng tôi"
 cstorms.1285.desc: "Kênh liên lạc trong cuốn sổ tay đã kết nối đến máy chủ trung tâm của một thực thể thương mại có tên là 'Vườn Treo Trên Không'.\n\nMột trí tuệ nhân tạo dùng giọng điệu thân thiện và trung lập nói với chúng ta rằng, nó rất cảm ơn vì chúng ta đã liên hệ, đồng thời hỏi xem nó có thể giúp được gì không. Các tùy chọn được liệt kê bao gồm 'trả lời các câu hỏi về đăng ký', 'tìm hiểu về hệ thống phòng thủ thông minh mới', và liệu chúng ta có muốn biết thêm về 'Sáng kiến Trách nhiệm Xã hội' của công ty hay không.\n\nTuy nhiên, các tùy chọn tiếp theo lại dẫn chúng ta đến những chủ đề ngày càng lạc quẻ. Tồi tệ hơn, nó còn thường xuyên bắt các [Root.Owner.GetEngineerPlural] của chúng ta phải chờ, sau đó thì tự động ngắt kết nối. Rõ ràng, dịch vụ trí tuệ nhân tạo này đã không chịu được thử thách của thời gian như các bộ phận khác của trạm cư trú.\n\nDù sao đi nữa, chúng ta sẽ tiếp tục thử giải quyết hệ thống bí ẩn này theo cách riêng của mình."
 cstorms.1290.name: "Mê cung tùy chọn"
 cstorms.1290.desc: "Các [Root.Owner.GetEngineerPlural] của chúng ta báo cáo rằng, dù họ có nói gì với trí tuệ nhân tạo này đi nữa, sau vài phút chờ đợi, hệ thống này sẽ chỉ lặp lại nội dung trước đó.\n\nChúng ta đã thử chạy nhiều mô phỏng để vẽ ra một cây thư mục chính xác, nhưng lại gặp phải lỗi đệ quy, và không thể đồng thời vừa giải quyết vừa kiểm tra các giải pháp. Ngay cả khi chạy mô hình lượng tử cũng không thu được kết quả mong đợi. Chúng ta nghi ngờ rằng trong quá trình này mình đã vô tình phá vỡ một vài hàm sóng nào đó.\n\nChúng ta đang không biết phải làm sao."
 cstorms.1290.a: "Nói với AI này rằng §R[từ cấm]§! của nó đã bị §R[từ cấm]§!."
 cstorms.1290.b: "Giữ im lặng trên kênh liên lạc."
 cstorms.1290.c: "Đập loạn xạ vào các nút."
 cstorms.1295.name: "Tuân theo giao thức"
 cstorms.1295.desc.a: "Cuối cùng cũng có tiến triển! AI này đã cảnh báo chúng ta về việc sử dụng ngôn từ không phù hợp, và thông báo rằng chúng ta nên đợi đại diện dịch vụ khách hàng liên hệ.\n\n$cstorms.1295.desc.followup$"
 cstorms.1295.desc.b: "Cuối cùng cũng có tiến triển! AI này rõ ràng đang cảm thấy bối rối trước sự im lặng kéo dài của chúng ta, và sẽ chuyển máy cho đại diện dịch vụ khách hàng.\n\n$cstorms.1295.desc.followup$"
 cstorms.1295.desc.c: "Cuối cùng cũng có tiến triển! AI này đã cảnh báo rằng chúng ta đang lạm dụng bảng điều khiển, và thông báo rằng chúng ta nên đợi đại diện dịch vụ khách hàng liên hệ.\n\n$cstorms.1295.desc.followup$"
 cstorms.1295.desc.followup: "Chúng ta chờ một lúc thì kênh liên lạc lại mở. Thực thể ở đầu bên kia giới thiệu cô ấy là quản trị viên lưu trữ của công ty Vườn Treo Trên Không. Bản thân bàn dịch vụ là một chương trình trí tuệ nhân tạo mà cô ấy được thừa kế từ quản trị viên lưu trữ đời trước. Theo những gì cô biết, kể từ khi Vườn Treo Trên Không phá sản cách đây vài chục năm, trạm liên lạc này chưa từng được sử dụng lại. Khi chúng ta hỏi tại sao cô vẫn tiếp tục làm việc cho một tổ chức đã phá sản, cô chỉ nói đó là nội dung hợp đồng của cô.\n\nSau khi giải thích tình huống của chúng ta cho người quản trị hồ sơ, cô ấy đã lục ra được một cuốn hướng dẫn khởi động nhanh trạm cư trú từ thời cổ đại. Cô ấy sẽ sớm gửi bản kỹ thuật số của các trang sách cho chúng ta."
 cstorms.1300.name: "Chút nữa là hỏng việc"
 cstorms.1300.desc: "Có cuốn hướng dẫn mới, việc khởi động lại trạm cư trú chẳng tốn chút công sức nào.\n\nSau khi âm thanh khởi động của máy móc dần lắng xuống, chúng ta quyết định một lần nữa bày tỏ lòng biết ơn tới người quản trị viên.\n\nCô ấy nói rằng đã tìm thấy một số thông tin tại trạm liên lạc này, rõ ràng, đây là một nguyên mẫu được chế tạo từ hơn năm thế kỷ trước, nhưng sau một cơn bão không gian đặc biệt tồi tệ, nó đã bị thất lạc trong không gian hỗn loạn. Thiệt hại tài sản và chi phí phát triển đổ sông đổ biển đã đủ để khiến Vườn Treo Trên Không phải phá sản.\n\nGiúp đỡ chúng ta là công việc có ý nghĩa đầu tiên của người quản trị viên này trong nhiều năm qua.\n\n'Hơn nữa,' cô nói. 'Tôi cũng rất vui vì được nghe lại giọng nói của bà cố mình, dù đó chỉ là một trí tuệ nhân tạo.'"
 ### Khu Phức Hợp Phục Hồi Năng Lượng
 site_repowered_complex: "Khu Phức Hợp Phục Hồi Năng Lượng"
 site_repowered_complex_intro: "Ngay sau khi §Y$electric_storm$§! quét qua, một đợt bùng phát năng lượng khó hiểu đã được phát hiện bên dưới bề mặt của §H[From.Planet.GetName]§!. Quét sâu hơn đã phát hiện ra một khu phức hợp ngầm cổ đại, máy phát điện bên trong đã được cơn bão khởi động lại, khiến cơ sở này lại bắt đầu hoạt động."
 cstorms.1845.name: "Phòng ngự kiên cố"
 cstorms.1845.desc: "Lối vào cơ sở bị bỏ hoang trên §H[From.Planet.GetName]§! được xây dựng cực kỳ kiên cố. Rõ ràng là nó được thiết kế để có độ bền bỉ rất cao, bên ngoài được bọc bằng một lớp giáp dày, khiên chống bức xạ và một hệ thống cảm biến thời tiết. §H[Leader.GetName]§! tin rằng nó được dùng để chống lại các điều kiện thời tiết cực đoan.\n\nCác bản quét chỉ ra rằng, sau khi vượt qua vài cánh cửa an ninh được niêm phong kín, ta sẽ đến được một khoang ngầm khổng lồ."
 cstorms.1850.name: "Hầm trú ẩn sinh tồn"
 cstorms.1850.desc: "Sau khi tiến vào khoang chính, §H[Leader.GetName]§! đi đến kết luận rằng, chúng ta đã phát hiện ra một hầm trú ẩn sinh tồn chưa từng được sử dụng, được xây dựng từ rất lâu trước đây cho một loài sinh vật hữu cơ vô danh nào đó.\n\nNó được trang bị các khu vực sinh hoạt với dự trữ dồi dào, bao gồm các khoang ngủ, khu giải trí và buồng y tế. Trong tủ khóa của mỗi tầng đều có một lượng lớn các gói dinh dưỡng, pin và dụng cụ chưa từng được mở. Mọi thứ trong hang động ẩn giấu này đều trong tình trạng hoàn toàn nguyên vẹn.\n\nCánh cửa an ninh cuối cùng vẫn còn đang bị niêm phong, chúng ta tin rằng mở nó ra sẽ dẫn đến phòng chỉ huy của căn cứ."
 cstorms.1850.a: "Tiếp tục tiến vào."
 cstorms.1855.name: "Gói hầm trú ẩn hạng sang"
 cstorms.1855.desc: "Bảng điều khiển chỉ huy của khoang này có một hệ thống màn hình hiển thị §Y$default_storm$§! vô cùng ấn tượng, tất cả đều được kết nối với hệ thống cảm biến thời tiết bên ngoài. Sau khi chạy ở chế độ chờ, các bảng điều khiển này đã lưu trữ dữ liệu thời tiết của các cơn bão trong lịch sử suốt nhiều thế kỷ, điều này sẽ thúc đẩy đáng kể sự hiểu biết của chúng ta về khí tượng liên sao.\n\n§H[Leader.GetName]§! cũng tìm thấy một máy chiếu ba chiều nhỏ gọn và tinh xảo. Khi được kích hoạt, nó sẽ phóng ra mô hình 3D của một sinh vật thân mềm, chạy ngang qua các cột mốc của hầm trú ẩn mang logo của công ty, đồng thời thực hiện một bài thuyết trình bán hàng.\n\nKhông rõ liệu sản phẩm còn sót lại này có tìm được người mua hay không, nhưng rõ ràng nó đã bị bỏ không ở đây rất nhiều năm."
 cstorms.1855.desc.megacorp: "Bộ phận tiếp thị của chúng ta đang phân tích xem lỗi ở đâu."
 ###############################
 #### Những Kẻ Thao Túng Thời Tiết #
 ###############################
 STORMS_PREC_WM_ONE: "Hầm trú ẩn cổ đại"
 STORMS_PREC_WM_ONE_DESC: "Chúng ta đã phân biệt được một số cấu trúc ẩn giấu dưới lòng đất của [From.Planet.GetName], dường như có lịch sử rất lâu đời. Nên nhân cơ hội này để tiến hành điều tra."
 cstorms.105.name: "Hầm trú ẩn cổ đại"
 cstorms.105.desc: "Hành tinh [From.Planet.GetName] trong hệ sao [From.GetStarName] là một hành tinh tàn tạ, rõ ràng là di tích của một đế chế nào đó đã biến mất trong dòng lịch sử. Những cấu trúc ngầm thu hút sự chú ý của chúng ta có độ tuổi gần như tương đương, và tương đối nguyên vẹn.\n\nHình ảnh cộng hưởng dội âm cho thấy một cấu trúc ngầm phức tạp, bao gồm các phòng lưu trữ và hầm trú ẩn, được thiết kế để chống lại sức mạnh của tự nhiên. Sự tàn phá trên bề mặt hành tinh chắc chắn là kiệt tác của một cơn bão không gian, điều này cũng lý giải cho sự tồn tại của hầm trú ẩn này.\n\nTuy nhiên, một lượng lớn mảnh vỡ khiến chúng ta khó có thể điều tra thêm. Tiến hành khai quật khảo cổ mới có thể giúp chúng ta thu được những kết quả khả quan hơn."
 #arcsite Hầm trú ẩn cổ đại
 site_weathermanipulators_the_ancient_storm_shelters: "Hầm trú ẩn cổ đại"
 site_weathermanipulators_the_ancient_storm_shelters_intro: "Một hầm trú ẩn bị chôn vùi dưới đống đổ nát trên một hành tinh đã bị bão tàn phá: sự tàn phá bên ngoài khiến nó khó có thể điều tra, nhưng bên trong dường như vẫn còn nguyên vẹn."
 cstorms.110.name: "Đón nhận sự hủy diệt trong cơn bão"
 cstorms.110.desc: "Khi tiếp cận hầm trú ẩn từ mặt đất, chúng ta phát hiện một khe hở nhỏ nằm dưới hai tòa tháp đã sụp đổ, phát ra ánh sáng yếu ớt, qua khe hở có thể thấy một số máy móc vẫn đang hoạt động.\n\nCác [Root.Owner.GetScientistPlural] của chúng ta dùng khe hở này làm mốc cơ sở để xác định kích thước của toàn bộ khu phức hợp, và cố gắng tìm cách mở nó ra mà không làm hỏng cấu trúc vốn đã mỏng manh của nó.\n\nKhu tàn tích bị chôn vùi này mang đầy dấu vết đặc trưng của sự tàn phá từ bão không gian. Kỳ lạ thay, không có dấu hiệu nào cho thấy cư dân của thành phố này đã tiến hành tự vệ.\n\nDường như họ đã chịu đựng sự tàn phá của cơn bão càng lâu càng tốt, sau đó vội vã sơ tán. Có lẽ câu trả lời thực sự đang nằm sâu dưới lòng đất [From.Planet.GetName]."
 cstorms.110.a: "Đã rõ."
 cstorms.115.name: "Bên dưới tòa tháp đôi"
 cstorms.115.desc: "Sau khi dọn dẹp nhiều lớp mảnh vỡ và bụi bẩn, cuối cùng các [Root.Owner.GetScientistPlural] của chúng ta cũng khoét đủ rộng khe hở dưới tòa tháp để có thể tiến vào hầm trú ẩn.\n\nHầm trú ẩn này khá đơn giản và thực dụng, có nhiều phòng phụ, nhưng hầu hết đều trống rỗng. Thật ra, dù trông tồi tàn nhưng nó thực sự là một dạng hầm trú ẩn, thế nhưng lại không có khả năng chống chọi với bão không gian. Những bức tường quá mỏng, hầu như không có gì chống đỡ, trần và sàn cũng không được gia cố. Việc hầm trú ẩn này có thể tồn tại được hoàn toàn là do may mắn. Nếu không nhờ hai tòa tháp bên trên và trận lở đất khiến toàn bộ khu phức hợp bị dịch chuyển, thì cái hầm trú ẩn 'tránh bão' này đã bị tiêu diệt từ lâu rồi.\n\nÁnh sáng yếu ớt mà chúng ta nhìn thấy từ bên ngoài phát ra từ một vài hệ thống báo động bị hỏng, và sâu trong hầm trú ẩn vẫn có thể thấy vài thiết bị đầu cuối đang hoạt động. Đây có lẽ là cơ hội tuyệt vời để tìm hiểu về những cư dân trước đây của cơ sở này cũng như những dị thường liên quan."
 cstorms.120.name: "Tài liệu cũ nát"
 cstorms.120.desc: "Việc tiếp cận các thiết bị đầu cuối khó khăn hơn chúng ta tưởng do một phần bị đất đá sạt lở cản đường. Một vài mảng đá vụn mới rơi xuống, báo hiệu hầm trú ẩn đã xuất hiện vấn đề cấu trúc nghiêm trọng sau khi bị xáo trộn. Cần tiến hành cực kỳ cẩn thận.\n\nThật không may, những dữ liệu cổ đại này rất khó để giải mã. Mọi ghi chép đều được viết bằng một ngôn ngữ hiện đã thất truyền, nhưng các nhật ký liên lạc liên sao còn lưu trên giao diện có thể sẽ giúp ích. Bằng cách kết hợp các nhật ký này với những phương tiện lưu trữ vật lý bị bỏ lại vung vãi quanh hầm trú ẩn, chúng ta sẽ có thể hoàn thành việc dịch thuật cơ bản. Hơn nữa, miễn là hầm trú ẩn không sụp đổ, vẫn còn nhiều căn phòng nữa để khám phá."
 cstorms.120.a: "Thận trọng tiến tới."
 cstorms.120.b: "Chúng ta có thể đẩy nhanh tiến độ một chút."
 cstorms.120.c: "Bất chấp tất cả đẩy nhanh tiến độ."
 cstorms.125.name: "Bảo hiểm tài sản"
 cstorms.125.desc: "Các căn phòng nằm sâu bên dưới không hoang tàn như lối vào. Hàng thùng hàng hóa được đóng gói cẩn thận, xếp chồng chất lên nhau từ dưới lên trên. Bản dịch sơ bộ cho thấy đây là nguyên liệu thô và linh kiện điện tử chưa hoàn thiện, cả hai đều không phải là nhu yếu phẩm để sinh tồn. Danh sách này còn liệt kê chi tiết số lượng hàng hóa được cất giữ ở đây, cũng như lợi nhuận mà chúng dự kiến tạo ra trong Mạng lưới Thương mại Bình đẳng Thiên hà (gọi tắt là INET).\n\nHọ không tiếc lời ca ngợi sàn giao dịch khổng lồ này, lưu giữ tỉ mỉ hồ sơ giao dịch và các chỉ số lợi nhuận từng mục. Sự thật là, nền văn minh đã biến mất này dường như được đặt tên theo chính sàn giao dịch này, tự xưng là Tập đoàn Inetian.\n\nHầm trú ẩn này không phải được xây dựng để bảo vệ người dân bình thường, mà là một kho chứa hàng hóa được tô vẽ lên. Điều này đặt ra một câu hỏi, tại sao trang thiết bị cho hầm trú ẩn của họ lại tồi tệ đến mức không thể đối phó với cơn bão?\n\nViệc dịch thuật sâu hơn sẽ đem lại nhiều hiểu biết mới, nhưng thời gian của chúng ta có hạn, và các cấu trúc đang phát ra những tiếng rạn nứt đáng lo ngại."
 cstorms.125.a: "Cẩn thận khi ở dưới đó."
 cstorms.125.b: "Ưu tiên thu thập dữ liệu."
 cstorms.125.c: "Chúng ta có thể hỗ trợ điều tra."
 cstorms.130.name: "Chiến lược thị trường"
 cstorms.130.desc: "Âm thanh xé toạc và sụp đổ ngày càng trở nên dữ dội hơn. Dù vậy, bên trong hầm trú ẩn của [From.Planet.GetName], công việc dịch thuật vẫn đang được tiến hành. Dù việc khảo sát hàng hóa tồn kho không đem lại kết quả gì, nhưng các thiết bị đầu cuối vẫn còn hoạt động đã tiết lộ rất nhiều thông tin.\n\nMột chuỗi tọa độ lộn xộn chỉ đến vị trí của một thiết bị 'quyền năng' nằm trên một hành tinh lân cận. Theo như chúng ta biết, thiết bị này có khả năng 'thao túng' bão không gian, nếu điều này là sự thật thì quả là không thể tin nổi.\n\nTuy nhiên, do độ ổn định của hầm trú ẩn ngày càng kém, và bản sao của tọa độ đã được truyền về con tàu trên quỹ đạo, nên chúng ta quyết định sơ tán khỏi hiện trường. Vẫn còn nhiều câu hỏi chưa có lời giải đáp, nhưng quá trình tìm kiếm vẫn sẽ tiếp tục."
 cstorms.130.a: "Đây là cơ hội không thể bỏ lỡ."
 #Dự án đặc biệt Giải mã tọa độ
 INETIAN_PROJECTS_01: "Giải mã tọa độ"
 INETIAN_PROJECTS_01_DESC: "Ngay trước khi hầm trú ẩn trên [wm_storm_shelter_planet.GetName] sụp đổ, chúng ta đã phát hiện một chuỗi tọa độ bị nhiễu sóng. Có lý do để tin rằng một trong những tọa độ đó chỉ đến vị trí của cỗ máy mà Tập đoàn Inetian dùng để thao túng các cơn bão không gian. Đây thực sự là một công nghệ rất đáng để tìm kiếm."
 #Dự án đặc biệt hoàn thành
 cstorms.135.name: "Hệ sao trù phú"
 cstorms.135.desc: "Các [Root.Owner.GetScientistPlural] của chúng ta đã may mắn phục hồi được một bộ tọa độ bị nhiễu sóng từ hầm trú ẩn sụp đổ trên [wm_storm_shelter_planet.GetName]. Dữ liệu đã được sửa chữa, và cho ra ba vị trí có thể để chúng ta khám phá:\n\n[wm_digsite_A.GetName], [wm_digsite_B.GetName] và [wm_digsite_C.GetName]. Phân tích thêm cho thấy mỗi hành tinh đều đóng một vai trò quan trọng trong Mạng lưới Thương mại Inetian, quan trọng đến mức xứng đáng được ghi chép lại trong hầm trú ẩn trên [wm_storm_shelter_planet.GetName]."
 #Chuỗi sự kiện Tiền bối
 cs_inetian_chain_title: "Tiền bối - Tập đoàn Inetian"
 cs_inetian_chain_desc: "Chúng ta đã tìm thấy tàn tích của một hầm trú ẩn cổ đại, thuộc về một nền văn minh thịnh vượng cách đây hàng triệu năm nhưng lại không hề tồn tại trong bất kỳ hồ sơ nào của chúng ta, như thể nó đã bị xóa sổ một cách tỉ mỉ khỏi lịch sử. Nếu tiến hành điều tra, có lẽ sẽ hiểu được nguyên do trong đó."
 #Arcsite Tọa độ A
 site_weathermanipulators_CoordinatesA_Residential_Planet: "Tọa độ A: Hành tinh thuộc địa"
 site_weathermanipulators_CoordinatesA_Residential_Planet_intro: "Một trong ba tọa độ được tìm thấy tại hầm trú ẩn chống bão cổ đại đã dẫn tôi đến [From.Planet.GetName]. Những đống đổ nát trên bề mặt trải dài vô tận, rõ ràng hành tinh này từng sở hữu nhiều trung tâm đô thị khổng lồ. Đây rất có thể là nơi sinh sống của công dân Tập đoàn Inetian từ hàng triệu năm trước. Việc tại sao những tọa độ này lại được lưu trữ an toàn trong một hầm trú ẩn chống bão vẫn cần được điều tra thêm."
 cstorms.140.name: "Ý đồ tôn giáo"
 cstorms.140.desc: "Chín phần mười số đô thị trên [From.Planet.GetName] đã bị phá hủy. Phần lớn các công trình kiến trúc khổng lồ từng là biểu tượng không chỉ bị thời gian ăn mòn mà còn bị tàn phá bởi bão. Đặc điểm của những công trình kiến trúc còn sót lại đều trùng khớp với những gì được nhìn thấy trên [wm_storm_shelter_planet.GetName], điều này có nghĩa là, dù có nhiều bằng chứng cho thấy bão đã càn quét nơi đây, nhưng lại thiếu hẳn các biện pháp chuẩn bị phòng chống thiên tai. Sự tàn phá hoàn toàn khiến chúng ta khó có thể tìm thấy bất kỳ thứ gì hữu ích, nhưng hy vọng chưa hẳn đã vụt tắt.\n\nCác [Root.Owner.GetScientistPlural] của chúng ta đã xác định được ba điểm đáng lưu ý gần bãi đáp: một cấu trúc dịch vụ công cộng tương đối nguyên vẹn, một tòa nhà giống đền thờ, và một quảng trường trung tâm khổng lồ. Đây hẳn là nơi tuyệt vời để tiếp tục khai quật những bí mật của Tập đoàn Inetian."
 cstorms.145.name: "Lõi kinh tế"
 cstorms.145.desc: "Nhiều đội nhóm đã chia nhau ra điều tra ba địa điểm triển vọng nhất này. Dù cơ sở dịch vụ công cộng và quảng trường rất thú vị khi đóng vai trò là những ví dụ điển hình về văn hóa và kiến trúc, nhưng chỉ có địa điểm liên quan đến đức tin mới đặc biệt đáng chú ý.\n\nPhía sau những bức tường đổ nát của nó là một đại sảnh hùng vĩ, chứa 521 máy tính được sắp xếp thành các vòng tròn đồng tâm, và ở tâm của vòng tròn này được đặt một mô hình hệ sao vô cùng ấn tượng và vẫn còn đầy đủ chức năng. Các linh kiện nano siêu nhạy trong mô hình này đồng bộ hoàn toàn với từ trường của hành tinh. Mặc dù mô hình này có niên đại cổ xưa đến mức khó tin, nhưng nó vẫn phản chiếu một cách tỉ mỉ sự chuyển động của các thiên thể trong toàn bộ hệ sao.\n\nHơn nữa, dọc theo bệ đỡ tròn của nó, có thể thấy mỗi máy tính đều đang chạy một giao diện tương tác. Các yếu tố hình ảnh của giao diện này bao gồm danh sách các thực thể công ty và giá trị cổ phiếu. Có vẻ như đây không phải là nơi thờ cúng tôn giáo, mà là trung tâm giao dịch và sàn chứng khoán của người Inetian.\n\nChắc chắn tòa nhà này phải lưu trữ những thông tin quan trọng, chúng ta hẳn sẽ tìm thấy được thứ gì đó."
 cstorms.145.a: "Lục soát mọi ngóc ngách."
 cstorms.150.name: "Sổ tay hướng dẫn"
 cstorms.150.intro: "Sau một cuộc điều tra toàn diện hơn, có vẻ như trung tâm giao dịch này trên [From.Planet.GetName] đã bị cướp sạch. Các thiết bị đầu cuối hoàn toàn không thể hoạt động, không lưu lại bất kỳ thông tin thương mại nào ngoại trừ những hình ảnh đã bị in hằn lên màn hình do hiển thị quá lâu qua năm tháng.\n\nTuy nhiên, trong một tủ lưu trữ giấu ở góc đại sảnh dường như có chứa sổ tay hướng dẫn sử dụng. Tận dụng khóa dịch thuật cơ bản được phát triển trong quá trình khai quật [wm_storm_shelter_planet.GetName], chúng ta đã có thể giải nghĩa sơ bộ nội dung của những cuốn sổ này.\n\nSổ tay có hướng dẫn về cách vận hành các thiết bị đầu cuối, điều chỉnh mô hình hệ thống, và cả hướng dẫn trợ giúp cho một cỗ máy được gọi là thiết bị triệt tiêu nhiễu loạn cục bộ. Chi tiết về cách thức vận hành, nhắm mục tiêu và kích hoạt cỗ máy này được mô tả rất chi tiết.\n\nĐây hẳn là thiết bị được nhắc đến trong hầm trú ẩn cổ đại, hoặc có lẽ cũng chính là thứ chúng ta đang tìm kiếm."
 cstorms.150.outro: "Chúng ta lại tiến thêm một bước trong việc thấu hiểu ý định của Tập đoàn Inetian, và biết đâu còn có hy vọng làm chủ được sức mạnh của cỗ máy này."
 cstorms.150.desc.a: "$cstorms.150.intro$Điều này có nghĩa là $cstorms.150.outro$"
 cstorms.150.desc.b: "$cstorms.150.intro$Cuốn sổ tay này có nhắc đến một linh kiện mà chúng ta đã tìm thấy trên [wm_digsite_B.GetName], cũng như phương pháp lắp đặt. Điều này có nghĩa là $cstorms.150.outro$"
 cstorms.150.desc.c: "$cstorms.150.intro$Cuốn sổ tay này có nhắc đến cỗ máy mà tôi đã tìm thấy trên [wm_digsite_C.GetName], nhưng chúng ta vẫn đang thiếu một linh kiện then chốt. Dù sao thì, $cstorms.150.outro$"
 cstorms.150.desc.d: "$cstorms.150.intro$Cuốn sổ tay này có nhắc đến cỗ máy mà chúng ta tìm thấy trên [wm_digsite_C.GetName], cũng như cách lắp đặt linh kiện được tìm thấy trên [wm_digsite_B.GetName] vào đó. Bước cuối cùng chính là khởi động thiết bị triệt tiêu nhiễu loạn cục bộ này, và sau đó chúng ta cuối cùng cũng có thể sử dụng sức mạnh của nó cho riêng mình!"
 cstorms.150.a: "Tiếp tục."
 #Arcsite Tọa độ B
 site_weathermanipulators_CoordinatesB_Industrial_Planet: "Tọa độ B: Hành tinh công nghiệp"
 site_weathermanipulators_CoordinatesB_Industrial_Planet_intro: "Một trong ba tọa độ được tìm thấy tại hầm trú ẩn chống bão cổ đại đã dẫn tôi đến [From.Planet.GetName], một hành tinh công nghiệp của Tập đoàn Inetian. Dựa trên những công trình còn sót lại, rõ ràng hành tinh này không phải dùng để cư trú. Tuy nhiên, chúng ta vẫn chưa thể xác định được các nhà máy trên đó dùng để sản xuất thứ gì."
 cstorms.155.name: "Hiệu suất công nghiệp"
 cstorms.155.desc: "Phía trên các nhà máy vẫn còn vương vấn những đám mây mù dày đặc che khuất mặt trời, khiến bề mặt của [From.Planet.GetName] trở nên rất khó nhìn. Sau khi chịu sự tàn phá của bão không gian, phần lớn bề mặt của hành tinh này chi chít những vết thương, những dải công trình dày đặc bị cắt ngang bởi các khe nứt khổng lồ.\n\nNhững cơ sở sản xuất này không có bất kỳ dấu hiệu nào cho thấy từng có nỗ lực tháo dỡ, chúng chỉ đơn giản là bị bỏ hoang tại đây, thậm chí bên trong vẫn còn giữ lại các nguyên liệu thô dùng trong sản xuất. Phân tích chúng sẽ giúp chúng ta hiểu được hành tinh này đã đóng vai trò gì trong hệ thống hạ tầng công nghiệp và thương mại của nền văn minh cổ đại này. Biết đâu nó còn có thể cung cấp thêm thông tin về cỗ máy lừng danh được nhắc đến trên [wm_storm_shelter_planet.GetName]."
 cstorms.160.name: "Chuyến hàng quan trọng"
 cstorms.160.desc: "Phân tích sơ bộ về nguyên liệu công nghiệp được sử dụng trên [From.Planet.GetName] cho thấy chúng chứa các thành phần có tính phát nổ cao. Các sản phẩm này là một phần của quy trình lớn hơn, không thể sử dụng độc lập. Những vật chất này cuối cùng sẽ được vận chuyển qua hệ thống băng chuyền đến một nhà kho trung tâm.\n\nDựa trên những vết cháy xém xung quanh, nhà kho này rất rõ ràng thường xuyên được dùng cho vận tải hàng hóa liên hành tinh. Câu hỏi đặt ra là những sản phẩm này sẽ được giao đến đâu? Xem xét tính chất dễ cháy nổ của lô hàng, địa chỉ nhận hàng chắc hẳn không thể quá xa.\n\nChúng ta còn tìm thấy vài thùng chứa hàng gần đó. Rõ ràng họ đã tốn rất nhiều công sức để đóng gói an toàn những thứ bên trong, tàn tích của các nhãn dán cảnh báo vẫn còn in trên hông thùng. Trên nhãn chỉ có thể nhận dạng được một từ duy nhất: 'Quan trọng'."
 cstorms.165.name: "Mảnh ghép còn thiếu"
 cstorms.165.intro: "Các [Root.Owner.GetScientistPlural] của chúng ta nhanh chóng tháo dỡ thùng chứa được niêm phong cẩn thận này.\n\nKhi mở thùng đầu tiên ra, có một tiếng xì xì mạnh phát ra, chứng tỏ bên trong chứa một buồng nội tạng có hệ thống kiểm soát khí hậu. Điều này ngay lập tức dấy lên một cơn hoảng loạn về việc liệu thứ bên trong có bị mất ổn định hay không. May mắn thay là chúng vẫn còn nguyên vẹn.\n\nKiểm tra kỹ lưỡng cho thấy bên trong là một linh kiện máy móc được chế tác tinh xảo, cất đặt cẩn thận, đồng thời chứa một số vật chất dễ cháy nổ do nhà máy sản xuất."
 cstorms.165.outro: "\n\nDo đó, chúng ta sẽ mang linh kiện này về tàu để tiến hành phân tích sâu hơn. Các [Root.Owner.GetScientistPlural] của chúng ta không cần thiết phải ở lại trên bề mặt khắc nghiệt của [From.Planet.GetName] lâu đến vậy."
 cstorms.165.desc.a: "$cstorms.165.intro$\n\nGiấy vận chuyển bên trong thùng có ghi chữ 'Thiết bị triệt tiêu nhiễu loạn cục bộ'. Các [Root.Owner.GetScientistPlural] của chúng ta không chắc đây rốt cuộc là thứ gì, nhưng dựa trên cái thùng chứa hạng nặng này và nhãn cảnh báo dán bên ngoài, đây hẳn phải là một vật phẩm rất quan trọng. $cstorms.165.outro$" #A & C sites not yet visited
 cstorms.165.desc.b: "$cstorms.165.intro$\n\nThoạt nhìn linh kiện này trông khá quen mắt, phi hành đoàn đã lấy cuốn sổ tay tìm thấy trên [wm_digsite_A.GetName] ra để so sánh và phát hiện ra rằng, linh kiện được chế tạo tinh xảo trong thùng chứa chính là một bộ phận then chốt của Thiết bị triệt tiêu nhiễu loạn cục bộ. $cstorms.165.outro$" #A site visited & C site not visited
 cstorms.165.desc.c: "$cstorms.165.intro$\n\nHình dáng độc đáo cùng cái lõi chứa đầy chất lỏng của nó cho thấy đây có lẽ là bộ phận dùng để hoàn tất việc lắp ráp tại [wm_digsite_C.GetName]. Vật chất bên trong chắc chắn được dùng để cung cấp năng lượng cho thiết bị triệt tiêu nhiễu loạn cục bộ. Tuy nhiên, có vẻ như muốn lắp đặt bộ phận này một cách an toàn thì cần phải có kiến thức chuyên môn. $cstorms.165.outro$" #A site not visited & C site visited
 cstorms.165.desc.d: "$cstorms.165.intro$\n\nDường như đây chính là linh kiện còn thiếu của thiết bị triệt tiêu nhiễu loạn cục bộ trên [wm_digsite_C.GetName]. Dựa vào cuốn sổ tay được tìm thấy trên [wm_digsite_A.GetName], chúng ta sẽ có thể tiến hành lắp đặt chính xác và hoàn tất việc kích hoạt. $cstorms.165.outro$" #A & C sites visited
 cstorms.165.a: "Làm tốt lắm."
 #Arcsite Tọa độ C
 site_weathermanipulators_CoordinatesC_Barren_Planet: "Tọa độ C: Hành tinh hoang vu"
 site_weathermanipulators_CoordinatesC_Barren_Planet_intro: "Một trong ba tọa độ được tìm thấy tại hầm trú ẩn chống bão cổ đại đã dẫn tôi đến [From.Planet.GetName]. Bề mặt của nó hầu như không có gì ngoài tuyết và bụi, các bản quét sơ bộ phát hiện ra rằng hành tinh này từng một thời có thể cư trú được. Không biết hành tinh giờ đã hóa thành đống đổ nát này trong quá khứ có ý nghĩa quan trọng với Tập đoàn Inetian hay không?"
 cstorms.170.name: "Cơn thịnh nộ vô tận"
 cstorms.170.desc: "Những cơn gió cuồng bạo bất tận càn quét bề mặt của [From.Planet.GetName]. Nếu điều này chưa đủ thử thách, thì ẩn sâu bên dưới lớp tuyết bao phủ là một sự kinh ngạc kỳ quái.\n\nBên dưới bề mặt, còn từng lớp từng lớp bụi dày đặc đang chờ đón chúng ta. Trong đó lại phát hiện thấy dấu vết của các dạng sống từng tồn tại trên hành tinh này. Bọn họ đều bị chôn vùi trong cùng một thời điểm, chứng tỏ đây là một sự kiện đại tuyệt chủng duy nhất. Sự sụp đổ của hệ sinh thái trên [From.Planet.GetName] tất yếu dẫn đến sự mỏng đi của bầu khí quyển sau đó, mang đến kỷ băng hà và cuối cùng biến hành tinh này trở nên hoang vu.\n\nNgoài sỏi đá và cánh đồng băng, nơi này chắc chắn còn nhiều thứ hơn thế, nhưng rõ ràng bề mặt hành tinh sẽ không tiết lộ thêm bí mật nào nữa. Các [Root.Owner.GetScientistPlural] của chúng ta đề xuất nghiên cứu sâu hơn dưới lòng đất."
 cstorms.170.a: "Bắt đầu sàng lọc nào."
 cstorms.171.name: "Cội nguồn sự sống"
 cstorms.171.desc: "Các [Root.Owner.GetScientistPlural] của chúng ta đã khoác lên mình bộ đồ bảo hộ, ngồi trên cỗ máy chống lạnh hạng nặng, chẳng mấy chốc đã hoàn thành công việc lặp đi lặp lại đơn giản là dọn dẹp tuyết tích tụ và bụi mịn. Ngay sau đó, chúng ta phát hiện ra những đặc điểm kỳ lạ, một mạng lưới các rãnh đan chéo ngoằn ngoèo như rễ cây lan rộng trên khắp vùng đất.\n\nTrong những khe nứt này, chúng ta tìm thấy hài cốt khô quắt của đủ loại sinh vật, từ thực vật đến động vật, và mọi dạng sống nằm ở giữa, mọi thứ có thể tìm thấy trên bề mặt đều có đủ. Bằng một cách nào đó, những rãnh này đã nghiền nát sinh khối giữa các thành đá để chiết xuất tất cả các chất dinh dưỡng hữu ích và vận chuyển chúng đến một điểm giao cắt, quá trình này giống như quá trình tiêu hóa. Bụi mà chúng phun ra giờ đây đã bao phủ phần lớn bề mặt của [From.Planet.GetName].\n\nVấn đề bây giờ là, những khe nứt này rốt cuộc đang nuôi dưỡng ai, hay nuôi dưỡng thứ gì."
 cstorms.171.a: "Tìm ra ngọn nguồn."
 cstorms.172.name: "Cỗ máy từ quá khứ"
 cstorms.172.intro: "Hệ thống rãnh ngầm này dường như trải dài vô tận. Các [Root.Owner.GetScientistPlural] của chúng ta càng đi sâu, những khe rãnh này càng trở nên dày đặc. Tất cả chúng đều hội tụ về một ngọn núi duy nhất còn sót lại trên [From.Planet.GetName]. Trên đỉnh ngọn núi này là một cao nguyên nhân tạo, có ba cỗ máy khổng lồ được đặt cách đều nhau. Những thiết bị này có vẻ như do người Inetian chế tạo, trên đó không chỉ ghi ngôn ngữ của họ, mà còn phù hợp với thiết kế xã hội mà chúng ta đã biết về họ. So với lịch sử cổ đại và những cơn gió cực mạnh thổi quét qua cao nguyên, tình trạng của những cỗ máy này lại vô cùng tốt."
 cstorms.172.outro: "\n\nDù sao đi nữa, chúng ta đã tìm thấy thứ mình muốn. Chúng ta chỉ còn cách một khám phá trọng đại một bước nữa thôi."
 cstorms.172.desc.a: "$cstorms.172.intro$Đây hẳn là những cỗ máy được nhắc đến trên [wm_storm_shelter_planet.GetName]. Đáng tiếc là chúng ta đang thiếu hụt kiến thức cần thiết để hiểu cơ chế hoạt động phức tạp bên trong các thiết bị này. Không những thế, bảng điều khiển được tìm thấy ở phần đế của một trong những cỗ máy rõ ràng đang bị thiếu một linh kiện then chốt. Trên một tấm bảng nhỏ xíu có khắc một dòng chữ nhỏ 'Thiết bị triệt tiêu nhiễu loạn cục bộ'.\n\nNếu có thể kích hoạt các cỗ máy này, chúng ta sẽ có thể khám phá ra công dụng của chúng. Để làm được điều đó, chúng ta cần khám phá những tọa độ còn lại. $cstorms.172.outro$" #A&B not visited
 cstorms.172.desc.b: "$cstorms.172.intro$\n\nHình minh họa trong cuốn sổ tay mà chúng ta tìm thấy trên [wm_digsite_A.GetName] có vẻ khớp với thiết bị đang hiện diện trước mặt chúng ta, điều đó có nghĩa là, đây chính là những gì được gọi là thiết bị triệt tiêu nhiễu loạn cục bộ, và đây cũng chính là cơ cấu cơ khí được nhắc đến tại hầm trú ẩn chống bão được tìm thấy trên [wm_storm_shelter_planet.GetName].\n\nHướng dẫn chỉ ra rằng những cỗ máy này cần một bảng điều khiển nào đó mới có thể vận hành. Các [Root.Owner.GetScientistPlural] của chúng ta đã tìm thấy bảng điều khiển này ở phần đế của một cỗ máy, nhưng dường như nó thiếu một bộ phận quan trọng. Tuy nhiên chúng ta vẫn còn một bộ tọa độ chưa khám phá, có lẽ phương pháp giải quyết tình thế tiến thoái lưỡng nan này đang ẩn giấu trong đó. $cstorms.172.outro$" #A visited & B not visited
 cstorms.172.desc.c: "$cstorms.172.intro$\n\nĐây chắc chắn là cỗ máy mang tên thiết bị triệt tiêu nhiễu loạn cục bộ được nhắc đến trên [wm_storm_shelter_planet.GetName]! Không chỉ vậy, linh kiện cơ khí mà chúng ta tìm thấy tại [wm_digsite_B.GetName] cũng có thể dễ dàng lắp vào bảng điều khiển ở phần đế của một trong các cỗ máy.\n\nTuy nhiên, linh kiện này vô cùng phức tạp và có tuổi đời rất lâu, việc mù quáng cố gắng sửa chữa thêm là rất nguy hiểm. Các [Root.Owner.GetScientistPlural] của chúng ta đề nghị tìm kiếm thêm thông tin trước khi tiếp tục. $cstorms.172.outro$" #A not visited & B visited
 cstorms.172.desc.d: "$cstorms.172.intro$\n\nChắc chắn đây là những cỗ máy được đề cập trên [wm_storm_shelter_planet.GetName], đồng thời cũng là đối tượng được miêu tả trong cuốn sổ tay trên [wm_digsite_A.GetName], và giờ đây chúng ta cũng biết nó được gọi là thiết bị triệt tiêu nhiễu loạn cục bộ. Những gì chúng ta cần làm lúc này là lắp linh kiện tìm thấy ở [wm_digsite_B.GetName] vào đó, và hy vọng cỗ máy này vẫn còn có thể hoạt động. Chỉ khi đó chúng ta mới có thể tìm ra được công dụng thật sự của nó. $cstorms.172.outro$" #A&B visited
 cstorms.172.a: "Đã đến lúc xem cỗ máy này thực chất dùng để làm gì." #Finished sites A and B
 cstorms.172.b: "Tiếp tục." #Did not finish sites A and B
 #Dự án Đặc biệt 2
 INETIAN_PROJECTS_02: "Công dụng của cỗ máy"
 INETIAN_PROJECTS_02_DESC: "Ba tọa độ trên [wm_storm_shelter_planet.GetName] đã ráp lại thành một bức tranh cổ đại, việc còn lại chỉ là kích hoạt thiết bị triệt tiêu nhiễu loạn cục bộ. Cuối cùng đã đến lúc làm rõ công dụng của nó."
 cstorms.176.name: "Công dụng của cỗ máy"
 cstorms.176.desc: "Mảnh ghép cuối cùng rốt cuộc đã được tìm thấy, các [Root.Owner.GetScientistPlural] của chúng ta bắt đầu bận rộn. Linh kiện trên [wm_digsite_B.GetName] đã được lắp ráp vừa vặn vào một bảng điều khiển. Sổ tay trên [wm_digsite_A.GetName] đã hướng dẫn chúng ta lắp đặt chính xác. Vừa mới lắp xong, ba cỗ máy bỗng nhiên bừng tỉnh.\n\nNhững âm thanh rung trời lở đất đã rũ sạch bụi và tuyết trên cao nguyên, kéo theo đó là một tiếng nổ tựa sấm sét, một [Root.Owner.GetScientist] bốc hơi ngay lập tức, xoáy bụi do thân xác đó hóa thành nhanh chóng bị hút vào những khe rãnh dẫn đến bộ triệt tiêu nhiễu loạn này.\n\nĐây chính là chìa khóa giải thích cho những gì đã xảy ra trên [wm_digsite_C.GetName]: các rãnh dẫn đến đáy cỗ máy chính là đường ống nhiên liệu, nó sẽ hấp thụ sinh khối xung quanh. Kết quả là để lại những vết tích hủy diệt trên toàn bộ hành tinh.\n\nThiết bị triệt tiêu nhiễu loạn cục bộ hiện đã được kích hoạt hoàn toàn, nhiên liệu còn lại đủ cho một lần sử dụng. Việc chúng ta cần làm chỉ là nhấn nút."
 cstorms.176.a: "Kích hoạt cỗ máy."
 cstorms.176.b: "Đừng nhấn nút."
 #Sự kiện trì hoãn 1
 cstorms.180.name: "Phát hiện lại tàn tích"
 cstorms.180.desc: "Sau khi vén màn bí mật về thiết bị triệt tiêu nhiễu loạn cục bộ, mọi manh mối về Tập đoàn Inetian dường như đã đứt đoạn. Tuy nhiên, việc đánh giá lại kỹ lưỡng các dữ liệu đã cung cấp cho chúng ta một số góc nhìn mới.\n\nHồ sơ thương mại trên [wm_digsite_A.GetName] chỉ ra rằng, những người này gìn giữ đức tin về chủ nghĩa quân bình một cách sâu sắc. Cơ sở của kết luận này là mức sống cao mà họ có được cũng như số lượng lớn các nhà máy sản xuất hàng xa xỉ còn lưu giữ trên hành tinh; mỗi một công dân, bất kể nghề nghiệp, địa vị xã hội hay dòng máu, đều được hưởng thụ sự thoải mái và cơ hội ngang nhau.\n\nTrên [wm_digsite_B.GetName], chúng ta đã tìm thấy một bảng chỉ mục mô tả chi tiết các ứng dụng của từng nhà máy. Đây là một phần của chuỗi sản xuất lớn hơn, được sử dụng để cung cấp cho đế chế rộng lớn này những phương tiện cần thiết để duy trì lối sống xa hoa của họ. Để phân bổ công bằng những lợi ích này, họ buộc phải tiêu thụ một lượng vật chất và thức ăn khổng lồ với tốc độ đáng kinh ngạc.\n\nThiết bị triệt tiêu nhiễu loạn cục bộ đã được sửa chữa trên [wm_digsite_C.GetName] lại cung cấp thêm hiểu biết trước khi nó hoàn toàn hỏng hóc. Dù mục đích chính xác về chức năng của nó vẫn còn là một bí ẩn, nhưng ít nhất chúng ta đã tìm lại được một tín hiệu dữ liệu có thể truy vết; mục tiêu của những cỗ máy này không phải là một thực thể di chuyển tự do.\n\nCác [Root.Owner.GetScientistPlural] của chúng ta đề xuất tìm kiếm những phản ứng khớp với tín hiệu này ở khu vực lân cận."
 cstorms.180.a: "Đi tìm thứ này."
 #Digsite 5
 site_weathermanipulators_storm_formation: "Khởi nguồn bình thường"
 site_weathermanipulators_storm_formation_intro: "Bên trong bảng điều khiển của thiết bị triệt tiêu nhiễu loạn cục bộ có lưu trữ một tín hiệu dữ liệu. Tuy có chút khó khăn, nhưng chúng ta có thể sao chép được mô hình của nó, và tìm kiếm sự trùng khớp trên toàn hệ sao. Dấu vết này dẫn đến một hành tinh không thể định cư. Đã đến lúc tìm hiểu xem Tập đoàn Inetian đang nhắm mục tiêu vào thứ gì, và tại sao lại nhắm vào nó."
 cstorms.181.name: "Bình nguyên mộc mạc"
 cstorms.181.desc: "Thoạt nhìn [From.Planet.GetName] dường như mọi thứ đều bình thường. Hành tinh này chẳng có gì khác biệt so với hàng trăm hành tinh cùng loại có thể tìm thấy ở khắp nơi trong hệ sao, cũng không tìm thấy bất kỳ chỉ báo cụ thể nào về vị trí phát ra tín hiệu này. Không có bộ phát tín hiệu nào có thể quan sát bằng mắt thường, cũng chẳng có đủ dấu vết công nghệ mạnh mẽ nào có thể bắt được tín hiệu từ các hệ thống khác.\n\nCuộc tìm kiếm của chúng ta vẫn đang tiếp tục."
 cstorms.182.name: "Thảm họa tập trung"
 cstorms.182.desc: "Sau khi đáp xuống bề mặt, chúng ta nhanh chóng phát hiện ra rằng độ mạnh yếu của tín hiệu nhận được phụ thuộc vào vị trí của chúng ta. Dựa vào quy luật đơn giản này, cuối cùng chúng ta cũng tìm thấy một đỉnh núi cao chót vót nằm ở phía bên kia hành tinh.\n\nCàng đến gần những dãy núi thoắt ẩn thoắt hiện kia, vùng đất càng trở nên hoang tàn, cằn cỗi và đổ nát, tựa như có một sức mạnh hủy diệt nào đó đã xé toạc mặt đất. Dựa trên đặc điểm của sự tàn phá, chúng ta tin rằng nơi này đã từng bị bão bụi không gian tấn công. Tuy nhiên, nếu điều này là sự thật, thì theo logic, toàn bộ hành tinh đáng ra đều phải chịu ảnh hưởng. Chúng ta chưa từng thấy một cơn bão nào có khả năng gây ra sức tàn phá tập trung đến như vậy. Để tìm hiểu thêm, bắt buộc phải leo lên đỉnh ngọn núi cao chót vót này."
 cstorms.183.name: "Năng lượng rò rỉ"
 cstorms.183.desc: "Dãy núi bị phá hủy cấu thành từ rất nhiều đỉnh núi và thung lũng, nhưng một miệng hố thiên thạch có hình thù kỳ dị đã nhanh chóng thu hút sự chú ý của chúng ta. Vách hố nhẵn thính, xung quanh tâm hố có những vòng tròn đồng tâm được khắc sâu vào lòng đất.\n\nKhi chúng ta đi xuống hố, cảm nhận được một lực kéo cực mạnh hướng thẳng về phía tâm của các vòng tròn đồng tâm. Những tia năng lượng nhấp nháy bốc lên từ chiếc vòng, một số tia trôi dạt ra rất xa, và cuối cùng thoát khỏi bầu khí quyển của hành tinh. Đây chính là nguồn gốc của tín hiệu.\n\nCác [Root.Owner.GetScientistPlural] của chúng ta đề xuất phân tích miệng hố thiên thạch cùng những biến động năng lượng của nó để hiểu rõ hơn những gì đã xảy ra tại đây."
 cstorms.184.name: "Khởi đầu không chắc chắn"
 cstorms.184.desc: "Dựa vào dữ liệu môi trường và các mô phỏng chi tiết, chúng ta có thể tự tin kết luận rằng quả thực đã có một cơn bão bụi thiên thể càn quét qua những đỉnh núi này. Trên thực tế, nó đã được hình thành ngay tại vị trí này! Còn về lý do tại sao nó không nuốt trọn toàn bộ hành tinh trong quá trình đó, phỏng đoán tốt nhất của chúng ta là vì nó quá nhỏ — phân tích chỉ ra rằng quy mô của cơn bão này thậm chí còn nhỏ hơn rất nhiều so với những cơn bão thông thường.\n\nDựa trên thực tế này, Tập đoàn Inetian đã gọi thiết bị triệt tiêu nhiễu loạn cục bộ là 'thiết bị thao túng', và tín hiệu năng lượng của cơn bão cụ thể này đã được lưu trữ trong cơ sở dữ liệu của họ, có vẻ như rất có khả năng họ đã cố gắng kiểm soát cơn bão không gian. Bằng cách tính toán lộ trình sau khi nó rời khỏi nơi này, chúng ta có thể học hỏi được rất nhiều thứ có lợi cho mình."
 cstorms.184.a: "Hãy tiếp tục nào."
 #Dự án Đặc biệt 3
 INETIAN_PROJECTS_03: "Truy dấu Tập đoàn"
 INETIAN_PROJECTS_03_DESC: "Chúng ta đã phát hiện ra địa điểm hình thành của một cơn bão bụi tinh vân cổ đại, nhưng bằng chứng cho thấy nó nhỏ hơn nhiều so với một cơn bão thông thường. Xét trên quy mô nhỏ bé của nó, việc Tập đoàn Inetian cho rằng cần thiết phải sử dụng thiết bị triệt tiêu nhiễu loạn cục bộ của họ để kiểm soát cơn bão lại trở nên vô cùng kỳ lạ.\n\nNếu tiếp tục lần theo hướng đi của cơn bão, chúng ta có lẽ sẽ khám phá ra được lý do tại sao họ lại đầu tư nhiều thời gian đến vậy cho dự án này."
 cstorms.186.name: "Truy dấu Tập đoàn"
 cstorms.186.desc: "Việc truy dấu lộ trình của cơn bão bụi tinh vân không đơn giản và dễ dàng như chúng ta nghĩ. Chỉ vừa đi được khoảng cách vài hệ sao tính từ nguồn cội, cường độ, quy mô và đường đi của nó đã có sự thay đổi rõ rệt. Các [Root.Owner.GetScientistPlural] của chúng ta nghi ngờ rằng, chính tại vị trí này, cơn bão đã bị thiết bị triệt tiêu nhiễu loạn cục bộ tấn công. Nó khiến cơn bão mất đi sự cân bằng, những mảnh vỡ xác động vật hoang dã cuốn lên từ bề mặt [wm_digsite_C.GetName] đã làm ô nhiễm vòng xoáy bên trong của cơn bão.\n\nKhi cơn bão tiếp tục trôi dạt trong hệ sao, nó đã nhấn chìm nhiều hệ thống sao, mang đến những hậu quả tàn khốc.\n\nMọi thứ được làm ra hòng can thiệp vào lộ trình của nhiễu loạn nhỏ nhoi này, mục đích đều là để khiến nó tránh xa khỏi một hệ sao cụ thể... Cảm biến phát hiện sự tồn tại của một trạm không gian bị bỏ hoang trong hệ sao đó. Nhằm bảo vệ nơi này, Tập đoàn Inetian thậm chí đã không ngần ngại tạo ra nhiều đợt đại tuyệt chủng.\n\nTrạm không gian này có thể không phải là hệ sao thủ đô mà chúng ta mong đợi, nhưng chắc chắn nó cũng cực kỳ quan trọng mới xứng đáng với các biện pháp bảo vệ có cái giá đắt đỏ đến vậy."
 cstorms.186.a: "Thiết lập lộ trình."
 #Digsite 6
 site_weathermanipulators_last_shelter: "Đêm trước tận thế"
 site_weathermanipulators_last_shelter_intro: "Tập đoàn Inetian đã cố gắng bảo vệ một trạm không gian nhỏ nhoi trong hệ sao này khỏi sự tác động của cơn bão bụi tinh vân. Và cơn bão này lại mạnh lên ngoài sức tưởng tượng và hủy diệt nhiều hệ sao khác. Tại sao họ lại phải tốn công tốn sức để bảo vệ cơ sở này đến vậy?"
 cstorms.190.name: "Quỹ đạo ổn định"
 cstorms.190.desc: "Quy mô của trạm không gian xoay quanh [From.Planet.GetName] đã vượt ngoài dự liệu của chúng ta. Có vẻ nó không chỉ đơn giản là một 'trạm' nữa, các ví dụ như cơ sở nghiên cứu và hệ thống duy trì sự sống phức tạp cùng với thiết bị thăm dò không gian sâu thẳm,... mọi thứ đều có đủ. Điều này chứng tỏ cơ sở này rất có thể được dùng làm thuộc địa dài hạn chứ không phải là một khu định cư tạm thời.\n\nTuy nhiên, tình trạng hiện tại của trạm không gian này vô cùng tồi tệ. Vỏ của nó đã bị hư hỏng, đợt sụt giảm áp suất thảm khốc đã thổi bay toàn bộ khu vực. Hiện vẫn chưa rõ thiệt hại là do nguyên nhân bên ngoài hay bên trong gây ra. May mắn thay, hệ thống kiểm soát quỹ đạo và ổn định trục vẫn còn hoạt động, điều này cũng giải thích tại sao cấu trúc này lại không trôi dạt vào các vì sao, và cũng không bị sụp đổ trong các chu kỳ tự quay không thể tránh khỏi.\n\nRất khó để tiến vào nó mà không phá vỡ sự cân bằng mong manh này."
 cstorms.191.name: "Áp lực đáng kinh ngạc"
 cstorms.191.desc: "Trừ khi chúng ta có thể cạy mở một cửa xả khí chưa bị hư hại và không gây ra tiếng nổ lớn, còn không thì khó lòng có thể tiến vào trạm không gian này trong hệ sao [This.System.GetName]. Bất chấp lịch sử lâu đời, bên trong trạm không gian vẫn còn được điều áp, và vẫn có thể mô phỏng thành công khí quyển hành tinh điển hình.\n\nChúng ta đã mất vài ngày để xây dựng hệ thống kín khí giữa con tàu của mình và trạm không gian, cân bằng áp suất không khí một cách tỉ mỉ, cuối cùng mới có thể mở cửa sập một cách an toàn. Đáng tiếc là chúng ta ngay lập tức gặp phải khó khăn tiếp theo: lối đi phía trước đã bị chặn bởi những xà đỡ cong queo và gạch đá vỡ nát sinh ra từ sự cố sụt giảm áp suất gần đó, chúng ta sẽ cần chút thời gian dọn dẹp trước khi tiếp tục tiến vào."
 cstorms.192.name: "Hầm mộ bên trong"
 cstorms.192.desc: "Sau khi dọn dẹp xong một lối đi, chúng ta bắt đầu khám phá trạm không gian này để tìm kiếm câu trả lời.\n\nKhảo sát toàn diện cho thấy, trạm không gian này không phải được xây dựng để quan sát không gian vũ trụ, mà là để bảo vệ một thứ gì đó, nhiều thiết bị quét tinh vi của nó đều nhắm vào bên trong. Trong đó còn phát hiện ra các vật dụng cá nhân thuộc về công dân của Tập đoàn Inetian, cùng với nhật ký miêu tả cuộc sống trên trạm. Họ kể về một khối tải trọng quan trọng, được lưu trữ trong một khoang được canh gác cẩn mật trong căn cứ. Mặc dù không mất nhiều thời gian để tìm ra, nhưng khoang chứa này giống hệt như một hầm mộ.\n\nNhững bộ hài cốt khô quắt hệt như xác ướp chất đầy khoang, tất cả họ đều đến từ Tập đoàn Inetian. Nhìn vào tư thế bình yên của họ, có vẻ như họ đã không kháng cự gì mà chỉ ngồi chờ chết. Rốt cuộc chuyện gì đã xảy ra ở đây?"
 cstorms.193.name: "Kiêu ngạo ngông cuồng"
 cstorms.193.desc: "Khối tải trọng mà những công dân này nhắc đến nằm ngay chính giữa khoang chứa. Ngoại hình mới toanh của thiết bị độc đáo này trông cứ như thể nó chưa từng được sử dụng. Chắc chắn nó thuộc về người Inetian, nhưng lại tiên tiến hơn bất kỳ thứ gì chúng ta từng thấy trước đây.\n\nCác thiết bị đầu cuối ở hai bên cỗ máy hiển thị nhiều đoạn văn bản giống hệt nhau cứ lặp đi lặp lại. Bản dịch nhanh chóng được đưa ra:\n\n§LKhách đến thăm thân mến, nếu bạn đang đọc bài viết này, thì bạn chính là nhân chứng cho sự kiêu ngạo của chúng tôi. Trong quá trình theo đuổi lý tưởng cao đẹp về chủ nghĩa quân bình, chúng tôi đã lãng quên bộ cân bằng thực sự: sáng tạo và hủy diệt.\n\nĐể bảo vệ tuyến đường thương mại của mình khỏi sự tàn phá của bão không gian, chúng tôi đã can thiệp vào tự nhiên. Những xáo trộn nhỏ nhoi từng có giờ đã vượt ngoài tầm kiểm soát. Cơn bão không gian đã càn quét qua rất nhiều hành tinh của chúng tôi. Đây không phải là sự trùng hợp ngẫu nhiên, mà là một sự trả thù. Giờ đây chúng tôi giam mình lại trong trạm không gian này, đây chính là phòng tuyến cuối cùng, bởi vì dù có làm gì đi nữa thì cũng đã quá muộn. Dù chúng tôi không bao giờ dùng máy triệt tiêu nữa, nhưng những cơn bão mới vẫn đang được hình thành, thậm chí còn mạnh hơn, hoang dại hơn so với trước. Nhiệm vụ cuối cùng của chúng tôi rất rõ ràng.\n\nChúng tôi làm việc không biết mệt mỏi để chế tạo ra cỗ máy này, chế tạo nó vì những vị khách ghé thăm như bạn. Nó sẽ cứu bạn khỏi cơn bão không gian, đồng thời tránh việc chọc giận chúng. Đối với chúng tôi cái chết là một sự giải thoát, còn với bạn thì chưa.§!\n\nTrong căn phòng này, Tập đoàn Inetian đã chấp nhận số phận của chính mình. Sự vĩ đại trong lòng quảng đại của họ hệt như sự nghiêm trọng trong hành vi ngông cuồng mà họ đã làm. Cuối cùng, chúng ta mang theo món quà của họ, và rời khỏi trạm không gian này."
 cstorms.193.a: "Hãy để họ yên nghỉ."
 cstorms.193.b: "Lũ ngốc này đáng bị như vậy."
 #Hành động Di vật
 artifact_inetian_research: "Bí mật của Tập đoàn Inetian"
 artifact_inetian_research_desc: "Khám phá sâu hơn về những bí mật của Tập đoàn Inetian."
 artifact_inetian_research_completed: "$artifact_inetian_research$"
 artifact_inetian_research_completed_desc: "Tri thức cổ đại của Tập đoàn Inetian đã nằm trong tay chúng ta."
 INETIAN_PROJECTS_04: "Khám phá bí mật của Tập đoàn Inetian"
 INETIAN_PROJECTS_04_DESC: "Sau khi phát hiện ra nơi an nghỉ của Tập đoàn Inetian, vẫn còn vô vàn bí ẩn chưa có lời giải về đế chế rộng lớn của họ. Chúng ta lên kế hoạch tiến hành điều tra một lần nữa."
 cstorms.195.name: "Khám phá bí mật của Tập đoàn Inetian"
 cstorms.195.desc: "Nơi an nghỉ cuối cùng của Tập đoàn Inetian có vẻ là một trạm không gian công nghệ cực cao. Họ xây dựng trạm không gian này để chống lại cơn bão không gian tồi tệ do chính tay họ gây ra. Trạm cư trú độc đáo này là đỉnh cao công nghệ của Inetian, sở hữu hệ thống kiểm soát khả năng sống và bảo vệ đáng kinh ngạc. Tuy vậy, dù có là một trạm cư trú tiên tiến đến nhường nào cũng không thể bảo vệ được họ mãi mãi.\n\nDo sự xuống cấp hàng ngàn hàng vạn năm của trạm không gian này, nó đã trở nên quá nguy hiểm không còn phù hợp để định cư, các [Root.Owner.GetScientistPlural] của chúng ta có thể trích xuất kho tàng kiến thức từ hệ thống của nó. Không chỉ vậy, họ còn tìm thấy tuyến đường thương mại quan trọng nhất của Tập đoàn Inetian trong một cơ sở dữ liệu, và một nguyên mẫu tinh xảo của cỗ máy kiểm soát khí hậu có hiệu suất cao hơn, ít gây tổn hại cho hành tinh hơn tại một trạm làm việc.\n\nCó vẻ như sự kiên trì của ít nhất một bộ phận Tập đoàn Inetian đã không hề uổng phí, điều này sẽ tiếp tục giúp chúng ta vượt qua những cơn bão."
 secrets_of_the_inetian_traders: "Bí mật của Tập đoàn Inetian"
 secrets_of_the_inetian_traders_hive_mach: "Bí mật của Tập đoàn Inetian"
 secrets_of_the_inetian_traders_desc: "Tri thức cổ đại của Tập đoàn Inetian một lần nữa nằm trong tay chúng ta. Nhờ sự ảnh hưởng của họ, chúng ta đã được giảm phí môi giới thị trường."
 secrets_of_the_inetian_traders_hive_mach_desc: "Tri thức cổ đại của Tập đoàn Inetian có thể được Tập thể của chúng ta sử dụng. Việc giảm phí môi giới thị trường đã có hiệu lực."
 #Hyperlane Detailer - Phần thưởng Bí mật của Tập đoàn Inetian
 sm_hyperlane_detailer: "Chiến dịch quảng bá làn siêu không gian"
 NAME_inetian: "Tập đoàn Inetian"
 ###########################################
 #Hiệp ước Nhân từ adAkkaria #
 ###########################################
 cs_adAkkaria_chain_title: "Tiền bối - adAkkaria"
 cs_adAkkaria_chain_desc: "Chúng ta cần lần theo một manh mối để vén bức màn bí mật về số phận cuối cùng của nền văn minh cổ đại kỳ dị này, dù manh mối này có dẫn tới đâu đi nữa."
 #Bất thường: Tín hiệu cổ đại
 STORMS_PREC_ONE: "Tín hiệu cổ đại"
 STORMS_PREC_ONE_DESC: "Chúng ta đã đánh chặn được một loạt tín hiệu điện từ kỳ lạ trong hệ sao này. Phân tích dữ liệu sơ bộ cho thấy các thiết bị phát tín hiệu này có lẽ đã được hàng ngàn năm tuổi. Thuyền viên của chúng ta đang khao khát tìm ra nguồn gốc của nó."
 cstorms.205.name: "Tín hiệu nhân từ"
 cstorms.205.desc: "Nguồn gốc của tín hiệu kỳ lạ được phát hiện trong hệ sao này xuất phát từ một trạm liên lạc cổ đại xoay quanh [FromFrom.GetName]. Những thông điệp này hẳn là những chương trình phát sóng cũ của một nền văn minh đã thất truyền nào đó.\n\nDo vậy, các [Root.Owner.GetScientistPlural] của chúng ta đã gặp chút khó khăn trong việc giải mã. Họ đề nghị lên trạm không gian này để có thể trực tiếp tương tác với máy chủ liên lạc."
 #Điểm khảo cổ: Trung tâm tuyên truyền
 site_adakkaria_the_propaganda_station: "Trung tâm tuyên truyền"
 site_adakkaria_the_propaganda_station_intro: "Trạm liên lạc cổ đại này vẫn còn hoạt động được. Sau khi lên trạm này và tương tác trực tiếp với hệ thống của nó, chúng ta có lẽ sẽ giải mã được những thông điệp đã nhận được trước đó."
 cstorms.215.name: "Giao diện quá khứ"
 cstorms.215.desc: "Quá trình lên trạm không gian hầu như không gặp phải vấn đề gì, nhưng rất khó để tìm đường đi trong cấu trúc của nó. Nhờ có hệ thống khiên che chắn tiên tiến bên ngoài, cấu trúc của nó được bảo tồn vô cùng hoàn hảo, nhưng những hành lang chật hẹp và trần nhà thấp lại là một thử thách cho nhóm của chúng ta.\n\nNgoại trừ những mảng hỗn hợp giấy-nhựa lớn được trang trí trên tường, không gian bên trong tiền đồn hầu như không cung cấp manh mối nào về bản chất của những người chủ cũ. Những tấm áp phích này vẽ hình ảnh cách điệu về các cá thể thuộc một loài sinh vật hữu cơ vô danh. Vẻ ngoài của họ vô cùng nổi bật, đứng trước bối cảnh chinh phục và ăn mừng. Hiệu ứng hình ảnh rõ ràng là nhằm truyền bá niềm tự hào và sự gắn kết.\n\nBản thân máy chủ liên lạc hoàn toàn là một câu đố. Ban đầu các [Root.Owner.GetEngineerPlural] cho rằng nó là đồ mô phỏng tự nhiên, tương tự như những thứ thường thấy trong các [Root.Owner.GetPreFTLLowerPlural]. Tuy nhiên, bên dưới những nút bấm và bảng chia độ lại là một hệ thống vi mạch điện tử phức tạp được làm từ một loại hợp kim không xác định. Các [Root.Owner.GetScientistPlural] nghi ngờ nền văn minh này có thể đã bỏ qua vài bước trong quá trình phát triển khoa học máy tính, điều này lý giải cho sự xuất hiện lẫn lộn của các công nghệ thuộc nhiều thời đại khác nhau tại đây.\n\nMặc dù vậy, sau một loạt các lần thử và sai, cuối cùng các [Root.Owner.GetLinguists] của chúng ta cũng đã giải mã thành công đoạn đầu tiên trong rất nhiều bản ghi âm phát sóng."
 cstorms.220.name: "Từ Lãnh đạo Tối cao"
 cstorms.220.desc: "Sau khi kết nối thành công với máy chủ liên lạc cổ đại này, các [Root.Owner.GetLinguists] của chúng ta đã cung cấp bản ghi chép của chương trình phát sóng đầu tiên:\n\n§LNhân dân của Hiệp ước adAkkaria!\n\nTôi đang nói chuyện với các bạn không phải với tư cách là một người lãnh đạo, mà là một người bạn cũ và một người thầy.\n\nCác bạn chắc hẳn đã chú ý, ban ngày đang ngày càng ngắn lại, bầu trời ngày càng u ám, thậm chí chính những ngôi sao cũng trở nên tràn ngập thù địch.\n\nNhưng tôi vẫn có niềm tin. Giống như ân nhân có niềm tin vào chúng ta, tôi có niềm tin vào mục tiêu của chúng ta, và vào các bạn.\n\nTrong suốt nhiều thế kỷ, nhân dân của chúng ta đã bảo vệ những hành tinh này khỏi những bộ tộc man rợ. Cứu vớt hệ sao khỏi tay những thế lực tà ác này là sứ mệnh của chúng ta. Vận mệnh sẽ không thay đổi chỉ vì một lần thất bại. Chúng ta sẽ không bị phá hoại bởi binh đoàn tà ác đang âm mưu chống lại chúng ta.\n\nTôi tin tưởng vào sứ mệnh của chúng ta. Hiệp ước Nhân từ adAkkaria sẽ mang lại chân lý và tự do cho mọi nền văn minh. Chính sứ mệnh đã giữ lại sinh mạng cho chúng ta, và chính vận mệnh đã để chúng ta giành chiến thắng và trở nên phồn vinh!\n\nVì vậy, hỡi những người bạn của tôi, xin đừng khuất phục trước những lời nghi ngờ. Hãy thương tiếc cho những mất mát, trao vinh dự cho những người tử vì đạo. Rồi hãy cùng nhau đoàn kết lại như chúng ta vẫn luôn làm. Vì ân nhân của chúng ta, vì Hiệp ước adAkkaria, vì lòng nhân từ!§!"
 cstorms.225.name: "Tối hậu thư của Liên minh Thiên hà"
 cstorms.225.desc: "Đối với các [Root.Owner.GetLinguists] của chúng ta, việc thu thập dữ liệu được khai quật từ trạm không gian cổ đại là một nhiệm vụ vô cùng khó khăn. Tuy nhiên, có một vài chương trình phát thanh đặc biệt cung cấp nhiều thông tin, trong đó có một vài đoạn đối thoại được ghi âm lại:\n\n§SIlsapigne Turshi — Người dẫn chương trình§!\n§L——Nói về sự can thiệp gần đây từ Liên minh Thiên hà, chúng tôi đã mời Giáo sư Tối cao Akmani Sando và Tiến sĩ Giác quan Toàn diện Emik Inna. Thưa Giáo sư kính mến, ông diễn giải thế nào về các yêu cầu của Liên minh?§!\n\n§SAkmani Sando — Giáo sư Tối cao§!\n§LYêu cầu của chúng thật quá sức lố bịch! Liên minh Thiên hà vẫn đang đối xử với những hành tinh kém văn minh bằng thái độ cực kỳ khinh miệt. Nhưng tôi muốn hỏi những kẻ tự xưng là người bảo vệ đạo đức của hệ sao: việc giữ lại công nghệ có thể dùng để cứu người, giữ lại những lý tưởng đã xây dựng nên nền tảng xã hội thành công của chúng ta há chẳng phải càng vô đạo đức hơn hay sao? Nếu chúng ta mặc kệ cho một hành tinh đẩy nhanh tốc độ tiến tới sự diệt vong, mà không vươn tay ra cứu giúp, thì chúng ta sẽ trở nên hèn hạ đến nhường nào?§!\n\n§SIlsapigne Turshi — Người dẫn chương trình§!\n§LThật là một quan điểm tuyệt vời! Tiến sĩ Giác quan Toàn diện, tôi tin rằng ông chắc hẳn cũng cảm thấy phẫn nộ trước sự can thiệp của Liên minh đối với vận mệnh của chúng ta.§!\n\n§SEmik Inna — Tiến sĩ Giác quan Toàn diện§!\n§LNhững lời tôi sắp nói đây có lẽ sẽ làm cô bị sốc. Mặc dù tổ chức này vô cùng ngoan cố, nhưng tôi cho rằng chúng ta nên cân nhắc nghiên cứu sự quan tâm của Liên——§!\n\n§TCó vẻ như chương trình phát thanh đã bị ngắt ngay tại lúc này.§!"
 cstorms.225.a: "Đúng là một giống loài cứng nhắc."
 cstorms.225.a.hive: "Nhiều tiếng nói hỗn tạp gây ra sự hỗn loạn."
 cstorms.225.a.machine: "Cuộc sống vốn dĩ đầy rẫy tranh cãi."
 cstorms.230.name: "Thánh nhân và Nhà ngoại cảm"
 cstorms.230.desc: "Một đoạn phát thanh khác cũng được đánh dấu là vô cùng giá trị. Mặc dù đây là một tác phẩm kịch tính, nhưng nó cũng cung cấp cho cuộc điều tra của chúng ta một số thông tin nền tảng liên quan:\n\n§SAktamen Revan§!\n§LTôi thấy tối qua cô lại đi gặp Entula Saman. Tôi còn tưởng cô đã từ bỏ chúng vì tình yêu của chúng ta chứ.§!\n\n§SInnerka Utai§!\n§LEm xin thề với anh, đó chỉ là một chuyến thăm xã giao thôi. Anh phải biết em chỉ chung thủy với một mình anh!§!\n\n§SAktamen Revan§!\n§LĐó chỉ là những lời lẽ hoa mỹ của cô thôi, nhưng tâm trí của cô lại nói cho tôi biết một điều hoàn toàn khác.§!\n\n§SInnerka Utai§!\n§LAnh cũng vậy thôi!§!\n\n§SAktamen Revan§!\n§LĐúng, chính xác là vậy! Tối qua tôi đã tình cờ phát hiện ra khả năng ngoại cảm của mình! Tôi cứ ngỡ đây sẽ là một cuộc khám phá đầy thú vị cho những cảm xúc sâu kín nhất của chúng ta, nhưng kết quả lại biến thành nỗi tuyệt vọng! Trong tâm trí cô đang ẩn chứa sự phản bội!§!\n\n§SInnerka Utai§!\n§LAnh không hiểu đâu! Trái tim em, em không thể kiểm soát nó. Em bắt buộc phải tin rằng con đường này là đúng đắn. Ôi, Revan, giá như khả năng ngoại cảm mới có của anh có thể giúp anh đọc được trái tim em chứ không phải là tâm trí em!§!"
 cstorms.230.a: "Khả năng ngoại cảm? Thật thú vị."
 cstorms.230.b: "Toàn là lời nhảm nhí!"
 cstorms.230.b.hive: "Đúng là một hình thức giải trí cá nhân chủ nghĩa kỳ lạ."
 cstorms.230.b.machine: "Đây chính là kịch tính của các sinh vật hữu cơ sao."
 dramatic_enthusiasm: "Người đam mê kịch ngoại hành tinh"
 melodramatic_much: "Kẻ ghét kịch ngoại hành tinh"
 cstorms.235.name: "Tin tức cũ"
 cstorms.235.desc: "Các [Root.Owner.GetLinguists] của chúng ta cũng đã dịch được một số bản tin. Họ cho rằng những bản tin này rất đáng để quan tâm:\n\n§LBáo cáo gửi về từ hệ sao Helios đang phác họa nên một viễn cảnh ngày càng tồi tệ hơn. Nhà chức trách hèn nhát của Solfani đã phục kích Đội quân Khai sáng dũng cảm của chúng ta tại vị trí Enypsal! Dù vậy, Lãnh đạo Tối cao của chúng ta đã chỉ ra rằng, tiến trình này sẽ không bị gián đoạn. Ngài nói: 'Ân nhân của chúng ta không hề bỏ rơi chúng ta. Chúng ta cũng không thể bỏ rơi bất kỳ nền văn minh đang phát triển nào.'\n\nCũng có tin đồn cho rằng giữa các chính quyền man rợ tà ác và các đại diện của Liên minh Thiên hà có thể đang tồn tại sự hợp tác. Tuy nhiên, đại sứ của Liên minh Thiên hà đã phủ nhận việc Cộng đồng Liên sao có giao tiếp với bất kỳ kẻ áp bức man rợ nào, và cho rằng đây lại là một ví dụ khác về chứng 'hoang tưởng thuận tiện' của Lãnh đạo Tối cao của chúng ta.\n\nNhưng bất kể có đồng minh hùng mạnh hay không, tiến trình khai sáng Solfani đang trong tình trạng nguy cấp. Lật ngược tình thế này không hề dễ dàng, nhưng-§!\n\n§TĐáng tiếc là phần còn lại của bản tin bị hư hỏng quá nặng, không thể giải mã được. Các [Root.Owner.GetEngineerPlural] của chúng ta đã tạo một bản sao của cơ sở dữ liệu. Hy vọng thời gian trôi qua, chúng ta có thể khôi phục thêm nhiều thông tin từ nền văn minh đã bị lãng quên từ lâu này.§!"
 cstorms.235.a: "Chúng ta mong đợi những khám phá xa hơn."
 #Sự kiện: Một vùng đất cằn cỗi và trống rỗng
 cstorms.245.name: "Vùng đất cằn cỗi"
 cstorms.245.desc: "Cơn bão không gian quét qua hệ sao [planet_windswept_fates.System.GetName] đã tình cờ làm lộ ra một địa điểm khảo cổ tiềm năng trên [planet_windswept_fates.GetName].\n\nCác bản quét sơ bộ đối với §Y[planet_windswept_fates.GetName]§! cho thấy bầu khí quyển của nó cực kỳ bất ổn định, những cơn bão hành tinh khổng lồ thống trị mọi thứ. Các [Root.Owner.GetScientistPlural] của chúng ta chưa bao giờ nghĩ rằng trên một hành tinh như thế này lại có tàn tích của một nền văn minh, họ tin rằng chúng ta có thể học hỏi được nhiều điều từ việc khảo sát."
 cstorms.245.a: "Chuẩn bị phái đội tiên phong đổ bộ!"
 #Điểm khảo cổ: Số phận bị cuốn trôi
 site_adakarria_windswept_fates: "Số phận bị cuốn trôi"
 site_adakarria_windswept_fates_intro: "Dù bão không gian thường mang tính hủy diệt, nhưng cơn bão này lại trở thành cơ hội để chúng ta tìm thấy bằng chứng tồn tại của một nền văn minh ngoài hành tinh. Dẫu cho bầu khí quyển của hành tinh này vô cùng bất ổn định, nhưng nhóm đổ bộ có thể sẽ khám phá ra được số phận kinh hoàng của nền văn hóa cổ đại này."
 cstorms.2105.name: "Môi trường khắc nghiệt"
 cstorms.2105.desc: "Đội tiên phong của chúng ta đã hạ cánh an toàn xuống [From.Planet.GetName] và nhanh chóng bắt tay vào khảo sát môi trường xung quanh.\n\nNhìn từ bề mặt, cơn bão không gian dữ dội mới càn quét qua hệ sao này đã thổi bay lớp bụi và đất dày, làm lộ ra tàn tích của nền văn minh cổ đại này.\n\nKhi các nhà khoa học tiếp tục đi sâu nghiên cứu những khám phá khảo cổ này, họ bàng hoàng nhận ra, lớp cát phủ lên tàn tích có thành phần hoàn toàn khác với lớp đất xung quanh. Quét hành tinh cho thấy những trầm tích này có nguồn gốc từ sa mạc cách đó hàng trăm dặm, chỉ có sức mạnh vô cùng lớn lao, chẳng hạn như những cơn bão hành tinh cực kỳ dữ dội, mới có thể mang chúng đến tận đây."
 cstorms.2105.a: "Tiếp tục."
 cstorms.2110.name: "Những thứ bị lãng quên"
 cstorms.2110.desc: "Bất chấp điều kiện thời tiết kỳ lạ hoành hành trên hành tinh này, các [Root.Owner.GetScientistPlural] của chúng ta đã đạt được nhiều tiến bộ to lớn. Cùng với thời gian trôi qua, những phát hiện của họ lại ngày càng khiến người ta phải bất an và khó hiểu.\n\nBan đầu là một số đồ chạm khắc đá và vật chất hữu cơ bị cháy đen, tiếp đến là vải rách, đồ da, áo giáp phủ polymer, và cuối cùng là hài cốt hữu cơ của cư dân trước đây trên hành tinh.\n\nHết thi thể này đến thi thể khác được tìm thấy, các cơ quan nội tạng khô quắt chứa đầy cát, móng tay bị mài mòn vì vùng vẫy. Mỗi xác chết đều được trang bị quân phục [Root.Owner.GetPreFTLLowerPlural] hạng nặng, cùng các loại vũ khí bắn đạn. Nơi mà chúng ta cứ ngỡ là một thành phố bị bỏ hoang, thực chất lại là một ngôi mộ tập thể.\n\nNhững mẫu vật này có lẽ đã trải qua hàng trăm triệu năm lịch sử, nhưng nhờ bị cô lập hoàn toàn khỏi bức xạ cực tím và các hóa chất phản ứng, tàn tích hữu cơ và trang thiết bị của họ đều được bảo tồn hoàn hảo. Chuyện gì đã xảy ra với họ ở đây vẫn là một ẩn số."
 cstorms.2110.a: "Thật là tàn nhẫn."
 cstorms.2115.name: "Bạo lực giáng xuống từ bầu trời"
 cstorms.2115.desc: "Những khám phá mới trên [From.Planet.GetName] vẫn đáng lo ngại như mọi khi. [Root.GetLeaderName] tin rằng nơi này không giống như một bãi chôn cất, tình trạng thể chất của những người ngoài hành tinh này trước khi bị chôn vùi trong cát dường như rất tốt.\n\nHơn nữa, chúng ta còn tìm thấy một vài ụ vũ khí có khả năng bắn ra đạn dược hạng nặng. Chúng không nhắm vào mục tiêu trên mặt đất, mà nòng súng lại hướng thẳng về phía không gian sâu thẳm.\n\nBất kể những người này phải đối mặt với điều gì, có vẻ như đó là những vị khách đến từ các vì sao."
 cstorms.2120.name: "Cơn bão vĩnh cửu"
 cstorms.2120.desc: "Giả thuyết của chúng ta về ngôi mộ tập thể kỳ lạ tìm thấy trên [From.Planet.GetName] không mang lại bất kỳ kết luận hữu ích nào. Manh mối duy nhất còn sót lại là làm rõ nguồn gốc của thứ cát đã nuốt chửng toàn bộ đội quân.\n\nSau khi thực hiện một loạt các phép tính và mô phỏng cực kỳ phức tạp, chúng ta xác định được rằng cơn bão mang cát đến đây vẫn đang tiếp tục hoành hành ở những nơi khác trên hành tinh. Một đội thám hiểm nhỏ đã được cử đi thám thính.\n\nChào đón họ là một cơn bão dữ dội, những cơn gió cuồng bạo đã khoét thành những rãnh sâu trên mặt đất. Không còn nghi ngờ gì nữa, câu trả lời rất có thể đang được cất giấu trong cái hố sâu này, ngay tại nơi tâm bão đang dừng chân."
 cstorms.2120.a: "Hãy chuẩn bị mọi biện pháp phòng ngừa cần thiết!"
 cstorms.2125.name: "Tàn tích"
 cstorms.2125.desc: "Tìm thấy vị trí này là một điều vô cùng khó khăn, đòi hỏi kỹ năng cực kỳ đỉnh cao và sự tập trung cao độ. Tuy nhiên, ngay tại trung tâm của cái hố và cơn bão, chúng ta đã tìm thấy một bộ hài cốt kỳ lạ. Tàn dư này cũng có tuổi đời tương đương với những thứ trong ngôi mộ tập thể, nhưng kiểu hình và kiểu gen của nó lại hoàn toàn khác biệt so với những xác chết chúng ta từng thấy trước đây.\n\nBộ quân phục của thi thể này được bảo quản tốt đến bất ngờ, và cho thấy một thiết kế hoàn toàn khác. Có dấu hiệu chỉ ra rằng một số chi phụ đã bị cố tình cắt bỏ...\n\nNhưng điều gây tò mò nhất chính là chỉ số trên cảm biến: chúng ta phát hiện có sự dao động năng lượng xung quanh và ngay bên trong hài cốt. Đặc điểm của chúng giống hệt đặc điểm của cơn bão khổng lồ này, cũng giống với cơn bão không gian từng làm lộ ra ngôi mộ tập thể.\n\nMột giả thuyết bắt đầu được hình thành: cá thể này có lẽ có liên quan đến những cơn bão mà chúng ta đang gặp phải? Thậm chí người này có thể chính là nguyên nhân chôn vùi đội quân kia? Nghe có vẻ kỳ quái, nhưng sự thật dường như đang ám chỉ điều đó."
 cstorms.2130.name: "Trở về cát bụi"
 cstorms.2130.desc: "So sánh chéo biểu tượng trên bộ quân phục với cơ sở dữ liệu của chúng ta đã cho ra một kết quả vô cùng bối rối: thi thể này là của một người đến từ Hiệp ước adAkkaria! Chính là nền văn minh sở hữu trạm phát thanh mà chúng ta vừa điều tra cách đây không lâu. Đáng kinh ngạc hơn nữa là, bộ quân phục, lai lịch của cái xác và những thông tin trong chương trình phát thanh đã xâu chuỗi lại thành một bức tranh liền mạch đến kinh ngạc. Bây giờ chúng ta tin rằng, nơi đây chính là hành tinh được nhắc đến trong các chương trình phát thanh kia.\n\nDựa vào kiến thức ngôn ngữ thu thập được từ trạm tuyên truyền, [Root.GetLeaderName] đã giải mã được tên của nạn nhân: §SHatul Galon§!.\n\nNgay sau đó, cơn bão xung quanh bỗng nhiên mở rộng quy mô và cường độ một cách nhanh chóng. Do tính chất cực kỳ khó đoán của loại thời tiết này, rủi ro hiện tại đã trở nên quá cao, chúng ta buộc lòng phải từ bỏ hành tinh này. Manh mối về Hiệp ước adAkkaria một lần nữa lại bị đứt đoạn."
 #Từ cơn bão đến tín hiệu
 cstorms.2140.name: "Tín hiệu từ cơn bão"
 cstorms.2140.desc: "Tín hiệu năng lượng phát ra từ xác chết người ngoài hành tinh này và cơn bão khổng lồ đã tàn phá hành tinh §Y[planet_windswept_fates.GetName]§! hoàn toàn trùng khớp với tín hiệu từ cơn bão không gian đã làm lộ ra đội quân bị chôn sống. Nhật ký cảm biến cho thấy, có một hệ sao mà chúng ta từng khám phá trước đây cũng chứa những biến động năng lượng tương tự. Những điều này hoàn toàn ăn khớp với các thông điệp phát thanh của Hiệp ước adAkkaria!\n\nChúng ta cần phải điều động một tàu thám hiểm đến đó điều tra."
 #Hạm đội mang ba lời nguyền
 site_adakkaria_fleets_of_the_thrice_damned: "Hạm đội mang ba lời nguyền"
 site_adakkaria_fleets_of_the_thrice_damned_intro: "Sự dao động năng lượng kỳ lạ ở khu vực này đang che giấu một bãi tha ma hải quân khổng lồ. Nghĩa địa cấu thành từ kim loại và polymer này có lẽ đang chứa đựng manh mối quan trọng giúp tìm hiểu về Hiệp ước adAkkaria."
 cstorms.2150.name: "Mảnh vỡ hoang tàn"
 cstorms.2150.desc: "Nơi đây đỗ đủ các loại tàu chiến, từ những con tàu vỏ gỗ hình quả trứng cho đến những chiếc phương thuyền tinh thể không gian siêu thực. Rất nhiều hình ảnh trong đó tương tự với những hình ảnh tìm thấy trong các thông điệp phát thanh và nhật ký của trạm liên lạc adAkkaria.\n\nChúng ta phỏng đoán rằng hạm đội của Hiệp ước và hạm đội của Liên minh Thiên hà đã xảy ra xung đột ở đây, cái gọi là hạm đội Liên minh Thiên hà chính là lực lượng gìn giữ hòa bình hệ sao từ vài ngàn năm trước.\n\nMặc dù những con tàu này đã hư hỏng đến mức không thể sửa chữa, nhưng dường như chúng không bị mắc kẹt bởi bất kỳ loại vũ khí thông thường nào, cũng không phải do sự cố máy móc hay những thảm họa tương tự. Phần bên trong của vỏ tàu bị xé nát, giống như bị tấn công bởi một chiếc máy hủy tài liệu khổng lồ vậy."
 cstorms.2155.name: "Giới hạn của trách nhiệm"
 cstorms.2155.desc: "Các [Root.Owner.GetEngineerPlural] của chúng ta đã cẩn thận lấy lại một số cơ sở dữ liệu từ những con tàu trong nghĩa địa. Hầu hết chúng đều đã bị lão hóa quá mức, nhưng có một cơ sở dữ liệu của adAkkaria đã sống sót:\n\n§L——Chúng ta đã bị phục kích! Nhắc lại, chúng ta đã bị phục kích! Liên minh Thiên hà yêu cầu chúng ta phải chấm dứt việc nâng tầm nền văn minh nguyên thủy Rokukola, nếu không sẽ tiêu diệt chúng ta. Hãy phản hồi. Nếu không rút lui, chúng ta sẽ chết ở đây mất! Xin hãy gửi tiếp viện đến đây đi mà!\n\n——Bị từ chối. Sự hy sinh của các bạn sẽ được ghi nhớ.§!"
 cstorms.2155.a: "Họ coi trọng trách nhiệm hơn cả mạng sống!"
 cstorms.2160.name: "Cần quan sát thêm"
 cstorms.2160.desc: "Sau khi các [Root.Owner.GetLinguists] chuyển ngữ nội dung của chương trình phát sóng mới, chúng ta lại có một phát hiện mới: một xác chết đông cứng đang trôi dạt ở trung tâm nghĩa địa!\n\nPhần lớn thi thể này đã héo khô, nhưng trang phục của anh ta cho thấy anh ta là một sĩ quan của Hiệp ước.\n\nKỳ lạ thay, một vành đai bao gồm các mảnh vỡ nhỏ đang xoay quanh vật thể này, dường như anh ta đã tác động một lực hấp dẫn nào đó lên những vật thể này. Thi thể đã được mang lên tàu để tiến hành phân tích sâu hơn."
 cstorms.2165.name: "Lời của người chết"
 cstorms.2165.desc.intro: "Bản dịch của tấm thẻ tên trên cái xác chết đông cứng này cho biết anh ta là một người adAkkaria tên là §SAlata Landil§!. Tương tự như xác chết tìm thấy trên [planet_windswept_fates.GetName], trước khi chết, anh ta cũng đã bị phẫu thuật cắt bỏ một số chi. Tuy nhiên, dù vậy thì bộ hài cốt này cũng đã phải hứng chịu những vết bỏng vô cùng nghiêm trọng. Thân mình anh ta cho thấy dấu vết của việc bị nước sôi dội vào, cùng với một quá trình hồi phục chậm chạp và chắc chắn là vô cùng đau đớn.\n\nCác [Root.Owner.GetScientist] của chúng ta đã đi đến một kết luận đáng buồn, những vết thương này có nét tương đồng đến đáng sợ với các phương pháp tra khảo nhằm moi thông tin từ những người không tự nguyện mà các nền văn minh [Root.Owner.GetPreFTLLowerPlural] hay dùng. Rốt cuộc thì đây là một người lính đã vào sinh ra tử, hay là đã gặp phải chuyện gì đó còn hiểm ác hơn thế?"
 cstorms.2165.desc.def: "$cstorms.2165.desc.intro$\n\nNgay sau khi chúng ta xác định được tính chất của những vết thương này, hệ thống đo lường trên tàu bỗng nhiên xảy ra một đợt dao động năng lượng dữ dội, và [Root.GetLeaderName] đã thét lên một tiếng.\n\nMãi một lúc lâu sau, [Leader.GetHeShe] mới có thể diễn tả lại trải nghiệm vừa rồi như là một cảm giác bị thiêu đốt bởi luồng ánh sáng chói lòa, kéo theo đó là một cơn đau tột cùng. Giống như có một thứ gì đó đang cố cạy mở tâm trí của [Leader.GetHerHis] từ bên trong."
 cstorms.2165.desc.psio: "$cstorms.2165.desc.intro$\n\nNgay sau khi chúng ta xác định được tính chất của những vết thương này, hệ thống đo lường trên tàu bỗng nhiên xảy ra một đợt dao động năng lượng dữ dội, và các thuyền viên có năng lực ngoại cảm của chúng ta đã thét lên.\n\nMãi một lúc lâu sau, họ mới báo cáo rằng, có một khoảnh khắc tâm trí họ hoàn toàn tỉnh táo, theo sau đó là từng cơn tức giận sục sôi. [Root.GetLeaderName] cho biết sâu thẳm trong cơn tức giận là sự kinh ngạc tột độ cùng với một cảm giác bị phản bội sâu sắc. Một ý nghĩ kỳ lạ lóe lên: §LHọ đã chọc giận tôi!§!"
 cstorms.2165.desc.psio_robot: "$cstorms.2165.desc.intro$\n\nNgay sau khi chúng ta xác định được tính chất của những vết thương này, hệ thống đo lường trên tàu bỗng nhiên xảy ra một đợt dao động năng lượng dữ dội, đơn vị được trang bị đầy đủ của chúng ta đã phải hứng chịu một đợt tăng vọt năng lượng từ bên trong.\n\nMãi một lúc lâu sau, họ mới báo cáo rằng, có một khoảnh khắc bộ xử lý ngoại cảm của họ được nạp vào một cơn phẫn nộ tột cùng. [Root.GetLeaderName] cho biết phản ứng cảm xúc này đi kèm với một dòng suy nghĩ, có thể được dịch là: §LHọ đã chọc giận tôi!§!"
 cstorms.2165.desc.gestalt: "$cstorms.2165.desc.intro$\n\nSau phát hiện này, cơ sở dữ liệu của phi hành đoàn chúng ta đã bị một thế lực không thể truy xuất nguồn gốc xâm nhập. Rất nhiều [controller.GetIndividualNamePlural] gợi lại cảm giác trải qua sự gia tăng năng lượng chớp nhoáng và làm suy kiệt cơ thể, trong khi những người khác lại bị phơi bày trước những ảo giác lộn xộn, dưới sự kích thích này, bộ điều chế âm thanh của họ đã phát ra thứ âm thanh chói tai vượt quá 120 decibel."
 cstorms.2165.a: "——Mất tín hiệu——"
 cstorms.2170.name: "Di sản của Landil"
 cstorms.2170.desc.def: "Ngay khi chúng ta thiết lập lại liên lạc với tàu khoa học §Y[Root.GetFleetName]§!, những người trên tàu đã bắt đầu la hét thất thanh. Trải qua một lúc lâu, sau khi đã tương đối bình tĩnh lại, mọi người mới phát hiện ra rằng, cái xác ngoài hành tinh mà họ mang lên tàu mới chính là thủ phạm gây ra đợt bạo loạn này.\n\nCái xác đó đang tạo ra một sức mạnh kỳ lạ nào đó lên tâm trí của họ. Những vật thể nhỏ li ti lơ lửng giữa không trung, bắt đầu xoay quanh cái xác. Một số đoạn tường nội bộ uốn cong và nứt nẻ do áp lực.\n\n§Y[Root.GetLeaderName]§! cố gắng kịp thời thoát khỏi trạng thái căng thẳng, nhanh chóng đẩy cái xác ra khỏi tàu. Chính nhờ phản ứng nhanh nhạy của [Leader.GetHerHis] mà con tàu khoa học này mới có thể thoát khỏi cơn bão không gian xuất hiện vô cùng bất ngờ. Nếu không nhờ [Leader.GetHeShe], bãi tha ma này đã đón chào thêm một con tàu mới.\n\nKhi [Root.GetLeaderName] hồi tưởng lại trải nghiệm của mình, [Leader.GetHeShe] đã chú ý đến một điều nữa: cho dù nguồn gốc sức mạnh kỳ lạ của xác chết là gì, thì nó sẽ tạo thành một mô hình vô cùng đặc biệt trên màn hình chỉ huy của con tàu. Có phải nó đang cố gắng liên lạc? Hay đây là tiếng khóc than vang vọng từ cõi âm?\n\nHiện tại, chúng ta vẫn chưa có câu trả lời."
 cstorms.2170.desc.gestalt: "Những hình ảnh hỗn loạn đã làm hỏng một số [controller.GetIndividualNamePlural] khám phá của chúng ta cuối cùng cũng được giải mã. Chúng tạo thành một hình ảnh về một trạm cư trú cổ đại. [controller.GetScientistCapital] đã bị ám ảnh bởi cảnh tượng một cá thể phải chịu đựng sự hành hạ ngày càng tàn nhẫn. Cơ thể hắn bị cháy xém, nội tạng đang bị luộc chín từ từ.\n\nMột vài [controller.GetIndividualNamePlural] đã cố gắng trốn thoát khỏi cuộc tấn công thính thị giác này. Họ nói rằng, vài mảnh vụn nhỏ bắt đầu lơ lửng trên quỹ đạo bay sát xác chết. Bằng một cách nào đó, những tàn dư hữu cơ này đã tự hình thành nên một trường hấp dẫn của riêng mình.\n\nSức mạnh vô danh này ngày càng trở nên lớn mạnh, cho đến khi một số đoạn tường bên trong bị áp lực làm biến dạng và xé toạc. Ngay khoảnh khắc đó, hệ thống an ninh của chúng ta đã được khởi động lại, và cái xác lại bị tống ra ngoài không gian.\n\nKhông lâu sau, một cơn bão không gian bùng phát trong hệ sao này. Tàu của chúng ta chỉ vừa vặn thoát thân.\n\nBất kể chuyện gì đã thực sự xảy ra ở đó, thì nó cũng mang đến nhiều câu hỏi hơn là câu trả lời."
 #Dự án đặc biệt: Chắp vá quá khứ
 cstorms.2180.name: "Chắp vá quá khứ"
 cstorms.2180.desc: "Sau cuộc chạm trán của [FromFrom.Leader.GetName] tại hệ sao §Y[planet_assembling_the_past.System.GetName]§!, các nhà khoa học của chúng ta ngày càng hứng thú muốn biết rốt cuộc chuyện gì đã xảy ra với Hiệp ước adAkkaria. Những thông tin thu thập được trong quá trình thám hiểm tại [planet_windswept_fates.GetName] và bãi tha ma hạm đội cho thấy, các trạm tuyên truyền của adAkkaria nằm rải rác khắp nơi trong hệ sao.\n\nHơn nữa, sau những cuộc thảo luận kéo dài, họ còn tin rằng, dạng mô hình nhiễu xuất hiện trên [Root.GetName] thực chất là một chuỗi tọa độ của một hệ sao chưa từng được phát hiện trước đây!\n\nChúng ta đã thiết lập một dự án đặc biệt để điều tra hệ sao mới này."
 project_adakkaria_tracing_history: "Theo dấu lịch sử"
 project_adakkaria_tracing_history_DESC: "Các tọa độ chỉ đến một hành tinh nằm trong hệ sao [planet_assembling_the_past.System.GetName]. Chúng ta nên phái một tàu thám hiểm để điều tra mối liên hệ có thể tồn tại giữa hành tinh này và Hiệp ước adAkkaria."
 NAME_adSalivul: "adSalivul"
 NAME_Patriotic_Institute_of_Exalted_Benevolence: "Nhân từ Cao cả"
 cstorms.2185.name: "Trạm cư trú cổ đại"
 cstorms.2185.desc: "Ban đầu chúng ta đã lo sợ rằng cuộc điều tra hệ sao [From.solar_system.GetName] sẽ đi vào ngõ cụt. Hướng đi này dẫn đến một hành tinh đang bị từ trường bất ổn định tàn phá, sự tàn phá nghiêm trọng đến mức toàn bộ địa hình hành tinh đều đã bị phá hủy hoàn toàn. Dưới sự tấn công dữ dội của từ trường như thế này, hầu như không có khả năng tồn tại bất kỳ thứ gì có giá trị ở đây.\n\nTuy nhiên, trên quỹ đạo của hành tinh này lại có một trạm cư trú cổ đại, với cấu trúc kiến trúc tương tự như trạm phát sóng adAkkaria. Mặc dù đã bị niêm phong từ bên ngoài, nhưng chúng ta có thể tận dụng những thông tin khôi phục được từ cơ sở dữ liệu của adAkkaria để tạo ra một tín hiệu cho phép xâm nhập.\n\nĐã hàng trăm triệu năm trôi qua kể từ lần cuối cùng có người đặt chân lên trạm không gian này. Chúng ta không có cách nào biết được điều gì đang chờ đợi mình ở bên trong."
 cstorms.2185.a: "Hành động thận trọng."
 #Hiệp hội Nhân từ Cao cả
 site_adakkaria_the_patriotic_institute: "Hiệp hội Nhân từ Cao cả"
 site_adakkaria_the_patriotic_institute_intro: "Trạm cư trú cổ đại này do Hiệp ước adAkkaria chế tạo, và đang xoay quanh một hành tinh hoang vu. Vật liệu xây dựng chất lượng cao đã giúp cho không gian trạm giữ được trạng thái gần như nguyên sơ.\n\nSau khi dò được tần số đường truyền, chúng ta nhận được một tin nhắn, tiếp sau đó là âm thanh chuông leng keng đầy phô trương: §LChào mừng đến với Hiệp hội Yêu nước Nhân từ Cao cả§!."
 cstorms.2200.name: "Bước vào Hiệp hội Nhân từ"
 cstorms.2200.desc: "Bên kia cửa khóa khí là một mạng lưới đường hầm nhỏ. Ở cuối con đường, chúng ta đã tìm thấy lối vào một quảng trường khổng lồ ngập tràn ánh nắng nhân tạo. Lạ lùng thay, thiết kế kiến trúc của trạm cư trú này lại giống với vùng ngoại ô trên một vài hành tinh định cư, chứ không phải là một trạm khoa học danh tiếng. Trạm cư trú này được thiết kế để chứa cả một tòa chung cư lớn, trung tâm mua sắm, trường học, và còn có cả công viên giải trí, công viên công cộng cùng nhiều tiện ích khác. Đây là nơi được thiết kế cho lối sống xa hoa.\n\nThế nhưng, giờ đây nó đã bị bỏ hoang hoàn toàn. Không hề phát hiện thấy bất kỳ dấu hiệu của một dạng sống hữu cơ nào trên toàn bộ trạm cư trú. Vừa tiếp tục khám phá, chúng ta vừa bị chấn động bởi sự trống rỗng và bầu không khí hoang vu của nơi này.\n\nÁnh nắng nhân tạo thỉnh thoảng lại xảy ra sự cố, đẩy trạm không gian chìm vào bóng tối tạm thời, mặc dù phần lớn các thiết bị điện tử khác vẫn đang hoạt động, nhưng chúng cũng chịu sự ảnh hưởng tương tự. Đáng tò mò nhất là mạng lưới thiết bị giám sát được phát hiện bên trong các căn hộ trên trạm cư trú. Có vẻ như mỗi một công dân ở đây đều bị giám sát vô cùng chặt chẽ. Việc tìm ra một trạm an ninh biết đâu sẽ cung cấp thêm manh mối."
 cstorms.2205.name: "May nhờ sự cố"
 cstorms.2205.desc.intro: "Chúng ta đã dành ra nhiều ngày để khám phá và phân loại cấu trúc của toàn thành phố trên trạm không gian, và cuối cùng cũng tìm ra thiết bị an ninh của nó. Hóa ra, trạm an ninh hoàn toàn bị cách ly khỏi phần còn lại của trạm cư trú, đòi hỏi phải sử dụng một mật khẩu truy cập hoàn toàn khác.\n\nTại đây chúng ta đã tìm thấy những dãy màn hình liên tiếp, phía sau kết nối với một hệ thống thiết bị giám sát khổng lồ. Những thiết bị vẫn còn hoạt động được đã cho chúng ta thấy mọi ngóc ngách của không gian trạm, tất nhiên là chúng cũng sẽ bị ảnh hưởng bởi sự cố mất điện."
 cstorms.2205.desc.mach: "$cstorms.2205.desc.intro$\n\nMáy bay không người lái của chúng ta báo cáo rằng, sau khi chứng kiến cảnh tượng hoang tàn này, chúng cảm thấy lo lắng, bởi nó gợi nhớ đến cuộc chạm trán với Hiệp ước adAkkaria tại nghĩa địa hạm đội cổ đại trước đó.\n\n$cstorms.2205.desc.outro$"
 cstorms.2205.desc.def: "$cstorms.2205.desc.intro$\n\n[Root.GetLeaderName] báo cáo rằng, sau khi chứng kiến cảnh tượng hoang tàn này, [Leader.GetHerHim] đã được khơi lại những ký ức về cuộc chạm trán với Hiệp ước adAkkaria tại nghĩa địa hạm đội cổ đại trước đó.\n\n$cstorms.2205.desc.outro$"
 cstorms.2205.desc.outro: "Nhưng điều gây lo lắng nhất là trung tâm an ninh điều hành mà chúng ta tìm thấy: theo cảnh báo trên màn hình, trạm cư trú này đã được thiết lập chế độ tự hủy!\n\nCác [Root.Owner.GetEngineerPlural] của chúng ta tin rằng hệ thống thành phố đã gặp trục trặc khiến lệnh này không được thực thi. Chúng ta nhanh chóng tắt chương trình tự hủy, đồng thời để các [Root.Owner.GetLinguists] tiến hành giải mã tất cả những nhật ký có thể khôi phục được ở đây. Kỳ lạ thay, các báo cáo từ trạm cư trú này đã chấm dứt gần một năm trước ngày trạm tuyên truyền lưu lại ghi chép cuối cùng."
 cstorms.2210.name: "Cuộc thẩm vấn Tối cao"
 cstorms.2210.desc: "Các [Root.Owner.GetLinguists] của chúng ta đã nhanh chóng làm rõ chức năng của trạm cư trú bao quanh [From.Planet.GetName]: nhật ký và tin nhắn từ công dân cùng đội ngũ nhân viên đều mô tả về quá trình điều tra sự xuất hiện của các năng lực ngoại cảm mới trong nhân dân adAkkaria. Tất cả những người sống ở đây đều nhận được lời mời từ Lãnh đạo Tối cao, đến đây để tận hưởng lối sống xa hoa và tự do thể hiện bản thân. Đổi lại, họ đồng ý tham gia các cuộc thử nghiệm đang được thực hiện trên trạm.\n\nHầu hết công dân đều rất hào hứng muốn tham gia vào dự án này. Nhật ký an ninh cho thấy nhiều người trong số họ là những cựu chiến binh khuyết tật. Họ nhận được sự chăm sóc, hỗ trợ tài chính, cùng lời hứa xóa bỏ mọi rắc rối pháp lý còn dang dở mà họ có thể gặp phải.\n\nQuan trọng hơn, trong danh sách nhân sự của trạm cư trú có một cái tên vô cùng quen thuộc: §SAlata Landil§! Anh ta là một nhà khoa học kiêm cựu chiến binh khuyết tật, thi thể bị cắt cụt chi của anh ta đã được chúng ta tìm thấy tại nghĩa địa hạm đội trước đó."
 cstorms.2210.a: "Cuối cùng cũng có tiến triển."
 cstorms.2215.name: "Thông tin của đối tượng nghiên cứu"
 cstorms.2215.desc: "Chúng ta đã giải mã được dòng tin nhắn cuối cùng gửi đi từ trạm cư trú:\n\n§gTin nhắn——Ngày 02100363——Người gửi: §SSidani Itenpil§!——Người nhận: Sizur Itenpil§!\n§LChào! Mình vẫn còn sống! Xin lỗi vì đã trả lời muộn. Trạm cư trú này bắt đầu trở nên kỳ quái kể từ khi... việc gửi tin nhắn khó khăn vô cùng. Bọn họ bảo không liên quan gì đến chuyện đó cả, nhưng chúng ta đều biết rõ anh ta có khả năng ngoại cảm mà. Còn về phần mình, mình cũng kể với cậu rồi đấy, mình chẳng tiến bộ chút nào, dù sao thì cũng đã xảy ra bao nhiêu chuyện... cho nên họ cũng đề nghị nên thử một vài phương pháp quyết liệt hơn: ...bão không gian. Mình biết cậu đang nghĩ gì, nhưng cũng chỉ là vài ngón tay thôi, biết đâu nó lại mọc ra nhỉ. Nhưng khi... cảm giác mà mình giải phóng ra...! \nYêu cậu, Sidani\n——Truyền tin§!§YĐã kiểm duyệt (Có câu hỏi? Xin vui lòng liên hệ Người hướng dẫn)§!\n\n§gTin nhắn——Ngày 02100365——Người gửi: §SHatul Galon§!——Người nhận: Aidal Asdur§!§L\nAidal thân mến,\nTôi vẫn sống rất tốt ở đây. Tôi cũng đã gặp vài cựu binh khác. Chúng tôi chẳng cần nói với nhau lời nào mà vẫn hiểu nhau, không phải nói chuyện thật tuyệt làm sao.\nHôm nay tôi chỉ mới vừa nghĩ đến việc nâng cái cốc lên, thì nó đã tự bay lên rồi. Tôi vẫn nhớ cái phần phụ bên phải của mình, nhưng có lẽ cuộc sống mới này cũng không tệ như tôi vẫn lo sợ. Tôi nghe nói họ định gửi tôi đi... có vẻ như tôi là một thần đồng ngoại cảm... Tôi... tôi muốn lại được điều động.\nTôi hy vọng có thể về nhà đón Ngày Yêu Nước. Hẹn gặp lại nhé.\nTrân trọng. Hatul.\n——Truyền tin§!§YĐã kiểm duyệt (Có câu hỏi? Xin vui lòng liên hệ Người hướng dẫn)§!\n\n§gTin nhắn——Ngày 02100367——Người gửi: §SEnrida Dylan§!——Người nhận: Onrida Dylan§!\n§LMình vừa dùng ý niệm để dập lửa!!!\nKhông hiểu sao có một đối tượng thí nghiệm đột nhiên trở nên cuồng loạn, và gây ra hỏa hoạn trong nhà ăn. Mọi người đều hoảng sợ, không ai có đường lui! Mình cũng sợ muốn chết, nhưng rồi không hiểu bên trong cơ thể mình đã xảy ra chuyện gì, tự dưng mình đã dập tắt được ngọn lửa!\nMình đã cứu mọi người!! Hãy nói với các trưởng lão rằng mình không phải là một món hàng lỗi hết thuốc chữa, hãy mau đến giúp mình đi!\n——Truyền tin§!§RĐã bị chặn (Báo cáo ngay cho Người hướng dẫn)§!\n\nĐáng chú ý nhất là tin nhắn thứ hai: §SHatul Galon§! chính là tên của thi thể chúng ta từng tìm thấy trong nhiệm vụ khảo cổ trên hành tinh của các [Root.Owner.GetPreFTLLowerPlural]."
 cstorms.2215.a: "Làm tốt lắm!"
 cstorms.2220.name: "Hậu quả của sự cố"
 cstorms.2220.desc: "Những tin nhắn này được lưu lại vài ngày trước khi trạm cư trú tiến hành sơ tán:\n\n§gTin nhắn——Ngày 02100359——Người gửi: Tiến sĩ Tối cao——Người nhận: Tư lệnh Hạm đội Tôn kính§!\n§LTin nhắn trước đó của ngài đã dấy lên một số mối quan ngại ở đây. Ngài có thể giải thích tại sao bao năm qua ngài luôn âm thầm ủng hộ chúng tôi, nhưng giờ lại đột nhiên đe dọa sẽ đóng cửa nơi này không?\n——Truyền tin§!§GĐã gửi§!\n\n§gTin nhắn——Ngày 02100360——Người gửi: Tư lệnh Hạm đội Tôn kính——Người nhận: Tiến sĩ Tối cao§!\n§LÔng đang đùa tôi đấy à. Tôi đã liên tục cảnh báo ông suốt mấy tháng nay rồi, nhưng chắc do quỹ đạo quay quanh cái hành tinh thất thường đó đã gây ra hội chứng mất trí nhớ tạm thời thuận tiện cho ông rồi. Ông biết Liên minh Thiên hà đang đe dọa sự sinh tồn của chúng ta chứ hả? Chiến tranh ngày một khốc liệt, tôi không có cách nào bào chữa cho việc vung phí hàng đống tài nguyên chỉ để đối tượng thí nghiệm của ông ngồi chằm chằm nhìn lũ gia súc cả ngày được. Tôi cần kết quả thực tế, và ngay lập tức.\n——Truyền tin§!§GĐã nhận§!\n\n§gTin nhắn——Ngày 02100360——Người gửi: Tiến sĩ Tối cao——Người nhận: Tư lệnh Hạm đội Tôn kính§!\n§LXin ngài thứ lỗi, chúng tôi đã không nhận được tin nhắn trước đó của ngài. Trạm liên lạc của chúng tôi vẫn luôn bị các lỗi kỹ thuật làm phiền, điều này chắc hẳn cũng đã ảnh hưởng đến hệ thống liên lạc của chúng ta. Dù thế nào đi nữa, chúng tôi cần thêm thời gian. Chúng tôi có các trình tự và giao thức cần tuân thủ, không thể nào bỏ dở giữa chừng được!\n——Truyền tin§!§GĐã gửi§!\n\n§gTin nhắn——Ngày 02100361——Người gửi: Tư lệnh Hạm đội Tôn kính——Người nhận: Tiến sĩ Tối cao§!\n§LCho ông một tuần, nếu không tôi sẽ lập tức ra lệnh đóng cửa. Không có nếu như, không có nhưng, cũng không có cơ hội thứ hai, tôi muốn có kết quả!\n——Truyền tin§!§GĐã nhận§!\n\n§gTin nhắn——Ngày 02100368——Người gửi: Tiến sĩ Tối cao——Người nhận: Tư lệnh Hạm đội Tôn kính§!\n§LĐính kèm là báo cáo tiến độ gần đây nhất của chúng tôi. Các đoạn video chứng minh rằng những người có khả năng ngoại cảm của chúng tôi có thể tác động đến bão không gian. Điều này có thể mang lại những ứng dụng quân sự vô cùng kinh ngạc. Nếu có đủ thời gian, chúng tôi có thể tăng cường khả năng ngoại cảm của họ mà không gây ra những tổn thương về thể chất hay tâm lý.\n——Truyền tin§!§RThất bại (Lý do: Ma trận truyền tin sụp đổ)§!"
 cstorms.2220.a: "Tin nhắn cuối cùng đã không được gửi đi."
 cstorms.2225.name: "Số phận dang dở"
 cstorms.2225.desc: "Đây là tin nhắn cuối cùng được khôi phục:\n§L\n\nCác đồng nghiệp thân mến,\n\nTôi mang tâm trạng nặng trĩu thông báo với các bạn rằng, Bộ Chỉ huy Tối cao đã quyết định chấm dứt mọi hoạt động của Hiệp hội Yêu nước Nhân từ Cao cả.\n\nĐây không phải là một lời buộc tội đối với công việc của các bạn. Được làm việc cùng các bạn là niềm vinh hạnh của tôi. Tôi biết các bạn sẽ có rất nhiều nghi vấn, nhưng nói ngắn gọn là, kỳ vọng của Hiệp hội Nhân từ Cao cả không còn đồng bộ với mục tiêu nghiên cứu của chúng ta nữa.\n\nVề phía các công dân, Bộ Chỉ huy Tôn kính mời họ đến tham gia dự án tại $building_adakkaria_patriotic_institute$ ở adSul. Các bạn có thể xem danh sách nhân sự đầy đủ ở bên dưới.\n\nCòn về những người khác... rất tiếc phải nói rằng tính bảo mật cho nghiên cứu của chúng ta đồng nghĩa với việc các đối tượng tham gia nghiên cứu sẽ không được phép quay trở lại xã hội. Bộ Chỉ huy Tôn kính đã đồng ý phái một đơn vị đặc nhiệm phụ trách xử lý họ. Các bạn không cần phải tự mình chứng kiến, điều này bản thân nó cũng là một ân huệ. Thân nhân của họ sẽ nhận được khoản bồi thường tối đa.\n\nTrân trọng.\nTiến sĩ Tối cao, §!§SAlata Landil§!\n\nDanh sách đính kèm dù đã bị hỏng một phần, nhưng vẫn nhắc đến §SHatul Galon§! và §SEnrida Dylan§!. Có vẻ như họ đã được chuyển đến thủ đô adSul của Hiệp ước adAkkaria. Bây giờ chúng ta đã có tọa độ của hành tinh này."
 cstorms.2225.a: "Thiết lập lộ trình đến hành tinh mẹ của Hiệp ước."
 #Dự án đặc biệt: Trái tim của Hiệp ước / Tiếng gọi của Hư không
 cstorms.2240.name: "Trái tim của Hiệp ước"
 cstorms.2240.desc: "Chuỗi tọa độ này đã tiết lộ một hệ sao từng bị ẩn khỏi các lần quét của chúng ta. Đã đến lúc ghé thăm Hiệp ước adAkkaria, trước khi những kẻ khác kịp làm điều đó.\n\nMột dự án đặc biệt mới đã được khởi xướng."
 cstorms.2245.name: "Tiếng gọi của Hư không"
 cstorms.2245.desc: "Ngay sau khi rời khỏi trạm cư trú, [event_target:leader_patriotic_institute.GetName] đã đưa ra một quyết định đột ngột và gây sốc. Tựa như bị một ngoại lực nào đó thao túng, [event_target:leader_patriotic_institute.GetHeShe] ra lệnh cho con tàu mở một kênh liên lạc vốn thường được sử dụng cho các sự kiện ngoại cảm quy mô lớn hoặc kết nối với các cơn bão không gian thoáng qua.\n\nKênh này được trỏ đến cùng một tọa độ với hệ sao mẹ của Hiệp ước adAkkaria. Chỉ sau một thời gian ngắn, cuộc gọi của chúng ta đã có hồi đáp."
 cstorms.2245.desc.gestalt: "Ngay sau khi rời khỏi trạm cư trú, nghi thức của Tập thể chúng ta đã bị nhiễu bởi một rung động bất thường, như thể có thứ gì đó đang cố gắng giao tiếp với chúng ta từ một nơi rất xa. Tín hiệu này phát ra từ cùng một tọa độ với hệ sao mẹ của Hiệp ước adAkkaria, và xảy ra trên một tần số thường thấy đối với các sự kiện ngoại cảm quy mô lớn hoặc đường đi của những cơn bão không gian chớp nhoáng.\n\nCuộc gọi phản hồi của chúng ta đã ngay lập tức nhận được hồi đáp."
 cstorms.2250.name: "Tiếng gọi của Cơn bão"
 cstorms.2250.desc: "Dù chúng ta đã thử qua mọi phương án, nhưng việc tiếp cận adSul vẫn khó khăn hơn tưởng tượng rất nhiều. Toàn bộ hệ sao bị nuốt trọn bởi một cơn bão không gian với thành phần cấu tạo không xác định, khiến chúng ta không thể lại gần hành tinh này.\n\nCòn về phần cơn bão nhấn chìm hệ sao này, nó có vẻ như đang... chào hỏi chúng ta?"
 #Cơn bão
 cstorms.2260.name: "Cơn bão"
 cstorms.2260.desc: "Hãy gọi tên chúng ta\n\nHãy gọi tên chúng ta\n\nHãy | Gọi | Tên | Ta"
 cstorms.2260.a: "Ngươi là ai?"
 cstorms.2260.b: "Chuyện gì đã xảy ra ở đây?"
 cstorms.2260.c: "Tên gì?"
 cstorms.2260.a.resp: "Có | Không | Sai\n\nGió gầm và bão rít\n\nVừa đau vừa giận vừa buồn vừa sợ\n\nHãy gọi tên chúng ta"
 cstorms.2260.b.resp: "Kích | Gọi | Triệu\n\nHãy gọi tên chúng ta"
 cstorms.2265.name: "$cstorms.2260.name$"
 cstorms.2265.desc: "Ta không thể nghĩ | nói | ước | ngủ\n\nTên của chúng ta gọi ta | Trả lại ta cho chúng ta | Cả thế giới đã quên ta\n\nHãy gọi tên chúng ta"
 cstorms.2265.c.resp: "$cstorms.2265.desc$"
 cstorms.2265.d: "Chúng ta có thể biết tên ngươi ở đâu?"
 cstorms.2265.e: "Hãy cho chúng ta xem lễ kỷ niệm này."
 cstorms.2270.name: "$cstorms.2260.name$"
 cstorms.2270.desc: "Đây là lễ kỷ niệm\n\nĐây chính là lễ kỷ niệm\n\nĐau | Giận | Buồn | Sợ\n\nLễ kỷ niệm\n\nHãy gọi tên chúng ta"
 NAME_adSul: "adSul"
 project_adakkaria_benevolent_grounds: "Vùng đất Nhân từ"
 project_adakkaria_benevolent_grounds_DESC: "Chúng ta đã khôi phục lại được tọa độ hành tinh mẹ của Hiệp ước adAkkaria.\n\nKhám phá hệ sao và hành tinh này biết đâu sẽ giúp vén bức màn bí mật về số phận của nền văn minh adAkkaria."
 # Lễ Kỷ Niệm
 site_adakkaria_celebration: "Học Viện Kỷ Niệm"
 site_adakkaria_celebration_intro: "Sau khi giao tiếp với cơn bão không gian, adSul đã tiết lộ một phần nhỏ của mình cho chúng ta thấy. Một khu phức hợp khổng lồ sừng sững giữa những đám mây tàn. Nơi này đã bị bỏ hoang từ lâu, nhưng kỳ lạ thay lại không hề bị ảnh hưởng bởi thời gian, và máy quét cho thấy có vật chất hữu cơ bên trong.\n\nTrước tòa nhà khổng lồ này giăng đầy những biểu ngữ mang cùng một dòng chữ: Đã đến giờ kỷ niệm."
 cstorms.2285.name: "Sự Hư Vô Cưỡng Chế"
 cstorms.2285.desc: "Những đại sảnh trống rỗng của Học Viện Kỷ Niệm chẳng có gì ngoài bề dày lịch sử và bụi bặm. Những tấm áp phích tuyên truyền ca ngợi sự anh dũng vĩnh cửu của Hiệp ước adAkkaria là tất cả những gì còn sót lại của một đế chế từng vô cùng phồn vinh và đáng sợ.\n\nTuy nhiên, những nỗ lực ngôn ngữ của chúng ta đã được đền đáp; hệ thống an ninh ở đây mỏng manh đến mức máy chủ chính dễ dàng tiết lộ những bí mật của nó.\n\nTrong các nhật ký được khôi phục, nơi này tràn ngập các hoạt động nhộn nhịp cho đến tận ngay trước đợt phát sóng cuối cùng của trạm tuyên truyền.\n\nVà kể từ ngày đó, Hiệp ước Nhân từ adAkkaria đã biến mất không để lại một dấu vết."
 cstorms.2290.name: "Tiến Vào Vùng Đất Bị Nguyền Rủa"
 cstorms.2290.desc: "Mang theo một chút sợ hãi xen lẫn tò mò, chúng ta đã tiến sâu vào phần dưới mặt đất của công trình này. Chào đón chúng ta là một mạng lưới phòng thí nghiệm khổng lồ được quy hoạch cẩn thận. Đội của chúng ta chia làm hai, một nửa phụ trách điều tra các phòng thí nghiệm để hiểu rõ hơn về vai trò của Học Viện Kỷ Niệm, nửa còn lại tiếp tục đi xuống sâu hơn.\n\nMáy quét của chúng ta cho thấy có sự hiện diện của vật chất hữu cơ, và chẳng mấy chốc nguyên nhân đã được làm rõ: các tầng dưới của Học Viện Kỷ Niệm là phòng quan sát. Hài cốt xác ướp của những công dân adAkkaria vẫn bị giam cầm trong các phòng giam chật hẹp này. Giao diện kỹ thuật số cạnh mỗi phòng hiển thị tên của người bên trong, giai đoạn thí nghiệm họ phải chịu đựng và các ghi chú của quan sát viên.\n\nĐồng thời, chúng ta đã khôi phục được tin nhắn sau:\n§LChạy thử nghiệm của chúng ta ở hệ sao Helios là một thảm họa tột cùng. Việc triển khai ban đầu đối với đối tượng §SHatul Galon§! diễn ra đúng kế hoạch. Nhưng khi chạm trán quân đội man rợ Solfani, đối tượng đã mất kiểm soát. Khi cơn bão quét sạch đội quân nguyên thủy, quân đội của chúng ta cũng vạ lây.\n\nĐiều đầu tiên cần hiểu là, những đối tượng này kém cỏi và tâm trí bất thường. Thiết bị gọi bão tốt nhất là nên đưa vào hoạt động càng sớm càng tốt.§!"
 cstorms.2290.a: "Bọn họ làm thí nghiệm gì ở đây vậy?"
 cstorms.2290.a.gen: "Giết nhiều như vậy sao, thật đáng kích động."
 cstorms.2295.name: "Các Loại Kỷ Niệm"
 cstorms.2295.desc.start.authgen: "Những thí nghiệm của Hiệp ước adAkkaria thật sự cuốn hút. Mỗi tù nhân đều ở một giai đoạn khác nhau, càng tiến sâu vào các giai đoạn, các thí nghiệm càng trở nên tàn nhẫn. Một số phương pháp sáng tạo nổi bật như: họ dùng lửa đốt và điện giật để khởi động sự tích tụ ngoại cảm của cơ thể; cắt bỏ các cơ quan quan trọng để kích thích sức mạnh tái tạo và kích hoạt thêm giác quan; hay sử dụng các chất làm biến đổi tâm trí để đẩy người ta vào trạng thái cận kề cái chết, v.v.\n\nTất nhiên, có những điều chúng ta có thể học hỏi ở đây. Các chuyên gia này đang hướng tới một mục tiêu chung, đó là để quyền bá chủ của người adAkkaria càn quét toàn thiên hà.\n\nMặc dù vậy, các báo cáo cho thấy những thí nghiệm này có thể không phải là nguyên nhân gây ra cái chết cho các đối tượng. Giống như §SHatul Galon§!, dường như họ chỉ đơn giản là bị bỏ rơi ở đây."
 cstorms.2295.desc.start.default: "Cảm giác sợ hãi và bối rối khi chúng ta tận mắt chứng kiến hài cốt của những người bị hại thật sự đáng sợ. Dù vậy, mong muốn hiểu rõ phạm vi và mục đích của các thí nghiệm của Hiệp ước cũng mãnh liệt không kém.\n\nCác nhà khoa học adAkkaria đã báo cáo về những gì họ làm với những người này bằng một giọng điệu lạnh lùng và khô khan. Mỗi nạn nhân đều ở một giai đoạn khác nhau, và càng về sau, các thí nghiệm càng trở nên tàn nhẫn. Lửa đốt, điện giật, cắt cụt chi, tước đoạt giác quan và bỏ đói — những thảm cảnh không từ ngữ nào tả xiết. Tất cả những thứ này đều được thực hiện dưới danh nghĩa cái gọi là 'sứ mệnh quang vinh' nhằm duy trì quyền bá chủ thiên hà của người adAkkaria. Mặc dù vậy, các báo cáo cho thấy, ngay cả những thao tác kinh hoàng như vậy cũng có thể chưa chắc đã giết chết đối tượng thí nghiệm. Giống như §SHatul Galon§!, dường như họ chỉ đơn giản là bị bỏ rơi ở đây."
 cstorms.2295.desc.end.default: "Ngay sau khi chúng ta quan sát xong, [Root.GetLeaderName] đột nhiên suy sụp. Trong tiếng rên rỉ đau đớn, [Root.GetLeaderName] gào thét rằng có thứ gì đó đã đục khoét tâm trí của [Leader.GetHerHim]!\n\nMặc dù tình hình hiện tại đã ổn định, nhưng dường như có một thực thể xâm nhập nào đó đang cố gắng nhồi nhét một tập hợp những nhận thức kỳ lạ vào [Leader.GetHerHim]. [Root.GetLeaderName] mong muốn được thử lại lần nữa, tin rằng trải nghiệm này cuối cùng sẽ mang lại một tác động sâu sắc."
 cstorms.2295.desc.end.psionic: "[Root.GetLeaderName] đang quan sát những thi thể này thì đột nhiên nghe thấy những lời thì thầm kỳ lạ, những giọng nói trống rỗng xen lẫn khao khát mãnh liệt đang kêu gọi:\n§LChúng tôi vô cùng trung thành! Chúng tôi tự hào về Hiệp ước, tin tưởng vào sứ mệnh của Hiệp ước.\nCơn bão vẫn luôn vẫy gọi chúng tôi, chúng đang nuốt chửng và khao khát chúng tôi!\nChúng tôi hoàn thành mọi nhiệm vụ. Chúng tôi tài năng và bất khuất!\nVậy mà họ lại vu khống chúng tôi là xấu xa, phản bội, họ tàn sát người thân và bạn bè của chúng tôi!\n\nĐáng lẽ đây phải là một lễ kỷ niệm!§!\n\nNhững lời thì thầm này dẫn chúng ta đến một hành lang có biển báo 'Giai đoạn Cuối'. Nhưng những biện pháp an ninh cao cấp hơn đã chặn đường chúng ta."
 cstorms.2295.desc.end.psionic_individual_robot: "[Root.GetLeaderName] đang phân tích những thi thể này thì [Leader.GetHeShe] bỗng bắt được một thông điệp ngoại cảm có thể giải mã được:\n§LChúng tôi vô cùng trung thành! Chúng tôi tự hào về Hiệp ước, tin tưởng vào sứ mệnh của Hiệp ước.\nCơn bão vẫn luôn vẫy gọi chúng tôi, chúng đang nuốt chửng và khao khát chúng tôi!\nChúng tôi hoàn thành mọi nhiệm vụ. Chúng tôi tài năng và bất khuất!\nVậy mà họ lại vu khống chúng tôi là xấu xa, phản bội, họ tàn sát người thân và bạn bè của chúng tôi!\n\nĐáng lẽ đây phải là một lễ kỷ niệm!§!\n\nNhững thông điệp này dẫn chúng ta đến một hành lang có biển báo 'Giai đoạn Cuối'. Nhưng những biện pháp an ninh cao cấp hơn đã chặn đường chúng ta."
 cstorms.2295.desc.end.psionic_gestalt: "Khi chúng ta điều tra những thi thể này, một tiếng lòng mới đã truyền qua tập thể, lấy [Root.GetLeaderName] làm kênh giao tiếp:\n§LChúng tôi vô cùng trung thành! Chúng tôi tự hào về Hiệp ước, tin tưởng vào sứ mệnh của Hiệp ước.\nCơn bão vẫn luôn vẫy gọi chúng tôi, chúng đang nuốt chửng và khao khát chúng tôi!\nChúng tôi hoàn thành mọi nhiệm vụ. Chúng tôi tài năng và bất khuất!\nVậy mà họ lại vu khống chúng tôi là xấu xa, phản bội, họ tàn sát người thân và bạn bè của chúng tôi!\n\nĐáng lẽ đây phải là một lễ kỷ niệm!§!\n\nNhững lời thì thầm này dẫn chúng ta đến một hành lang có biển báo 'Giai đoạn Cuối'. Nhưng những biện pháp an ninh cao cấp hơn đã chặn đường chúng ta."
 cstorms.2295.desc.end.gestalt: "Trong tiến trình nhận thức của các [controller.GetIndividualNamePlural] xuất hiện thêm nhiều biến dạng kỳ lạ, khơi dậy những ý nghĩ không thuộc về chính chúng ta. Qua những suy nghĩ này, chúng ta biết được rằng các đối tượng thử nghiệm của viện nghiên cứu đã giao tiếp với nhau bằng các phương thức phi vật lý, một kiểu giao tiếp gần như tức thời, tương tự như một tâm trí bầy đàn sơ khai.\n\nMặc dù chúng ta không thể giải mã chính xác câu chữ, nhưng mục đích của cuộc thảo luận rất rõ ràng: có một cuộc nổi loạn đang âm thầm nhen nhóm trong buổi lễ kỷ niệm này."
 cstorms.2295.desc.authgen.default: "$cstorms.2295.desc.start.authgen$\n\n$cstorms.2295.desc.end.default$"
 cstorms.2295.desc.authgen.psionic: "$cstorms.2295.desc.start.authgen$\n\n$cstorms.2295.desc.end.psionic$"
 cstorms.2295.desc.authgen.psionic_individual_robot: "$cstorms.2295.desc.start.authgen$\n\n$cstorms.2295.desc.end.psionic_individual_robot$"
