 STORM_PREFIX_10: "Dòng Xoáy $NAME$"
 #################
 # Sự Kiện Thuộc Địa #
 #################
 # Lõi Hành Tinh Bị Từ Hóa
 pm_magnetized_planetary_core: "Lõi Hành Tinh Siêu Từ Hóa"
 pm_magnetized_planetary_core_desc: "Hoạt động điện từ sâu dưới lớp phủ khiến cho việc khai thác từ tính trở nên khả thi, nhưng đồng thời nó cũng phá hủy các cơ sở hạ tầng kỹ thuật."
 cstorms.1705.name: "$pm_magnetized_planetary_core$"
 cstorms.1705.desc: "Theo các báo cáo, sau trận §Y$magnetic_storm$§! gần đây, [this.GetName] đã xuất hiện những di chứng bất thường. Trường năng lượng khổng lồ của cơn bão đã gia tăng sự dao động từ trường trong lõi nóng chảy của hành tinh, dẫn đến sự đình trệ trên diện rộng của các cơ sở hạ tầng công nghệ.\n\nTuy nhiên, tình trạng này cũng mang đến một cơ hội khai thác tài nguyên có một không hai. Dòng dung nham giàu kim loại bên dưới lớp phủ đã được tích điện, và chúng ta có thể thu hoạch chúng dưới sự trợ giúp của các thỏi nam châm khai khoáng."
 # Đại Dương Tích Điện
 d_electrified_oceans: "Đại Dương Tích Điện"
 d_electrified_oceans_desc: "Một dòng điện vĩnh cửu đang cuộn trào bên trong những đại dương bao la của hành tinh."
 GLACIAL_OCEANS: "Đại Dương Dưới Băng"
 DEFAULT_OCEANS: "Đại Dương"
 cstorms.1715.name: "$d_electrified_oceans$"
 cstorms.1715.desc.common: "Sau trận §Y$electric_storm$§! gần đây, một hiện tượng dị thường đã được quan sát thấy trên [this.GetName]. Các [GetOceansState] của hành tinh này giờ đây đã chứa đầy những dòng điện vĩnh cửu, những dòng điện này tuần hoàn trong các vùng nước rộng lớn, tạo ra mối đe dọa chí mạng đối với các sinh vật thủy sinh."
 cstorms.1715.desc.aquatic: "Điều này tạo ra mối đe dọa nghiêm trọng đối với viễn cảnh sinh tồn của thuộc địa chúng ta, và chúng ta cần phải giải quyết nó ngay lập tức."
 cstorms.1715.desc.non_aquatic: "Dù hiện tượng này không gây ra tổn hại trực tiếp nào cho chúng ta, nhưng nó lại tạo ra thách thức cho sự phát triển trong tương lai của thuộc địa."
 cstorms.1715.a: "Giải phóng dòng điện."
 cstorms.1715.b: "Chúng ta phải học cách làm quen với nó thôi."
 # Bóng Ma Hiện Hình
 d_ghostly_canyon: "Hẻm Núi U Linh"
 d_ghostly_canyon_desc: "Những người ghé thăm hẻm núi này đã tận mắt chứng kiến những bóng ma thanh tao."
 cstorms.1725.name: "Bóng Ma Trùng Trùng"
 cstorms.1725.desc.common: "Sau sự kiện §Y$shroud_storm$§! gần đây tại [this.solar_system.GetName], các [owner.GetColonistPlural] báo cáo rằng họ đã phát hiện ra những hiện tượng bí ẩn khó bề giải thích bên trong một hẻm núi biệt lập. Những bóng ma màu xanh lam xuất hiện trong chốc lát, có vẻ như chúng không thể hoặc không muốn tương tác với [owner.GetColonistPlural] của chúng ta, chúng chỉ lang thang vô định, và rồi biến mất."
 cstorms.1725.desc.psionic: "Mặc dù về bản chất những bóng ma này có vẻ là các thực thể ngoại cảm, nhưng chúng ta vẫn không thể thiết lập bất kỳ giao tiếp tinh thần nào với chúng. Tuy nhiên, chúng ta phát hiện ra rằng sự tồn tại của chúng lại là một yếu tố cường hóa thụ động cho khả năng ngoại cảm của chúng ta."
 cstorms.1725.desc.psionic_robot: "Mặc dù về bản chất những bóng ma này có vẻ là các thực thể ngoại cảm, nhưng chúng ta vẫn không thể thiết lập bất kỳ giao tiếp tinh thần nào với chúng. Tuy nhiên, quá trình kiểm tra hệ thống đã xác nhận rằng sự xuất hiện của chúng lại mang đến sự hỗ trợ tích cực cho khả năng ngoại cảm của chúng ta."
 cstorms.1725.desc.spiritualist: "Hiện tượng phi thường này như một lời nhắc nhở rằng, luôn tồn tại những kỳ tích vô hình trong cuộc sống của chúng ta."
 cstorms.1725.desc.gestalt: "Cho đến thời điểm hiện tại, không có thêm báo cáo nào về thương vong hay thiệt hại."
 cstorms.1725.desc.default: "Cho đến thời điểm hiện tại, không có báo cáo nào về thương vong hay thiệt hại. Mặc dù vậy, hiện tượng kỳ lạ này vẫn khiến người ta cảm thấy bất an và phân tâm."
 cstorms.1725.a: "Lấp đầy hẻm núi bằng đất đá. Người chết rồi sẽ được chôn cất an nghỉ."
 # Núi lửa Ngưng hoạt động
 cstorms.1735.name: "Núi lửa Tắt"
 cstorms.1735.desc: "Lượng bức xạ còn sót lại từ cơn §H[this.GetAffectedStormType]§! gần đây đã làm cho các hoạt động địa chất trên §Y[this.GetName]§! trở nên dị thường.\n\nĐáng chú ý nhất, sức mạnh của cơn bão đã khiến một ngọn núi lửa đang hoạt động hoàn toàn ngủ yên, cô lập nó khỏi điểm nóng địa chất và cắt đứt nguồn cung cấp magma.\n\nNhờ lớp magma đã nguội tạo thêm vùng đất mới, chúng ta có thêm những cơ hội tuyệt vời để tiếp tục khai phá hành tinh này."
 # Ngọn núi trên Không
 d_sky_mountain: "Ngọn núi trên Không"
 d_sky_mountain_desc: "Một dãy núi khổng lồ lơ lửng giữa tầng khí quyển loãng của hành tinh, để lộ ra những mỏ khoáng sản hoàn toàn mới."
 unlocks_zone_minerals_physics: "$t$Mở khóa Chuyên môn hóa Khu vực: §Y$zone_minerals_physics$§!"
 cstorms.1745.name: "$d_sky_mountain$"
 cstorms.1745.desc: "Một trận §Y$gravity_storm$§! dữ dội đã làm biến đổi hoàn toàn cảnh quan của §H[this.GetName]§!. Những đợt sóng trọng lực mạnh mẽ từ cơn bão đã bứt tung dãy núi cao nhất khỏi lớp vỏ kiến tạo và nhấc bổng nó lên bầu trời.\n\nGiờ đây, nó vẫn đang lơ lửng trên tầng khí quyển, được giữ ở trên cao nhờ lực hấp dẫn còn sót lại của cơn bão. Sự biến động lớn này đã làm lộ ra những mỏ khoáng sản vốn nằm sâu dưới tầng đá nền không thể khai thác trước đây, đồng thời mang lại vô số dữ liệu cho [owner.GetResearchers] nghiên cứu."
 # Sông băng Tan chảy
 cstorms.1755.name: "Sông Băng Tan Chảy"
 cstorms.1755.desc.common: "Trận §Y[this.GetAffectedStormType]§! gần đây đã gây ra những tác động ngoài ý muốn đối với khí hậu trên [this.GetName]."
 cstorms.1755.desc.electric: "Điện tích tích tụ trong bầu khí quyển đã dẫn đến những biến đổi nhiệt độ khắc nghiệt ở các khu vực vùng cực. $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.particle: "Điện tích tích tụ trong bầu khí quyển đã dẫn đến những biến đổi nhiệt độ khắc nghiệt ở các khu vực vùng cực. $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.gravity: "Sự thay đổi trọng lực do cơn bão mang lại đã xé toạc nhiều lớp băng dưới nước, $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.magnetic: "Sự nhiễu loạn từ trường hành tinh được sinh ra đã gây nên những chấn động địa chấn dữ dội, $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.solar: "Nhiệt lượng cực đoan của cơn bão đã nung nóng toàn bộ hành tinh trong suốt khoảng thời gian nó kéo dài, $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.celestial: "Nồng độ cực cao của bụi sao siêu nhiệt đã ảnh hưởng nghiêm trọng đến các khu vực vùng cực, $cstorms.1755.desc.common_2$"
 cstorms.1755.desc.common_2: "khiến cho vùng lãnh nguyên từng không thể tiếp cận nay đã bị rã đông.\n\nBây giờ chúng ta đã có thể khai thác vùng đất mới được khám phá này."
 # Thức Uống Đầy Bụi
 cstorms.1761.name: "Sự Tắc Nghẽn Vũ Trụ"
 cstorms.1761.desc.common: "Các [Owner.GetEngineerPlural] của chúng ta trên §H[this.GetName]§! báo cáo rằng §Y$celestial_storm$§! đã gây ra tác động bất lợi cho hệ thống lọc nước. Khi các hạt lắng đọng trong mạch nước ngầm của hành tinh, hỗn hợp bùn khoáng được tạo ra đã làm tắc nghẽn các cơ sở hạ tầng trọng yếu."
 cstorms.1761.desc.default: "Sự cố thủy canh phát sinh từ việc này đã ảnh hưởng nghiêm trọng đến nền nông nghiệp trên hành tinh, đồng thời dẫn đến tình trạng thiếu hụt nước uống an toàn.\n\nNếu không được giải quyết, vấn đề này có thể sẽ gây ra những hệ lụy lâu dài đối với nguồn cung cấp nước của chúng ta. Rất may là các [owner.GetEngineerPlural] của chúng ta khá tự tin rằng họ có thể thiết kế ra một hệ thống lọc mạnh mẽ hơn để khắc phục tình trạng này."
 cstorms.1761.desc.lithoid: "Trong quá trình nghiên cứu tình trạng tắc nghẽn thủy canh, các [Owner.GetColonistPlural] của chúng ta phát hiện ra rằng, bản thân lớp bùn khoáng hóa lại là một món ăn vừa ngon miệng vừa bổ dưỡng đối với sinh lý học của dân số Kẻ Ăn Đá. Sau một vài tinh chỉnh nhỏ đối với hệ thống lọc của thuộc địa, chúng đã được sản xuất hàng loạt thành một loại thức uống theo mùa mới mẻ, và sẽ được cung cấp cho đến khi cơn bão kết thúc."
 cstorms.1761.a: "Tiến hành nghiên cứu."
 cstorms.1761.b: "Thu hoạch ngoài ý muốn."
 pm_satured_filtration: "Bộ Lọc Bão Hòa"
 pm_satured_filtration_desc: "Nguồn tài nguyên nước ở địa phương đã bị bão hòa bởi bụi sao vũ trụ, dẫn đến sự tắc nghẽn của mạng lưới thủy canh."
 filtration_insight_modifier: "Sáng Kiến Lọc Thủy Canh"
 CLEAR_DUSTY_PIPES_PROJECT: "Dọn Dẹp Đường Ống"
 CLEAR_DUSTY_PIPES_PROJECT_DESC: "Ảnh hưởng của §Y$celestial_storm$§! đối với §H[this.GetName]§! đã khiến hệ thống lọc nước bị tắc nghẽn bởi vô số lớp bùn khoáng không thể hòa tan. Chúng ta phải nâng cấp và cải tạo thành một hệ thống lọc mạnh mẽ hơn để giải quyết triệt để vấn đề này."
 cstorms.1765.name: "Khai Thông Bộ Lọc"
 cstorms.1765.desc: "Các [Owner.GetEngineerPlural] đã giải quyết xong tình trạng tắc nghẽn thủy canh và thiếu hụt nước trên §H[this.GetName]§!. Mạng lưới cung cấp nước của thuộc địa đã được nâng cấp, và giờ đây đã có thể lọc sạch những tạp chất phức tạp do $celestial_storm$ mang lại.\n\nNhững cải tiến đối với cơ sở hạ tầng cung cấp nước này cũng có thể được áp dụng để nâng cao hiệu quả cho các hoạt động tưới tiêu trên [Owner.GetName]."
 # Quần Thể Sinh Vật Không Thể Bay
 cstorms.1771.name: "Đôi Cánh Không Thể Bay"
 cstorms.1771.desc.common: "Các [Owner.GetScientistPlural] trên [this.GetName] đã quan sát thấy §Y$gravity_storm$§! đã gây ra tác động nghiêm trọng đối với các loài chim hoang dã bản địa.\n\nSự biến động trọng lực do cơn bão mang lại đã gây ra những điều kiện khí quyển bất thường, khiến cho nhiều loài chim không thể cất cánh bay lượn."
 cstorms.1771.desc.default: "Điều này không chỉ khiến chúng không thể săn mồi bình thường, mà còn khiến chúng dễ trở thành mục tiêu tấn công của các loài ăn thịt hơn.\n\nCó người đang lo ngại rằng, nếu chúng ta không can thiệp, những giống loài bị ảnh hưởng này có thể sẽ phải đối mặt với nguy cơ tuyệt chủng."
 cstorms.1771.desc.swarm: "Một bữa tiệc thịnh soạn thực sự đang chờ đón chúng ta."
 cstorms.1771.a: "Chỉ là con mồi mà thôi."
 cstorms.1771.b: "Cứ thuận theo tự nhiên đi."
 cstorms.1771.c: "Đưa những sinh vật này vào khu bảo tồn."
 cstorms.1771.evopred: "Bảo tồn vật chất di truyền của chúng trước khi mọi chuyện kết thúc."
 d_avian_reserve: "Khu Bảo Tồn Loài Chim"
 d_avian_reserve_desc: "Một khu bảo tồn thiên nhiên ẩn dật, được xây dựng để bảo vệ những loài chim nhỏ bé yếu ớt."
 cstorms.1776.name: "Lại Được Tung Cánh"
 cstorms.1776.desc: "Ngay sau khi §Y$gravity_storm$§! đi qua, những loài chim tạm thời mất đi khả năng bay lượn trên [this.GetName] đã từng tị nạn trong khu bảo tồn loài chim của chúng ta, nay lại một lần nữa được vút bay trên bầu trời.\n\nMặc dù rất nhiều cá thể hiện đã quay trở về môi trường sống trước đây, nhưng vẫn còn một lượng lớn các loài động vật quyết định ở lại khu bảo tồn, dường như chúng đang rất tận hưởng sự thoải mái và an toàn mà nơi này mang lại.\n\nĐiều này cung cấp một cơ hội cực kỳ độc đáo để chúng ta có thể nghiên cứu các loài chim hoang dã trên hành tinh này ở khoảng cách rất gần."
 cstorms.1776.a: "Quả là một tin tốt lành."
 ################
 # Sự Kiện Bão #
 ################
 # Mắt Bão
 cstorms.1801.name: "Mắt Bão"
 cstorms.1801.desc: "Quá trình quét phát hiện ra một hiện tượng dị thường ngay tại trung tâm của [fromfrom.GetName] bên trong [from.GetName], điều này cho thấy cấu trúc cốt lõi của nó đang mang theo một dạng vật chất vô cùng kỳ lạ. Những chỉ số bất thường này rất đáng để chúng ta tiến hành điều tra sâu hơn trước khi cơn bão tan biến hoặc rời khỏi hệ sao này."
 EYE_OF_THE_STORM_PROJECT: "$cstorms.1801.name$"
 EYE_OF_THE_STORM_PROJECT_DESC: "Tiến hành quét [fromfrom.GetName] nằm bên trong [this.GetName], kết quả cho thấy những vòng xoáy bên trong nó đang mang theo một lượng lớn vật chất. Các cảm biến tầm xa không thể cung cấp câu trả lời xác đáng cho hiện tượng bất thường này. Để nâng cao sự hiểu biết của chúng ta, chúng ta cần phải tiến hành một cuộc khảo sát thực địa ngay tại trung tâm cơn bão."
 cstorms.1805.name: "Tiến Vào Vòng Xoáy"
 cstorms.1805.desc: "Thông qua việc xâm nhập vào mắt bão không gian của [from.GetName], [leader.GetName] đã tìm ra nguyên nhân gây ra sự bất thường trong kết quả quét của chúng ta. Cơn bão kỳ lạ này được thúc đẩy bởi sự hội tụ của một lượng khổng lồ [from.star.GetEarnedResources] tại lõi trung tâm.\n\nTàu khoa học của chúng ta đã thu thập được các tài nguyên có thể thu hoạch trước khi bị hất văng ra ngoài một cách thô bạo. Dữ liệu từ các cảm biến sẽ giúp các kỹ sư của chúng ta cải thiện hiệu năng cho tàu thuyền trong điều kiện bão tố cực đoan."
 cstorms.1805.desc.traumatized: "Thật không may, thử thách đầy rủi ro này đã để lại những tổn thương dai dẳng đối với [leader.GetName]."
 energy_lower: "Năng lượng"
 exotic_gases_lower: "Khí Kỳ Lạ"
 volatile_motes_lower: "Hạt Dễ Cháy"
 alloys_lower: "Hợp kim"
 minerals_lower: "Khoáng thạch"
 zro_lower: "Zro"
 living_metal_lower: "Kim loại Sống"
 cstorms.1805.desc.charged_matter: "Vật Chất Tích Điện"
 # Dự Án Đặc Biệt EotS
 EYE_OF_THE_gravity_storm_PROJECT: "$EYE_OF_THE_STORM_PROJECT$"
