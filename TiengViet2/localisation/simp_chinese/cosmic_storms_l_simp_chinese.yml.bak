l_simp_chinese:
 #########################################
 # BẢN DỊCH TIẾNG ANH - Bão Vũ Trụ #
 #########################################
 COSMIC_STORMS_TITLE: "Cosmic Storms" # Không dịch
 DLC_COSMIC_STORMS_RECOMMENDATION_DESC: "Chúng tôi đề xuất §S$COSMIC_STORMS_TITLE$§!, vì một số lựa chọn của bạn rất phù hợp với chủ đề của nó."
 # Đế chế có sẵn
 EMPIRE_DESIGN_YATUNAN_RADICALS: "Phe Cấp Tiến Yatunan"
 PRESCRIPTED_adjective_yatunan_radicals: "Yatunan"
 PRESCRIPTED_ship_prefix_yatunan_radicals: "RAD"
 PRESCRIPTED_species_name_yatunan_radicals: "Yatun"
 PRESCRIPTED_species_plural_yatunan_radicals: "Yatun"
 PRESCRIPTED_species_adjective_yatunan_radicals: "Yatun"
 PRESCRIPTED_planet_name_yatunan_radicals: "Yatunia"
 PRESCRIPTED_system_name_yatunan_radicals: "Kohn Tar Mo"
 PRESCRIPTED_ruler_name_yatunan_radicals: "$HUM4_CHR_Hem$$HUM4_CHR_talGun$"
 gov_storm_chasers: "Hội đồng Trưởng lão"
 gov_storm_chasers_desc: "Những thành viên xuất chúng nhất trong hội đồng cai trị rất giỏi vượt qua các thử thách thể chất đầy rủi ro. Họ leo lên những ngọn núi cao nhất, cưỡi lên những con sóng lớn nhất, cống hiến cả đời để theo đuổi những thử thách nguyên thủy này, và qua đó giành được niềm tin của mọi người, cũng như quyền dẫn dắt đám đông.\n\nBất kể tuổi tác, các thành viên hội đồng đều được gọi chung là trưởng lão, bởi vì những chiến tích của họ đã trở thành huyền thoại, và tên tuổi của họ sẽ sống mãi muôn đời."
 RT_ELDER_SPEAKER: "Trưởng lão Cầm quyền"
 RT_ELDER_SPEAKER_FEMALE: "$RT_ELDER_SPEAKER$"
 # Đặc quyền Thăng thiên
 ap_weather_control: "Kiểm soát Thời tiết Hệ sao"
 ap_weather_control_desc: "Những bước tiến mới nhất của chúng ta trong khí tượng học giữa các vì sao cho phép chúng ta gọi ra bão vũ trụ theo ý muốn. Khi có công nghệ phù hợp, ta thậm chí có thể chọn loại bão muốn tạo ra."
 requires_technology_tech_advanced_storm_manipulation: "$TRIGGER_FAIL$Cần công nghệ £physics£§Y$tech_advanced_storm_manipulation$§!."
 # Chú thích Bão
 cosmic_storm_planet_modifiers: "§HChỉ số Hành tinh§!"
 cosmic_storm_fleet_modifiers: "§HChỉ số Hạm đội§!"
 cosmic_storm_country_modifiers: "§HChỉ số Đế chế§!"
 cosmic_storm_ship_modifiers: "§HChỉ số Tàu§!"
 cosmic_storm_system_modifiers: "§HChỉ số Hệ sao§!"
 cosmic_storm_forecast_indicator_header: "Bão Vũ trụ đang đến"
 celestial_storm_tt: "-$celestial_storm$ sẽ làm giảm §Y$intel$§! trong hệ sao, cho phép hạm đội đi qua các biên giới bị đóng."
 solar_storm_tt: "-$solar_storm$ sẽ làm lộ diện mọi hạm đội trong các hệ sao bị ảnh hưởng."
 electric_storm_fleet_tt: "-$MOD_SHIP_SHIELD_REGEN_ADD_PERC$ bị §Rvô hiệu hóa§! đối với tàu và trạm không gian.\n-Tàu và trạm không gian chịu §R$@storm_monthly_dmg_low|0$§!$MOD_SHIP_SHIELD_ADD$ sát thương mỗi tháng."
 particle_storm_fleet_tt: "-$MOD_SHIP_HULL_REGEN_ADD_PERC$, $MOD_SHIP_ARMOR_REGEN_ADD_PERC$ và $MOD_SHIP_SHIELD_REGEN_ADD_PERC$ bị §Rvô hiệu hóa§! với tàu và trạm không gian.\n-Tàu và trạm không gian có trên $@storm_hp_perc_limit|0Y%$$HITPOINTS$ chịu §R$@storm_monthly_dmg_low|0$§! sát thương mỗi tháng.\n-Tàu dưới $@storm_hp_perc_limit|0Y%$$HITPOINTS$ tạo ra §G+$@particle_storm_unity_per_ship|0$§!£unity£$unity$."
 gravity_storm_consumer_goods_upkeep_tt: "Thuộc địa không thuộc Ý thức Tập hợp:\n$t$Phí bảo trì $r_consumer_goods$ của [farmer.GetIcon][GetFarmerPlural], [miner.GetIcon][GetMinerPlural] và [technician.GetIcon][GetTechnicianPlural]: §R+1§!"
 gravity_storm_energy_upkeep_tt: "Thuộc địa thuộc Ý thức Tập hợp:\n$t$Phí bảo trì $r_energy$ của [farmer.GetIcon][GetFarmerPlural], [miner.GetIcon][GetMinerPlural] và [technician.GetIcon][GetTechnicianPlural]: §R+1§!"
 gravity_storm_ship_tt: "-§R$@gravity_storm_dmg_malus|1%$§! $MOD_SHIP_WEAPON_DAMAGE$ với mỗi mức kích cỡ tàu."
 nexus_storm_fleet_tt: "-§RVô hiệu hóa§! $MOD_SHIP_HULL_REGEN_ADD_PERC$, $MOD_SHIP_ARMOR_REGEN_ADD_PERC$ và $MOD_SHIP_SHIELD_REGEN_ADD_PERC$ của tàu và trạm không gian.\n-Gây §R$@storm_monthly_dmg_high|0$§! sát thương mỗi tháng lên tàu và trạm không gian có trên $@storm_hp_perc_limit|0Y%$ $HITPOINTS$."
 shroud_storm_ship_evasion_modifier_tt: "-Sau khi đế chế thâm nhập §YHư Cảnh§!, §G+$@shroud_storm_evasion|0%$§!$MOD_SHIP_EVASION_MULT$"
 shroud_storm_ship_damage_modifier_tt: "-Sau khi đế chế thâm nhập §YHư Cảnh§!, §G+$@shroud_storm_damage|0%$§!$MOD_SHIP_WEAPON_DAMAGE$."
 # Bản dịch cho Mod
 storm_attraction: "Độ thu hút bão vũ trụ: $VALUE$"
 storm_repellent: "Độ xua đuổi bão vũ trụ: $VALUE$"
 storm_influence: "Mức can thiệp bão vũ trụ: $VALUE$"
 spawn_storm_effect: "Tạo ra $TYPE|Y$"
 spawn_random_storm_effect: "Tạo bão ngẫu nhiên"
 spawn_storm_with_location_effect: "Tạo bão $TYPE|Y$ tại $LOCATION|Y$"
 spawn_random_storm_with_location_effect: "Tạo bão ngẫu nhiên tại $LOCATION|Y$"
 effect_every_system_within_storm: "Tại mọi hệ sao trong vùng bão"
 effect_random_cosmic_storm_start_position: "Vị trí bão xuất hiện"
 effect_every_system_added_to_storm: "Bão quét qua hệ sao này"
 effect_random_system_added_to_storm: "Bão ảnh hưởng hệ sao ngẫu nhiên"
 effect_every_system_removed_from_storm: "Bão rời khỏi hệ sao này"
 effect_random_system_removed_from_storm: "Bão rời khỏi hệ sao ngẫu nhiên"
 effect_every_owned_storm_influence_field: "Mọi trường can thiệp có tâm nằm trong đế chế của bạn"
 effect_random_owned_storm_influence_field: "Trường can thiệp ngẫu nhiên có tâm nằm trong đế chế của bạn"
 effect_every_cosmic_storm: "Mọi hiệu ứng bão vũ trụ"
 # Bản dịch cho Mod - Tạo danh sách mọi trường can thiệp thuộc sở hữu của một quốc gia
 any_owned_storm_influence_field_trigger: "any_owned_storm_influence_field_trigger"
 any_system_in_cosmic_storm_influence_field_trigger: "any_system_in_cosmic_storm_influence_field_trigger"
 # Công nghệ Bão
 tech_storm_manipulation: "Thao túng Bão"
 tech_storm_manipulation_desc: "Bằng cách tận dụng nguyên lý đằng sau công nghệ phủ nhận bão, chúng ta có thể bắt đầu thao túng các đặc tính khí tượng giữa các vì sao để phục vụ nhu cầu của mình."
 tech_advanced_storm_manipulation: "Thao túng Bão Tiên tiến"
 tech_advanced_storm_manipulation_desc: "Nghiên cứu liên tục về khí tượng học giữa các vì sao cho phép ta bẻ cong và thao túng §YBão Vũ trụ§! một cách chuẩn xác hơn để phục vụ nhu cầu của bản thân."
 tech_industrial_storm_protection: "Chống Bão Hành tinh"
 tech_industrial_storm_protection_desc: "Trạm trung chuyển thông tin thời tiết này có thể giảm thiểu thiệt hại do thảm họa thời tiết vũ trụ gây ra. Tác động của các cơn bão quét qua đối với nền sản xuất sẽ bị giảm bớt."
 tech_advanced_industrial_storm_protection: "Triệt tiêu Bão Hành tinh"
 tech_advanced_industrial_storm_protection_desc: "Bằng cách củng cố hệ thống kiểm soát thời tiết khu vực và điều tiết các kiểu thời tiết trên hành tinh, ta có thể giảm đáng kể phần lớn tác động tiêu cực của bão vũ trụ lên sản xuất."
 tech_storm_prediction_1: "Mô hình Thời tiết Vũ trụ"
 tech_storm_prediction_1_desc: "Bằng cách sử dụng các mô hình thời tiết khoa học, chúng ta có thể theo dõi sự di chuyển và hình thành của các §YBão Vũ trụ§! đang kéo tới."
 tech_storm_prediction_1_title: "§HMở khóa tính năng§!: Dự báo Bão Vũ trụ"
 tech_storm_prediction_1_tooltip: "Mở khóa khả năng §YDự báo Hình thành Bão Vũ trụ§! và §YDự báo Hướng đi Bão Vũ trụ§! trong §YChế độ Bản đồ Dự báo Thời tiết§!"
 tech_storm_prediction_2: "Dòng Xác suất"
 tech_storm_prediction_2_desc: "Bằng cách áp dụng dòng xác suất vào mô hình thời tiết khoa học, ta có thể tăng cường đáng kể khả năng theo dõi chuyển động của §YBão Vũ trụ§! cũng như phát hiện quá trình hình thành của chúng."
 tech_storm_prediction_2_title: "§HNâng cấp tính năng§!: Dự báo Bão Vũ trụ"
 tech_storm_prediction_2_tooltip: "Tối đa hóa phạm vi §YDự báo Hình thành Bão Vũ trụ§! và §YDự báo Hướng đi Bão Vũ trụ§! trong §YChế độ Bản đồ Dự báo Thời tiết§!"
 tech_ship_hull_storm_breaker_1: "Máy tạo Trường Triệt tiêu Bão"
 tech_ship_hull_storm_breaker_1_desc: "Những trường lực triệt tiêu này cung cấp lớp bảo vệ thiết yếu cho các con tàu đi qua bão vũ trụ."
 tech_ship_hull_storm_breaker_2: "Lớp phủ Phá bão"
 tech_ship_hull_storm_breaker_2_desc: "Những lớp phủ đặc biệt này có thể sạc năng lượng cho vỏ tàu và bao bọc chúng bằng trường lực triệt tiêu bão, qua đó chống chọi với bão hiệu quả hơn."
 tech_ship_storm_weapons_1: "Vật liệu Lót Tải trọng"
 tech_ship_storm_weapons_1_desc: "Phương pháp bố trí hợp kim hoàn toàn mới trong lĩnh vực quân sự này giúp giảm thiểu đáng kể tác động của bão vũ trụ lên vũ khí năng lượng và vũ khí nổ."
 tech_ship_storm_weapons_2: "Cấu trúc Hạn chế Bão"
 tech_ship_storm_weapons_2_desc: "Cấu trúc tàu kiểu mới này có thể giảm đáng kể các tác động tiêu cực của bão vũ trụ lên hệ thống vũ khí."
 feature_sustain_cosmic_storm_unlocked: "Duy trì Bão Vũ trụ"
 feature_sustain_cosmic_storm_unlocked_desc: "Cho phép tàu khoa học của bạn ngừng công việc hiện tại và duy trì vô thời hạn §Y$default_storm$§!."
 FLEETORDER_SUSTAIN_COSMIC_STORM: "Duy trì Bão Vũ trụ $STORM|Y$ tại $SYSTEM|Y$"
 FLEETORDER_SUSTAIN_COSMIC_STORM_BUTTON: "Duy trì §YBão Vũ trụ§!"
 FLEETORDER_SUSTAIN_COSMIC_STORM_CANCELLED: "§RCơn bão vũ trụ sau đó đã tan biến.§!"
 # Chế độ Bản đồ
 storm_map_mode: "Chế độ Bản đồ Dự báo Thời tiết"
 storm_map_mode_desc: "Chế độ Bản đồ Dự báo Thời tiết hiển thị tất cả các cơn bão, dự báo và các khu vực bị ảnh hưởng trên bản đồ thiên hà."
 # Công nghệ Mở đường Bão Vũ trụ
 gateway_tech_advanced_storm_manipulation: "§HĐường lối Thao túng Bão§!\n§ECông nghệ này sẽ thúc đẩy hơn nữa sự phát triển của công nghệ thao túng bão vũ trụ.§!"
 gateway_tech_advanced_industrial_storm_protection: "§HĐường lối Chống Bão Vũ trụ§!\n§ECông nghệ này sẽ thúc đẩy hơn nữa sự phát triển của công nghệ chống bão vũ trụ.§!"
 gateway_tech_storm_location_prediction: "§HĐường lối Dự báo Bão Vũ trụ§!\n§ECông nghệ này sẽ thúc đẩy hơn nữa sự phát triển của công nghệ dự báo bão vũ trụ.§!"
 gateway_tech_ship_hull_storm_breaker: "§HĐường lối Bảo vệ Tàu trước Bão Vũ trụ§!\n§ECông nghệ này sẽ thúc đẩy hơn nữa sự phát triển của công nghệ bảo vệ thân tàu trước bão vũ trụ.§!"
 gateway_tech_ship_hull_storm_weapons: "§HĐường lối Bảo vệ Vũ khí trước Bão Vũ trụ§!\n§ECông nghệ này sẽ thúc đẩy hơn nữa sự phát triển của công nghệ bảo vệ vũ khí trước bão vũ trụ.§!"
 # Chỉ số Bão Vũ trụ
 storm_base_modifier: "Chỉ số Bão Cơ bản" # Đây là chỉ số ẩn
 nexus_storm_modifier: "$storm_base_modifier$" # Đây là chỉ số ẩn
 storm_attraction_field_modifier: "Chỉ số Trường Thu hút Bão" # Đây là chỉ số ẩn
 storm_repelling_field_modifier: "Chỉ số Trường Xua đuổi Bão" # Đây là chỉ số ẩn
 STORM_LIFESPAN_LEFT: "Thời gian còn lại: £time£$TIME$"
 STORM_DEVASTATION_MODIFIER: "-Mức tàn phá mỗi tháng: §R+$VALUE|1$§!"
 STORM_PLANET_DEVASTATION: "Mức tàn phá tăng thêm mỗi tháng do §Y$default_storm$§!: §R$DEVASTATION$§!"
 # Các loại Bão Vũ trụ
 electric_storm: "Bão Điện từ"
 electric_storm_color_tooltip: "§B$electric_storm$§!"
 particle_storm: "Bão Hạt"
 particle_storm_color_tooltip: "§E$particle_storm$§!"
 gravity_storm: "Bão Trọng lực"
 gravity_storm_color_tooltip: "§r$gravity_storm$§!"
 magnetic_storm: "Bão Từ trường"
 magnetic_storm_color_tooltip: "§c$magnetic_storm$§!"
 solar_storm: "Bão Bức xạ"
 solar_storm_color_tooltip: "§S$solar_storm$§!"
 celestial_storm: "Bão Bụi Sao"
 celestial_storm_color_tooltip: "§Y$celestial_storm$§!"
 shroud_storm: "Bão Hư Cảnh"
 shroud_storm_color_tooltip: "§M$shroud_storm$§!"
 nexus_storm: "Bão Nexus"
 nexus_storm_color_tooltip: "§P$nexus_storm$§!"
 default_storm: "Bão Vũ trụ"
 storm_planet_modifier_intro: "Một trận "
 storm_planet_modifier_outro: " dữ dội sẽ quét qua hệ sao này, gây ra tác động cực đoan cho hành tinh. Khuyến cáo tìm nơi trú ẩn."
 electric_storm_lore_description: "§L$storm_planet_modifier_intro$$electric_storm$$storm_planet_modifier_outro$§!"
 gravity_storm_lore_description: "§L$storm_planet_modifier_intro$$gravity_storm$$storm_planet_modifier_outro$§!"
 magnetic_storm_lore_description: "§L$storm_planet_modifier_intro$$magnetic_storm$$storm_planet_modifier_outro$§!"
 solar_storm_lore_description: "§L$storm_planet_modifier_intro$$solar_storm$$storm_planet_modifier_outro$§!"
 celestial_storm_lore_description: "§L$storm_planet_modifier_intro$$celestial_storm$$storm_planet_modifier_outro$§!"
 shroud_storm_lore_description: "§L$storm_planet_modifier_intro$$shroud_storm$$storm_planet_modifier_outro$§!"
 particle_storm_lore_description: "§L$storm_planet_modifier_intro$$particle_storm$$storm_planet_modifier_outro$§!"
 nexus_storm_lore_description: "§LMột trận $nexus_storm$ cực kỳ mãnh liệt đang đe dọa hệ sao này và gây tàn phá hành tinh. Hãy tìm nơi trú ẩn để bảo toàn mạng sống!§!"
 # Chỉ số Công nghệ Bão
 MOD_COUNTRY_STORM_LOCATION_INTEL_ADD: "Thông tin vị trí Bão Vũ trụ"
 MOD_COUNTRY_STORM_MOVEMENT_INTEL_ADD: "Thông tin di chuyển Bão Vũ trụ"
 MOD_COUNTRY_STORM_PROTECTION_TECH_LEVEL_ADD: "Cấp độ công nghệ bảo vệ khỏi Bão Vũ trụ"
 MOD_COUNTRY_STORM_INFLUENCE_MULT: "Hiệu suất công trình bão"
 MOD_INFLUENCE_FIELD_ADD: "Hiệu quả thu hút Bão Vũ trụ: $VALUE$"
 MOD_COUNTRY_STORM_ATTRACTION_ADD: "Hiệu quả thu hút Bão Vũ trụ"
 MOD_COUNTRY_STORM_REPELLING_ADD: "Hiệu quả xua đuổi Bão Vũ trụ"
 MOD_PLANET_STORM_DEVASTATION_MULT: "Giảm độ tàn phá hành tinh của Bão Vũ trụ"
 MOD_STORM_SHIP_HULL_BREAKER_MULT: "Tác động tiêu cực của Bão Vũ trụ lên lớp bảo vệ tàu:"
 MOD_SHIP_HULL_STORM_BREAKER_1: "$MOD_STORM_SHIP_HULL_BREAKER_MULT$§G-50%§!"
 MOD_SHIP_HULL_STORM_BREAKER_2: "$MOD_STORM_SHIP_HULL_BREAKER_MULT$§G-100%§!"
 MOD_SHIP_STORM_WEAPONS_MULT: "Tác động tiêu cực của Bão Vũ trụ lên vũ khí tàu:"
 MOD_SHIP_STORM_WEAPONS_1: "$MOD_SHIP_STORM_WEAPONS_MULT$§G-50%§!"
 MOD_SHIP_STORM_WEAPONS_2: "$MOD_SHIP_STORM_WEAPONS_MULT$§G-100%§!"
 MOD_PLANETARY_STORM_SHIELD_MULT: "Giảm hiệu ứng tàn phá hành tinh của Bão Vũ trụ: §G50%§!"
 MOD_STORM_REPELLENT_TIMED: "Thời gian duy trì trường xua đuổi Bão Vũ trụ:"
 # Sự kiện Thấu hiểu Công nghệ Bão
 cstorms.505.name: "Đối mặt với Bão"
 cstorms.505.desc: "Trong hậu quả tàn phá của §H[this.GetAffectedStormType]§!, chúng ta đã gặt hái được nhiều hiểu biết về hiện tượng thiên nhiên vũ trụ này.\n\nThông qua việc nghiên cứu khí tượng học giữa các vì sao, chúng ta có thể tự bảo vệ mình tốt hơn trong tương lai. Lĩnh vực nghiên cứu hoàn toàn mới này rất có thể sẽ mang lại phương tiện để hoàn toàn kiểm soát những cơn bão này."
 # Công trình Bão
 building_storm_attraction_center: "Trung tâm Thu hút Bão"
 building_storm_attraction_center_desc: "Các cơ sở này có thể thu hút bão vũ trụ xung quanh bằng cách điều chỉnh lực hút một cách cẩn trọng."
 building_advanced_storm_attraction_center: "Trung tâm Thu hút Bão Tiên tiến"
 building_advanced_storm_attraction_center_desc: "Sau khi hiểu sâu hơn về năng lượng tối, chúng ta có thể nạp quá tải từng $building_storm_attraction_center$ để thu hút bão vũ trụ với hiệu suất cao hơn."
 building_storm_repellent_center: "Trung tâm Xua đuổi Bão"
 building_storm_repellent_center_desc: "Bão càng xa, người dân của ta càng an toàn và bớt lo âu. Những lõi khí tượng tinh vi này có thể đẩy lùi các cơn bão đang ập đến."
 building_advanced_storm_repellent_center: "Trung tâm Xua đuổi Bão Tiên tiến"
 building_advanced_storm_repellent_center_desc: "Chỉ cần có thể bảo vệ hành tinh khỏi bão vũ trụ, ngay cả việc thao túng không thời gian cũng là hợp lý. Đó chính là chức năng của thiết bị cốt lõi này."
 building_storm_resistant_production: "Trung tâm Cứu hộ Bão"
 building_storm_resistant_production_desc: "Trung tâm cứu hộ này giúp người dân địa phương loại bỏ tác động của bão vũ trụ lên nền sản xuất hành tinh. Thông qua liên lạc và phối hợp hiệu quả, $building_storm_resistant_production$ sẽ nhanh chóng triển khai các đội cứu hộ, cải thiện môi trường giao thương trên hành tinh."
 building_storm_resistant_production_tt: "Hình phạt sản xuất từ §Y$default_storm$§! giảm §G25%§!.\n\nKhi §Y$default_storm$§! xuất hiện:$TABBED_NEW_LINE$$mod_planet_miners_minerals_produces_add$: §G+1§!$TABBED_NEW_LINE$$mod_planet_farmers_food_produces_add$: §G+1§!$TABBED_NEW_LINE$$mod_planet_technician_energy_produces_add$: §G+1§!\n\nMở khóa Quyết định Hành tinh §Y$decision_hunker_down$§!"
 building_advanced_storm_resistant_production: "Máy kìm hãm Bão"
 building_advanced_storm_resistant_production_desc: "Sau khi $building_storm_resistant_production$ triển khai hệ thống kiểm soát thời tiết, các tác động tiêu cực của bão vũ trụ đã giảm đi đáng kể. Hơn nữa, các đội cứu hộ có thể được triển khai hiệu quả hơn, và giao thương trên hành tinh gần như không còn bị ảnh hưởng bởi điều kiện thời tiết địa phương."
 building_advanced_storm_resistant_production_tt: "Hình phạt sản xuất từ §Y$default_storm$§! giảm §G40%§!.\n\nKhi §Y$default_storm$§! xuất hiện:$TABBED_NEW_LINE$$mod_planet_miners_minerals_produces_add$: §G+2§!$TABBED_NEW_LINE$$mod_planet_farmers_food_produces_add$: §G+2§!$TABBED_NEW_LINE$$mod_planet_technician_energy_produces_add$: §G+2§!\n\nMở khóa Quyết định Hành tinh §Y$decision_hunker_down$§!"
 building_adakkaria_patriotic_institute: "Học viện Lễ hội Ái quốc"
 building_adakkaria_patriotic_institute_desc: "$building_adakkaria_patriotic_institute$ là kho tàng chứa đựng những hiểu biết tiên tiến về trạng thái cảm xúc. Tại đây, chúng ta cho phép người dân nuôi dưỡng bão tố trong lòng khi họ chống lại bài ca cám dỗ tàn nhẫn của Khế ước."
 building_adakkaria_patriotic_institute_effect_desc: "Mỗi khi bão vũ trụ quét qua hệ sao này, có 10% tỷ lệ khiến £pop£§HPop§! nhận được đặc điểm $Name_Storm_Fused$"
 building_adakkaria_patriotic_institute_effect_upgrade_desc: "Mỗi khi bão vũ trụ quét qua hệ sao này, có 40% tỷ lệ khiến £pop£§HPop§! nhận được đặc điểm $Name_Storm_Fused$. Hơn nữa, cứ sau 10 năm, có 20% khả năng §Y100§! £pop£§HPop§! sẽ hóa thân thành bão vũ trụ."
 building_astrometeorology_observation_center: "Đài Quan sát Khí tượng Vũ trụ"
 building_astrometeorology_observation_center_desc: "Bằng các cảm biến tinh vi, trung tâm quan sát này nghiên cứu những môi trường khí tượng khác nhau, từ đó khoét sâu thêm hiểu biết của ta về vũ trụ tự nhiên."
 concept_building_astrometeorology_observation_center: "$building_astrometeorology_observation_center$"
 building_storm_summoning_theater: "Nhà hát Triệu hồi Bão"
 building_storm_summoning_theater_desc: "Sự kết hợp đầy hân hoan giữa nghệ thuật và công nghệ, những bước nhảy xoay vòng của các $job_storm_dancer_plural$ đang vẫy gọi bão vũ trụ kéo tới."
 building_storm_holo_theater: "Nhà hát Bão Toàn ảnh"
 building_storm_holo_theater_desc: "$building_storm_holo_theater$ phát sóng hình ảnh đầy mê hoặc của các $job_storm_dancer_plural$ ra khắp hành tinh và xa hơn nữa."
 building_storm_grand_theater: "Đại Nhà hát Bão"
 building_storm_grand_theater_desc: "Những nhà hát tráng lệ này phô diễn đỉnh cao của thành tựu nghệ thuật và công nghệ, đem lại một sân khấu hoàn mỹ cho những điệu múa tuyệt đẹp."
 sm_storm_attraction_computer: "Hệ thống Thu hút Bão"
 sm_storm_attraction_computer_desc: "Thiết bị này có khả năng biến đổi trường hấp dẫn cục bộ, từ đó hút lấy những cơn bão ngoài không gian thẳm."
 sm_storm_repelling_computer: "Hệ thống Xua đuổi Bão"
 sm_storm_repelling_computer_desc: "Hệ thống phóng laser năng lượng cao này có thể tạo ra các túi hạt từ tính mang điện tích mạnh, sinh ra lực đẩy lùi bão vũ trụ."
 # Jobs
 astrometeorologist: "$job_astrometeorologist$"
 job_astrometeorologist: "Nhà Khí tượng Vũ trụ"
 job_astrometeorologist_plural: "Nhà Khí tượng Vũ trụ"
 job_astrometeorologist_desc: "$job_astrometeorologist_plural$ chuyên nghiên cứu các tác động môi trường ở cấp độ vũ trụ."
 job_astrometeorologist_effect_desc: "$job_astrometeorologist_plural_with_icon$ chuyển hóa $r_consumer_goods$ thành $r_physics$\n\nSản lượng của công việc sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!"
 job_astrometeorologist_with_icon: "£job_astrometeorologist£$job_astrometeorologist$"
 job_astrometeorologist_plural_with_icon: "£job_astrometeorologist£$job_astrometeorologist_plural$"
 physicist_is_astrometeorologist_tt: "\n£job_physicist£$job_physicist_plural$ chuyển thành $job_astrometeorologist_plural_with_icon$.\n\nSản lượng của công việc §Y$job_astrometeorologist_with_icon$§! sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!."
 astrometeorologist_hive: "$job_astrometeorologist_hive$"
 job_astrometeorologist_hive: "Drone Khí tượng Vũ trụ"
 job_astrometeorologist_hive_plural: "Drone Khí tượng Vũ trụ"
 job_astrometeorologist_hive_desc: "Những drone nghiên cứu này chuyên quan sát và ghi chép tác động của bão vũ trụ."
 job_astrometeorologist_hive_effect_desc: "$job_astrometeorologist_hive_plural_with_icon$ chuyển hóa $r_minerals$ thành $r_research$\n\nSản lượng của công việc sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!"
 job_astrometeorologist_hive_with_icon: "£job_astrometeorologist£ $job_astrometeorologist_hive$"
 job_astrometeorologist_hive_plural_with_icon: "£job_astrometeorologist_hive£ $job_astrometeorologist_hive_plural$"
 physics_brain_drone_is_astrometeorologist_tt: "\n£job_brain_drone_physicist£$job_brain_drone_physicist$ chuyển thành $job_astrometeorologist_hive_plural_with_icon$.\n\nSản lượng của công việc §Y$job_astrometeorologist_hive_with_icon$§! sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!."
 astrometeorologist_machine: "$job_astrometeorologist_machine$"
 job_astrometeorologist_machine: "Cỗ máy Khí tượng Vũ trụ"
 job_astrometeorologist_machine_plural: "Cỗ máy Khí tượng Vũ trụ"
 job_astrometeorologist_machine_desc: "Những đơn vị nghiên cứu cần mẫn này tỉ mỉ ghi chép các sự kiện thiên văn để đúc kết thêm kiến thức."
 job_astrometeorologist_machine_effect_desc: "$job_astrometeorologist_machine_plural_with_icon$ chuyển hóa $r_energy$ thành $r_research$\n\nSản lượng của công việc sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!"
 job_astrometeorologist_machine_with_icon: "£job_astrometeorologist_machine£ $job_astrometeorologist_machine$"
 job_astrometeorologist_machine_plural_with_icon: "£job_astrometeorologist_machine£ $job_astrometeorologist_machine_plural$"
 physics_calculator_is_astrometeorologist_tt: "\n£job_calculator_physicist£$job_calculator_physicist_plural$ chuyển thành $job_astrometeorologist_machine_plural_with_icon$.\n\nSản lượng của công việc §Y$job_astrometeorologist_machine_with_icon$§! sẽ tăng khi hệ sao hiện tại có §YTác động Môi trường§!."
 storm_dancer: "$job_storm_dancer$"
 job_storm_dancer: "Vũ công Bão tố"
 job_storm_dancer_plural: "Vũ công Bão tố"
 job_storm_dancer_desc: "Công việc của $job_storm_dancer$ không chỉ là biểu diễn đơn thuần, họ đang hiện thực hóa bản chất của bão."
 job_storm_dancer_effect_desc: "[entertainer.GetIcon][entertainer.GetNamePlural] chuyển hóa $r_consumer_goods$ thành $r_unity$ và $r_amenities$"
 job_storm_dancer_with_icon: "£job_storm_dancer£$job_storm_dancer$"
 job_storm_dancer_plural_with_icon: "£job_storm_dancer£$job_storm_dancer_plural$"
 storm_duelist: "$job_storm_duelist$"
 job_storm_duelist: "Đấu sĩ Bão tố"
 job_storm_duelist_plural: "Đấu sĩ Bão tố"
 job_storm_duelist_desc: "Đấu sĩ Bão tố dùng những vũ điệu cuồng nhiệt và lối đánh như sấm sét để dẫn dắt những cơn bão dữ dội, kết hợp kỹ năng chiến đấu và nghi lễ ngay trên đấu trường."
 job_storm_duelist_effect_desc: "[entertainer.GetIcon][entertainer.GetNamePlural] biến $r_consumer_goods$ thành $r_unity$$r_amenities$ và £mod_country_naval_cap_add£§Y$MOD_COUNTRY_NAVAL_CAP_ADD$§!"
 job_storm_duelist_with_icon: "£job_storm_duelist£$job_storm_duelist$"
 job_storm_duelist_plural_with_icon: "£job_storm_duelist£$job_storm_duelist_plural$"
 reenactor: "$job_reenactor$"
 job_reenactor: "Người tái hiện Lịch sử"
 job_reenactor_plural: "Người tái hiện Lịch sử"
 job_reenactor_desc: "Những nhân viên chuyên nghiệp này vừa là diễn viên, người trông coi bảo tàng, vừa là chiến binh, họ hiểu rằng cách tốt nhất để nắm rõ quá khứ là tự mình trải nghiệm."
 # Điều kiện
 count_system_within_storm_trigger: "Số hệ sao trong bão $CONDITIONS$$IS_NOT$$COMPARATOR$$NUM|Y$"
