l_simp_chinese:
 ############
 # Tàng hình #
 ############
 #Công nghệ
 tech_cloaking_1: "Trường Tàng Hình Cơ Bản"
 tech_cloaking_1_desc: "Một trường hạt được tinh chỉnh có thể \"che giấu\" hạm đội của chúng ta một cách hiệu quả giữa không gian rộng mở. Tuy nhiên, cái giá phải trả là sự mất ổn định của lá chắn năng lượng vốn có nhiệm vụ bảo vệ con tàu."
 tech_cloaking_2: "Trường Tàng Hình Tiên Tiến"
 tech_cloaking_2_desc: "Những tiến bộ trong công nghệ chế tác thấu kính pha lê hiếm có thể cải thiện đáng kể hiệu suất tàng hình."
 tech_cloaking_3: "Trường Tàng Hình Tinh Nhuệ"
 tech_cloaking_3_desc: "Công nghệ tàng hình điển hình trước đây thường gây ra hư hỏng nghiêm trọng cho các thiết bị tương đối tinh vi trên tàu. Nhưng sự xuất hiện của trường tàng hình tinh nhuệ đã biến nỗi lo lắng này thành dĩ vãng."
 tech_cloaking_dark_matter: "Trường Tàng Hình Vật Chất Tối"
 tech_cloaking_dark_matter_desc: "Thiết bị này sử dụng vật chất tối để bóp méo không thời gian xung quanh con tàu, khiến nó cực kỳ khó bị phát hiện."
 tech_cloaking_psi: "Máy Phát Trường Pha Tâm Linh"
 tech_cloaking_psi_desc: "Máy phát trường pha tâm linh có thể tập trung tiềm năng tâm linh của phi hành đoàn, qua đó đưa một phần con tàu lặn vào cõi Shroud. Điều này sẽ khiến con tàu chỉ có thể bị phát hiện bởi những mảng cảm biến tối tân nhất, mặc dù trong hoàn cảnh đó, tốt nhất là không nên nhắc đến những gì phi hành đoàn buộc phải đối mặt."
 tech_detection_array: "Mảng Phát Hiện"
 tech_detection_array_desc: "$sm_detection_array_desc$"
 tech_dark_matter_detection: "Phát Hiện Vật Chất Tối"
 tech_dark_matter_detection_desc: "Buồng cộng hưởng vật chất tối có thể cải thiện đáng kể hiệu suất của mảng phát hiện của chúng ta."
 tech_assisted_detection: "Thuật Toán Phát Hiện Tiên Tiến"
 tech_assisted_detection_desc: "Việc kết hợp mảng phát hiện với máy tính trên tàu khoa học có thể nâng cao đáng kể độ phân giải quét."
 feature_assist_cloaking_detection_unlocked: "$ASSIST_CLOAKING_DETECTION_ORDER$"
 feature_assist_cloaking_detection_unlocked_desc: "$ASSIST_CLOAKING_DETECTION_ORDER_DESC$"
 feature_active_reconnaissance_unlocked: "$ACTIVE_RECONNAISSANCE_ORDER$"
 feature_active_reconnaissance_unlocked_desc: "$ACTIVE_RECONNAISSANCE_ORDER_TECH_DESC$"
 #Thành phần Tàu
 TECH_UNLOCK_CLOAKING_1_TITLE: "§HMở khóa linh kiện:§! $CLOAKING_1$"
 TECH_UNLOCK_CLOAKING_1_DESC: "§H$CLOAKING_1$§!\n$tech_cloaking_1_desc$"
 TECH_UNLOCK_CLOAKING_2_TITLE: "§HMở khóa linh kiện:§! $CLOAKING_2$"
 TECH_UNLOCK_CLOAKING_2_DESC: "§H$CLOAKING_2$§!\n$tech_cloaking_2_desc$"
