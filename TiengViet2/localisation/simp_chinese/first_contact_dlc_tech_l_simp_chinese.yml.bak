 CLOAKING_STRENGTH_10_DESC: "$CLOAKING_EXCEPTIONAL_DESC$"
 CLOAKING_DETECTION_UNKNOWN: "§gKhông Rõ§!"
 CLOAKING_DETECTION_0: "§gKhông Tồn Tại§!"
 CLOAKING_DETECTION_1: "§YCực Thấp§!"
 CLOAKING_DETECTION_2: "§YThấp§!"
 CLOAKING_DETECTION_3: "§YTrung Bình§!"
 CLOAKING_DETECTION_4: "§YCao§!"
 CLOAKING_DETECTION_5: "§YCực Cao§!"
 CLOAKING_DETECTION_6: "§MTối Thượng (Cấp 1)§!"
 CLOAKING_DETECTION_7: "§MTối Thượng (Cấp 2)§!"
