 #Tàng hình Tâm linh
 CLOAKING_PSI: "$tech_cloaking_psi$"
 CLOAKING_PSI_DESC: "$tech_cloaking_psi_desc$"
 CORVETTE_CLOAKING_PSI: "$CLOAKING_PSI$"
 CORVETTE_CLOAKING_PSI_DESC: "$CLOAKING_PSI_DESC$"
 DESTROYER_CLOAKING_PSI: "$CLOAKING_PSI$"
 DESTROYER_CLOAKING_PSI_DESC: "$CLOAKING_PSI_DESC$"
 CRUISER_CLOAKING_PSI: "$CLOAKING_PSI$"
 CRUISER_CLOAKING_PSI_DESC: "$CLOAKING_PSI_DESC$"
 BATTLESHIP_CLOAKING_PSI: "$CLOAKING_PSI$"
 BATTLESHIP_CLOAKING_PSI_DESC: "$CLOAKING_PSI_DESC$"
 SCIENCE_CLOAKING_PSI: "$CLOAKING_PSI$"
 SCIENCE_CLOAKING_PSI_DESC: "$CLOAKING_PSI_DESC$"
 CLOAKING_PSI_TOOLTIP: "$CLOAKING_SHIELD_REDUCTION_HEADER$§R100%§!\n\n§ENếu chỉ trang bị rào chắn tâm linh hoặc lá chắn tâm linh thì có thể tránh được $SHIP_SHIELD_REDUCTION_CLOAKING$. Bất kỳ loại khiên nào khác cũng sẽ làm mất hiệu ứng này.§!\n\n"
 #Mảng Phát hiện
 sm_detection_array: "Mảng Phát Hiện"
 sm_detection_array_plural: "Các Mảng Phát Hiện"
 sm_detection_array_desc: "Một hệ thống cảm biến bên ngoài mạnh mẽ, có khả năng phát hiện các hạm đội tàng hình.\n"
 sm_dark_matter_detector: "Buồng Cộng Hưởng Vật Chất Tối"
 sm_dark_matter_detector_desc: "Bằng cách kích thích vật chất tối đạt trạng thái cộng hưởng, buồng này có thể tăng cường đáng kể mảng phát hiện của chúng ta.\n"
 sm_dark_matter_detector_desc_modifier: "Mỗi §Y3§! §H$sm_detection_array_plural$§! cung cấp:\n$t$Cường độ Phát hiện: §G+1§!"
 sm_dark_matter_listening_post: "Trạm Lắng Nghe Vật Chất Tối"
 sm_dark_matter_listening_post_desc: "Trạm lắng nghe này có khả năng phát hiện tàng hình đặc biệt, bộ cảm biến mạnh mẽ của nó được tăng cường bởi một buồng cộng hưởng vật chất tối độc lập.\n"
 #Cường độ Tàng hình và Cấp độ Phát hiện
 CLOAKING_STRENGTH: "Cường độ Tàng hình"
 CLOAKING_STRENGTH_VALUE: "$CLOAKING_STRENGTH$: $VALUE|0$"
 FLEET_CLOAKING_STRENGTH_DESC: "§E§HCường độ Tàng hình§! là thước đo đánh giá sự ổn định của trường tàng hình bao phủ mọi con tàu trong hạm đội. Trường tàng hình càng ổn định, hạm đội càng ít phải chịu hình phạt khi tàng hình. Độ ổn định tối đa của trường tàng hình trong hạm đội phụ thuộc vào con tàu có cường độ tàng hình thấp nhất trong hạm đội đó.§!"
 SHIP_CLOAKING_STRENGTH_DESC: "$FLEET_CLOAKING_STRENGTH_DESC$"
 CLOAKING_DETECTION: "Cường độ Phát hiện"
 CLOAKING_DETECTION_VALUE: "$CLOAKING_DETECTION$: $VALUE|0$"
 CLOAKING_DETECTION_DESC: "§E§HCường độ Phát hiện§! dùng để đo độ nhạy của mảng phát hiện được trang bị trên căn cứ không gian. Độ nhạy của mảng phát hiện càng cao, nó càng có khả năng xuyên thấu các trường tàng hình mạnh mẽ.§!"
 CLOAKING_DEVICE_VALUE: "Máy Phát Trường Tàng Hình: §G+$VALUE|0$§!"
 FLEET_CLOAKING_ACTIVE_EFFECTS: "Khi tàng hình, hạm đội này sẽ phải chịu các hình phạt sau:"
 FLEET_CLOAKING_LEVEL_THRESHOLDS: "Nâng cao khả năng tàng hình sẽ giảm bớt toàn bộ hình phạt.\nGiảm khả năng tàng hình sẽ làm tăng toàn bộ hình phạt.\n\n$SHIP_SHIELD_REDUCTION_CLOAKING$ sẽ có hiệu lực riêng rẽ đối với từng con tàu, tùy thuộc vào linh kiện máy phát trường tàng hình được trang bị."
 FLEET_VIEW_ACTIVATE_CLOAK: "Kích Hoạt Tàng Hình"
 FLEET_VIEW_ACTIVATE_CLOAK_DESC: "Hạm đội này §Yđang không tàng hình§!.\nRa lệnh cho hạm đội kích hoạt trạng thái tàng hình, né tránh sự phát hiện của các cảm biến truyền thống. $CLOAKING_COOLDOWN_TOOLTIP$"
 STARBASE_ACTIVATE_CLOAK_DESC: "Trạm không gian này §Ychưa tàng hình§!\nRa lệnh cho trạm kích hoạt tàng hình, né tránh sự dò tìm của các cảm biến thông thường. $CLOAKING_COOLDOWN_TOOLTIP$"
 FLEET_VIEW_DEACTIVATE_CLOAK: "Tắt tàng hình"
 FLEET_VIEW_DEACTIVATE_CLOAK_DESC: "Hạm đội này §Yđang tàng hình§!.\nRa lệnh cho hạm đội tắt trạng thái tàng hình, khiến nó có thể bị dò tìm bởi các cảm biến thông thường. $CLOAKING_COOLDOWN_TOOLTIP$"
 STARBASE_DEACTIVATE_CLOAK_DESC: "Trạm không gian này §Yđang tàng hình§!.\nRa lệnh cho trạm tắt trạng thái tàng hình, khiến nó có thể bị dò tìm bởi các cảm biến thông thường. $CLOAKING_COOLDOWN_TOOLTIP$"
 CLICK_TO_DEACTIVATE_CLOAKING: "§GNhấp để tắt tàng hình§!"
 CLICK_TO_ACTIVATE_CLOAKING: "§GNhấp để kích hoạt tàng hình§!"
 FLEET_SHIPS_CANT_CLOAK: "§RCác tàu trong hạm đội không thể tàng hình§!"
 STARBASE_CANT_CLOAK: "§RTrạm không gian này không thể tàng hình§!"
 FLEET_SHIPS_CANT_CLOAK_COOLDOWN: "§RMáy tạo trường tàng hình đang nạp năng lượng. Khả năng tàng hình sẽ khả dụng sau §Y$VALUE$§! ngày nữa.§!"
 FLEET_SHIPS_CANT_CLOAK_COMBAT: "§RHạm đội đang giao chiến không thể tàng hình§!"
 STARBASE_CANT_CLOAK_COMBAT: "§RTrạm không gian đang giao chiến không thể tàng hình§!" FLEET_CLOAKED_ICON: "£outliner_fleet_cloaked£"
 CLOAKING_COOLDOWN_TOOLTIP: "Sau khi tắt tàng hình, máy phát trường tàng hình cần §Y120§! ngày để có thể kích hoạt trở lại. $CLOAKING_COOLDOWN_MODIFIER$"
 CLOAKING_COOLDOWN_MODIFIER: "$BLANK_STRING$"
 SHIP_STAT_CLOAKING_STRENGTH: "Cường độ Tàng hình"
 SHIP_STAT_CLOAKING_DETECTION: "Cường độ Phát hiện"
 SHIP_STAT_CLOAKING_STRENGTH_INLINE: "£ship_stats_cloaking_strength£ $SHIP_STAT_CLOAKING_STRENGTH$:"
 SHIP_STAT_CLOAKING_DETECTION_INLINE: "£ship_stats_cloaking_detection£ $SHIP_STAT_CLOAKING_DETECTION$:"
 cloaking_fire_rate_bonus: "Phục kích"
 CLOAKING_PENALTY_MODS: "§Y$MOD_SHIP_SPEED_MULT$§! và §Y$MOD_SHIP_WINDUP_MULT$§!"
 CLOAKING_EXCEPTIONAL_DESC: "\nHạm đội này có khả năng tạo ra một trường tàng hình cực kỳ ổn định, không bị hạn chế bởi bất kỳ $CLOAKING_PENALTY_MODS$ nào."
 CLOAKING_EXCEPTIONAL_CAN_BE_IMPROVED: "\n\nTiếp tục cải tiến có thể giúp hạm đội né tránh được sự phát hiện của các mảng phát hiện ngày càng tiên tiến hơn."
 CLOAKING_STRENGTH_UNKNOWN: "§gKhông Rõ§!"
 CLOAKING_STRENGTH_0: "§gKhông Có§!"
 CLOAKING_STRENGTH_1: "§YCực Thấp§!"
 CLOAKING_STRENGTH_2: "§YThấp§!"
 CLOAKING_STRENGTH_3: "§YTrung Bình§!"
 CLOAKING_STRENGTH_4: "§YCao§!"
 CLOAKING_STRENGTH_5: "§YCực Cao§!"
 CLOAKING_STRENGTH_6: "§MTối Thượng (Cấp 1)§!"
 CLOAKING_STRENGTH_7: "§MTối Thượng (Cấp 2)§!"
 CLOAKING_STRENGTH_8: "§MTối Thượng (Cấp 3)§!"
 CLOAKING_STRENGTH_9: "§MTối Thượng (Cấp 4)§!"
 CLOAKING_STRENGTH_10: "§MTối Thượng (Cấp 5)§!"
 CLOAKING_STRENGTH_UNKNOWN_DESC: "Bạn có quá ít thông tin tình báo để có thể phán đoán khả năng của trường tàng hình của hạm đội này."
 CLOAKING_STRENGTH_0_DESC: "\nHạm đội này không thể tạo ra trường tàng hình."
 CLOAKING_STRENGTH_1_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình cực kỳ không ổn định, chịu sự hạn chế rất lớn của $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_2_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình không ổn định, chịu sự hạn chế rất lớn của $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_3_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình cơ bản ổn định, chịu sự hạn chế đôi chút của $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_4_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình khá ổn định, chịu sự hạn chế nhỏ của $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_5_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình cực kỳ ổn định, chịu sự hạn chế đáng kể của $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_5_DESC: "\nHạm đội này có thể tạo ra một trường tàng hình cực kỳ ổn định, chịu hạn chế đáng kể bởi $CLOAKING_PENALTY_MODS$."
 CLOAKING_STRENGTH_6_DESC: "$CLOAKING_EXCEPTIONAL_DESC$ $CLOAKING_EXCEPTIONAL_CAN_BE_IMPROVED$"
 CLOAKING_STRENGTH_7_DESC: "$CLOAKING_EXCEPTIONAL_DESC$ $CLOAKING_EXCEPTIONAL_CAN_BE_IMPROVED$"
 CLOAKING_STRENGTH_8_DESC: "$CLOAKING_EXCEPTIONAL_DESC$ $CLOAKING_EXCEPTIONAL_CAN_BE_IMPROVED$"
