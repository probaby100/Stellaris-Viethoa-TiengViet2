 col_capital_nomad: "首都方舟"
 col_capital_nomad_desc: "$col_capital_workforce_desc$"
 col_capital_nomad_tt: "游牧帝国的首都方舟承载着政府的行政中枢。那些引领舰队穿越星海的领袖们就居住于此。"
 col_capital_nomad_foundry: "铸造方舟"
 col_capital_nomad_foundry_desc: "$col_foundry_desc$"
 col_capital_nomad_foundry_tt: "我们首都锻造厂的声浪，足以与引擎的轰鸣一较高下。"
 col_capital_nomad_factory: "制造方舟舰"
 col_capital_nomad_factory_desc: "$col_factory_desc$"
 col_capital_nomad_factory_tt: "工匠与工厂工人们忙碌的身影穿梭于首都的每层甲板，源源不断地为飞船注入动力。"
 col_capital_nomad_trade: "贸易方舟"
 col_capital_nomad_trade_desc: "$col_city_desc$"
 col_capital_nomad_trade_tt: "我们的首都是一座繁荣的商业枢纽，货舱中堆满了来自星系各地的货物。"
 col_nomad_city: "城市方舟舰"
 col_nomad_city_desc: "$col_city_desc$"
 col_nomad_city_tt: "方舟的甲板层上住满了居民，其市场与大道上处处洋溢着商业与贸易的生机。"
 col_nomad_foundry: "铸造方舟舰"
 col_nomad_foundry_desc: "$col_foundry_desc$"
 col_nomad_foundry_tt: "合金铸造厂的热浪辐射穿透了每一层甲板，工业机器有节奏的铿锵声在过道中回荡。"
 col_nomad_factory: "制造方舟舰"
 col_nomad_factory_desc: "$col_factory_desc$"
 col_nomad_factory_tt: "$col_factory_tt$"
 col_nomad_bureau: "统一方舟舰"
 col_nomad_bureau_desc: "$col_bureau_desc$"
 col_nomad_bureau_tt: "整艘方舟专注于管理并统合子民。"
 col_nomad_research: "研究方舟舰"
 col_nomad_research_desc: "$col_research_desc$"
 col_nomad_research_tt: "这艘方舟的实验室在科学研究与技术进步中处于领先地位。"
 col_nomad_farming: "农业方舟舰"
 col_nomad_farming_desc: "$col_farming_desc$"
 col_nomad_farming_tt: "一排排的水培装置与生物质加工线，支撑着方舟上的人口度过星际间的漫长旅程。"
 col_nomad_generator: "发电方舟舰"
 col_nomad_generator_desc: "$col_generator_desc$"
 col_nomad_generator_tt: "近乎无穷无尽的反应堆核心阵列在这艘方舟各处嗡嗡作响、散发光芒，输出的能量供给着整个舰队。"
 col_nomad_fortress: "堡垒方舟舰"
 col_nomad_fortress_desc: "$col_fortress_desc$"
 col_nomad_fortress_tt: "这艘方舟遍布武器炮台，并加固了舱壁，堪称一座移动堡垒。"
 col_nomad_nexus: "中枢方舟舰"
 col_nomad_nexus_desc: "$col_nexus_desc$"
 col_nomad_nexus_tt: "一个由维修机库与修复设施组成的网络贯穿这艘方舟的各层甲板，维持着整个舰队的正常运转。"
 col_nomad_hive: "蜂群方舟舰"
 col_nomad_hive_desc: "$col_hive_desc$"
 col_nomad_hive_tt: "这艘方舟的每一层都满是熙熙攘攘的走廊与公共舱室，集体意志的嗡鸣声在其中回荡。"
 col_nomad_bureau_spiritualist: "教会方舟舰"
 col_nomad_bureau_spiritualist_desc: "$col_bureau_spiritualist_desc$"
 col_nomad_bureau_spiritualist_tt: "$col_bureau_spiritualist_tt$"
