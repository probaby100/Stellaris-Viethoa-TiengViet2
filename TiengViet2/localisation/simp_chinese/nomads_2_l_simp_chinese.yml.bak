l_simp_chinese:
 # Arkship
 OUTLINER_ARKSHIPS: "方舟"
 OUTLINER_ARKSHIP_COLONY_LABEL: "群落"
 OUTLINER_ARKSHIP_SHIP_CONTROLS_LABEL: "舰船控制"
 OUTLINER_ARKSHIP_IDLE_CONSTRUCTION: "无建设工作"
 mobile: "航行"
 stationary: "停泊"
 district_ark_city: "居住甲板"
 district_ark_city_plural: "$district_ark_city$"
 district_ark_city_desc: "一大块划归居住、商业及社区功能的舰船区段。它是我们迁徙文明涌动的核心。"
 district_ark_generator: "反应堆阵列"
 district_ark_generator_plural: "$district_ark_generator$"
 district_ark_generator_desc: "在下部舰体整齐排列的一大组大功率反应堆，将澎湃的动力传输给舰上的每个系统。"
 district_ark_basic: "方舟甲板"
 district_ark_basic_name: "基础住房"
 district_ark_basic_plural: "$district_ark_basic$"
 district_ark_basic_desc: "方舟的这些甲板目前用于居住，但也可以发展出更多特化用途。"
 district_ark_military: "军械工程"
 district_ark_military_plural: "$district_ark_military$"
 district_ark_military_desc: "这些装甲工程区段里居住着工程专家，负责维护方舟武备、防御系统和船体完整性。"
 district_ark_military_name: "工程学核心"
 district_ark_military_flavor_desc: "$district_ark_military_desc$"
 pc_ark: "方舟"
 mod_pc_ark_habitability: "方舟宜居性"
 job_ark_waystation_trader: "驿站审计官"
 job_ark_waystation_trader_plural: "$job_ark_waystation_trader$"
 job_ark_waystation_trader_desc: "对驿站的远程管理是一项充满艰辛且永无止境的后勤工作，但总得有人来承担这项任务。"
 job_ark_harvester: "宇航采收工"
 job_ark_harvester_plural: "宇航采收工"
 job_ark_harvester_desc: "宇航采收工负责轨道矿藏的收集和处理，大幅提升了资源产出。"
 mod_job_ark_waystation_trader_add: "$job_ark_waystation_trader$岗位"
 mod_job_ark_harvester_add: "$job_ark_harvester$岗位"
 job_ark_harvester_plural_with_icon: "£job_ark_harvester£ $job_ark_harvester_plural$"
 mod_pop_ark_harvester_bonus_workforce_mult: "$job_ark_harvester_plural$的岗位效率"
 zone_ark_missile_silos: "导弹发射井"
 zone_ark_missile_silos_desc: "专业的维护组会对导弹舱进行定期维护保养，确保其状态良好随时待发，他们以纯粹的能源消耗为代价换取了先发制人的打击能力。"
 zone_ark_ammunition_lines: "弹药生产线"
 zone_ark_ammunition_lines_desc: "全天候生产动能弹药，确保我们的巨炮永不哑火。每一件装填器、每一个弹壳、每一份推进剂的用量都经过精确计算。"
 zone_ark_laser_capacitors: "激光电容"
 zone_ark_laser_capacitors_desc: "一排排高容量电容直接向激光阵列灌输能量，在发射器散热能力的极限维持开火速率。"
 zone_ark_flight_decks: "飞行甲板"
 zone_ark_flight_decks_desc: "无间断的训练让我们可以用无与伦比的精度运作舰载机，编织起梯次火力。"
 zone_ark_missile_silos_module_synergy_tt: "§H$sm_explosive_cat$§!模块提供的$soldier_type_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_ammunition_lines_module_synergy_tt: "§H$sm_projectile_cat$§!模块提供的$soldier_type_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_laser_capacitors_module_synergy_tt: "§H$sm_energy_cat$§!模块提供的$soldier_type_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_flight_decks_module_synergy_tt: "§H$sm_strike_craft_cat$§!模块提供的$soldier_type_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_engine_bypass: "$district_ark_engine_bypass$"
 zone_ark_engine_bypass_desc: "$district_ark_engine_bypass_desc$"
 zone_ark_shield_overloader: "$district_ark_shield_overloader$"
 zone_ark_shield_overloader_desc: "$district_ark_shield_overloader_desc$"
 district_ark_engine_bypass: "引擎分流器"
 district_ark_engine_bypass_plural: "$district_ark_engine_bypass$"
 district_ark_engine_bypass_desc: "引擎旁路系统摒弃了传统的冷却方式，转而将多余能量直接用于驱动舰船引擎，但这一做法的代价是能量币的产量随之降低。"
 district_ark_shield_overloader: "护盾超频器"
 district_ark_shield_overloader_plural: "$district_ark_shield_overloader$"
 district_ark_shield_overloader_desc: "在反应堆中注入异星物质使我们能够维持超出正常指标参数的护盾。"
 district_ark_harvest: "$zone_ark_harvest$"
 district_ark_harvest_plural: "$zone_ark_harvest$"
 district_ark_harvest_desc: "$zone_ark_harvest_desc$"
 district_ark_harvest_flavor_desc: "$zone_ark_harvest_desc$"
 district_ark_harvest_name: "处理设施"
 mod_ship_speed_from_technicians: "每$pop_group_unit$$technician_type_plural_with_icon$提供的£mod_ship_speed_mult£$MOD_SHIP_SPEED_MULT$"
 mod_ship_shield_from_technicians: "每100$technician_type_plural_with_icon$提供的£mod_ship_shield_mult£$MOD_SHIP_SHIELD_MULT$"
 mod_ship_shield_regen_from_technicians: "每100$technician_type_plural_with_icon$提供的£mod_ship_shield_regen_mult£$MOD_SHIP_SHIELD_REGEN_MULT$"
 mod_ship_armor_from_metallurgists: "每100$foundry_type_plural_with_icon$提供的£mod_ship_armor_mult£$MOD_SHIP_ARMOR_MULT$"
 mod_ship_hardening_from_metallurgists: "每100$foundry_type_plural_with_icon$提供的£mod_ship_armor_hardening_add£$MOD_SHIP_ARMOR_HARDENING_ADD$"
 mod_naval_cap_from_shipwright: "每100$soldier_type_plural_with_icon$提供的£mod_country_naval_cap_add£$MOD_COUNTRY_NAVAL_CAP_ADD$"
 mod_ship_build_speed_from_shipwright: "每100$soldier_type_plural_with_icon$提供的£mod_ship_build_speed_mult£舰船建造速度"
 mod_weapon_explosive_from_soldiers: "每100$soldier_type_plural_with_icon$提供的£mod_weapon_damage_mult£$mod_weapon_type_explosive_weapon_damage_mult$"
 mod_weapon_kinetic_from_soldiers: "每100$soldier_type_plural_with_icon$提供的£mod_weapon_damage_mult£$mod_weapon_type_kinetic_weapon_damage_mult$"
 mod_weapon_energy_from_soldiers: "每100$soldier_type_plural_with_icon$提供的£mod_weapon_type_energy_weapon_damage_mult£$mod_weapon_type_energy_weapon_damage_mult$"
 mod_weapon_strike_craft_from_soldiers: "每100$soldier_type_plural_with_icon$提供的£mod_weapon_damage_mult£$mod_weapon_type_strike_craft_weapon_damage_mult$"
 zone_ark_harvest: "采收港"
 zone_ark_harvest_desc: "在方舟上划分出专用空间，用于对采集到的资源进行分类与初筛，可以利用重力场下的操作优势与高效机械设备，从而提高资源产出。"
 planet_ark_harvester: "$job_ark_harvester_plural$"
 zone_ark_food: "方舟水培舱"
 zone_ark_food_desc: "方舟上的水培农场将为我们的人民提供食物。"
 zone_ark_waystation_trade: "驿站贸易中心"
 zone_ark_waystation_trade_desc: "随着专业人员开始协调我们的驿站和定居国家市场之间的货物运输，商业在这些甲板间川流不息。"
 district_ark_food: "$zone_ark_food$"
 district_ark_food_plural: "$zone_ark_food$"
 district_ark_food_desc: "$zone_ark_food_desc$"
 district_ark_hydroponics_name: "水培舱"
 district_ark_hydroponics_flavor_desc: "$zone_ark_food_desc$"
 district_ark_waystation_trade: "$zone_ark_waystation_trade$"
 district_ark_waystation_trade_plural: "$zone_ark_waystation_trade$"
 district_ark_waystation_trade_desc: "$zone_ark_waystation_trade_desc$"
 district_ark_waystation_trade_name: "贸易运营"
 district_ark_waystation_trade_flavor_desc: "$zone_ark_waystation_trade_desc$"
 job_ark_waystation_trader_gestalt: "贸易运营子个体"
 job_ark_waystation_trader_gestalt_plural: "$job_ark_waystation_trader_gestalt$"
 job_ark_waystation_trader_gestalt_desc: "这是一个负责协调我们驿站与广阔市场之间货物流通的处理单元。效率是其唯一目标。"
 mod_job_ark_waystation_trader_gestalt_add: "$job_ark_waystation_trader_gestalt$岗位"
 mod_pop_ark_waystation_trader_bonus_workforce_mult: "$job_ark_engineer_plural$$BONUS_WORKFORCE_FOR$"
 job_ark_harvester_gestalt: "宇航采收子个体"
 job_ark_harvester_gestalt_plural: "宇航采收子个体"
 job_ark_harvester_gestalt_desc: "宇航员配备的采收子个体，是专为执行太空行走任务而设计的，其主要职责是离开方舟，前往舱外采集轨道上的矿产资源。"
 job_ark_harvester_gestalt_effect_desc: "$job_ark_harvester_effect_desc$"
 mod_job_ark_engineer_gestalt_add: "$job_ark_engineer_gestalt_plural$岗位"
 mod_job_ark_harvester_gestalt_add: "$job_ark_harvester_gestalt_plural$岗位"
 mod_pop_ark_harvester_gestalt_bonus_workforce_mult: "$job_ark_harvester_gestalt_plural$$BONUS_WORKFORCE_FOR$"
 ark_harvester_jobs_bonus_workforce_mult: "$job_ark_harvester_plural$$BONUS_WORKFORCE_FOR$"
 ark_harvester_jobs_bonus_workforce_mult_tt: "$job_ark_harvester_plural$$BONUS_WORKFORCE_FOR$: $VARIABLE|1%=+$"
 mod_planet_ark_harvester_trade_upkeep_add: "$trade_upkeep_per_pop_group_unit$ $job_ark_harvester_plural_with_icon$"
 pc_ark_desc: "聚星球于一舟，化一舟为星球。"
 zone_ark_military_eco: "虚空熔炉"
 zone_ark_military_eco_desc: "将我们部分铸造厂改造为专门生产标准化装甲板的工厂，即可为我们提供随时可用的烧蚀防护备用件。"
 zone_ark_shipwright: "船舶工兵营"
 zone_ark_shipwright_desc: "将船舶建造和维护服务纳入我们的军事日程中，就能够调动部队支援海军造船厂。"
 zone_ark_shipwright_module_synergy_tt: "§H$sm_naval_support_cat$§!模块提供的$soldier_type_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_shipwright_module_synergy_gestalt_tt: "§H$sm_naval_support_cat$§!模块提供的$job_warrior_drone_swap_plural_with_icon$岗位：§G+$@arkship_module_jobs|0$§!"
 zone_ark_reactor_physics: "高能粒子加速器"
 zone_ark_reactor_physics_desc: "一座专门研究高能物理的设施，部署在方舟飞船的核心。"
 zone_ark_farm_society: "社会生态观测站"
 zone_ark_farm_society_desc: "研究人员借助这些定制实验室对方舟上的人口进行观察性研究。"
 zone_ark_military_engineering: "军事研究综合体"
 zone_ark_military_engineering_desc: "我们的研究人员与负责方舟飞船维护的人员之间的跨学科交流取得了实际成果。"
