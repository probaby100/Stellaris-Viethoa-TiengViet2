 RECIPIENT_IS_VOID_REAVERS: "虚空掠夺者"
 # Empire Creation - Nomadic Alternatives to "Homeworld"
 ARKSHIP_LABEL: "$arkship_cap$"
 ARKSHIP_CLASS: "$ARKSHIP_LABEL$类型"
 ARKSHIP_CLASS_LABEL: "$ARKSHIP_CLASS$"
 ARKSHIP_NAME: "$ARKSHIP_LABEL$名称"
 planet_class_editor_nomadic: "$ARKSHIP_LABEL$"
 TOOLTIP_SETUP_NAME_CLASS_NOMADIC: "§H$ARKSHIP_LABEL$§!\n选择你初始方舟的类型并自定义名称。"
 # Operational Reserves affordability check
 nomad_insufficient_operational_reserves: "§R运行储备不足§!"
 # Aetherophasic Anchor Waystation Module
 sm_waystation_aetherophasic_anchor: "以太相锚定"
 sm_waystation_aetherophasic_anchor_desc: "此设施将我们漂泊的舰队扎根于宇宙中的一个固定点位。借助锚定于此的驿站，我们指定此恒星系为§H$crisis_sphere_0$§!工程的天锚。我们在星海间收割的能量将汇聚于此，撕裂两界之间的屏障。"
 requires_waystation_aetherophasic_anchor: "游牧帝国必须选定§H以太相锚定§!驿站模块的位置才能启动最终阶段。该驿站模块所处的恒星系将承载§H$crisis_sphere_0$§!。"
 # Shown when starbase construction is blocked because a Nomad Arkship is mid-Settle in the target system.
 NOMAD_SETTLING_IN_PROGRESS_FAIL: "有一艘§H方舟舰§!目前正在向该恒星系§Y定居§!。"
 # Seize Waystation - operation_seize_waystation / nomads.8010 / 8015
 operation_seize_waystation: "夺取驿站"
 operation_seize_waystation_desc: "游牧舰队的力量来源于支撑它的驿站网络。控制驿站即可有效限制其行动能力。"
 operation_seize_waystation_on_success: "$IF_SUCCESSFUL|E$\n劫掠一座游牧驿站，窃取其中储备的资源并摧毁一个模块。\n\n向该行动指派一名§Y线人§!即有概率夺取驿站。"
 operation_seize_waystation_no_targets: "目标帝国在探测范围内没有运转中的驿站。"
 nomads.8010.name: "接近目标"
 nomads.8010.desc: "我方特工已经开始接近目标驿站，并绘制了安全模式图，确定了进入位置。我们已准备好推进至下一阶段。"
 nomads.8015.name: "系统已渗透"
 nomads.8015.desc: "我们的特工现已渗透进驿站的船员、访客与系统之中。关键安全中继器已被禁用，内部通讯正通过我们自己的过滤器转发。这座空间站，已经是我们的囊中之物了。"
 nomads.8020.name: "抢夺驿站"
 nomads.8020.desc: "我们的情报网络已经确定了一个目标驿站。特工已经渗透完成，准备就绪。增援部队随时待命，准备登上空间站。他们将按我们的指令发起突袭。"
 nomads.8025.name: "控制驿站"
 nomads.8025.desc: "我方特工已消灭了§Y[target_waystation.GetName]§!上的安全部队，我们正在转移其资源。待行动完成后，他们将……"
 nomads.8025.a: "...摧毁空间站。"
 nomads.8025.a.tt: "§R[target_waystation.GetName]§!被摧毁。"
 nomads.8025.b: "...拿走物资。"
 nomads.8025.c: "...全面控制。"
 nomads.8030.name: "驿站被渗透"
 nomads.8030.intro: "§Y[target_waystation.GetName]§!遭到了渗透！入侵者以武力强行夺取了空间站的控制权，并洗劫了库存的资源。"
 nomads.8030.detected: "尽管袭击者采取了种种预防措施以隐匿身份，但我们还是查明他们隶属于 §Y[From.GetName]§!。他们必须要为此付出代价！"
 nomads.8030.anonymous: "尽管我们尽了最大努力，但还是无法确认袭击者的真实身份。"
 nomads.8030.destroyed: "炸药引爆后，空间站被破坏，关键系统被摧毁，空间站的完整性受到损害。"
 nomads.8030.looted: "空间站局部在战斗中受损，但在部分敌人先行带着战利品离开后，我们的安全部队设法重新夺回了空间站。"
 nomads.8030.detected_destroyed.desc: "$nomads.8030.intro$$nomads.8030.destroyed$\n\n$nomads.8030.detected$"
 nomads.8030.detected_looted.desc: "$nomads.8030.intro$$nomads.8030.looted$\n\n$nomads.8030.detected$"
 nomads.8030.destroyed.desc: "$nomads.8030.intro$$nomads.8030.destroyed$\n\n$nomads.8030.anonymous$"
 nomads.8030.looted.desc: "$nomads.8030.intro$$nomads.8030.looted$\n\n$nomads.8030.anonymous$"
 nomads.8030.stolen.desc: "$nomads.8030.intro$现已查明，§Y[From.GetName]§!正是此次行动的幕后黑手——现在他们已经直接控制了该驿站，令其脱离了我们的驿道网络。"
 # Arkship / Waystation module and building slot tooltips
 OUTLINER_ARKSHIP_CONSTRUCTION_AVAILABLE_DESC: "这艘方舟现在可以建设额外的§Y模块§!或§Y系统§!。"
 OUTLINER_WAYSTATION_CONSTRUCTION_AVAILABLE_DESC: "这个驿站现在可以建设额外的§Y模块§!。"
 OUTLINER_ARKSHIP_UPGRADE_AVAILABLE_DESC: "该§Y方舟§!可被升级。"
 OUTLINER_WAYSTATION_UPGRADE_AVAILABLE_DESC: "该§Y驿站§!可被升级。"
 ARKSHIP_SYSTEMS: "系统"
 SYSTEM_SLOT: "系统槽位"
 EMPTY_MODULE_SLOT_DESC_ARKSHIP: "$SEPARATOR$\n§E该§H$SLOT_TYPE$§!未使用，可用于方舟的进一步升级改造。§!"
 EMPTY_MODULE_SLOT_LOCKED_DESC_ARKSHIP: "§R该§H$SLOT_TYPE$§!当前尚未解锁。§!\n$SEPARATOR$\n§E升级方舟舰解锁更多槽位。§!"
 EMPTY_MODULE_SLOT_DESC_WAYSTATION: "$SEPARATOR$\n§E该§H$SLOT_TYPE$§!未使用，可用于进一步发展驿站。§!"
 EMPTY_MODULE_SLOT_LOCKED_DESC_WAYSTATION: "§R这个§H$SLOT_TYPE$§!目前被锁定。§!\n$SEPARATOR$\n§E升级驿站以解锁更多槽位。§!"
 WAYSTATION_DOWNGRADE_CLICK: "\n§G点击降级驿站§!"
 WAYSTATION_DISMANTLE_DIALOG_TITLE: "拆解驿站？"
 WAYSTATION_DISMANTLE_DIALOG_DESC: "这将会摧毁驿站。"
 WAYSTATION_DESTROY_DESC: "这将会摧毁驿站。"
 nomadic_system_initializer: "§Y游牧恒星系初始化器§!\n"
 protoplanetary_nomad_init_NAME: "行星摇篮£nomad£"
 protoplanetary_nomad_init_DESC: "$nomadic_system_initializer$一颗被星云遮蔽的棕矮星，周围环绕着由岩石与冰星构成的原始行星盘，这些天体仍在不断凝聚之中。\n\n$system_initializer_DESC$"
 neutron_star_nomad_init_NAME: "超新星残余£nomad£"
 neutron_star_nomad_init_DESC: "$nomadic_system_initializer$超新星爆发后留下的致密残骸，周围环绕着被灼烧过的岩质世界与饱受辐射的碎片。\n\n$system_initializer_DESC$"
 blue_giant_nomad_init_NAME: "高光巨星£nomad£"
 blue_giant_nomad_init_DESC: "$nomadic_system_initializer$一颗高亮度的蓝巨星，正以近乎自我毁灭的速度消耗着自身的燃料。\n\n$system_initializer_DESC$"
 xray_binary_nomad_init_NAME: "中子双星£nomad£"
 xray_binary_nomad_init_DESC: "$nomadic_system_initializer$一颗明亮的蓝星与一颗中子星相伴而行，其外层物质被持续牵引剥离，化作喷薄而出的X射线辐射。\n\n$system_initializer_DESC$"
 black_hole_nomad_init_NAME: "黑洞£nomad£"
 black_hole_nomad_init_DESC: "$nomadic_system_initializer$一个恒星级黑洞，周围环绕着其前身恒星的残骸，高度辐射的岩石世界与漂泊的小行星带在其周围运行。\n\n$system_initializer_DESC$"
 twin_blue_star_nomad_init_NAME: "双子巨星£nomad£"
 twin_blue_star_nomad_init_DESC: "$nomadic_system_initializer$两颗炽热的蓝星在相近的轨道上紧密缠绕，它们一起释放的辐射将近处的一切摧毁。\n\n$system_initializer_DESC$"
 situation_nomad_economy_critical_reserves_desc: "§H运行储备§!低于1000\n$mod_country_physics_research_produces_mult$：§R-75%§!\n$mod_country_society_research_produces_mult$：§R-75%§!\n$mod_country_engineering_research_produces_mult$：§R-75%§!\n$mod_country_unity_produces_mult$：§R-75%§!\n$mod_country_alloys_produces_mult$：§R-75%§!"
 COLONIZATION_IMPOSSIBLE_EMBARKING: "$TRIGGER_FAIL$§RCannot colonize while embarking§!"
 EMBARKING_IMPOSSIBLE_COLONIZATION: "§RCannot embark while colonizing§!"
