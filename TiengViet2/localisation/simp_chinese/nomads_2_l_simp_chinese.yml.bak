 # Action UI
 ACTION_SHARE_WAYSTATION_PACT_TYPE: "签订$wayline_pact$"
 ACTION_SHARE_WAYSTATION_PACT_TYPE_DESC: "我们将与该帝国签订$wayline_pact$，并从驿道网络中共同受益。"
 ACTION_SHARE_WAYSTATION_PACT_TITLE: "$ACTION_SHARE_WAYSTATION_PACT_TYPE$"
 ACTION_SHARE_WAYSTATION_PACT_DESC: "$ACTION_SHARE_WAYSTATION_PACT_TYPE_DESC$"
 ACTION_SHARE_WAYSTATION_PACT_IMPOSSIBLE_DESC: "无法与该帝国分享驿道网络。"
 ACTION_SHARE_WAYSTATION_PACT_OFFER_DESC: "§H[Actor.GetName]§!提议双方共享驿道网络。"
 # Notification
 MESSAGE_SHARE_WAYSTATION_PACT_TITLE: "驿站网络共享"
 ACTION_SHARE_WAYSTATION_PACT_PROPOSAL_FAILED_ACTOR: "我方提出的共享驿道网络的提议被拒绝了。"
 ACTION_SHARE_WAYSTATION_PACT_PROPOSAL_FAILED_RECIPIENT: "§H[Actor.GetName]§!拒绝了我方共享驿道网络的提议。"
 ACTION_SHARE_WAYSTATION_PACT_NOTIFICATION: "§H[Actor.GetName]§!同意与我方共享驿道网络。"
 # Dialogue
 01_SHARE_WAYSTATION_PACT_SELECT: "他们是想要共享我们在驿站间建立的驿道吗？"
 01_SHARE_WAYSTATION_PACT_PROPOSE: "我们的舰队与大家共享这片虚空，拓展驿道，并藉由建造的设施获益，这似乎是很自然的。"
 01_SHARE_WAYSTATION_PACT_ACCEPT: "我们之间的道路应当畅通无阻。我方同意与你们共享驿道网络。"
 01_SHARE_WAYSTATION_PACT_REFUSE: "我们觉得把航道握在自己手中更好，就不和你们分享这套网络了。"
 # Cancel
 # Action UI
 ACTION_BREAK_WAYSTATION_PACT_TYPE: "撕毁$wayline_pact$"
 ACTION_BREAK_WAYSTATION_PACT_TYPE_DESC: "撕毁与该帝国的$wayline_pact$，收回所有关联驿道网络的通行权。"
 ACTION_BREAK_WAYSTATION_PACT_TITLE: "$ACTION_BREAK_WAYSTATION_PACT_TYPE$"
 ACTION_BREAK_WAYSTATION_PACT_DESC: "$ACTION_BREAK_WAYSTATION_PACT_TYPE_DESC$"
 ACTION_BREAK_WAYSTATION_PACT_OFFER_DESC: "§H[Actor.GetName]§!已经撕毁了与§H[Recipient.GetName]§!的$wayline_pact$。"
 # Notification
 MESSAGE_BREAK_WAYSTATION_PACT_TITLE: "$wayline_pact$被撕毁"
 ACTION_BREAK_WAYSTATION_PACT_NOTIFICATION: "§H[Actor.GetName]§!已经撕毁了我们的$wayline_pact$。"
 # Dialogue
 01_BREAK_WAYSTATION_PACT_SELECT: "他们已经撕毁了我们的$wayline_pact$。"
 01_BREAK_WAYSTATION_PACT_PROPOSE: "原先设置的条款不再适合我们了，我们之间的$wayline_pact$就此解除，即刻生效。"
 01_BREAK_WAYSTATION_PACT_ACCEPT: "我们没有收到预期的效果，条约即刻终止。"
 opinion_cancelled_waystation_pact: "撕毁$wayline_pact$"
 TRUST_FROM_WAYSTATION_PACT: "$wayline_pact$: $VALUE|+=$"
