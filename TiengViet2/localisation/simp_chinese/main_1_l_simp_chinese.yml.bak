 trait_pc_desert_preference: "Ưa hành tinh sa mạc"
 trait_pc_desert_preference_short: "Sa mạc"
 trait_pc_desert_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_tropical_preference: "Ưa hành tinh nhiệt đới"
 trait_pc_tropical_preference_short: "Nhiệt đới"
 trait_pc_tropical_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_nuked_preference: "Ưa hành tinh chết chóc"
 trait_pc_nuked_preference_short: "Hành tinh chết chóc"
 trait_machine_pc_nuked_preference: "$trait_pc_nuked_preference$"
 trait_machine_pc_nuked_preference_short: "$trait_pc_nuked_preference_short$"
 trait_pc_nuked_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_machine_pc_nuked_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_gaia_preference: "Ưa hành tinh Gaia"
 trait_pc_gaia_preference_short: "Hành tinh Gaia"
 trait_pc_gaia_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_ai_preference: "Ưa hành tinh trí tuệ nhân tạo"
 trait_pc_ai_preference_short: "Hành tinh trí tuệ nhân tạo"
 trait_pc_ai_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_ringworld_habitable_preference: "Ưa thế giới vòng tròn"
 trait_pc_ringworld_habitable_preference_short: "Thế giới vòng tròn"
 trait_pc_ringworld_habitable_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_habitat_preference: "Ưa trạm cư trú"
 trait_pc_habitat_preference_short: "Trạm cư trú"
 trait_pc_habitat_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_shattered_ring_habitable_preference: "Ưa thế giới vòng tròn"
 trait_pc_shattered_ring_habitable_preference_short: "Thế giới vòng tròn"
 trait_pc_shattered_ring_habitable_preference_desc: "$trait_pc_arctic_preference_desc$"
 trait_pc_gaia_preference_terraforming: "$trait_pc_gaia_preference$"
 trait_pc_gaia_preference_terraforming_short: "$trait_pc_gaia_preference_short$"
 trait_pc_gaia_preference_terraforming_desc: "§LSở thích khí hậu được thiết lập ở mức độ gen, trong trường hợp này, đó là do một sự cố.§!"
 gaia_preference_terraforming_trait_tooltip: "Sản lượng nhân khẩu trên hành tinh Gaia: §G+5%§!"
 trait_dry_planet_preference: "Ưa hành tinh khô ráo"
 trait_dry_planet_preference_short: "Hành tinh khô ráo"
 trait_dry_planet_preference_desc: "§LSở thích khí hậu đã được thiết kế sẵn.§!"
 trait_wet_planet_preference: "Ưa hành tinh ẩm ướt"
 trait_wet_planet_preference_short: "Hành tinh ẩm ướt"
 trait_wet_planet_preference_desc: "$trait_dry_planet_preference_desc$"
 trait_cold_planet_preference: "Ưa hành tinh lạnh giá"
 trait_cold_planet_preference_short: "Hành tinh lạnh giá"
 trait_cold_planet_preference_desc: "$trait_dry_planet_preference_desc$"
 trait_machine_habitat_planet_preference: "$trait_pc_habitat_preference$"
