 shroud_forged_defense_army: "Quân phòng thủ Rèn từ Hư Cảnh"
 shroud_forged_defense_army_plural: "Quân phòng thủ Rèn từ Hư Cảnh"
 shroud_forged_defense_army_desc: "Những cơ thể người tổng hợp được đồng điệu linh năng bảo vệ thế giới của chúng, tiếp nhận lòng quyết tâm từ Hư Cảnh — một niềm tin mà các đơn vị máy móc thuần túy không thể nào đạt tới."
 android_army: "Quân xung kích Android"
 android_army_plural: "Quân Android"
 android_army_desc: "Những binh lính bán tự động cấu thành nên cỗ máy chiến tranh trơn tru này. So với Robot thông thường, lính Android linh hoạt hơn, hung hãn hơn và biết cách xử lý các tình huống chiến trường đa dạng."
 android_defense_army: "Quân phòng vệ Android"
 android_defense_army_plural: "Quân phòng vệ Android"
 android_defense_army_desc: "$android_army_desc$"
 psionic_army: "Quân Linh năng"
 psionic_army_plural: "Quân Linh năng"
 psionic_army_desc: "Lực lượng sở hữu năng lực tâm linh. Sức mạnh linh năng hủy diệt cho phép họ áp dụng các chiến thuật độc đáo trên chiến trường — mục tiêu hàng đầu thường là bẻ gãy ý chí chiến đấu của kẻ thù."
 xenomorph_army: "Quân Dị hình"
 xenomorph_army_plural: "Quân Dị hình"
 xenomorph_army_desc: "Hàng ngàn quái thú đói khát với nanh vuốt sắc nhọn và bản năng khao khát chém giết, được lai tạo từ kỹ thuật sinh học. Một nhóm khoa học gia đứng ở hầm ngầm kiên cố cách xa tiền tuyến để giám sát và lùa bầy thú điên cuồng này ra trận."
 gene_warrior_army: "Quân Chiến binh Gen"
 gene_warrior_army_plural: "Quân đoàn Chiến binh Gen"
 gene_warrior_army_desc: "Siêu chiến binh biến đổi gen. Họ là những lính mới tinh anh được tuyển chọn từ các đơn vị truyền thống, sau đó trải qua quá trình chỉnh sửa gen để trở nên to lớn hơn, mạnh mẽ hơn và nhanh nhẹn hơn gấp bội."
 swarm_army: "Bầy đàn Prethoryn"
 swarm_army_plural: "Quân Bầy đàn"
 swarm_army_desc: "Chúng đang đói."
 ARMY_RANK: "Cấp độ: $RANK|Y$"
 ARMY_EXPERIENCE_FOR_NEXT_RANK: "Kinh nghiệm thăng cấp: $EXP|0Y$/$NEXT|0Y$"
 ARMY_AT_MAX_RANK: "Quân đội đã đạt cấp độ tối đa"
 ARMY_RANK_DESC: "§ECấp độ quân đội phụ thuộc vào kinh nghiệm tác chiến, quân hàm càng cao thì càng nắm nhiều ưu thế trên chiến trường.§!"
 SHIP_RANK: "Cấp độ: $RANK|Y$"
 SHIP_EXPERIENCE_FOR_NEXT_RANK: "Kinh nghiệm thăng cấp: $EXP|0Y$/$NEXT|0Y$"
 SHIP_AT_MAX_RANK: "Tàu đã đạt cấp độ tối đa"
 SHIP_RANK_DESC: "§ECấp độ tàu phụ thuộc vào kinh nghiệm chiến đấu của thủy thủ đoàn. Tàu có cấp độ càng cao thì hiệu năng chiến đấu càng vượt trội.§!"
 army_rank_regular: "Tân binh"
 army_rank_experienced: "Đã huấn luyện"
 army_rank_veteran: "Cựu binh"
 army_rank_elite: "Tinh nhuệ"
 ship_rank_regular: "$army_rank_regular$"
 ship_rank_experienced: "$army_rank_experienced$"
 ship_rank_veteran: "$army_rank_veteran$"
 ship_rank_elite: "$army_rank_elite$"
 rebel_army: "Quân Nổi dậy"
 rebel_army_desc: "Khi người dân bị đối xử bất công, quân nổi dậy sẽ hình thành."
 rebel_slave_defense_army: "Nô lệ Nổi dậy"
 rebel_slave_defense_army_desc: "Đội quân gồm những nô lệ bất mãn, họ công khai nổi dậy vũ trang với hy vọng giành lại tự do."
 primitive_army: "Quân Bản địa"
 primitive_army_plural: "Quân Bản địa"
 primitive_army_desc: "Lực lượng bản địa nhìn chung chỉ là một nhóm ô hợp được trang bị những vũ khí thô sơ nhất mà họ có thể chế tạo."
 primitive_additional_army: "$primitive_army$"
 primitive_additional_army_desc: "$primitive_army_desc$"
 industrial_army: "Quân đội Thời Công nghiệp"
 industrial_army_plural: "Quân đội Thời Công nghiệp"
 industrial_army_desc: "Quân đội của một xã hội công nghiệp tuy thiếu khả năng phản ứng nhanh của lực lượng lục quân hiện đại, nhưng ít nhất họ được tổ chức bài bản. "
 postatomic_army: "Quân đội Hậu Nguyên tử"
 postatomic_army_plural: "Quân đội Hậu Nguyên tử"
 postatomic_army_desc: "Chiếu theo tiêu chuẩn sơ khai, lực lượng Hậu Nguyên tử được trang bị rất tốt, kỷ luật và quá trình huấn luyện của họ đôi khi đủ sức đánh bại cả quân đội của những nền văn minh đã tiến vào kỷ nguyên không gian."
 subterranean_industrial_army: "$industrial_army$"
 subterranean_industrial_army_plural: "$industrial_army_plural$"
 subterranean_industrial_army_desc: "$industrial_army_desc$"
 subterranean_postatomic_army: "$postatomic_army$"
 subterranean_postatomic_army_plural: "$postatomic_army_plural$"
 subterranean_postatomic_army_desc: "$postatomic_army_desc$"
 elite_guard_army: "Cận vệ Tinh nhuệ"
 elite_guard_army_plural: "Cận vệ Tinh nhuệ"
 elite_guard_army_desc: "Lực lượng cận vệ cá nhân tinh nhuệ của Người cai trị."
 elite_guard_army_proper: "Cận vệ Tinh nhuệ"
 elite_guard_army_plural_proper: "Cận vệ Tinh nhuệ"
 elite_guard_army_desc_proper: "Lực lượng cận vệ cá nhân tinh nhuệ của Người cai trị."
 elite_guard_army_trigger_tooltip: "Mỗi vị Người cai trị chỉ có thể chiêu mộ một đội Cận vệ Tinh nhuệ."
 mutant_army: "Bầy Đột biến"
 mutant_army_desc: "Những bầy đột biến tấn công với sự tàn bạo dị thường."
 ice_army: "Chiến binh Tuyết sống"
 ice_army_desc: "Lực lượng tuyết sống hợp thành một đội quân đáng sợ, có khả năng đóng băng cả xương tủy, lớp mai hay bảng mạch của kẻ thù."
 titanic_assault_army: "Thú khổng lồ Titan"
 titanic_assault_army_desc: "Những quái thú khổng lồ là những chiến binh vô cùng hùng mạnh."
 titanic_guardian_army: "Hộ vệ Khổng lồ"
 titanic_guardian_army_desc: "Ít hung hãn hơn dã thú khổng lồ, nhưng ở vị trí phòng ngự thì các hộ vệ này vẫn cực kỳ đáng gờm."
 NAME_Rampaging_Forest: "Khu rừng Cuồng nộ"
 tree_army: "$NAME_Rampaging_Forest$"
 tree_army_desc: "Một khu rừng biết di chuyển với trí tuệ thấp kém nhưng tràn ngập lòng thù hận."
 robot_uprising_army: "Quân Nổi dậy Robot"
 robot_uprising_army_plural: "Quân Nổi dậy Robot"
 robot_uprising_army_desc: "Những cỗ máy sát thủ máu lạnh đang nổi dậy chống lại chính đấng sáng tạo của mình. Chúng sẵn sàng hy sinh tất cả để đạt mục đích, và không hề bị ảnh hưởng bởi tinh thần sa sút như quân đội sinh học."
