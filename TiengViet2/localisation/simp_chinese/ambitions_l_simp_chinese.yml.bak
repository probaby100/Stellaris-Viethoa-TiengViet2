l_simp_chinese:
 #######################
 # Tham Vọng Phi Khủng Hoảng
 #######################
 ##Người Bảo Vệ Thiên Hà
 crisis_defender_level_1: "§AChí Sĩ§!"
 crisis_defender_level_1_desc: "Cấp độ Tham vọng 1"
