 # Paladin Traits
 leader_trait_paladin: "Thánh Kỵ Sĩ"
 leader_trait_paladin_desc: "Nhà lãnh đạo này đang gánh vác trọng trách của một Thánh Kỵ Sĩ. Thông qua lời nói và hành động của mình, họ đã thể hiện bản thân là một người anh dũng, là một chiến binh vì sự tự do của thiên hà."
 leader_trait_paladin_effect: "Nhà lãnh đạo này không tốn §YPhí bảo trì§!, và không chiếm §YGiới hạn Lãnh đạo§!"
 leader_trait_paladin_ace: "Phi Công Chủ Lực"
 leader_trait_paladin_ace_desc: "Thánh Kỵ Sĩ này rất giỏi đưa ra quyết định và phản ứng trong chớp mắt, tấn công thẳng vào trái tim kẻ thù với độ chính xác cực cao."
 leader_trait_paladin_strategist: "Chiến Lược Gia"
 leader_trait_paladin_strategist_desc: "Thánh Kỵ Sĩ bình tĩnh và điềm đạm này rất giỏi trong việc lập kế hoạch, có thể tối đa hóa ưu thế của đồng đội."
 leader_trait_paladin_strategist_tt: "Hạm đội trong Hệ sao: $TABBED_NEW_LINE$—Tốc độ Bắn Vũ khí Hạm thuyền: §G+30%§!"
 PALADIN_STRATEGIST_AURA: "Hiệu Lệnh của $leader_trait_paladin_strategist$"
 leader_trait_paladin_ambusher: "Thánh Đột Kích"
 leader_trait_paladin_ambusher_desc: "Vị Thánh Kỵ Sĩ tập trung này rất kiên nhẫn và chính xác, là một bậc thầy trong việc tung ra những đòn tấn công quyết định."
 leader_trait_paladin_logistician: "Bậc Thầy Hậu Cần"
 leader_trait_paladin_logistician_desc: "Tư duy nhạy bén và quá trình huấn luyện khoa học của Thánh Kỵ Sĩ này cho phép họ giải quyết các vấn đề về hậu cần và bảo trì ngay cả trong những trận chiến ác liệt nhất."
 leader_trait_paladin_logistician_tt: "Hạm đội trong Hệ sao: $TABBED_NEW_LINE$—Phí bảo trì Hạm thuyền: §G-15%§!"
 PALADIN_LOGISTICIAN_AURA: "Tối Ưu Hóa của $leader_trait_paladin_logistician$"
 leader_trait_paladin_defender: "Thánh Hộ Vệ"
 leader_trait_paladin_defender_desc: "Thánh Kỵ Sĩ kiên định này tin rằng con tàu và phi hành đoàn có thể chống đỡ những khó khăn áp đảo, và luôn sẵn sàng bảo vệ bất kỳ đồng minh nào cần giúp đỡ."
 leader_trait_paladin_spearhead: "Thánh Tiên Phong"
 leader_trait_paladin_spearhead_desc: "Thánh Kỵ Sĩ dũng cảm này không ngần ngại chiến đấu trên tiền tuyến, phối hợp cùng các đồng minh để đánh bại những kẻ thù đáng sợ nhất."
 leader_trait_paladin_knight: "Hiệp Sĩ"
 leader_trait_paladin_knight_desc: "Thánh Kỵ Sĩ này đã lập lời thề dũng cảm. Kỹ năng vô song của họ trên chiến trường chỉ có thể được sánh bằng với quyết tâm không thể lay chuyển của họ."
 # Paladin Ships
 paladin_ship: "Chiến Hạm Thánh Kỵ Sĩ"
 paladin_ship_plural: "$paladin_ship$"
 paladin_ship_cap: "Chiến Hạm Thánh Kỵ Sĩ"
 only_one_paladin: "£trigger_no£Chúng ta chỉ có thể duy trì một §Y$paladin_ship$§!"
 PALADIN_SHIP_TEMPLATE: "Mũi Tàu Thực Vật"
 PALADIN_SHIP_TEMPLATE_MAM: "Mũi Tàu Động Vật Có Vú"
 PALADIN_SHIP_TEMPLATE_AVI: "Mũi Tàu Chim Chóc"
 PALADIN_SHIP_TEMPLATE_MACH: "Mũi Tàu Máy Móc"
 PALADIN_SHIP_TEMPLATE_ARTH: "Mũi Tàu Động Vật Chân Đốt"
 SHIP_GRAPHICS_PALADIN_SHIP_DESC: "Nghệ thuật và công nghệ dung hợp, tạo nên biểu tượng tự do tỏa sáng trong bóng tối."
 SHIP_PALADIN_CREST: "Huy Hiệu Thánh Kỵ Sĩ"
 SHIP_PALADIN_CREST_DESC: "Huy hiệu thanh lịch này chứng tỏ con tàu này được chỉ huy bởi một Thánh Kỵ Sĩ, người bảo vệ Cộng Đồng Thiên Hà."
 SHIP_PALADIN_CREST_TT: "Mở khóa khả năng hạm thuyền độc đáo."
 # Paladin Abilities
 paladin_super_shield: "Thánh Kỵ Sĩ Thần Thuẫn"
 paladin_super_shield_ship_button: "\nHạm thuyền này nhận được các bùa lợi sau, kéo dài trong §Y£time£3 tháng§!:\n—§G+1000%§! $MOD_SHIP_SHIELD_MULT$\n—§G+75%§! $MOD_SHIP_SHIELD_REGEN_ADD_PERC$\n—§G+15%§! $MOD_SHIP_SHIELD_HARDENING_ADD$"
 paladin_super_shield_activity_key: "$paladin_super_shield$"
 paladin_super_shield_menu_title: "$paladin_super_shield$"
 paladin_super_shield_progress_activity_key: "$paladin_super_shield$"
 paladin_thunderclap: "Ngọn Giáo Dũng Vũ"
 paladin_thunderclap_ship_button: "\nMột §Rhạm đội thù địch§! ngẫu nhiên trong hệ sao này phải nhận tới §Y3750§! sát thương. Cứ mỗi §Y100,000§! điểm £diplo_weight£Trọng Lượng Ngoại Giao mà chúng ta sở hữu trong §YCộng Đồng Thiên Hà§!, hiệu ứng này sẽ có tác dụng lặp lại thêm một lần."
 paladin_thunderclap_activity_key: "$paladin_thunderclap$"
 paladin_thunderclap_menu_title: "$paladin_thunderclap$"
 paladin_thunderclap_progress_activity_key: "$paladin_thunderclap$"
 paladin_recall: "Triệu Hồi"
 paladin_recall_ship_button: "\nDịch chuyển Chiến Hạm Thánh Kỵ Sĩ đến Căn cứ không gian không thù địch gần nhất, và sửa chữa tối đa §G25%§! §YGiáp§! cùng §YThân tàu§! của nó."
 paladin_recall_activity_key: "$paladin_recall$"
 paladin_recall_menu_title: "$paladin_recall$"
 paladin_recall_progress_activity_key: "$paladin_recall$"
 paladin_teamwork: "Phối Hợp Nhịp Nhàng"
 paladin_teamwork_ship_button: "\nTrong §Y£time£3 tháng§!, tất cả Chiến Hạm Thánh Kỵ Sĩ trong hệ sao này nhận được:\n—§G+7.5%§!$MOD_SHIP_DAMAGE_REDUCTION_MULT$\n—§G+7.5%§!$MOD_SHIP_FIRE_RATE_MULT$\n—§G+7.5%§!$MOD_SHIP_EVASION_MULT$\n\nHiệu ứng này được nhân lên bởi số lượng Thánh Kỵ Sĩ trong hệ sao."
 paladin_teamwork_activity_key: "$paladin_teamwork$"
 paladin_teamwork_menu_title: "$paladin_teamwork$"
 paladin_teamwork_progress_activity_key: "$paladin_teamwork$"
 paladin_teamwork_tt: "£trigger_no£Hạm thuyền này đã nhận được hiệu ứng §H$paladin_teamwork$§!"
 paladin_leadership: "Tuân Theo Mệnh Lệnh"
 paladin_leadership_ship_button: "\nTất cả hạm thuyền đồng minh trong hệ sao nhận được hiệu ứng sau, kéo dài trong §Y£time£3 tháng§!:\n—§G+20%§! $MOD_SHIP_WEAPON_RANGE_MULT$\n—§G+20%§! $MOD_SHIP_WEAPON_DAMAGE$\n—§G+20%§! $MOD_SHIP_SPEED_MULT$"
 paladin_leadership_activity_key: "$paladin_leadership$"
 paladin_leadership_menu_title: "$paladin_leadership$"
 paladin_leadership_progress_activity_key: "$paladin_leadership$"
 paladin_field_testing: "Thử Nghiệm Thực Địa"
 paladin_field_testing_ship_button: "\nTổ hợp vũ khí nguyên mẫu nguy hiểm này sẽ tạo ra những tác động không thể đoán trước."
 paladin_field_testing_activity_key: "$paladin_field_testing$"
 paladin_field_testing_menu_title: "$paladin_field_testing$"
 paladin_field_testing_progress_activity_key: "$paladin_field_testing$"
 paladin_harmonic_disruption: "Nhiễu Loạn Sóng Âm"
 paladin_air_superiority: "Ưu Thế Không Gian"
 paladin_air_superiority_ship_button: "\nTất cả hạm thuyền địch trong hệ sao này nhận được các bùa hại sau, kéo dài trong §Y£time£3 tháng§!:\n—§R-85%§!$mod_weapon_type_point_defense_weapon_damage_mult$\n—§R-85%§!$mod_weapon_type_strike_craft_weapon_damage_mult$\n—§R-85%§!$MOD_STRIKE_CRAFT_REGENERATION_MULT$"
