 crisis_defender_level_4_desc: "Cấp độ Tham vọng 4"
 crisis_defender_level_5: "§AHuyền Thoại§!"
 crisis_defender_level_5_desc: "Cấp độ Tham vọng 5"
 defender_level_2_req_clear_tooltip: "£trigger_yes£Đã hoàn thành dự án đặc biệt §H$DEFENDER_CRISIS_SPECIAL_PROJECT_1$§!"
 defender_level_2_req_tooltip: "£trigger_no£Đã hoàn thành dự án đặc biệt §H$DEFENDER_CRISIS_SPECIAL_PROJECT_1$§!"
 defender_level_3_req_clear_tooltip: "£trigger_yes£Đã hoàn thành dự án đặc biệt §H$DEFENDER_CRISIS_SPECIAL_PROJECT_2$§!"
