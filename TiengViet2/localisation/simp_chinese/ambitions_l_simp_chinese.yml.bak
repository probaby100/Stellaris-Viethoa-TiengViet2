 paladin_plan_b_menu_title: "$paladin_plan_b$"
 paladin_plan_b_progress_activity_key: "$paladin_plan_b$"
 paladin_sudden_strike: "Đột Kích"
 paladin_sudden_strike_ship_button: "\nTất cả hạm thuyền trong cụm hạm đội này nhận được các bùa lợi sau, kéo dài trong §Y£time£3 tháng§!:\n—§G+30%§! $MOD_SHIP_FIRE_RATE_MULT$\n—§G+75%§! $MOD_SHIP_SHIELD_PENETRATION_MULT$ và $MOD_SHIP_ARMOR_PENETRATION_MULT$\n—§G+20%§! $MOD_SHIP_ACCURACY_MULT$"
