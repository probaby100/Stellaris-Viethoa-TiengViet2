 paladin_sudden_strike_menu_title: "$paladin_sudden_strike$"
 paladin_sudden_strike_progress_activity_key: "$paladin_sudden_strike$"
 paladin_field_repairs: "Sửa Chữa Chiến Trường"
 paladin_field_repairs_ship_button: "\nTất cả hạm thuyền đồng minh trong hệ sao này nhận được các bùa lợi sau, kéo dài trong §Y£time£3 tháng§!:\n—§G+10%§! $MOD_SHIP_HULL_REGEN_ADD_PERC$\n—§G+10%§! $MOD_SHIP_ARMOR_REGEN_ADD_PERC$\n—§G+10%§! $MOD_SHIP_ARMOR_HARDENING_ADD$"
