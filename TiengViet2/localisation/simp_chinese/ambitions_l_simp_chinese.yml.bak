 paladin_air_superiority_progress_activity_key: "$paladin_air_superiority$"
 paladin_plan_b: "Kế Hoạch Dự Phòng"
 paladin_plan_b_ship_button: "\nTất cả hạm thuyền đồng minh trong hệ sao này nhận được các bùa lợi sau, kéo dài trong §Y£time£3 tháng§!:\n—§G+10§! $MOD_SHIP_DAMAGE_REDUCTION_ADD$\n—§G+25%§! $MOD_SHIP_SHIELD_PENETRATION_MULT$ và $MOD_SHIP_ARMOR_PENETRATION_MULT$\n—§G+50%§! $MOD_SHIP_ACCURACY_MULT$"
