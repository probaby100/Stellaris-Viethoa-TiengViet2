l_simp_chinese:
 ####################################
 #Lập trường Ngoại giao
 ####################################
 DIPLOMACY_STANCE: "§HLập trường Ngoại giao§!"
 diplo_stance_belligerent: "Cậy mạnh hiếp yếu"
 diplo_stance_belligerent_name: "$diplo_stance_belligerent$"
 diplo_stance_belligerent_nomad: "$diplo_stance_belligerent$"
 diplo_stance_belligerent_nomad_desc: "$diplo_stance_belligerent_desc$"
 diplo_stance_belligerent_desc: "Đế chế này cậy mạnh hiếp yếu, luôn tìm cách ép buộc các quốc gia nhỏ bé hơn phải cúi đầu trước ý chí của họ.\n\n§E$influence_cost_for_improving_relations_effect$§!"
 diplo_stance_cooperative: "Sẵn lòng Hợp tác"
 diplo_stance_cooperative_name: "$diplo_stance_cooperative$"
 diplo_stance_cooperative_nomad: "$diplo_stance_cooperative$"
 diplo_stance_cooperative_nomad_desc: "$diplo_stance_cooperative_desc$"
 diplo_stance_cooperative_desc: "Đế chế này sẽ lấy danh nghĩa tình bạn để đàm phán với các đế chế khác, tìm kiếm điểm chung và gác lại bất đồng.\n\n§E$influence_cost_for_harming_relations_effect$§!"
 diplo_stance_isolationist: "Tự cô lập"
 diplo_stance_isolationist_name: "$diplo_stance_isolationist$"
 diplo_stance_isolationist_nomad: "$diplo_stance_isolationist$"
 diplo_stance_isolationist_nomad_desc: "$diplo_stance_isolationist_desc$"
 diplo_stance_isolationist_desc: "Đế chế này chỉ muốn được yên ổn, tập trung lo chuyện trong nhà.\n\n§E$influence_cost_for_improving_or_harming_relations_effect$§!"
 diplo_stance_expansionist: "Bành trướng"
 diplo_stance_expansionist_name: "$diplo_stance_expansionist$"
 diplo_stance_expansionist_desc: "Đế chế này tìm kiếm sự phát triển trong hòa bình, nhưng không có trọng tâm cụ thể nào trong ngoại giao.\n "
 diplo_stance_expansionist_wilderness: "$diplo_stance_expansionist$"
 diplo_stance_expansionist_wilderness_name: "$diplo_stance_expansionist_name$"
 diplo_stance_expansionist_wilderness_desc: "$diplo_stance_expansionist_desc$"
 diplo_stance_supremacist: "Bá quyền"
 diplo_stance_supremacist_name: "$diplo_stance_supremacist$"
 diplo_stance_supremacist_nomad: "$diplo_stance_supremacist$"
 diplo_stance_supremacist_nomad_desc: "$diplo_stance_supremacist_desc$"
 diplo_stance_supremacist_desc: "Đế chế này đòi hỏi mọi thứ phải quỳ gối trước mặt họ.\n\n§RLập trường ngoại giao này sẽ làm xấu đi quan hệ với tất cả các đế chế khác cũng có lập trường §Y$diplo_stance_supremacist$§!§!\n\n§E$easy_rivalry$\n$influence_cost_for_improving_relations_effect$§!"
 triggered_opinion_diplo_stance_supremacy: "Cùng là $diplo_stance_supremacist$"
 diplo_stance_animosity: "Thù địch"
 diplo_stance_animosity_name: "$diplo_stance_animosity$"
 diplo_stance_animosity_desc: "Đế chế này muốn so kè với mọi Kẻ thù tiềm tàng.\n\n§RLập trường ngoại giao này làm tăng thêm 100 điểm ảnh hưởng ngoại giao tiêu cực khi trở thành §YKẻ thù§!.§!\n\n§EGiới hạn chỉ được coi những đế chế không yếu hơn mình là §YKẻ thù§! đã bị gỡ bỏ.\n\n$easy_rivalry$§!\n"
 diplo_stance_mercantile: "Thương mại là trên hết"
 diplo_stance_mercantile_name: "$diplo_stance_mercantile$"
 diplo_stance_mercantile_desc: "Đế chế này đặt việc tạo thuận lợi cho đầu tư thương mại lên hàng đầu.\n\n§E$influence_cost_for_close_borders$§! "
 diplo_stance_hunger: "Đói khát"
 diplo_stance_hunger_name: "$diplo_stance_hunger$"
 diplo_stance_hunger_desc: "Đế chế này luôn đói khát và tham lam, muốn nuốt chửng mọi thứ."
 diplo_stance_isolationist_swarm: "Nghỉ ngơi tĩnh dưỡng"
 diplo_stance_isolationist_swarm_name: "$diplo_stance_isolationist_swarm$"
 diplo_stance_isolationist_swarm_desc: "Đế chế này đã tiến vào trạng thái như đang say giấc."
 diplo_stance_extermination: "Tuyệt diệt"
 diplo_stance_extermination_name: "$diplo_stance_extermination$"
 diplo_stance_extermination_desc: "Đế chế này có ý định hủy diệt mọi sinh vật hữu cơ."
 diplo_stance_isolationist_exterminators: "Biên dịch lại"
 diplo_stance_isolationist_exterminators_name: "$diplo_stance_isolationist_exterminators$"
 diplo_stance_isolationist_exterminators_desc: "Đế chế này đã bước vào trạng thái tự kiểm tra, tạm dừng mọi thứ để đánh giá lại mục tiêu của mình."
 diplo_stance_purification: "Thanh tẩy"
 diplo_stance_purification_name: "$diplo_stance_purification$"
 diplo_stance_purification_desc: "Đế chế này tin rằng giá trị tồn tại duy nhất của kẻ thù là bị hủy diệt, và chính họ là những kẻ sẽ ban phát sự hủy diệt đó."
 diplo_stance_isolationist_purifiers: "Lùi bước Chiến lược"
 diplo_stance_isolationist_purifiers_name: "$diplo_stance_isolationist_purifiers$"
 diplo_stance_isolationist_purifiers_desc: "Đế chế này đã chuyển sự chú ý vào chuyện nội bộ và bước vào giai đoạn tái thiết."
 diplo_stance_isolationist_fallen_empire: "Ẩn mình"
 diplo_stance_isolationist_fallen_empire_name: "$diplo_stance_isolationist_fallen_empire$"
 diplo_stance_isolationist_fallen_empire_desc: "Đế chế này đã chìm vào một thời kỳ tăm tối từ rất lâu, và gần như hoàn toàn tách biệt bản thân khỏi phần còn lại của tinh hệ."
 diplo_stance_ignorant: "Hoàn toàn mù tịt"
 diplo_stance_ignorant_name: "$diplo_stance_ignorant$"
 diplo_stance_ignorant_desc: "Nền văn minh chưa đạt đến tốc độ siêu quang tốc này hoàn toàn mù tịt về những gì nằm ngoài giếng trọng lực của họ."
 diplo_stance_questioning: "Khát khao Khám phá"
 diplo_stance_questioning_name: "$diplo_stance_questioning$"
 diplo_stance_questioning_desc: "Nền văn minh chưa đạt đến tốc độ siêu quang tốc này đang bắt đầu tìm hiểu xem rốt cuộc có thứ gì tồn tại ngoài hệ sao của họ."
 diplo_stance_eager: "Háo hức"
 diplo_stance_eager_name: "$diplo_stance_eager$"
 diplo_stance_eager_desc: "Nền văn minh chưa đạt đến tốc độ siêu quang tốc này đang nóng lòng muốn vươn tới các vì sao, khám phá những phần còn lại của tinh hệ."
 diplo_stance_fearful: "Hoảng sợ"
 diplo_stance_fearful_name: "$diplo_stance_fearful$"
 diplo_stance_fearful_desc: "Nền văn minh chưa đạt đến tốc độ siêu quang tốc này luôn lo sợ về những mối đe dọa ngoài hành tinh tồn tại trong tinh hệ."
 diplo_stance_uncertain: "Do dự"
 diplo_stance_uncertain_name: "$diplo_stance_uncertain$"
 diplo_stance_uncertain_desc: "Nền văn minh chưa đạt đến tốc độ siêu quang tốc này không biết phải làm sao để tiếp xúc với các xã hội ngoài hành tinh."
 diplo_stance_culture_shock: "$culture_shock_diplomacy$"
 diplo_stance_culture_shock_name: "$diplo_stance_culture_shock$"
 diplo_stance_culture_shock_desc: "$culture_shock_diplomacy_desc$"
 policy_diplomatic_stance: "Lập trường Ngoại giao"
 policy_diplomatic_stance_desc: "Chúng ta có thể thiết lập đường lối ngoại giao chung, quyết định thái độ khi giao thiệp với các nền văn minh khác trong tinh hệ.\n"
 requires_supremacy_traditions: "$TRIGGER_FAIL$Yêu cầu §Y$tr_supremacy_finish$§!"
 requires_enmity_traditions: "$TRIGGER_FAIL$Yêu cầu §Y$tr_enmity_finish$§!"
