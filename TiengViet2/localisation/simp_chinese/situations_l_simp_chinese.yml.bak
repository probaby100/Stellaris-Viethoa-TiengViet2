 spiritualist_biological_parade_reject: "Nghi Thức Thanh Trừng [Root.GetLeviathanTargetName]"
 spiritualist_biological_parade_accept: "Nghi Thức Hiến Tế [Root.GetLeviathanTargetName]"
 spiritualist_mechanical_parade: "Nghi Thức Tuyệt Diệt Vô Hồn Của [Root.GetLeviathanTargetName]"
